    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Add to cart"
        },
        {
          "type": "select",
          "id": "mode",
          "label": "After adding",
          "default": "cart",
          "options": [
            {
              "value": "cart",
              "label": "Open the cart"
            },
            {
              "value": "checkout",
              "label": "Go straight to checkout"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "show_options",
          "label": "Show the option pickers above the button",
          "default": true,
          "info": "Turn off when a separate Variant picker block is used."
        },
        {
          "type": "checkbox",
          "id": "show_qty",
          "label": "Show quantity selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_payments",
          "label": "Show accepted payments",
          "default": true
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note under the button",
          "default": ""
        }
      ]
    },
    {
      "type": "trust_icons",
      "name": "Trust icons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label_1",
          "label": "Heart icon",
          "default": "30-day risk-free trial"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Shield icon",
          "default": "Secure checkout"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Truck icon",
          "default": "Fast & free shipping"
        }
      ]
    },
    {
      "type": "review",
      "name": "Featured review",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the product's top real review."
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & delivery"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "default": "custom",
          "options": [
            {
              "value": "custom",
              "label": "Text below"
            },
            {
              "value": "description",
              "label": "Product description"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Text",
          "default": "<p>Orders ship within 1–3 business days. See our <a href=\"{{ShippingLink}}\">Shipping Policy</a>.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 4,
      "settings": [
        {
          "type": "richtext",
          "id": "body",
          "label": "Text",
          "default": "<p>Add a short note.</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Until an image is picked, an empty frame shows here."
        },
        { "type": "text", "id": "default_image", "label": "Theme file while empty", "info": "Path inside assets/, e.g. images/xx-sections/photo.webp. Shown until a file is picked above." },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": ""
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "limit": 6,
      "settings": []
    },
    {
      "type": "custom_html",
      "name": "Custom HTML",
      "limit": 3,
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "HTML",
          "default": "<p>Custom content</p>"
        }
      ]
    },
    {
      "type": "media_slider",
      "name": "Image / video slider",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": ""
        },
        {
          "type": "range",
          "id": "per_view",
          "label": "Slides per row (desktop)",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 3,
          "info": "More slides than this = a sideways slider with arrows."
        },
        {
          "type": "select",
          "id": "per_view_mobile",
          "label": "Slides per row (phones)",
          "default": "1.5",
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "1.2",
              "label": "1.2 (peek at the next)"
            },
            {
              "value": "1.5",
              "label": "1.5 (peek at the next)"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "2.5",
              "label": "2.5"
            },
            {
              "value": "3",
              "label": "3"
            }
          ]
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Shape",
          "default": "9/16",
          "options": [
            {
              "value": "9/16",
              "label": "Portrait 9:16"
            },
            {
              "value": "3/4",
              "label": "Portrait 3:4"
            },
            {
              "value": "1/1",
              "label": "Square"
            },
            {
              "value": "4/3",
              "label": "Landscape 4:3"
            },
            {
              "value": "16/9",
              "label": "Landscape 16:9"
            }
          ]
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Gap",
          "min": 0,
          "max": 24,
          "step": 2,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "radius",
          "label": "Corner radius",
          "min": 0,
          "max": 24,
          "step": 2,
          "unit": "px",
          "default": 8
        },
        {
          "type": "checkbox",
          "id": "show_arrows",
          "label": "Show arrows when the slides do not fit",
          "default": true
        },
        {
          "type": "paragraph",
          "content": "Pick an image or a video (MP4 / WebM) in each slot. Videos play muted and looped while on screen; a tap pauses or resumes."
        },
        {
          "type": "range",
          "id": "slots",
          "label": "Number of slots",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 3,
          "info": "Slots without a file show an empty frame in the chosen shape until you upload one."
        },
        {
          "type": "image_picker",
          "id": "media_1",
          "label": "Image or video 1"
        },
        { "type": "text", "id": "default_media_1", "label": "Theme file while empty", "info": "Path inside assets/, e.g. images/xx-sections/photo.webp. Shown until a file is picked above." },
        {
          "type": "image_picker",
          "id": "media_2",
          "label": "Image or video 2"
        },
        { "type": "text", "id": "default_media_2", "label": "Theme file while empty", "info": "Path inside assets/, e.g. images/xx-sections/photo.webp. Shown until a file is picked above." },
        {
          "type": "image_picker",
          "id": "media_3",
          "label": "Image or video 3"
        },
        { "type": "text", "id": "default_media_3", "label": "Theme file while empty", "info": "Path inside assets/, e.g. images/xx-sections/photo.webp. Shown until a file is picked above." },
        {
