{
  "name": "Product",
  "tag": "section",
  "limit": 1,
  "max_blocks": 50,
  "settings": [
    {
      "type": "select",
      "id": "gallery_side",
      "label": "Gallery side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "default": "thumbs",
      "options": [
        {
          "value": "thumbs",
          "label": "Main image + thumbnails below"
        },
        {
          "value": "thumbs-left",
          "label": "Main image + thumbnails on the left"
        },
        {
          "value": "stack",
          "label": "All images stacked (desktop)"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show % off badge on the image",
      "default": true
    },
    {
      "type": "select",
      "id": "sale_badge_style",
      "label": "Badge text",
      "default": "minus",
      "options": [
        {
          "value": "minus",
          "label": "-50%"
        },
        {
          "value": "off",
          "label": "50% OFF"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "sticky_atc",
      "label": "Sticky Add to cart bar",
      "default": true
    },
    {
      "type": "select",
      "id": "sticky_style",
      "label": "Sticky bar style",
      "default": "compact",
      "options": [
        {
          "value": "compact",
          "label": "Compact (small card, bottom right on desktop)"
        },
        {
          "value": "full",
          "label": "Full width (price, SAVE badge, variant select, button)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": "Everything in the info column is a block — reorder, hide or add them."
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🏆"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Voted product of the year"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label after the count",
          "default": "reviews",
          "info": "Real reviews only; hidden while the product has none."
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Short line under the title"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit (check line)",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Key benefit of the product"
        }
      ]
    },
    {
      "type": "stock",
      "name": "Stock note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "In stock – ships within 24 hours",
          "info": "Keep it truthful: the theme does not read live stock."
        }
      ]
    },
    {
      "type": "urgency",
      "name": "Urgency line",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text ({n} = live number)",
          "default": "🔥 {n} people are viewing this right now"
        },
        {
          "type": "number",
          "id": "min",
          "label": "Lowest number",
          "default": 18
        },
        {
          "type": "number",
          "id": "max",
          "label": "Highest number",
          "default": 46
        }
      ]
    },
    {
      "type": "offer_heading",
      "name": "Offer heading",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Limited time offer"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Option pickers on their own (pills / swatches / dropdown come from each option's display type). Turn off \"Show the option pickers\" in Buy buttons when you use this."
        }
      ]
    },
    {
      "type": "variant_cards",
      "name": "Pack cards",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Cards show",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto: the product's variants (a Pack / Bundle / Set option if there is one, else the option below)"
            },
            {
              "value": "option",
              "label": "The option below"
            },
            {
              "value": "quantity",
              "label": "Quantity packs of the chosen variant (1 Pack, 2 Pack…)"
            }
          ],
          "info": "Variant cards show each option value as a card with that variant's real price. Quantity packs are priced with your live automatic discounts."
        },
        {
          "type": "number",
          "id": "option_index",
          "label": "Option shown as cards",
          "default": 0,
          "info": "0 = the product's first option (e.g. Color), 1 = the second… Used by Auto when the product has no Pack/Bundle option."
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Card style",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto: big cards for packs, compact tiles (price above) for other options"
            },
            {
              "value": "cards",
              "label": "Big cards with the price inside"
            },
            {
              "value": "tiles",
              "label": "Compact tiles, price shown above"
            }
          ]
        },
        {
          "type": "select",
          "id": "selected",
          "label": "Quantity pack selected by default",
          "default": "2",
          "options": [
            {
              "value": "1",
              "label": "Card 1"
            },
            {
              "value": "2",
              "label": "Card 2"
            },
            {
              "value": "3",
              "label": "Card 3"
            },
            {
              "value": "4",
              "label": "Card 4"
            },
            {
              "value": "5",
              "label": "Card 5"
            },
            {
              "value": "6",
              "label": "Card 6"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "currency_code",
          "label": "Show the currency code after prices (e.g. $57.95 AUD)",
          "default": true
        },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card style",
          "default": "classic",
          "options": [
            {
              "value": "classic",
              "label": "Classic (picture, boxed chosen card)"
            },
            {
              "value": "radio",
              "label": "Volume bundle (radio dot, no picture)"
            }
          ]
        },
        {
          "type": "color",
          "id": "pack_color",
          "label": "Chosen card, radio and badge colour (empty = button colour)",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "unit_pickers",
          "label": "Quantity packs: one Color / Size row per unit in the chosen pack",
          "default": false,
          "info": "Shoppers can mix variants inside a pack (e.g. 2 × Black M + 1 × Green L); each variant becomes its own cart line."
        },
        {
          "type": "text",
          "id": "unit_label",
          "label": "Per-unit price name (e.g. Pair, Item). Empty = hidden",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "includes_all",
          "label": "Show every pack's \"What's included\" list (not only the chosen one)",
          "default": false
        },
        {
          "type": "header",
          "content": "Card 1"
        },
        {
          "type": "number",
          "id": "card_1_qty",
          "label": "Quantity (quantity packs; 0 hides the card)",
          "default": 1
        },
        {
          "type": "text",
          "id": "card_1_title",
          "label": "Title (quantity packs)",
          "default": "1 Pack"
        },
        {
          "type": "image_picker",
          "id": "card_1_image",
          "label": "Image (quantity packs; empty = the chosen variant's photo)"
        },
        { "type": "text", "id": "default_card_1_image", "label": "Theme file while empty", "info": "Path inside assets/, e.g. images/xx-sections/photo.webp. Shown until a file is picked above." },
        {
          "type": "text",
          "id": "card_1_sub",
          "label": "Subtitle",
          "default": ""
        },
        {
          "type": "text",
          "id": "card_1_badge",
          "label": "Badge",
          "default": ""
        },
        {
          "type": "richtext",
          "id": "card_1_includes",
