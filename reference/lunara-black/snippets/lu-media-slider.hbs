ue"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button><button type="button" class="lu-ms__ar lu-ms__ar--n" aria-label="Next" hidden><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>{{/unless}}</div></div><style>.lu-ms{margin:1.5rem 0}.lu-ms__h{margin:0 0 1rem;font-size:1.8rem}.lu-ms__vp{position:relative}.lu-ms__tr{display:flex;gap:var(--gap);overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}.lu-ms__tr::-webkit-scrollbar{display:none}.lu-ms__it{flex:0 0 calc((100% - (var(--pv) - 1) * var(--gap)) / var(--pv));scroll-snap-align:start;aspect-ratio:var(--ar);border-radius:var(--r);overflow:hidden;background:rgba(var(--color-foreground),.04)}.lu-ms__it .lu-ms__m{display:block;width:100%!important;height:100%!important;max-width:none!important;object-fit:cover}.lu-ms__it video{cursor:pointer}@media (max-width:749px){.lu-ms__it{flex-basis:calc((100% - (var(--pvm) - 1) * var(--gap)) / var(--pvm))}}.lu-ms__ar{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:1px solid rgba(var(--color-foreground),.15);background:rgb(var(--color-background));color:rgb(var(--color-foreground));display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;z-index:1}.lu-ms__ar[hidden]{display:none}.lu-ms__ar--p{left:8px}.lu-ms__ar--n{right:8px}</style><script>(function(){if(window.__luMs)return window.__luMs();var io="IntersectionObserver" in window?new IntersectionObserver(function(es){es.forEach(function(e){var v=e.target;if(e.isIntersecting){var p=v.play();p&&p.catch(function(){})}else v.pause()})},{threshold:.25}):null;window.__luMs=function(){document.querySelectorAll(".lu-ms:not([data-ok])").forEach(function(r){r.setAttribute("data-ok","");var t=r.querySelector(".lu-ms__tr"),p=r.querySelector(".lu-ms__ar--p"),n=r.querySelector(".lu-ms__ar--n");function u(){if(!p)return;var o=t.scrollWidth-t.clientWidth>2;p.hidden=!o||t.scrollLeft<4;n.hidden=!o||t.scrollLeft>t.scrollWidth-t.clientWidth-4}function go(d){var it=t.querySelector(".lu-ms__it");t.scrollBy({left:d*(it?it.getBoundingClientRect().width:t.clientWidth),behavior:"smooth"})}p&&p.addEventListener("click",function(){go(-1)});n&&n.addEventListener("click",function(){go(1)});t.addEventListener("scroll",u,{passive:true});window.addEventListener("resize",u);u();r.querySelectorAll("video").forEach(function(v){io&&io.observe(v);v.addEventListener("click",function(){v.muted=!v.muted;v.play()})})})};window.__luMs()})()</script>
