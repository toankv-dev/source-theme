.lu-sf-res{margin-top:18px;padding:14px 16px;border-radius:10px;background:rgba(0, 0, 0,.07);border:1px solid rgba(0, 0, 0,.18);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.lu-sf-res[hidden]{display:none}
.lu-sf-res p{margin:0;font-size:1.4rem;color:#444;letter-spacing:0}
.lu-sf-res strong{display:block;font-size:2.4rem;line-height:1.15;color:var(--lu-primary,#000000);letter-spacing:0}
.lu-sf-res small{display:block;margin-top:2px;font-size:1.2rem;color:#777}
.lu-sf-go{height:46px;padding:0 22px;border:0;border-radius:10px;background:var(--lu-primary,#000000);color:#fff;font:inherit;font-size:1.5rem;font-weight:700;cursor:pointer;letter-spacing:0}
.lu-sf-go:hover{filter:brightness(1.08)}
.lu-sf-hint{margin:14px 0 0;font-size:1.3rem;color:#777;letter-spacing:0}
.lu-sf-tg{margin-top:16px;padding:0;border:0;background:none;color:#000000;font:inherit;font-size:1.4rem;font-weight:600;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.lu-sf-tbl{margin-top:10px;overflow:auto;border:1px solid #e6e6e6;border-radius:8px}
.lu-sf-tbl[hidden]{display:none}
.lu-sf-tbl table{border-collapse:collapse;width:100%;font-size:1.3rem;text-align:center}
.lu-sf-tbl table{table-layout:auto;margin:0;border:0}.lu-sf-tbl th,.lu-sf-tbl td{padding:7px 6px!important;height:auto!important;line-height:1.3!important;border:0!important;border-bottom:1px solid #eee!important;white-space:nowrap;color:#000000;font-size:1.3rem;letter-spacing:0;text-align:center;vertical-align:middle}
.lu-sf-tbl thead th{background:#f6f6f6;font-weight:700}
.lu-sf-tbl tbody th{background:#fafafa;font-weight:700}
.lu-sf-tbl td.on{background:var(--lu-primary,#000000);color:#fff;font-weight:700}
@media (max-width:749px){
.lu-sf-dlg{width:100vw;max-width:100vw;max-height:88vh;margin:auto 0 0;border-radius:16px 16px 0 0}
.lu-sf-dlg[open]{animation:luSfUp .22s ease-out}
@keyframes luSfUp{from{transform:translateY(100%)}to{transform:none}}
.lu-sf-hd{padding:16px 16px 10px}.lu-sf-bd{padding:2px 16px 20px}
.lu-sf-pill{min-width:0;flex:0 0 calc((100% - 32px)/5);padding:0 4px;height:44px;font-size:1.4rem}
.lu-sf-go{width:100%}
}
</style>
<style>
.lu-sf-units{display:inline-flex;border:1px solid #b9b9b9;border-radius:999px;overflow:hidden;margin:2px 0 4px}
.lu-sf-units button{border:0;background:#fff;color:#000000;font:inherit;font-size:1.3rem;padding:6px 14px;cursor:pointer;letter-spacing:0}
.lu-sf-units button[aria-pressed="true"]{background:var(--lu-primary,#000000);color:#fff}
.lu-sf-f{display:grid;gap:14px 12px;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));align-items:start;margin:8px 0 4px}
.lu-sf-f label{display:flex;flex-direction:column;gap:6px;font-size:1.4rem;font-weight:600;color:#000000;letter-spacing:0}
.lu-sf-f label[hidden],.lu-sf [hidden]{display:none!important}
.lu-sf-f label small{font-weight:400;color:#6b6b6b;font-size:1.2rem;line-height:1.35}
.lu-sf-l{line-height:1.2}
.lu-sf-f input,.lu-sf-f select{height:44px;border:1px solid #b9b9b9;border-radius:10px;padding:0 12px;font:inherit;font-size:1.5rem;color:#000000;background:#fff;width:100%;box-sizing:border-box}
.lu-sf-f input:focus,.lu-sf-f select:focus{outline:none;border-color:var(--lu-primary,#000000);box-shadow:0 0 0 3px color-mix(in srgb,var(--lu-primary,#000000) 15%,transparent)}
.lu-sf-how{margin:10px 0 0;font-size:1.25rem;color:#6b6b6b;line-height:1.5}
</style>
<style>.lu-sf-chart{display:block;width:100%;height:auto;margin:0 0 16px}.lu-sf[data-popup=image] .lu-sf-bd>:not(.lu-sf-chart){display:none!important}.lu-sf[data-popup=image] .lu-sf-chart{margin:0}</style><button type="button" class="lu-sf-open" data-lu-sf-open><svg class="lu-ruler" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7.5" width="20" height="9" rx="1.5"/><path d="M6 7.5v3M10 7.5v4.5M14 7.5v3M18 7.5v4.5"/></svg><span>{{#if section.settings.sf_link_label}}{{section.settings.sf_link_label}}{{else}}Size guide{{/if}}</span></button>
