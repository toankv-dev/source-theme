<script type="text/plain" data-lu-sf-map>{{#if section.settings.sf_map}}{{section.settings.sf_map}}{{else}}30: S, S, S, S, M, M, L, L
32: S, S, S, M, M, L, L, XL
34: S, M, M, M, L, L, XL, XL
36: M, M, L, L, L, XL, XL, XXL
38: L, L, L, XL, XL, XL, XXL, XXL
40: XL, XL, XL, XL, XXL, XXL, XXL, XXL
42: XL, XXL, XXL, XXL, XXL, XXL, XXL, XXL
44: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL
46: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL
48: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL{{/if}}</script>
<script type="text/plain" data-lu-sf-letters>{{#if section.settings.sf_letter_map}}{{section.settings.sf_letter_map}}{{else}}XXS: 31, 24, 34
XS: 33, 26, 36
S: 35, 28, 38
M: 37, 30, 40
L: 40, 33, 43
XL: 43, 36, 46
2XL: 46, 39, 49
3XL: 49, 42, 52
4XL: 52, 45, 55
5XL: 55, 48, 58{{/if}}</script>
<script>
(function(){
  /* Find my size (Lunara). Theme tu nhan dang kieu size tu option cua san pham (backend chi gui ten option + gia tri):
     - bra: gia tri dang 34B (Band+Cup trong 1 option), hoac 2 option Band + Cup, hoac size chu ma ten san pham la bra
       -> chon Band + Cup (size chu: tra bang Band x Cup trong Theme editor)
     - wl : quan size so W29 / L28 -> W = vong eo (inch), L = chieu dai chan trong (inch): khong can bang
     - letter: size chu XS..5XL -> do vong nguc / eo / hong, tra bang chuan US (Theme editor); co option Inseam
       (Extra Petite / Petite / Regular / Tall) -> hoi chieu cao
     Khong nhan ra -> an link. Ket qua dien vao bo chon chinh + moi dong Kaching. */
  var LETTERS=['XXXS','XXS','XS','S','M','L','XL','XXL','XXXL','XXXXL','XXXXXL','XXXXXXL'];
  var CUP_RE=/^(AA|A|B|C|DD|DDD|D|E|F|FF|G|GG|H|HH|I|J|K)(\/[A-Z]+)?$/;
  function norm(v){return String(v==null?'':v).trim().toUpperCase().replace(/[\s._-]+/g,'');}
  function letter(v){
    var n=norm(v).replace(/^(EXTRA|X)SMALL$/,'XS').replace(/^SMALL$/,'S').replace(/^MEDIUM$/,'M').replace(/^LARGE$/,'L')
      .replace(/^(EXTRA|X)LARGE$/,'XL').replace(/^(\d)X$/,'$1XL').replace(/^(\d)XL$/,function(m,d){return new Array(+d+1).join('X')+'L';})
      .replace(/^(\d)XS$/,function(m,d){return new Array(+d+1).join('X')+'S';});
    return LETTERS.indexOf(n)>=0?n:null;
  }
  function num(v,pre){var m=norm(v).match(pre?new RegExp('^'+pre+'?(\\d{2})(IN|")?$'):/^(\d{2})(IN|")?$/);return m?+m[1]:null;}
  function tier(v){var n=norm(v);
    if(/EXTRAPETITE|XPETITE|XSHORT|EXTRASHORT/.test(n))return 0;if(/PETITE|SHORT/.test(n))return 1;if(/REGULAR|STANDARD|AVERAGE/.test(n))return 2;
    if(/EXTRATALL|XTALL|EXTRALONG|XLONG/.test(n))return 4;if(/TALL|LONG/.test(n))return 3;return null;}
  function all(vals,fn){var ok=vals.filter(function(x){return fn(x)!=null;}).length;return vals.length>0&&ok>=Math.max(1,Math.ceil(vals.length*0.6));}

  Array.prototype.forEach.call(document.querySelectorAll('[data-lu-sf]:not([data-lu-sf-ready])'),function(root){
    root.setAttribute('data-lu-sf-ready','1');
    // Popup chi co anh bang size (Product > Size finder > Popup content): luon hien link, bo qua phan tinh size.
    if(root.getAttribute('data-popup')==='image'){var d0=root.querySelector('dialog');root.hidden=false;root.querySelector('[data-lu-sf-open]').addEventListener('click',function(){d0.showModal?d0.showModal():d0.setAttribute('open','');});root.querySelector('[data-lu-sf-close]').addEventListener('click',function(){d0.close?d0.close():d0.removeAttribute('open');});d0.addEventListener('click',function(e){if(e.target===d0&&d0.close)d0.close();});return;}
    var scope=root.closest('[data-ms-pdp]')||document;
    var MODE=(root.getAttribute('data-mode')||'auto').toLowerCase();
    var OPT=(root.getAttribute('data-option')||'Size').trim().toLowerCase();
    var title=((scope.querySelector('.product__title h1')||{}).textContent||'').toLowerCase();
    // ---- option cua san pham (bo chon chinh, an khi co Kaching nhung van trong DOM)
    var groups=Array.prototype.map.call(scope.querySelectorAll('.ms-variant-group'),function(g){
      var vals=[];Array.prototype.forEach.call(g.querySelectorAll('input[type=radio],option'),function(i){vals.push(i.value);});
      return {name:String(g.getAttribute('data-option-name')||''),key:String(g.getAttribute('data-option-name')||'').trim().toLowerCase(),vals:vals};
    });
    // Khong co block Variant picker (bo chon chinh) -> doc option tu JSON in san trong snippet.
    if(!groups.length){try{groups=(JSON.parse((root.querySelector('[data-lu-sf-opts]')||{}).textContent||'[]')||[]).map(function(g){return {name:String(g.name||''),key:String(g.name||'').trim().toLowerCase(),vals:(g.options||[]).map(function(o){return String(o.label);})};});}catch(e){}}
    function find(fn){for(var i=0;i<groups.length;i++)if(fn(groups[i]))return groups[i];return null;}
    var BRA_WORD=/\bbra\b|bralette|brassiere|\bbras\b/;
    var bra34=find(function(g){return all(g.vals,function(v){var m=norm(v).match(/^(\d{2})([A-Z]+(\/[A-Z]+)?)$/);return m&&CUP_RE.test(m[2])?1:null;});});
    var bandG=find(function(g){return /band|underbust/.test(g.key)&&all(g.vals,function(v){return num(v);});});
    var cupG=find(function(g){return /cup/.test(g.key);});
    var waistG=find(function(g){return (/waist/.test(g.key)||all(g.vals,function(v){return num(v,'W');})&&g.vals.some(function(v){return /^W/i.test(String(v).trim());}))&&all(g.vals,function(v){return num(v,'W');});});
    var lenG=find(function(g){return g!==waistG&&(/length|inseam|leg/.test(g.key)||g.vals.some(function(v){return /^L\s*\d/i.test(String(v).trim());}))&&all(g.vals,function(v){return num(v,'L');});});
    var letterG=find(function(g){return g.key===OPT&&all(g.vals,letter);})||find(function(g){return all(g.vals,letter);});
    var tierG=find(function(g){return g!==letterG&&all(g.vals,tier);});
    var kind=null;
    if(MODE==='off')kind=null;
    else if((MODE==='auto'||MODE==='bra')&&(bra34||(bandG&&cupG)))kind='bra';
    else if((MODE==='auto'||MODE==='bottoms')&&waistG)kind='wl';
    else if(letterG&&(MODE==='bra'||(MODE==='auto'&&BRA_WORD.test(title))))kind='braLetter';
    else if(letterG)kind='letter';
    if(!kind)return;                                   // san pham khong co size nhan ra duoc -> an link
    var BOTTOMS=MODE==='bottoms'||(MODE!=='tops'&&(!!tierG||!!lenG||/pant|jean|legging|trouser|short|skirt|jogger|capri|culotte|bottom|brief|panty|panties|underwear|thong/.test(title)));
    root.hidden=false;
    // ---- doc bang (Theme editor)
    function lines(sel){return ((root.querySelector(sel)||{}).textContent||'').split(/\n|<br\s*\/?>/i).map(function(l){return l.trim();}).filter(Boolean);}
    var BRA_MAP={};lines('[data-lu-sf-map]').forEach(function(l){var m=l.split(':');if(m.length>1)BRA_MAP[m[0].trim()]=m.slice(1).join(':').split(',').map(function(x){return x.trim();});});
    var CHART=[];lines('[data-lu-sf-letters]').forEach(function(l){var m=l.split(':');if(m.length<2)return;var v=m[1].split(',').map(function(x){return parseFloat(x);});var s=letter(m[0]);if(s)CHART.push({size:s,label:m[0].trim(),bust:v[0],waist:v[1],hip:v[2]});});
    var dlg=root.querySelector('dialog'),res=root.querySelector('[data-lu-sf-res]'),sizeEl=root.querySelector('[data-lu-sf-size]'),noteEl=root.querySelector('[data-lu-sf-note]');
    var hint=root.querySelector('[data-lu-sf-hint]'),go=root.querySelector('[data-lu-sf-go]'),tg=root.querySelector('[data-lu-sf-tg]'),tbl=root.querySelector('[data-lu-sf-tbl]');
    var chosen=null,KEY='lu_sf_v3';
    var saved={};try{saved=JSON.parse(localStorage.getItem(KEY)||'{}')||{};}catch(e){}
    function save(){try{localStorage.setItem(KEY,JSON.stringify(saved));}catch(e){}}
    function show(sel){Array.prototype.forEach.call(root.querySelectorAll('[data-lu-sf-pane]'),function(p){p.hidden=p.getAttribute('data-lu-sf-pane')!==sel;});}
    function pickVal(g,want){if(!g)return null;for(var i=0;i<g.vals.length;i++)if(norm(g.vals[i])===norm(want))return g.vals[i];return null;}
    function result(sel,label,note){chosen=sel;hint.hidden=true;res.hidden=false;sizeEl.textContent=label;noteEl.textContent=note||'';go.hidden=!sel;}
    function empty(){chosen=null;res.hidden=true;hint.hidden=false;}

    // ================= BRA: Band + Cup
    var pick={band:saved.band||null,cup:saved.cup||null},bands=[],cups=[];
    if(kind==='bra'&&bra34){bra34.vals.forEach(function(v){var m=norm(v).match(/^(\d{2})(.+)$/);if(!m)return;if(bands.indexOf(m[1])<0)bands.push(m[1]);if(cups.indexOf(m[2])<0)cups.push(m[2]);});}
    else if(kind==='bra'){bands=bandG.vals.map(function(v){return String(v).trim();});cups=cupG.vals.map(function(v){return String(v).trim();});}
    else if(kind==='braLetter'){bands=(root.getAttribute('data-bands')||'').split(',').map(function(x){return x.trim();}).filter(Boolean);cups=(root.getAttribute('data-cups')||'').split(',').map(function(x){return x.trim();}).filter(Boolean);}
    bands.sort(function(a,b){return +a-+b;});
    function braSize(b,c){var row=BRA_MAP[b];return row?row[cups.indexOf(c)]||'':'';}
    function braUpdate(){
      saved.band=pick.band;saved.cup=pick.cup;save();
      if(tbl&&!tbl.hidden)drawTable();
      if(!pick.band||!pick.cup)return empty();
      var sel={},label;
      if(kind==='bra'&&bra34){var v=null;bra34.vals.forEach(function(x){if(norm(x)===norm(pick.band+pick.cup))v=x;});if(v)sel[bra34.name]=v;label=pick.band+pick.cup;}
      else if(kind==='bra'){sel[bandG.name]=pickVal(bandG,pick.band);sel[cupG.name]=pickVal(cupG,pick.cup);label=pick.band+' / '+pick.cup;}
      else{var raw=braSize(pick.band,pick.cup),m=null;letterG.vals.forEach(function(x){if(letter(x)&&letter(x)===letter(raw))m=x;});if(m)sel[letterG.name]=m;label=m||raw||'-';}
      var ok=Object.keys(sel).length&&Object.keys(sel).every(function(k){return sel[k];});
      result(ok?sel:null,label,'Band '+pick.band+' · Cup '+pick.cup+(ok?'':' · not available for this item'));
    }
    function pills(box,arr,key){box.innerHTML='';arr.forEach(function(v){var b=document.createElement('button');b.type='button';b.className='lu-sf-pill';b.textContent=v;b.setAttribute('aria-pressed',pick[key]===v?'true':'false');
      b.addEventListener('click',function(){pick[key]=v;Array.prototype.forEach.call(box.children,function(c){c.setAttribute('aria-pressed',c===b?'true':'false');});braUpdate();});box.appendChild(b);});}

    // ================= SO DO CO THE (size chu / W-L)
    var unit=saved.unit==='cm'?'cm':'in';
    var need=kind==='wl'?(lenG?['waist','height','inseam']:['waist']):(BOTTOMS?['waist','hip']:['bust','waist','hip']);
    if(kind==='letter'&&tierG)need.push('height');
    // so do co the: chon tu danh sach (gia tri luon la inch, nut inch/cm chi doi nhan)
    var RANGE={bust:[28,60],waist:[22,52],hip:[30,62],height:[56,77],inseam:[24,38]};
    function lbl(k,i){if(k==='height')return unit==='cm'?Math.round(i*2.54)+' cm':Math.floor(i/12)+"' "+(i%12)+'"';return unit==='cm'?Math.round(i*2.54)+' cm':i+'"';}
    function fillAll(){Object.keys(RANGE).forEach(function(k){var el=root.querySelector('[data-lu-sf-in="'+k+'"]');if(!el)return;var cur=el.value;
      el.innerHTML='<option value="">'+(k==='inseam'?'Not sure':'Select')+'</option>';for(var i=RANGE[k][0];i<=RANGE[k][1];i++){var o=document.createElement('option');o.value=i;o.textContent=lbl(k,i);el.appendChild(o);}el.value=cur;});}
    function inches(k){var el=root.querySelector('[data-lu-sf-in="'+k+'"]');if(!el||!el.value)return null;var v=parseFloat(el.value);return v>0?v:null;}
    function letterFor(m){       // size nho nhat ma MOI so do deu <= muc toi da cua size (giua 2 size -> size lon hon)
      var best=-1;['bust','waist','hip'].forEach(function(k){if(m[k]==null)return;var idx=CHART.length-1;
        for(var i=0;i<CHART.length;i++)if(CHART[i][k]>0&&m[k]<=CHART[i][k]+0.01){idx=i;break;}best=Math.max(best,idx);});
      return best<0?null:CHART[best];}
    function nearest(g,want,pre,up){var b=null,bd=1e9;g.vals.forEach(function(v){var n=num(v,pre);if(n==null)return;var d=up?(n>=want-0.25?n-want:1e6+want-n):Math.abs(n-want);if(d<bd){bd=d;b=v;}});return b;}
    function bodyUpdate(){
      need.forEach(function(k){var el=root.querySelector('[data-lu-sf-in="'+k+'"]');saved[k]=el?el.value:'';});saved.unit=unit;save();
      var m={};need.forEach(function(k){m[k]=inches(k);});
      var sel={},label=[],note=[];
      if(kind==='wl'){
        if(m.waist==null||(lenG&&m.height==null&&m.inseam==null))return empty();
        var w=nearest(waistG,m.waist,'W',true);if(w){sel[waistG.name]=w;label.push(w);}
        if(lenG){var ins=m.inseam!=null?m.inseam:m.height*0.45;var l=nearest(lenG,ins,'L',false);if(l){sel[lenG.name]=l;label.push(l);}note.push((m.inseam!=null?'Inseam ':'Inseam ~')+(unit==='cm'?Math.round(ins*2.54)+' cm':(Math.round(ins*10)/10)+'"')+(m.inseam!=null?'':' (from your height)'));}
        note.unshift('Waist '+(unit==='cm'?Math.round(m.waist*2.54)+' cm':m.waist+'"'));
      }else{
        if(need.some(function(k){return k!=='height'&&m[k]==null;}))return empty();
        var row=letterFor(m),v=null;
        if(row)letterG.vals.forEach(function(x){if(letter(x)===row.size)v=x;});
        if(v){sel[letterG.name]=v;label.push(v);}else label.push(row?row.label:'-');
        if(tierG){if(m.height==null)return empty();var t=m.height<61?0:m.height<64?1:m.height<68?2:m.height<72?3:4,tv=null,td=9;
          tierG.vals.forEach(function(x){var d=Math.abs(tier(x)-t);if(tier(x)!=null&&d<td){td=d;tv=x;}});if(tv){sel[tierG.name]=tv;label.push(tv);}}
        if(!v)note.push('not available for this item');
      }
      var ok=label.length&&Object.keys(sel).length===label.length;
      result(ok?sel:null,label.join(' / '),note.join(' · ')||'US standard size chart');
    }
    function setUnit(u){
      if(u===unit)return;
      unit=u;Array.prototype.forEach.call(root.querySelectorAll('[data-lu-sf-unit]'),function(b){b.setAttribute('aria-pressed',b.getAttribute('data-lu-sf-unit')===u?'true':'false');});
      fillAll();bodyUpdate();
    }

    function drawTable(){
      var h='';
      if(kind==='braLetter'){h='<table><thead><tr><th>Band</th>'+cups.map(function(c){return '<th>'+c+'</th>';}).join('')+'</tr></thead><tbody>';
        bands.forEach(function(b){h+='<tr><th>'+b+'</th>'+cups.map(function(c){var on=b===pick.band&&c===pick.cup;return '<td'+(on?' class="on"':'')+'>'+(braSize(b,c)||'-')+'</td>';}).join('')+'</tr>';});}
      else if(kind==='letter'){var f=function(x){return x>0?(unit==='cm'?Math.round(x*2.54):x):'-';};
        h='<table><thead><tr><th>Size</th><th>Bust</th><th>Waist</th><th>Hips</th></tr></thead><tbody>';
        CHART.forEach(function(r){var on=chosen&&letter(chosen[letterG.name])===r.size;h+='<tr><th>'+r.label+'</th><td'+(on?' class="on"':'')+'>'+f(r.bust)+'</td><td'+(on?' class="on"':'')+'>'+f(r.waist)+'</td><td'+(on?' class="on"':'')+'>'+f(r.hip)+'</td></tr>';});
        h+='<tr><td colspan="4">Maximum measurement for each size ('+(unit==='cm'?'cm':'inches')+').</td></tr>';}
      tbl.innerHTML=h+'</tbody></table>';
    }

    if(kind==='bra'||kind==='braLetter'){show('bra');pills(root.querySelector('[data-lu-sf-band]'),bands,'band');pills(root.querySelector('[data-lu-sf-cup]'),cups,'cup');}
    else{show('body');fillAll();
      need.forEach(function(k){var f=root.querySelector('[data-lu-sf-field="'+k+'"]');if(f)f.hidden=false;var el=root.querySelector('[data-lu-sf-in="'+k+'"]');if(el){if(saved[k])el.value=saved[k];el.addEventListener('input',bodyUpdate);el.addEventListener('change',bodyUpdate);}});
      Array.prototype.forEach.call(root.querySelectorAll('[data-lu-sf-unit]'),function(b){b.setAttribute('aria-pressed',b.getAttribute('data-lu-sf-unit')===unit?'true':'false');});
      Array.prototype.forEach.call(root.querySelectorAll('[data-lu-sf-unit]'),function(b){b.addEventListener('click',function(){setUnit(b.getAttribute('data-lu-sf-unit'));});});}
    if(kind==='bra'||kind==='wl')tg.hidden=true;       // gia tri cua san pham la so do that -> khong can bang
    tg.addEventListener('click',function(){var o=tbl.hidden;tbl.hidden=!o;tg.setAttribute('aria-expanded',String(o));tg.textContent=o?'Hide size chart':'View full size chart';if(o)drawTable();});
    function update(){if(kind==='bra'||kind==='braLetter')braUpdate();else bodyUpdate();}

    // ---- dien vao bo chon chinh + moi dong Kaching
    function setSel(s,v){if(s.value!==v){s.value=v;s.dispatchEvent(new Event('change',{bubbles:true}));}}
    function apply(sel){Object.keys(sel).forEach(function(name){var key=name.trim().toLowerCase(),v=sel[name];
      Array.prototype.forEach.call(scope.querySelectorAll('.ms-variant-group'),function(g){
        if(String(g.getAttribute('data-option-name')).trim().toLowerCase()!==key)return;
        var s=g.querySelector('select');if(s){setSel(s,v);return;}
        Array.prototype.forEach.call(g.querySelectorAll('input[type=radio]'),function(i){if(i.value===v&&!i.checked){i.checked=true;i.dispatchEvent(new Event('change',{bubbles:true}));}});
      });
      Array.prototype.forEach.call(scope.querySelectorAll('[data-lu-unit] select[data-name]'),function(s){if(String(s.getAttribute('data-name')).trim().toLowerCase()===key)setSel(s,v);});
    });}
    var applied=null;
    go.addEventListener('click',function(){if(!chosen)return;applied=chosen;apply(chosen);root.setAttribute('data-lu-sf-size',Object.keys(chosen).map(function(k){return chosen[k];}).join(' / '));dlg.close();});
    // doi goi Kaching -> dong moi cung nhan size da chon
    if(window.MutationObserver)new MutationObserver(function(ms){if(!applied)return;
      for(var i=0;i<ms.length;i++)for(var j=0;j<ms[i].addedNodes.length;j++){var nd=ms[i].addedNodes[j];if(nd.nodeType===1&&(nd.matches('[data-lu-unit]')||nd.querySelector('[data-lu-unit]'))){setTimeout(function(){apply(applied);},0);return;}}
    }).observe(scope===document?document.body:scope,{childList:true,subtree:true});
    root.querySelector('[data-lu-sf-open]').addEventListener('click',function(){update();dlg.showModal?dlg.showModal():dlg.setAttribute('open','');});
    root.querySelector('[data-lu-sf-close]').addEventListener('click',function(){dlg.close();});
    dlg.addEventListener('click',function(e){if(e.target===dlg)dlg.close();});
  });
})();
</script>
</div>
