{{!-- Find my size: theme tu nhan dang kieu size tu option cua san pham (Adlux chi gui ten option + gia tri) -
      bra (34B / Band+Cup / size chu + ten "bra"), quan W-L (W29/L28), size chu XS-5XL (+ Inseam Petite/Regular/Tall).
      Ket qua dien vao bo chon chinh + moi dong Kaching. Bang quy doi (chuan US) sua trong Product section > Size finder. --}}
<div class="lu-sf" data-lu-sf data-popup="{{#if section.settings.sf_chart_image}}{{#if (eq section.settings.sf_popup "image")}}image{{/if}}{{/if}}" data-mode="{{#if section.settings.sf_mode}}{{section.settings.sf_mode}}{{else}}auto{{/if}}" data-option="{{#if section.settings.sf_option_name}}{{section.settings.sf_option_name}}{{else}}Size{{/if}}" data-bands="{{#if section.settings.sf_bands}}{{section.settings.sf_bands}}{{else}}30, 32, 34, 36, 38, 40, 42, 44, 46, 48{{/if}}" data-cups="{{#if section.settings.sf_cups}}{{section.settings.sf_cups}}{{else}}A, B, C, D, DD/E, DDD/F, G, H/I{{/if}}" hidden><script type="application/json" data-lu-sf-opts>{{{json product.variants}}}</script>
<style>
.lu-sf{margin:1.2rem 0 .4rem}
.lu-sf-open{display:inline-flex;align-items:center;gap:6px;padding:0;border:0;background:none;color:rgb(var(--color-foreground));font:inherit;font-size:1.4rem;font-weight:600;cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.lu-sf-open svg{width:18px;height:18px;flex:0 0 auto;color:var(--lu-primary,#000000)}
.lu-sf-open:hover{color:var(--lu-primary,#000000)}
.lu-sf-dlg{border:0;padding:0;margin:auto;width:min(560px,calc(100vw - 32px));max-height:calc(100vh - 32px);border-radius:12px;background:#fff;color:#000000;box-shadow:0 20px 60px rgba(0,0,0,.25);overflow:hidden}
.lu-sf-dlg::backdrop{background:rgba(0,0,0,.5)}
.lu-sf-dlg[open]{display:flex;flex-direction:column;animation:luSfIn .18s ease-out}
@keyframes luSfIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.lu-sf-hd{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 20px 12px}
.lu-sf-hd h2{margin:0;font-size:2rem;line-height:1.2;font-weight:700;color:#000000;letter-spacing:0}
.lu-sf-x{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border:0;border-radius:50%;background:#f2f2f2;color:#000000;cursor:pointer;flex:0 0 auto;padding:0}
.lu-sf-x:hover{background:#e6e6e6}
.lu-sf-bd{padding:4px 20px 20px;overflow:auto}
.lu-sf-q{margin:14px 0 10px;font-size:1.6rem;font-weight:700;color:#000000;letter-spacing:0}
.lu-sf-pills{display:flex;flex-wrap:wrap;gap:8px}
.lu-sf-pill{min-width:52px;height:46px;padding:0 14px;border:1px solid #b9b9b9;border-radius:10px;background:#fff;color:#000000;font:inherit;font-size:1.5rem;cursor:pointer;transition:border-color .15s,background .15s,color .15s;letter-spacing:0}
.lu-sf-pill:hover{border-color:#000000}
