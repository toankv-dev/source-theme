<div class="lu-sf-bd">{{#if section.settings.sf_chart_image}}{{#unless (eq section.settings.sf_popup "finder")}}<img class="lu-sf-chart" src="{{section.settings.sf_chart_image}}" alt="Size chart" loading="lazy">{{/unless}}{{/if}}
<div data-lu-sf-pane="bra" hidden>
<p class="lu-sf-q">{{#if section.settings.sf_band_label}}{{section.settings.sf_band_label}}{{else}}What is your closest Band Size?{{/if}}</p><div class="lu-sf-pills" data-lu-sf-band role="group" aria-label="Band size"></div>
<p class="lu-sf-q">{{#if section.settings.sf_cup_label}}{{section.settings.sf_cup_label}}{{else}}What is your closest Cup Size?{{/if}}</p><div class="lu-sf-pills" data-lu-sf-cup role="group" aria-label="Cup size"></div>
</div>
<div data-lu-sf-pane="body" hidden>
<p class="lu-sf-q">Your measurements</p>
<div class="lu-sf-units" role="group" aria-label="Units"><button type="button" data-lu-sf-unit="in" aria-pressed="true">inch</button><button type="button" data-lu-sf-unit="cm" aria-pressed="false">cm</button></div>
<div class="lu-sf-f"><label data-lu-sf-field="bust" hidden><span class="lu-sf-l">Bust</span><select data-lu-sf-in="bust"></select><small>Fullest part of the chest</small></label><label data-lu-sf-field="waist" hidden><span class="lu-sf-l">Waist</span><select data-lu-sf-in="waist"></select><small>Narrowest part, above the belly button</small></label><label data-lu-sf-field="hip" hidden><span class="lu-sf-l">Hips</span><select data-lu-sf-in="hip"></select><small>Fullest part of the hips</small></label><label data-lu-sf-field="height" hidden><span class="lu-sf-l">Height</span><select data-lu-sf-in="height"></select><small>Without shoes</small></label><label data-lu-sf-field="inseam" hidden><span class="lu-sf-l">Inseam</span><select data-lu-sf-in="inseam"></select><small>Optional - crotch to ankle</small></label></div>
<p class="lu-sf-how">Measure over light clothing with a soft tape. Between two sizes? Choose the larger one.</p>
</div>
<div class="lu-sf-res" data-lu-sf-res aria-live="polite" hidden><p>Your recommended size<strong data-lu-sf-size></strong><small data-lu-sf-note></small></p><button type="button" class="lu-sf-go" data-lu-sf-go>Select this size</button></div>
<p class="lu-sf-hint" data-lu-sf-hint>Answer the questions above - we will match you instantly.</p>
<button type="button" class="lu-sf-tg" data-lu-sf-tg aria-expanded="false">View full size chart</button>
