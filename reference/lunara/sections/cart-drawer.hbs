</style><cart-drawer class="drawer is-empty cart-drawer--desktop-width-normal cart-drawer--mobile-width-full" data-type="modal" data-tiers="{{#if @root.settings.allow_tiered_discount}}{{nextItemTiers}}{{/if}}" data-bxgy="{{#if @root.settings.allow_bxgy_discount}}{{bxgyOffers}}{{/if}}" data-amountoff="{{#unless (eq @root.settings.allow_amount_off_discount false)}}{{amountOffOffers}}{{/unless}}"><div id="CartDrawer" class="cart-drawer"><div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div><div class="drawer__inner" role="dialog" aria-modal="true" aria-label="Your cart" tabindex="-1"><div class="drawer__inner-empty"><div class="cart-drawer__warnings center"><div class="cart-drawer__empty-content"><h2 class="cart__empty-text" {{{editableSetting "cart_empty_text"}}}>{{#if settings.cart_empty_text}}{{settings.cart_empty_text}}{{else}}Your cart is empty{{/if}}</h2><a href="{{@root.config.homeUrl}}#collection/all" class="button" data-ms-cart-close> {{#if settings.empty_cart_button_label}}{{settings.empty_cart_button_label}}{{else}}Continue shopping{{/if}} </a><button class="drawer__close" type="button" aria-label="Close"><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-close" fill="none" viewBox="0 0 18 17"><path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor"></path></svg></button></div></div></div><div class="drawer__header" style="--alignment:flex-start"><h2 class="drawer__heading" {{{editableSetting "cart_title"}}}>{{#if settings.cart_title}}{{settings.cart_title}}{{else}}Your cart{{/if}}</h2><button class="drawer__close" type="button" aria-label="Close"><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-close" fill="none" viewBox="0 0 18 17"><path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor"></path></svg></button></div>{{#if settings.cart_notice}}<p class="gs-cart-notice" {{{editableSetting "cart_notice"}}}>{{settings.cart_notice}}</p>{{/if}}<div class="cart-drawer__body"><cart-drawer-items class=" is-empty" style="--image-size: 20%;--title-size:1.5rem;--margin-top: 2.1rem;--margin-bottom: 2.1rem;"><form action="#" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post"><div id="CartDrawer-CartItems" class="drawer__contents js-contents"><div class="drawer__cart-items-wrapper"><ul class="cart-items list-unstyled" data-ms-cart-items></ul></div><p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p><p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">Loading...</p></div><div id="CartDrawer-CartErrors" role="alert"></div></form></cart-drawer-items>{{#if settings.cart_body_upsells.length}}<style>#CartDrawer .lu-bups{--lu-bup-bg:{{#if settings.cart_body_upsell_card_bg}}{{settings.cart_body_upsell_card_bg}}{{else}}#ffffff{{/if}};--lu-bup-btn:{{#if settings.cart_body_upsell_btn_bg}}{{settings.cart_body_upsell_btn_bg}}{{else}}var(--lu-primary, #124F9F){{/if}};--lu-bup-btn-text:{{#if settings.cart_body_upsell_btn_color}}{{settings.cart_body_upsell_btn_color}}{{else}}#ffffff{{/if}};--lu-bup-badge:{{#if settings.cart_body_upsell_badge_color}}{{settings.cart_body_upsell_badge_color}}{{else}}#121212{{/if}};--lu-bup-title:{{#if settings.cart_body_upsell_title_size}}{{settings.cart_body_upsell_title_size}}{{else}}15{{/if}}px;}</style><div class="lu-bups" data-lu-bups data-mode="{{#if (eq settings.cart_body_upsell_move false)}}stay{{else}}move{{/if}}" data-delay="{{settings.cart_body_upsell_delay}}" hidden>{{#if settings.cart_body_upsell_heading}}<p class="lu-bups__h" {{{editableSetting "cart_body_upsell_heading"}}