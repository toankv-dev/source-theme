<div id="shopify-section-cart-drawer" class="shopify-section"><style>#CartDrawer .drawer__header{background:{{settings.cart_header_bg}};box-shadow:-16px 0 0 {{settings.cart_header_bg}},16px 0 0 {{settings.cart_header_bg}};}#CartDrawer .drawer__heading{color:{{settings.cart_header_color}};}#CartDrawer .drawer__header .drawer__close{color:{{settings.cart_header_color}} !important;}#CartDrawer .drawer__inner{background:{{settings.cart_body_bg}};}#CartDrawer .drawer__footer{background:{{settings.cart_footer_bg}};box-shadow:-16px 0 0 {{settings.cart_footer_bg}},16px 0 0 {{settings.cart_footer_bg}};}#CartDrawer #CartDrawer-Checkout{background:{{#if settings.cart_checkout_bg}}{{settings.cart_checkout_bg}}{{else}}var(--lu-primary, #124F9F){{/if}};color:{{settings.cart_checkout_color}};}#CartDrawer .gs-cart-notice{margin:0 -16px;padding:8px 16px;font-size:13px;line-height:1.4;text-align:center;background:{{settings.cart_notice_bg}};color:{{settings.cart_notice_color}};}#CartDrawer .gs-cart-note{margin:8px 0 0;font-size:12px;line-height:1.4;text-align:center;opacity:.75}</style><style>
