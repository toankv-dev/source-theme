<section class="shopify-section section lu-reviews-section"><div id="lu-reviews" class="lu-reviews"><lu-reviews style="--lu-rv-star:{{#if section.settings.star_color}}{{section.settings.star_color}}{{else}}#03AA6D{{/if}};--lu-rv-btn:{{#if section.settings.button_bg}}{{section.settings.button_bg}}{{else}}var(--lu-primary, #124F9F){{/if}};--lu-rv-btn-text:{{#if section.settings.button_color}}{{section.settings.button_color}}{{else}}#ffffff{{/if}};"{{#if is_home}} data-home="true"{{/if}} data-total="{{#if is_home}}0{{else}}{{product.reviews.summary.total_count}}{{/if}}"><template shadowrootmode="open"><style>
          @font-face{font-family:inherit;font-style:normal;font-weight:400;font-display:swap;src:url('{{assets_url}}/fonts/crimson-text-latin-ext.woff2') format('woff2');unicode-range:U+0100-024F,U+1E00-1EFF,U+20A0-20AB,U+2C60-2C7F,U+A720-A7FF}
          @font-face{font-family:inherit;font-style:normal;font-weight:400;font-display:swap;src:url('{{assets_url}}/fonts/crimson-text-latin.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+20AC,U+2122}
          @font-face{font-family:inherit;font-style:normal;font-weight:200 900;font-display:swap;src:url('{{assets_url}}/fonts/crimson-pro-latin-ext.woff2') format('woff2');unicode-range:U+0100-024F,U+1E00-1EFF,U+20A0-20AB,U+2C60-2C7F,U+A720-A7FF}
          @font-face{font-family:inherit;font-style:normal;font-weight:200 900;font-display:swap;src:url('{{assets_url}}/fonts/crimson-pro-latin.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+20AC,U+2122}
          :host{--cream:#fbfaf6;--ink:#29241c;--muted:#6f685c;--line:#ded9ce;--gold:var(--lu-rv-star,#03AA6D);display:block;contain:content;color:var(--ink);font-family:inherit;font-size:16px}
          *{box-sizing:border-box}
          button,select,a,input{font:inherit}
          button,a,select{cursor:pointer}
          button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--lu-rv-btn);outline-offset:3px}
          .wrap{background:var(--cream);margin:0 auto;max-width:1440px;padding:56px 30px}
          .eyebrow{color:var(--lu-rv-btn);font-size:11px;font-weight:800;letter-spacing:.18em;margin:0 0 12px;text-transform:uppercase}
          h2,h3{color:var(--ink)}
          h2{font-family:inherit;font-size:clamp(36px,4.4vw,64px);font-weight:600;letter-spacing:-.035em;line-height:1.02;margin:0;max-width:980px}
          :host([data-home]) h2{margin-bottom:28px}
          :host([data-home]) .summary{display:none!important}
          .summary{border:1px solid var(--line);border-radius:14px;display:grid;grid-template-columns:34% 66%;margin-top:26px;min-height:132px;overflow:hidden}
          .score{align-items:center;border-right:1px solid var(--line);display:flex;justify-content:center;min-width:0;padding:20px}
          .score>strong{font-family:inherit;font-size:48px;font-weight:600;letter-spacing:-.04em;line-height:1}
          .scoreDetail{margin-left:14px}.stars{color:var(--gold);font-size:16px;letter-spacing:2px;white-space:nowrap}.scoreDetail small{color:var(--muted);display:block;font-size:11px;margin-top:5px}
          .bars{align-content:center;display:grid;gap:6px;padding:18px 26px}.bar{align-items:center;color:#625c51;display:grid;font-size:10px;gap:8px;grid-template-columns:12px 12px 1fr 30px}.bar>i{color:var(--gold);font-style:normal}.track{background:#e5e2db;border-radius:99px;height:6px;overflow:hidden}.track>i{background:var(--gold);border-radius:inherit;display:block;height:100%;min-width:0}.bar>em{font-style:normal;text-align:right}
          .tools{align-items:center;display:flex;gap:16px;justify-content:flex-end;margin:18px 0 14px}.write,.more{align-items:center;border-radius:9px;display:inline-flex;font-size:13px;font-weight:700;justify-content:center;min-height:44px;padding:0 20px}.write{background:var(--lu-rv-btn);border:1px solid var(--lu-rv-btn);color:var(--lu-rv-btn-text);min-width:154px}
          .reviews{align-items:start;display:grid;gap:14px;grid-template-columns:repeat(4,minmax(0,1fr))}.reviewColumn{display:flex;flex-direction:column;min-width:0}.review{background:var(--cream);border:1px solid var(--line);border-radius:13px;cursor:pointer;display:block;margin:0 0 14px;overflow:hidden;transition:box-shadow .18s ease,transform .18s ease;width:100%}.review:hover{box-shadow:0 11px 28px rgb(46 36 16/.1);transform:translateY(-2px)}.review:focus-visible{outline:3px solid var(--lu-rv-btn);outline-offset:3px}.media{background:#eee9de;border:0;display:block;overflow:hidden;padding:0;position:relative;width:100%}.mediaOpenIcon{background:rgb(20 20 18/.72);border:1px solid rgb(255 255 255/.72);border-radius:99px;bottom:10px;box-sizing:border-box;fill:none;height:34px;padding:8px;pointer-events:none;position:absolute;right:10px;stroke:#fff;stroke-linecap:round;stroke-linejoin:round;stroke-width:2;width:34px}.media img,.media video{aspect-ratio:1/.9;display:block;height:auto;object-fit:cover;width:100%}.media video{min-height:200px}.content{padding:15px}.reviewTop{align-items:center;display:flex;gap:10px;justify-content:space-between}.reviewTop .stars{font-size:14px}.reviewTop time{color:#777066;font-size:10px}.review h3{font-size:19px;font-weight:700;line-height:1.05;margin:11px 0 7px}.review p{color:#625b50;font-size:16px;line-height:1.48;margin:0}.review footer{align-items:center;display:flex;gap:8px;justify-content:space-between;margin-top:14px}.review footer strong{font-size:11px}.verified{color:var(--lu-rv-btn);font-size:10px;font-weight:700}.reply{border-left:2px solid var(--lu-rv-btn);color:#5f584c;font-size:13px;margin-top:14px;padding:2px 0 2px 12px}.reply strong{display:block;font-size:10px;margin-bottom:4px}.moreRow{display:flex;justify-content:center;margin-top:24px}.more{background:transparent;border:1px solid var(--ink);color:var(--ink);min-width:210px}.more[disabled]{cursor:wait;opacity:.58}.skeleton{animation:pulse 1.4s ease-in-out infinite;background:#e8e4dc;border-radius:8px}.sk-title{height:52px;max-width:760px}.sk-panel{height:132px;margin-top:26px;width:100%}.sk-grid{display:grid;gap:14px;grid-template-columns:repeat(4,1fr);margin-top:22px}.sk-card{height:300px}.error{background:#f8f1de;border:1px solid #e2d1a5;border-radius:10px;color:#665d4c;padding:20px}
          dialog{border:0;margin:auto;padding:0}.reviewDialog{background:transparent;max-width:none;overflow:visible;width:min(94vw,1000px);outline:none}.reviewDialog::backdrop,.composerDialog::backdrop{background:rgb(14 16 14/.78);backdrop-filter:blur(7px)}.viewerShell{background:var(--cream);border-radius:16px;box-shadow:0 30px 90px rgb(0 0 0/.38);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);max-height:calc(100vh - 48px);overflow:hidden;position:relative;touch-action:pan-y}.viewerShell.noMedia{grid-template-columns:minmax(0,620px);margin:auto;max-width:620px}.viewerMedia{background:#1e1a14;min-height:min(72vh,650px);position:relative}.viewerMedia img,.viewerMedia video{display:block;height:100%;max-height:calc(100vh - 48px);object-fit:cover;width:100%}.viewerCopy{align-self:center;max-height:calc(100vh - 48px);overflow-y:auto;padding:48px 36px 28px;position:relative}.viewerTop{align-items:center;display:flex;gap:12px;justify-content:space-between;padding-right:52px}.viewerTop .stars{font-size:15px}.viewerCount,.viewerDesktopHint,.viewerMobileHint{color:var(--muted);font-size:11px}.viewerMobileHint{display:none}.viewerCopy h3{font-family:inherit;font-size:26px;line-height:1.15;margin:16px 0 12px;word-break:break-word;overflow-wrap:break-word}.viewerBody{color:#625b50;font-size:16px;line-height:1.55;margin:0;word-break:break-word;overflow-wrap:break-word}.viewerAuthor{align-items:flex-start;display:flex;flex-direction:column;gap:5px;margin-top:20px}.viewerAuthor strong{font-size:13px}.viewerAuthor time{color:var(--muted);font-size:11px}.viewerNav{align-items:center;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr auto 1fr;margin-top:24px;padding-top:16px}.viewerNav button{align-items:center;background:transparent;border:0;color:var(--ink);display:flex;font-size:12px;font-weight:700;gap:6px;min-height:44px;padding:0;cursor:pointer}.viewerNav button:last-child{justify-self:end}.viewerNav button:disabled{cursor:default;opacity:.35}.viewerClose{align-items:center;background:#fff;border:1px solid var(--line);border-radius:99px;color:#111;display:flex;font-size:26px;font-weight:300;height:42px;width:42px;justify-content:center;position:absolute;right:13px;top:13px;z-index:20;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,0.18);line-height:1;padding:0;transition:transform .15s ease,background .15s ease}.viewerClose:hover{background:#f5f2eb;transform:scale(1.06)}.dialogClose{align-items:center;background:#fff;border:0;border-radius:99px;color:#111;display:flex;font-size:22px;height:44px;justify-content:center;width:44px}.composerDialog{background:#fff;border-radius:16px;box-shadow:0 24px 80px rgb(0 0 0/.4);height:min(90dvh,850px);max-width:760px;overflow:hidden;width:min(94vw,760px)}.composerDialog[open]{display:grid;grid-template-rows:56px minmax(0,1fr)}.composerDialog>.dialogClose{align-self:center;grid-row:1;justify-self:end;margin-right:8px;position:static}.composerDialog iframe{background:#fff;border:0;display:block;grid-row:2;height:100%;min-height:0;pointer-events:auto;position:relative;touch-action:pan-y;width:100%;z-index:1}
          .reviewDialog{width:min(94vw,760px)}.viewerShell{display:block;margin:auto;max-width:760px;overflow-y:auto;-webkit-overflow-scrolling:touch}.viewerShell.noMedia{max-width:620px}.viewerMedia{aspect-ratio:16/10;min-height:0}.viewerMedia img,.viewerMedia video{height:100%;max-height:none}.viewerCopy{max-height:none;overflow:visible;padding:36px 32px 24px}
          [data-image-ratio="actual"] .media img,[data-image-ratio="actual"] .media video{aspect-ratio:auto;height:auto;object-fit:cover}[data-image-ratio="actual"] .viewerMedia{aspect-ratio:auto}[data-image-ratio="actual"] .viewerMedia img,[data-image-ratio="actual"] .viewerMedia video{height:auto;max-height:75vh;object-fit:contain;width:100%}
          [data-show-date="false"] time{display:none}
          @keyframes pulse{50%{opacity:.52}}
          @media(max-width:900px){.reviews{gap:12px;grid-template-columns:repeat(3,minmax(0,1fr))}.sk-grid{grid-template-columns:repeat(3,1fr)}}
          @media(max-width:700px){
            .wrap{padding:28px 12px}
            h2{font-size:clamp(26px,6vw,36px);line-height:1.15;word-break:break-word}
            :host([data-home]) h2{margin-bottom:18px}
            .summary{border-radius:12px;margin-top:18px;grid-template-columns:1fr;min-height:auto}
            .score{border-right:0;border-bottom:1px solid var(--line);flex-direction:row;align-items:center;justify-content:center;gap:16px;padding:16px 14px;text-align:left}
            .score>strong{font-size:42px;line-height:1}
            .scoreDetail{margin-left:0}
            .scoreDetail .stars{font-size:15px;letter-spacing:1px}
            .scoreDetail small{font-size:12px;margin-top:3px}
            .bars{gap:6px;padding:14px 16px}
            .bar{font-size:11px;gap:8px;grid-template-columns:12px 14px 1fr 32px}
            .track{height:6px}
            .tools{justify-content:center;margin:16px 0 16px}
            .write{min-height:44px;width:100%;max-width:320px;padding:0 20px;font-size:14px}
            .reviews{gap:10px;grid-template-columns:repeat(2,minmax(0,1fr))}
            .review{border-radius:10px;margin-bottom:0;word-break:break-word;overflow-wrap:break-word}
            .review:hover{box-shadow:none;transform:none}
            .content{padding:12px}
            .reviewTop{align-items:flex-start;gap:4px;flex-direction:column}
            .reviewTop .stars{font-size:13px}
            .reviewTop time{font-size:10px}
            .review h3{font-size:16px;line-height:1.2;margin:8px 0 6px;word-break:break-word;overflow-wrap:break-word}
            .review p{font-size:14px;line-height:1.45;word-break:break-word;overflow-wrap:break-word}
            .review footer{align-items:flex-start;flex-direction:column;margin-top:10px}
            .sk-grid{gap:8px;grid-template-columns:repeat(2,1fr)}
            .sk-card{height:240px}
            .eyebrow{font-size:10px}
            .reviewDialog{width:calc(100vw - 20px);max-width:calc(100vw - 20px);margin:auto}
            .viewerShell{display:block;max-height:calc(100dvh - 24px);overflow-y:auto;-webkit-overflow-scrolling:touch;border-radius:14px}
            .viewerMedia{aspect-ratio:1/.88;min-height:0}
            .viewerMedia img,.viewerMedia video{height:100%;max-height:none}
            .viewerCopy{max-height:none;overflow:visible;padding:26px 18px 20px}
            .viewerTop{padding-right:48px}
            .viewerCopy h3{font-size:22px;margin:12px 0 10px;word-break:break-word;overflow-wrap:break-word}
            .viewerBody{font-size:15px;line-height:1.55;word-break:break-word;overflow-wrap:break-word}
            .viewerClose{right:10px;top:10px;height:38px;width:38px;font-size:24px}
            .viewerDesktopHint{display:none}
            .viewerMobileHint{display:inline}
            .composerDialog{border-radius:12px;height:calc(100dvh - 16px);max-height:calc(100dvh - 16px);width:calc(100vw - 16px)}
          }
          @media(max-width:480px){
            .wrap{padding:24px 8px}
            .reviews{gap:10px;grid-template-columns:1fr}
            .score{padding:14px 10px;gap:12px}
            .score>strong{font-size:38px}
            .bars{padding:12px 10px}
          }
          @media(max-width:349px){.composerDialog{height:calc(100dvh - 8px);max-width:calc(100vw - 8px);width:calc(100vw - 8px)}.composerDialog[open]{inset-block:0;inset-inline:auto;left:calc(50% + (100vw - 100%)/2);margin:auto 0;transform:translateX(-50%)}}
          @media(prefers-reduced-motion:reduce){.skeleton{animation:none}}
        
:where(.composerPage, .composerPage *){box-sizing:border-box}:where(.composerPage) :where(button, input, textarea){font:inherit;color:inherit;letter-spacing:normal}:where(.composerPage button){cursor:pointer}:where(.composerPage) :where(h1, p){margin:0}.composerPage{letter-spacing:normal;text-transform:none}.composerDialog .composerPage.composerEmbedded{grid-row:2;min-height:0;height:100%}.composerPage [hidden]{display:none!important}.dialogClose:focus:not(:focus-visible),.composerPage:focus{outline:none}
.storefrontPage, .composerPage{    --store-ink: #2d2c29; --store-muted: #79756e; --store-line: #e8e2d8; --store-cream: #faf7f1; --store-gold: var(--lu-rv-star,#124F9F); color: var(--store-ink); font-family:inherit; background: rgb(255, 255, 255); min-height: 100vh; }
.storefrontPage :is(h1, h2), .composerPage h1{ font-family:inherit; }
.storefrontHeader, .composerHeader{ border-bottom: 1px solid var(--store-line); background: rgb(255, 255, 255); grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 72px; padding: 0px 4.5vw; display: grid; }
.storefrontEyebrow{ color: var(--lu-rv-btn); letter-spacing: 0.2em; text-transform: uppercase; margin: 0px 0px 12px; font-size: 9px; font-weight: 800; }
.storefrontIntro h1, .composerCard h1{ color: rgb(45, 43, 40); font-family:inherit; letter-spacing: -0.035em; margin: 0px; font-size: clamp(35px, 4.2vw, 53px); font-weight: 400; line-height: 1.05; }
.composerPage{ background: radial-gradient(circle at 12% 15%, #e7d8b047, transparent 27%), radial-gradient(circle at 88% 84%, #c6dbcd52, transparent 25%), var(--store-cream); font-size: 16px; }
.composerPage.composerEmbedded{ overscroll-behavior: contain; touch-action: pan-y; background: rgb(255, 255, 255); height: 100dvh; min-height: 0px; overflow: hidden auto; }
.composerEmbedded .composerMain{ min-height: 100%; padding: 24px 20px 34px; }
.composerEmbedded .composerCard{ box-shadow: none; border: 0px; padding-top: 28px; }
.composerHeader{ background: rgba(255, 255, 255, 0.75); grid-template-columns: 1fr auto; min-height: 66px; }
.composerHeader .storefrontLogo{ font-size: 18px; }
.composerClose{ border: 1px solid var(--store-line); border-radius: 50%; justify-content: center; justify-self: end; align-items: center; width: 44px; height: 44px; display: flex; }
.composerMain{ max-width: 720px; min-height: calc(-116px + 100vh); margin: 0px auto; padding: 34px 20px 68px; }
.composerProduct{ justify-content: center; align-items: center; gap: 11px; margin-bottom: 20px; display: flex; }
.composerProductImage{ color: var(--lu-rv-btn); background: color-mix(in srgb, var(--lu-rv-btn) 12%, #fff); border: 2px solid rgb(255, 255, 255); border-radius: 9px; justify-content: center; align-items: center; width: 44px; height: 44px; display: flex; }
.composerProductImage img{ object-fit: cover; border-radius: 7px; width: 100%; height: 100%; }
.composerProduct span, .composerProduct strong{ display: block; }
.composerProduct > div:last-child > span{ color: rgb(143, 136, 125); margin-bottom: 3px; font-size: 12px; }
.composerProduct strong{ font-family:inherit; font-size: 15px; font-weight: 600; }
.composerProgress{ grid-template-columns: 1fr 1fr; gap: 5px; max-width: 110px; margin: 0px auto 15px; display: grid; }
.composerProgress > span{ background: rgb(222, 216, 204); border-radius: 99px; height: 3px; }
.composerProgress > .composerStepActive{ background: var(--store-gold); }
.composerProgress > small{ color: rgb(146, 139, 128); text-align: center; grid-column: 1 / -1; font-size: 11px; }
.composerCard{ border: 1px solid var(--store-line); text-align: center; background: rgb(255, 255, 255); padding: 36px 48px 42px; position: relative; box-shadow: rgba(75, 66, 49, 0.1) 0px 24px 70px; }
.composerCard h1{ max-width: 520px; margin: 0px auto; font-size: clamp(32px, 6vw, 44px); }
.composerCard .storefrontEyebrow{ font-size: 12px; }
.composerLead{ color: var(--store-muted); font-family:inherit; max-width: 410px; margin: 12px auto 0px; font-size: 16px; line-height: 1.55; }
.composerStars{ justify-content: center; gap: 6px; margin-top: 27px; display: flex; }
.composerStars button{ color: var(--store-gold); background: 0px 0px; border: 0px; padding: 3px; }
.ratingLabel{ color: rgb(133, 126, 116); font-family:inherit; min-height: 18px; margin-top: 6px; font-size: 15px; font-style: italic; display: block; }
.ratingLabelError{ color: rgb(164, 63, 63); font-style: normal; font-weight: 700; }
.composerFields{ text-align: left; gap: 17px; margin-top: 28px; display: grid; }
.composerFields label, .identityFields label{ display: block; position: relative; }
.composerFields label > span, .identityFields label > span{ color: rgb(73, 70, 65); margin-bottom: 7px; font-size: 14px; font-weight: 700; display: block; }
.composerFields input, .composerFields textarea, .identityFields input{ border: 1px solid var(--store-line); font-family:inherit; background: rgb(252, 251, 248); border-radius: 3px; outline: 0px; width: 100%; padding: 12px 13px; font-size: 16px; }
.composerFields input:focus, .composerFields textarea:focus, .identityFields input:focus{ border-color: var(--store-gold); box-shadow: color-mix(in srgb, var(--lu-rv-btn) 15%, transparent) 0px 0px 0px 3px; }
.composerFields textarea{ resize: vertical; min-height: 118px; line-height: 1.55; }
.composerFieldMeta{ color: rgb(138, 132, 122); justify-content: space-between; margin: 6px 1px 0px !important; font-size: 12px !important; font-weight: 400 !important; display: flex !important; }
.composerFieldMeta small{ font-size: inherit; }
.composerFieldError{ line-height: 1.35; display: block; color: rgb(164, 63, 63) !important; margin: 6px 1px 0px !important; font-size: 13px !important; font-weight: 700 !important; }
.composerIdentityHint{ color: rgb(138, 132, 122); margin: 6px 1px 0px; font-size: 12px; line-height: 1.35; display: block; }
.composerFields input[aria-invalid="true"], .composerFields textarea[aria-invalid="true"], .identityFields input[aria-invalid="true"]{ background: snow; border-color: rgb(185, 79, 79); }
.composerFields input[aria-invalid="true"]:focus, .composerFields textarea[aria-invalid="true"]:focus, .identityFields input[aria-invalid="true"]:focus{ border-color: rgb(164, 63, 63); box-shadow: rgba(164, 63, 63, 0.11) 0px 0px 0px 3px; }
.recommendRow{ border-bottom: 1px solid var(--store-line); border-top: 1px solid var(--store-line); justify-content: space-between; align-items: center; min-height: 62px; margin-top: 20px; display: flex; }
.recommendRow > span{ color: rgb(94, 90, 84); font-size: 14px; font-weight: 700; }
.recommendRow > div{ gap: 6px; display: flex; }
.recommendRow button{ border: 1px solid var(--store-line); color: rgb(114, 109, 101); background: rgb(255, 255, 255); border-radius: 99px; min-height: 44px; padding: 0px 17px; font-size: 14px; }
.recommendRow .choiceActive{ color: rgb(255, 255, 255); background: rgb(45, 55, 47); border-color: rgb(45, 55, 47); }
.composerNext{ color: var(--lu-rv-btn-text); background: var(--lu-rv-btn); border: 0px; border-radius: 3px; justify-content: center; align-items: center; gap: 8px; width: 100%; min-height: 50px; margin-top: 24px; padding: 0px 22px; font-size: 16px; font-weight: 700; text-decoration: none; display: flex; }
.composerNext:disabled{ background: rgb(169, 174, 169); }
.composerBack{ color: rgb(126, 120, 111); background: 0px 0px; border: 0px; align-items: center; gap: 4px; min-height: 44px; font-size: 13px; display: inline-flex; position: absolute; top: 15px; left: 18px; }
.composerBack svg{ transform: rotate(180deg); }
.uploadZone{ color: rgb(89, 85, 78); background: rgb(252, 251, 247); border: 1px dashed rgb(203, 194, 178); border-radius: 4px; flex-direction: column; align-items: center; width: 100%; min-height: 154px; margin-top: 28px; padding: 22px; display: flex; }
.uploadZone:hover{ border-color: var(--store-gold); background: rgb(250, 246, 236); }
.uploadZoneIcon{ color: var(--lu-rv-btn); background: color-mix(in srgb, var(--lu-rv-btn) 12%, #fff); border-radius: 50%; justify-content: center; align-items: center; width: 38px; height: 38px; margin-bottom: 10px; display: flex; }
.uploadZone strong{ font-family:inherit; font-size: 16px; }
.uploadZone small{ color: rgb(151, 144, 134); margin-top: 6px; font-size: 12px; line-height: 1.45; }
.composerUploads{ grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 10px; display: grid; }
