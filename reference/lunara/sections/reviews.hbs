iv></dialog>{{/unless}}</section></template></lu-reviews>{{#if is_home}}<script>(function(){function run(){var h=document.querySelector('lu-reviews[data-home]');if(!h)return;var r=h.shadowRoot||h.querySelector('template')&&h.querySelector('template').content;if(!r)return;var ps=[];try{ps=JSON.parse((document.getElementById('ms-products')||{}).textContent||'[]')||[];}catch(e){}var n=0,s=0;ps.forEach(function(p){var c=+p.reviewCount||0,v=+p.rating||0;if(c>0&&v>0){n+=c;s+=v*c;}});var pill=r.querySelector('[data-lu-home-pill]');if(!pill||!n)return;r.querySelector('[data-lu-home-avg]').textContent=(Math.round(s/n*10)/10).toFixed(1);r.querySelector('[data-lu-home-count]').textContent=n.toLocaleString('en-US');pill.hidden=false;}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run);else run();})();</script>{{/if}}</div></section>
