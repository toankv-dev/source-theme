      {
        "type": "text",
        "id": "atc_label",
        "label": "Add-to-cart label",
        "default": "ADD TO CART"
      },
      {
        "type": "checkbox",
        "id": "open_cart_on_add",
        "label": "Open cart drawer after adding",
        "default": true
      },
      {
        "type": "text",
        "id": "checkout_button_label",
        "label": "Place-order button label",
        "default": "PLACE ORDER (TEST)"
      },
      {
        "type": "checkbox",
        "id": "show_discount_offer_cart",
        "label": "Show discount offer in the cart",
        "default": true
      },
      {
        "type": "text",
        "id": "discount_tiers_config",
        "label": "Volume discount tiers (qty:percent, qty:percent, ...)",
        "default": "2:10, 3:15, 4:20, 5:25, 6:30, 7:35, 8:40, 9:45, 10:50",
        "info": "\"2:10\" means 10% off from the 2nd item. Ignored while a tiered automatic discount is live on the Discounts page: the cart's real pricing always wins."
      }
    ]
  },
  {
    "name": "Cart upsells",
    "settings": [
      {
        "type": "header",
        "content": "Shipping protection (cart footer)"
      },
      {
        "type": "store_products",
        "id": "cart_upsells",
        "label": "Protection product",
        "info": "Pick per store domain the product you sell as protection (e.g. 'Shipping Protected'). It shows above the subtotal with its description, switched ON: added to the cart as a real item. The buyer can switch it off."
      },
      {
        "type": "checkbox",
        "id": "cart_upsell_as_line",
        "label": "Also list it with the cart items",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Heading (empty = none)",
        "default": ""
      },
      {
        "type": "color",
        "id": "cart_upsell_bg",
        "label": "Background",
        "default": "#F5F5F5"
      },
      {
        "type": "color",
        "id": "cart_upsell_color",
        "label": "Text",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "cart_upsell_accent",
        "label": "Switch colour",
        "default": "",
        "info": "Empty = black."
      },
      {
        "type": "header",
        "content": "Upsell products (cart body)"
      },
      {
        "type": "store_products",
        "id": "cart_body_upsells",
        "label": "Upsell products",
        "info": "Pick products per store domain. They show under the cart items as cards with a button; the buyer adds them as real items."
      },
      {
        "type": "checkbox",
        "id": "cart_body_upsell_move",
        "label": "Move an added product up into the cart items",
        "default": true,
        "info": "Off = the card stays and its button shows the 'added' text. Removing the item brings the card back."
      },
      {
        "type": "select",
        "id": "cart_body_upsell_control",
        "label": "Add control",
        "default": "button",
        "options": [
          {
            "value": "button",
            "label": "Button (text below)"
          },
          {
            "value": "switch",
            "label": "Switch (on / off)"
          }
        ]
      },
      {
        "type": "range",
        "id": "cart_body_upsell_delay",
        "label": "Add delay (spinner)",
        "min": 0,
        "max": 3,
        "step": 0.5,
        "unit": "s",
        "default": 1,
        "info": "0 = add at once."
      },
      {
        "type": "text",
        "id": "cart_body_upsell_heading",
        "label": "Heading",
        "default": "Customers also add ..."
      },
      {
        "type": "text",
        "id": "cart_body_upsell_badge",
        "label": "Badge (empty = none)",
        "default": ""
      },
      {
        "type": "text",
        "id": "cart_body_upsell_btn",
        "label": "Button text",
        "default": "Add +"
      },
      {
        "type": "text",
        "id": "cart_body_upsell_added",
        "label": "Button text when added",
        "default": "Added ✓"
      },
      {
        "type": "range",
        "id": "cart_body_upsell_title_size",
        "label": "Product title size",
        "min": 12,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 15
      },
      {
        "type": "color",
        "id": "cart_body_upsell_btn_bg",
        "label": "Button colour",
        "default": "",
        "info": "Empty = black."
      },
      {
        "type": "color",
        "id": "cart_body_upsell_btn_color",
        "label": "Button text colour",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "cart_body_upsell_badge_color",
        "label": "Badge colour",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "cart_body_upsell_card_bg",
        "label": "Card background",
        "default": "#ffffff"
      }
    ]
  },
