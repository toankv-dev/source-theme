{{!-- Footer TwinklingTree nguyen ban. Dong: menu chinh sach / collections, lien he brand.*, mang xa hoi, ten cua hang. --}}
<footer class="footer">
    <div class="container">
        <section class="footer-sections">
                    <div class="footer-section">
                        <label for="Policies" class="footer-section--title">Policies</label>
                        <input class="footer-section-title-checkbox" id="Policies" type="checkbox">
                        <img class="footer-section--title-arrow" src="{{assets_url}}/images/chevron-down-white.svg" title="chevron-down" alt="chevron-down" width="28" height="16">
                        <div class="footer-section-content">
                            <div class="expandable">
                                <ul>{{#if policies.privacy}}<li><a href="{{policyLinks.privacy}}">Privacy Policy</a></li>{{/if}}{{#if policies.terms}}<li><a href="{{policyLinks.terms}}">Terms of Service</a></li>{{/if}}{{#if policies.refund}}<li><a href="{{policyLinks.refund}}">Return Policy</a></li>{{/if}}{{#if policies.about}}<li><a href="{{policyLinks.about}}">About Us</a></li>{{/if}}</ul>
                            </div>
                        </div>
                    </div>
                    <div class="footer-section">
                        <label for="Explore" class="footer-section--title">Explore</label>
                        <input class="footer-section-title-checkbox" id="Explore" type="checkbox">
                        <img class="footer-section--title-arrow" src="{{assets_url}}/images/chevron-down-white.svg" title="chevron-down" alt="chevron-down" width="28" height="16">
                        <div class="footer-section-content">
                            <div class="expandable">
                                <ul>{{#each collections}}{{#unless (gt @index 1)}}<li><a href="{{@root.config.homeUrl}}#collection/{{handle}}">{{title}}</a></li>{{/unless}}{{/each}}{{#if policies.shipping}}<li><a href="{{policyLinks.shipping}}">Shipping Info</a></li>{{/if}}<li><a href="{{config.trackUrl}}">Track Order</a></li><li><a href="{{policyLinks.contact}}">Contact Us</a></li></ul>
                            </div>
                        </div>
                    </div>


            <div class="footer-section footer-section--unlock-exclusive-access">
                <div class="footer-section--wrapper">
                    <label for="unlock-exclusive-access" class="footer-section--title">Unlock Exclusive Access</label>
                    <input class="footer-section-title-checkbox" id="unlock-exclusive-access" type="checkbox">
                    <img class="footer-section--title-arrow" src="{{assets_url}}/images/chevron-down-white.svg" title="chevron-down" alt="chevron-down" width="28" height="16">
                    <div class="footer-section-content">
                        <div class="expandable">
                            <p>
                                Sign up and receive 10% off your first order! Your spiritual
                                journey awaits.
                            </p>
                            <form class="subscription-form" action="#" method="post" data-tt-newsletter>
    <div class="subscription-form-field">
        <input type="hidden" name="action" value="subscribe">
        <input type="hidden" name="nl_first_name" value="bc">
        <input type="hidden" name="check" value="1">
        <input id="nl_email" name="nl_email" type="email" value="" placeholder="Enter your email" aria-describedby="alertBox-message-text" aria-required="true" required="">
        <button>
            <img class="button-mail" src="{{assets_url}}/images/mail.svg" title="mail" alt="mail" height="64" width="64">
            <span class="button-submitted tt-spinner tt-spinner--button" role="status" aria-label="Submitting"></span>
        </button>
    </div>
</form>                            <div class="footer-socials">
                                {{#if settings.social_instagram}}<a target="_blank" rel="noopener" href="{{settings.social_instagram}}" title="{{brand.name}} on Instagram">
                                    <img class=" lazyloaded" alt="instagram" title="instagram" width="24" height="24" src="{{assets_url}}/images/instagram-white.svg">
                                </a>{{/if}}
                                {{#if settings.social_facebook}}<a target="_blank" rel="noopener" href="{{settings.social_facebook}}" title="{{brand.name}} on Facebook">
                                    <img class=" lazyloaded" alt="facebook" title="facebook" width="24" height="24" src="{{assets_url}}/images/facebook-white.svg">
                                </a>{{/if}}
                                {{#if settings.social_pinterest}}<a target="_blank" rel="noopener" href="{{settings.social_pinterest}}" title="{{brand.name}} on Pinterest">
                                    <img class=" lazyloaded" alt="pinterest" title="pinterest" width="24" height="24" src="{{assets_url}}/images/pinterest-white.svg">
                                </a>{{/if}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-section footer-section--get-in-touch">
                <div class="footer-section--wrapper">
                    <label for="get-in-touch" class="footer-section--title">Get in Touch</label>
                    <input class="footer-section-title-checkbox" id="get-in-touch" type="checkbox">
                    <img class="footer-section--title-arrow" src="{{assets_url}}/images/chevron-down-white.svg" title="chevron-down" alt="chevron-down" width="28" height="16">
                    <div class="footer-section-content">
                        <div class="expandable">
                            <p>
                                To get in touch with our helpful Customer Service team, please
                                <a class="text-link hover-underline-animation reverse" style="--underline-animation-color: white; --underline-animation-bottom: -2px;" href="{{@root.policyLinks.contact}}" title="contact us">click here</a>
                                . They will respond to all your questions and enquiries ASAP.
                            </p>{{#if brand.email}}<p class="tt-footer-contact">Email: <a class="text-link" href="mailto:{{brand.email}}">{{brand.email}}</a></p>{{/if}}{{#if brand.phone}}<p class="tt-footer-contact">Phone: <a class="text-link" href="tel:{{brand.phone}}">{{brand.phone}}</a></p>{{/if}}{{#if brand.address}}<p class="tt-footer-contact">{{brand.address}}</p>{{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <div class="footer-payment-cards">
            <img class=" lazyloaded" loading="lazy" title="amex-card" alt="amex-card" width="38" height="24" src="{{assets_url}}/images/amex-card.svg">
            <img class=" lazyloaded" loading="lazy" title="apple-pay-card" alt="apple-pay-card" width="38" height="24" src="{{assets_url}}/images/apple-pay-card.svg">
            <img class=" lazyloaded" loading="lazy" title="google-pay-card" alt="google-pay-card" width="38" height="24" src="{{assets_url}}/images/google-pay-card.svg">
            <img class=" lazyloaded" loading="lazy" title="master-card" alt="master-card" width="38" height="24" src="{{assets_url}}/images/master-card.svg">
            <img class=" lazyloaded" loading="lazy" title="paypal-card" alt="paypal-card" width="38" height="24" src="{{assets_url}}/images/paypal-card.svg">
            <img class=" lazyloaded" loading="lazy" title="visa-card" alt="visa-card" width="38" height="24" src="{{assets_url}}/images/visa-card.svg">
        </div>
        <p class="footer-copyright">© <span id="currentYear">2026</span> {{brand.name}}</p>
        
    </div>
    <div id="newsletter-notification">Thank you for subscribing!</div>
</footer><template id="tt-card-tpl"><li class="product fade-in-enabled animated"><article class="card "><div class="card-img-container"><div class="badge">Sale</div><a href="" class="card-img-link" draggable="false"><img src="" alt="" height="340" width="340" class="card-image lazyloaded" draggable="false" loading="lazy"></a></div><div class="card-body"><a href="" class="product-title"></a><div class="card-text product-price" data-test-info-type="price"><div class="price--original"><s></s></div><div class="price--discounted"><span></span> USD </div></div><span class="stamped-product-reviews-badge ttCardRating" style="display:block;" data-twinkling-card-rating=""><span class="ttCardRatingInner"><span class="ttCardRatingStars" aria-hidden="true"><i class="tt-star"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg></i><i class="tt-star"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg></i><i class="tt-star"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg></i><i class="tt-star"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg></i><i class="tt-star"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg></i></span><span class="ttCardRatingCount"></span></span></span></div></article></li></template>
