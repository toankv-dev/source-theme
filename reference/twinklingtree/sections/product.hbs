{{!-- PDP TwinklingTree nguyen ban (BigCommerce productView). Dong: gallery, ten, sao, gia, bien the, Add to cart, mo ta, FAQ, review. --}}
<main class="body" id="main-content" role="main" data-currency-code="USD" data-template="pages-product">
<div id="product-page" class="tt-pdp-scope">
<div class="productView-image-container mobile-only"><section class="productCarousel mobile-only flickity-enabled is-draggable" data-tt-carousel="mobile"><div class="flickity-viewport" style="touch-action: pan-y;"><div class="flickity-slider" style="left: 0px;">{{#each product.media.gallery}}<div class="productView-img-container{{#if @first}} is-selected{{/if}}" data-index="{{@index}}" style="position: absolute; left: 0px;"><img alt="{{#if alt}}{{alt}}{{else}}{{@root.product.title}}{{/if}}" width="700" height="700" class="productView-image{{#if @first}} productView-image--default{{/if}}" src="{{url}}" decoding="async"{{#if @first}} fetchpriority="high"{{else}} loading="lazy"{{/if}} data-main-image=""></div>{{/each}}</div></div><button class="flickity-button flickity-prev-next-button previous" type="button" aria-label="Previous"><svg class="flickity-button-icon" viewBox="0 0 100 100"><path d="M 10,50 L 60,100 L 70,90 L 30,50  L 70,10 L 60,0 Z" class="arrow"></path></svg></button><button class="flickity-button flickity-prev-next-button next" type="button" aria-label="Next"><svg class="flickity-button-icon" viewBox="0 0 100 100"><path d="M 10,50 L 60,100 L 70,90 L 30,50  L 70,10 L 60,0 Z" class="arrow" transform="translate(100, 100) rotate(180) "></path></svg></button><ol class="flickity-page-dots">{{#each product.media.gallery}}<li class="dot{{#if @first}} is-selected{{/if}}" aria-label="Page dot {{@index}}"></li>{{/each}}</ol></section><section class="productView-thumbnails">{{#each product.media.gallery}}<a href="{{url}}" class="thumbnail-link{{#if @first}} is-active{{/if}}" draggable="false" data-index="{{@index}}"><img class="lazyloaded" src="{{url}}" draggable="false" loading="lazy" alt="{{#if alt}}{{alt}}{{else}}{{@root.product.title}}{{/if}}" height="80" width="80"></a>{{/each}}</section>{{#if product.off_pct}}<div class="discount-tag" data-tt-discount-tag>{{product.off_pct}}% OFF</div>{{/if}}</div>
<div class="container"><div class="productView"><section class="productView-images" data-image-gallery=""><div class="productView-image-container desktop-only"><section class="productCarousel desktop-only flickity-enabled is-draggable" data-tt-carousel="desktop"><div class="flickity-viewport" style="touch-action: pan-y;"><div class="flickity-slider" style="left: 0px;">{{#each product.media.gallery}}<div class="productView-img-container{{#if @first}} is-selected{{/if}}" data-index="{{@index}}" style="position: absolute; left: 0px;"><img alt="{{#if alt}}{{alt}}{{else}}{{@root.product.title}}{{/if}}" width="700" height="700" class="productView-image{{#if @first}} productView-image--default{{/if}}" src="{{url}}" decoding="async"{{#if @first}} fetchpriority="high"{{else}} loading="lazy"{{/if}} data-main-image=""></div>{{/each}}</div></div><button class="flickity-button flickity-prev-next-button previous" type="button" aria-label="Previous"><svg class="flickity-button-icon" viewBox="0 0 100 100"><path d="M 10,50 L 60,100 L 70,90 L 30,50  L 70,10 L 60,0 Z" class="arrow"></path></svg></button><button class="flickity-button flickity-prev-next-button next" type="button" aria-label="Next"><svg class="flickity-button-icon" viewBox="0 0 100 100"><path d="M 10,50 L 60,100 L 70,90 L 30,50  L 70,10 L 60,0 Z" class="arrow" transform="translate(100, 100) rotate(180) "></path></svg></button></section><section class="productView-thumbnails">{{#each product.media.gallery}}<a href="{{url}}" class="thumbnail-link{{#if @first}} is-active{{/if}}" draggable="false" data-index="{{@index}}"><img class="lazyloaded" src="{{url}}" draggable="false" loading="lazy" alt="{{#if alt}}{{alt}}{{else}}{{@root.product.title}}{{/if}}" height="80" width="80"></a>{{/each}}</section>{{#if product.off_pct}}<div class="discount-tag" data-tt-discount-tag>{{product.off_pct}}% OFF</div>{{/if}}</div></section>
<section class="productView-details product-data"><div class="productView-product"><h2 class="productView-title">{{product.title}}</h2>{{#if product.reviews.summary.total_count}}<button type="button" data-twinkling-rating-badge="1" data-scroll-to="#tt-reviews" aria-label="{{product.reviews.summary.average_rating}} out of 5. Jump to customer reviews."><span class="ttTitleStars"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg></span><strong class="ttTitleRating">{{product.reviews.summary.average_rating}}</strong><span class="ttTitleCount">{{product.reviews.summary.total_count}} reviews</span></button>{{/if}}{{#unless (eq settings.show_viewing false)}}<div class="productView-viewing" data-min="{{#if settings.viewing_min}}{{settings.viewing_min}}{{else}}180{{/if}}" data-max="{{#if settings.viewing_max}}{{settings.viewing_max}}{{else}}230{{/if}}"><img src="{{assets_url}}/images/tt-eye-icon.png" alt="Customers viewing product" width="20" height="10"><span id="productView-viewing"></span> people viewing this product </div>{{/unless}}<div class="productView-price"><div class="price--original"{{#unless product.compare_at_price}} style="display: none;"{{/unless}}><s class="productView--base-price">{{product.compare_at_price}}</s> <span class="currency-text">USD</span></div><div class="price--discounted"><span class="productView--sale-price">{{product.price}}</span> <span class="currency-text">USD</span></div></div>{{#unless (eq settings.show_stock false)}}<div class="productView-stock" data-min="{{#if settings.stock_min}}{{settings.stock_min}}{{else}}17{{/if}}" data-max="{{#if settings.stock_max}}{{settings.stock_max}}{{else}}24{{/if}}" style="margin-bottom: 20px;"> Only <span id="productView-stock" style="font-weight: 600;"></span> left in stock </div>{{/unless}}<div class="productView-options"><form method="post" action="#" data-cart-item-add="" class="tt-pdp-form">{{#each product.variants}}{{#if (eq displayType "dropdown")}}<div class="product-variant-label" data-label="{{name}}">{{name}}</div><div class="productView-variant productView-variant--select tt-variant-group" data-option-name="{{name}}"><select class="form-select" data-option-name="{{name}}" aria-label="{{name}}">{{#each options}}<option value="{{label}}"{{#if active}} selected{{/if}}>{{#if custom_name}}{{custom_name}}{{else}}{{label}}{{/if}}</option>{{/each}}</select></div>{{else if (eq displayType "swatches")}}<div class="product-variant-label" data-label="{{name}}">{{name}}</div><div class="productView-variant productView-variant--radio"><div class="productView-variant--radio-group tt-variant-group" data-option-name="{{name}}">{{#each options}}<div class="productView-variant--radio-input productView-variant--radio-input--custom{{#if active}} active{{/if}}" data-option-name="{{../name}}" data-variant-label="{{label}}"><input type="radio" name="tt-opt-{{@../index}}" value="{{label}}" id="tt-opt-{{@../index}}-{{@index}}"{{#if active}} checked=""{{/if}} aria-label="{{label}}">{{#if badge_text}}<span class="customSwatch-popular">{{badge_text}}</span>{{/if}}<label class="form-variant-label" for="tt-opt-{{@../index}}-{{@index}}"><span class="customSwatch-image" aria-hidden="true" data-tt-swatch="{{label}}" style="{{#if image}}background-image: url('{{image}}');{{else}}{{#if color}}background: {{color}};{{else}}{{swatchStyle label}}{{/if}}{{/if}}"></span><span class="customSwatch-label">{{#if custom_name}}{{custom_name}}{{else}}{{label}}{{/if}}</span></label></div>{{/each}}</div></div>{{else if (isColorGroup name)}}<div class="product-variant-label" data-label="{{name}}">{{name}}&nbsp; — <span class="productView-variants--value" data-tt-variant-value>{{#each options}}{{#if active}}{{label}}{{/if}}{{/each}}</span></div><div class="productView-variant productView-variant--radio"><div class="productView-variant--radio-group tt-variant-group tt-color-group" data-option-name="color" data-tt-name="{{name}}">{{#each options}}<div class="productView-variant--radio-input{{#if active}} active{{/if}}" style="--i: {{#if color}}{{color}}{{else}}{{label}}{{/if}}" data-option-name="color" data-variant-label="{{label}}" title="{{label}}"{{#if image}} data-tt-img="{{image}}"{{/if}}><input type="radio" name="tt-opt-{{@../index}}" value="{{label}}" id="tt-opt-{{@../index}}-{{@index}}"{{#if active}} checked=""{{/if}} aria-label="{{label}}"><label class="form-variant-label" for="tt-opt-{{@../index}}-{{@index}}"></label></div>{{/each}}</div></div>{{else}}<div class="product-variant-label" data-label="{{name}}">{{name}}</div><div class="productView-variant productView-variant--radio"><div class="productView-variant--radio-group tt-variant-group" data-option-name="{{name}}">{{#each options}}<div class="productView-variant--radio-input{{#if active}} active{{/if}}" data-option-name="{{../name}}" data-variant-label="{{label}}"><input type="radio" name="tt-opt-{{@../index}}" value="{{label}}" id="tt-opt-{{@../index}}-{{@index}}"{{#if active}} checked=""{{/if}} aria-label="{{label}}">{{#if badge_text}}<span class="customSwatch-popular">{{badge_text}}</span>{{/if}}<label class="form-variant-label" for="tt-opt-{{@../index}}-{{@index}}">{{#if custom_name}}{{custom_name}}{{else}}{{label}}{{/if}}</label></div>{{/each}}</div></div>{{/if}}{{/each}}<div id="add-to-cart-wrapper" class="add-to-cart-wrapper"><div class="alertBox productAttributes-message" style="display:none"><p class="alertBox-column alertBox-message"></p></div><div class="quantity-container"><div class="form-field form-field--increments"><label class="form-label form-label--alternate" for="qty[]">QUANTITY</label><div class="form-increment" data-quantity-change=""><button type="button" data-action="dec"><img src="{{assets_url}}/images/minus.svg" alt="minus"></button><input class="form-input--incrementTotal" id="qty[]" name="qty[]" type="tel" readonly="" tabindex="-1" inputmode="none" maxlength="3" value="1" min="1" pattern="[0-9]*" aria-live="polite" aria-label="Quantity"><button type="button" data-action="inc"><img src="{{assets_url}}/images/plus.svg" alt="add"></button></div></div><button id="addToCart" data-testid="add-to-cart" class="black-button add-to-cart-button" type="submit">{{#if settings.atc_label}}{{settings.atc_label}}{{else}}ADD TO CART{{/if}}</button></div></div>{{#unless (eq settings.show_pdp_notes false)}}<div class="add-to-cart--note">{{#if settings.pdp_note_1}}{{settings.pdp_note_1}}{{else}}Planting A Tree for Every Order 🌲{{/if}}</div><div class="add-to-cart--note">Fast Shipping, <span id="displayCountryName">United States</span><span id="displayCountryFlag">🇺🇸</span></div>{{/unless}}</form></div></div><hr class="hr"><article class="productView-description"><div class="productView-description"><div class="elementor-widget-container tt-description">{{{product.description_html}}}</div>{{#unless (eq settings.show_faq false)}}<div class="tt-pdp-faq"><h3 style="font-family: inherit; text-align: center; font-size: 22px; font-weight: bold;">Frequently Asked Questions</h3><ul class="accordion">{{#if page.faqFromListing}}{{#each page.faq}}<li><i class="toggle-icon fa-solid fa-plus"></i><span>{{this.q}}</span><br><ul><li>{{{applyTokens this.a}}}</li></ul></li>{{/each}}{{else}}{{#each (faqItems settings)}}<li><i class="toggle-icon fa-solid fa-plus"></i><span>{{this.q}}</span><br><ul><li>{{{applyTokens this.a}}}</li></ul></li>{{/each}}{{/if}}</ul></div>{{/unless}}</div></article></section></div>
{{#unless (eq settings.show_reviews false)}}<div id="tt-reviews"><twinkling-reviews data-total="{{product.reviews.summary.total_count}}"><template shadowrootmode="open"><style>
          @font-face{font-family:'TT Crimson Text';font-style:normal;font-weight:400;font-display:swap;src:url('{{assets_url}}/fonts/crimson-text-latin-ext.woff2') format('woff2');unicode-range:U+0100-024F,U+1E00-1EFF,U+20A0-20AB,U+2C60-2C7F,U+A720-A7FF}
          @font-face{font-family:'TT Crimson Text';font-style:normal;font-weight:400;font-display:swap;src:url('{{assets_url}}/fonts/crimson-text-latin.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+20AC,U+2122}
          @font-face{font-family:'TT Crimson Pro';font-style:normal;font-weight:200 900;font-display:swap;src:url('{{assets_url}}/fonts/crimson-pro-latin-ext.woff2') format('woff2');unicode-range:U+0100-024F,U+1E00-1EFF,U+20A0-20AB,U+2C60-2C7F,U+A720-A7FF}
          @font-face{font-family:'TT Crimson Pro';font-style:normal;font-weight:200 900;font-display:swap;src:url('{{assets_url}}/fonts/crimson-pro-latin.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+20AC,U+2122}
          :host{--cream:#fbfaf6;--ink:#29241c;--muted:#6f685c;--line:#ded9ce;--gold:#ffbc00;display:block;contain:content;color:var(--ink);font-family:'TT Crimson Text','Crimson Text',serif;font-size:16px}
          *{box-sizing:border-box}
          button,select,a,input{font:inherit}
          button,a,select{cursor:pointer}
          button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #2e6b53;outline-offset:3px}
          .wrap{background:var(--cream);margin:0 auto;max-width:1440px;padding:56px 30px}
          .eyebrow{color:#74550d;font-size:11px;font-weight:800;letter-spacing:.18em;margin:0 0 12px;text-transform:uppercase}
          h2,h3{color:var(--ink)}
          h2{font-family:'TT Crimson Pro','Crimson Pro','TT Crimson Text','Crimson Text',serif;font-size:clamp(36px,4.4vw,64px);font-weight:600;letter-spacing:-.035em;line-height:1.02;margin:0;max-width:980px}
          .summary{border:1px solid var(--line);border-radius:14px;display:grid;grid-template-columns:34% 66%;margin-top:26px;min-height:132px;overflow:hidden}
          .score{align-items:center;border-right:1px solid var(--line);display:flex;justify-content:center;min-width:0;padding:20px}
          .score>strong{font-family:'TT Crimson Pro','Crimson Pro','TT Crimson Text','Crimson Text',serif;font-size:48px;font-weight:600;letter-spacing:-.04em;line-height:1}
          .scoreDetail{margin-left:14px}.stars{color:var(--gold);font-size:16px;letter-spacing:2px;white-space:nowrap}.scoreDetail small{color:var(--muted);display:block;font-size:11px;margin-top:5px}
          .bars{align-content:center;display:grid;gap:6px;padding:18px 26px}.bar{align-items:center;color:#625c51;display:grid;font-size:10px;gap:8px;grid-template-columns:12px 12px 1fr 30px}.bar>i{color:var(--gold);font-style:normal}.track{background:#e5e2db;border-radius:99px;height:6px;overflow:hidden}.track>i{background:var(--gold);border-radius:inherit;display:block;height:100%;min-width:0}.bar>em{font-style:normal;text-align:right}
          .tools{align-items:center;display:flex;gap:16px;justify-content:flex-end;margin:18px 0 14px}.write,.more{align-items:center;border-radius:9px;display:inline-flex;font-size:13px;font-weight:700;justify-content:center;min-height:44px;padding:0 20px}.write{background:#050505;border:1px solid #050505;color:#fff;min-width:154px}
          .reviews{align-items:start;display:grid;gap:14px;grid-template-columns:repeat(4,minmax(0,1fr))}.reviewColumn{display:flex;flex-direction:column;min-width:0}.review{background:var(--cream);border:1px solid var(--line);border-radius:13px;cursor:pointer;display:block;margin:0 0 14px;overflow:hidden;transition:box-shadow .18s ease,transform .18s ease;width:100%}.review:hover{box-shadow:0 11px 28px rgb(46 36 16/.1);transform:translateY(-2px)}.review:focus-visible{outline:3px solid #2e6b53;outline-offset:3px}.media{background:#eee9de;border:0;display:block;overflow:hidden;padding:0;position:relative;width:100%}.mediaOpenIcon{background:rgb(20 20 18/.72);border:1px solid rgb(255 255 255/.72);border-radius:99px;bottom:10px;box-sizing:border-box;fill:none;height:34px;padding:8px;pointer-events:none;position:absolute;right:10px;stroke:#fff;stroke-linecap:round;stroke-linejoin:round;stroke-width:2;width:34px}.media img,.media video{aspect-ratio:1/.9;display:block;height:auto;object-fit:cover;width:100%}.media video{min-height:200px}.content{padding:15px}.reviewTop{align-items:center;display:flex;gap:10px;justify-content:space-between}.reviewTop .stars{font-size:14px}.reviewTop time{color:#777066;font-size:10px}.review h3{font-size:19px;font-weight:700;line-height:1.05;margin:11px 0 7px}.review p{color:#625b50;font-size:16px;line-height:1.48;margin:0}.review footer{align-items:center;display:flex;gap:8px;justify-content:space-between;margin-top:14px}.review footer strong{font-size:11px}.verified{color:#267156;font-size:10px;font-weight:700}.reply{border-left:2px solid #d5c798;color:#5f584c;font-size:13px;margin-top:14px;padding:2px 0 2px 12px}.reply strong{display:block;font-size:10px;margin-bottom:4px}.moreRow{display:flex;justify-content:center;margin-top:24px}.more{background:transparent;border:1px solid var(--ink);color:var(--ink);min-width:210px}.more[disabled]{cursor:wait;opacity:.58}.skeleton{animation:pulse 1.4s ease-in-out infinite;background:#e8e4dc;border-radius:8px}.sk-title{height:52px;max-width:760px}.sk-panel{height:132px;margin-top:26px;width:100%}.sk-grid{display:grid;gap:14px;grid-template-columns:repeat(4,1fr);margin-top:22px}.sk-card{height:300px}.error{background:#f8f1de;border:1px solid #e2d1a5;border-radius:10px;color:#665d4c;padding:20px}
          dialog{border:0;margin:auto;padding:0}.reviewDialog{background:transparent;max-width:none;overflow:visible;width:min(94vw,1000px)}.reviewDialog::backdrop,.composerDialog::backdrop{background:rgb(14 16 14/.78);backdrop-filter:blur(7px)}.viewerShell{background:var(--cream);border-radius:16px;box-shadow:0 30px 90px rgb(0 0 0/.38);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);max-height:calc(100vh - 48px);overflow:hidden;position:relative;touch-action:pan-y}.viewerShell.noMedia{grid-template-columns:minmax(0,620px);margin:auto;max-width:620px}.viewerMedia{background:#1e1a14;min-height:min(72vh,650px)}.viewerMedia img,.viewerMedia video{display:block;height:100%;max-height:calc(100vh - 48px);object-fit:cover;width:100%}.viewerCopy{align-self:center;max-height:calc(100vh - 48px);overflow-y:auto;padding:64px 38px 32px}.viewerTop{align-items:center;display:flex;gap:12px;justify-content:space-between;padding-right:52px}.viewerTop .stars{font-size:15px}.viewerCount,.viewerDesktopHint,.viewerMobileHint{color:var(--muted);font-size:10px}.viewerMobileHint{display:none}.viewerCopy h3{font-family:'TT Crimson Pro','Crimson Pro','TT Crimson Text','Crimson Text',serif;font-size:30px;line-height:1.08;margin:18px 0 14px}.viewerBody{color:#625b50;font-size:17px;line-height:1.55;margin:0}.viewerAuthor{align-items:flex-start;display:flex;flex-direction:column;gap:5px;margin-top:22px}.viewerAuthor strong{font-size:12px}.viewerAuthor time{color:var(--muted);font-size:10px}.viewerNav{align-items:center;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr auto 1fr;margin-top:28px;padding-top:18px}.viewerNav button{align-items:center;background:transparent;border:0;color:var(--ink);display:flex;font-size:11px;font-weight:700;gap:6px;min-height:44px;padding:0}.viewerNav button:last-child{justify-self:end}.viewerNav button:disabled{cursor:default;opacity:.35}.viewerClose{align-items:center;background:#fff;border:1px solid var(--line);border-radius:99px;color:#111;display:flex;font-size:24px;height:44px;justify-content:center;position:absolute;right:13px;top:13px;width:44px;z-index:2}.dialogClose{align-items:center;background:#fff;border:0;border-radius:99px;color:#111;display:flex;font-size:22px;height:44px;justify-content:center;width:44px}.composerDialog{background:#fff;border-radius:16px;box-shadow:0 24px 80px rgb(0 0 0/.4);height:min(90dvh,850px);max-width:760px;overflow:hidden;width:min(94vw,760px)}.composerDialog[open]{display:grid;grid-template-rows:56px minmax(0,1fr)}.composerDialog>.dialogClose{align-self:center;grid-row:1;justify-self:end;margin-right:8px;position:static}.composerDialog iframe{background:#fff;border:0;display:block;grid-row:2;height:100%;min-height:0;pointer-events:auto;position:relative;touch-action:pan-y;width:100%;z-index:1}
          .reviewDialog{width:min(94vw,760px)}.viewerShell{display:block;margin:auto;max-width:760px;overflow-y:auto}.viewerShell.noMedia{max-width:620px}.viewerMedia{aspect-ratio:16/10;min-height:0}.viewerMedia img,.viewerMedia video{height:100%;max-height:none}.viewerCopy{max-height:none;overflow:visible;padding:64px 36px 26px}
