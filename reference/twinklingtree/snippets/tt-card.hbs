{{!-- Card san pham TwinklingTree (li.product > article.card). Du lieu: card trang chu (toProductCard). --}}
<li class="product fade-in-enabled animated"><article class="card " data-test="card-{{id}}" data-handle="{{handle}}"><div class="card-img-container">{{#if (gt compareAtPrice sellingPrice)}}<div class="badge">Sale</div>{{/if}}<a href="{{url}}" class="card-img-link" draggable="false" aria-label="{{title}}"><img src="{{imageUrl}}" alt="{{title}}" title="{{title}}" height="{{#if imageHeight}}{{imageHeight}}{{else}}340{{/if}}" width="{{#if imageWidth}}{{imageWidth}}{{else}}340{{/if}}" class="card-image lazyloaded" draggable="false" loading="lazy"{{#if imagePosterUrl}} poster="{{imagePosterUrl}}"{{/if}}></a></div><div class="card-body"><a aria-label="{{title}}" href="{{url}}" class="product-title">{{title}}</a><div class="card-text product-price" data-test-info-type="price">{{#if (gt compareAtPrice sellingPrice)}}<div class="price--original"><s>{{money compareAtPrice}}</s></div>{{/if}}<div class="price--discounted"><span>{{money sellingPrice}}</span> USD </div></div>{{#if reviewCount}}<span class="stamped-product-reviews-badge ttCardRating" style="display:block;" data-twinkling-card-rating="{{id}}" aria-label="Rated {{rating}} out of 5 stars, {{reviewCount}} reviews"><span class="ttCardRatingInner"><span class="ttCardRatingStars" aria-hidden="true">{{#each (stars5 rating)}}<i class="tt-star tt-star--{{this}}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9z"></path></svg></i>{{/each}}</span><span class="ttCardRatingCount">({{reviewCount}})</span></span></span>{{/if}}</div></article></li>
