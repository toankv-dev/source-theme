<style>
  /* A part-filled last row leaves empty cells beside "Show More", which reads as a broken grid
     rather than the end of a list. The trailing cards are marked by trimPartialRow() in
     _customisations/pages/category.js and come back as soon as the next page makes up a full row.
     Never set on the last page — a short final row is honest there. */
  #product-listing .productGrid > li.product[data-tt-row-trim] {
    display: none;
  }

  /*.pagination-list {*/
  /*  display: none !important;*/
  /*}*/

  .loader {
    display: none;
    width: 48px;
    height: 48px;
    /* Match the full-page (search) loader: brand gold arc on a faint gold track. */
    border: 4px solid rgba(240, 179, 35, 0.25);
    border-top-color: #f0b323;
    border-radius: 50%;
    box-sizing: border-box;
    animation: rotation 1s linear infinite;
    margin: 20px auto;
  }

  .loader.is-active {
    display: block;
  }

  @keyframes rotation {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }
</style>

