{{!-- Us vs. others table. Each row block says whether each side has the feature. --}}
<div class="w-wrap w-compare">
  {{#if section.settings.heading}}<h2 class="w-h2" {{{editable "heading"}}}>{{section.settings.heading}}</h2>{{/if}}
  <div class="w-compare__table" role="table">
    <div class="w-compare__head" role="row">
      <div role="columnheader" class="w-compare__side">{{#if section.settings.ours_image}}<img src="{{section.settings.ours_image}}" alt="" loading="lazy">{{/if}}<span>{{#if section.settings.ours_label}}{{section.settings.ours_label}}{{else}}{{@root.brand.name}}{{/if}}</span></div>
      <div role="columnheader" class="w-compare__mid"></div>
      <div role="columnheader" class="w-compare__side">{{#if section.settings.theirs_image}}<img src="{{section.settings.theirs_image}}" alt="" loading="lazy">{{/if}}<span>{{section.settings.theirs_label}}</span></div>
    </div>
    {{#each section.blocks}}
    <div class="w-compare__row" role="row" {{{this.attributes}}}>
      <div role="cell" class="w-compare__side">{{#if this.settings.ours}}<span class="w-yes" aria-label="Yes">✓</span>{{else}}<span class="w-no" aria-label="No">✕</span>{{/if}}</div>
      <div role="cell" class="w-compare__mid">{{this.settings.label}}</div>
      <div role="cell" class="w-compare__side">{{#if this.settings.theirs}}<span class="w-yes" aria-label="Yes">✓</span>{{else}}<span class="w-no" aria-label="No">✕</span>{{/if}}</div>
    </div>
    {{/each}}
  </div>
</div>
