{{!-- Rendered by the layout AND on its own for platform pages (tracking result, contact…), where product
      is empty — read only brand / config / policyLinks / settings. Those pages restyle a <header> element (white
      logo-only bar) and hide [aria-label*="cart"]: the bar is a div role="banner" and the cart labels are
      screen-reader text, so it renders exactly as on the store. The cart drawer is printed here too (not in the
      layout) so the cart icon opens it on those pages.
      Product-page config has no allProductsUrl / searchUrl, so those fall back to plain paths that theme.js
      tags with ?domain= on localhost (data-local-domain). The store has no customer login: the menu
      drawer links the order lookup page. --}}
{{> w-vars}}
{{#unless (eq settings.show_topbar false)}}
<div class="w-topbar" role="region" aria-roledescription="carousel" aria-label="Announcements" data-topbar="{{settings.topbar_text}}" data-autoplay="{{#if settings.topbar_autoplay}}true{{else}}false{{/if}}">
  <div class="w-wrap w-topbar__inner">
    <button type="button" class="w-topbar__arrow w-topbar__arrow--prev" data-topbar-step="-1" aria-label="Previous announcement">{{> w-caret}}</button>
    <p class="w-topbar__text" aria-live="polite" data-topbar-text>{{#if settings.topbar_text}}{{settings.topbar_text}}{{else}}Holiday sale | Up to 50% off + free shipping{{/if}}</p>
    <button type="button" class="w-topbar__arrow w-topbar__arrow--next" data-topbar-step="1" aria-label="Next announcement">{{> w-caret}}</button>
  </div>
</div>
{{/unless}}
<div class="w-header" role="banner">
  <div class="w-wrap w-header__inner">
    <button type="button" class="w-icon-btn w-header__burger" data-menu-open aria-label="Menu" aria-expanded="false" aria-controls="w-menu-drawer">
      <svg viewBox="0 0 18 16" width="20" height="20" aria-hidden="true"><path d="M1 1h16M1 8h16M1 15h16" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>
    </button>
    <a class="w-logo" href="{{#if config.homeUrl}}{{config.homeUrl}}{{else}}{{#if policyLinks.home}}{{policyLinks.home}}{{else}}/{{/if}}{{/if}}">
      {{#if brand.logo}}<img src="{{brand.logo}}" alt="{{brand.name}}" width="110" height="39">{{else}}<span>{{brand.name}}</span>{{/if}}
    </a>
    <nav class="w-nav" aria-label="Main">{{> w-nav-links}}</nav>
    <div class="w-header__actions">
      {{#unless (eq settings.show_search false)}}
      <button type="button" class="w-icon-btn" data-search-open aria-label="Search" aria-haspopup="dialog">
        <svg viewBox="0 0 18 19" width="19" height="19" aria-hidden="true"><circle cx="7.5" cy="8" r="6.3" stroke="currentColor" stroke-width="1.1" fill="none"/><path d="m12.2 12.8 5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
      </button>
      {{/unless}}
      <button type="button" class="w-icon-btn" data-cart-open aria-haspopup="dialog"><span class="w-sr">Open cart</span>
        <svg viewBox="0 0 40 40" width="30" height="30" aria-hidden="true"><path d="M12.6 12.3h14.8l.75 11.1a4.5 4.5 0 0 1-4.5 4.8h-7.3a4.5 4.5 0 0 1-4.5-4.8ZM16.2 12.3v-1a4.3 4.3 0 0 1 8.6 0v1m-8.6 0v.5a4.3 4.3 0 0 0 8.6 0v-.5" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/></svg>
        <span class="w-cart-count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>
</div>
{{> cart-drawer}}
{{!-- Platform pages have no <head> of ours: theme.js falls back to this when #sf-config is missing. --}}
<script type="application/json" id="sf-chrome-config">{{{configJson}}}</script>

{{!-- Mobile menu drawer (slides in from the left). --}}
<div class="w-menu-drawer" id="w-menu-drawer" data-menu-drawer hidden>
  <div class="w-menu-drawer__overlay" data-menu-close></div>
  <nav class="w-menu-drawer__panel" aria-label="Menu">
    <button type="button" class="w-icon-btn w-menu-drawer__close" data-menu-close aria-label="Close menu">
      <svg viewBox="0 0 18 17" width="18" height="18" aria-hidden="true"><path d="m1 1 16 15M17 1 1 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
    </button>
    <div class="w-menu-drawer__links">{{> w-nav-links}}</div>
    {{#unless (eq settings.show_account false)}}
    <a class="w-menu-drawer__account" href="/pages/order-list" data-local-domain>
      <svg viewBox="0 0 18 19" width="18" height="18" aria-hidden="true"><circle cx="9" cy="4.6" r="3.6" stroke="currentColor" stroke-width="1.1" fill="none"/><path d="M1 18c.1-5.3 2.8-6.6 8-6.6s7.9 1.3 8 6.6Z" stroke="currentColor" stroke-width="1.1" fill="none"/></svg>
      Your orders
    </a>
    {{/unless}}
  </nav>
</div>

{{!-- Search dialog: submits to the platform's /search page (templates/search.hbs filters by ?q=). --}}
{{#unless (eq settings.show_search false)}}
<div class="w-search" data-search hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="w-search__overlay" data-search-close></div>
  <form class="w-wrap w-search__form" action="{{#if config.searchUrl}}{{config.searchUrl}}{{else}}/search{{/if}}" method="get" role="search" data-search-form>
    {{#if config.domain}}<input type="hidden" name="domain" value="{{config.domain}}" data-local-only>{{/if}}
    <label class="w-search__field">
      <span class="w-search__label">Search</span>
      <input type="search" name="q" placeholder="Search" autocomplete="off" data-search-input>
    </label>
    <button type="submit" class="w-icon-btn" aria-label="Search">
      <svg viewBox="0 0 18 19" width="19" height="19" aria-hidden="true"><circle cx="7.5" cy="8" r="6.3" stroke="currentColor" stroke-width="1.1" fill="none"/><path d="m12.2 12.8 5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
    </button>
    <button type="button" class="w-icon-btn" data-search-close aria-label="Close search">
      <svg viewBox="0 0 18 17" width="16" height="16" aria-hidden="true"><path d="m1 1 16 15M17 1 1 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
    </button>
  </form>
</div>
{{/unless}}
