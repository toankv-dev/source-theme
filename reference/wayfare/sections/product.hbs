{{!-- Main product section; blocks render in the merchant's order. From the legacy entry
      (templates/product.hbs) `section` is undefined, so the {{else}} branch renders price, options and the
      buy button — the page still sells without a template document. --}}
<div class="w-wrap w-pdp" data-pdp>
  <div class="w-gallery" data-gallery>
    <div class="w-gallery__main">
      {{#if product.media.main_image}}
      <img data-gallery-main src="{{product.media.main_image}}" alt="{{product.title}}" fetchpriority="high">
      {{/if}}
    </div>
    {{#if product.media.gallery.length}}
    <div class="w-gallery__strip">
      <button type="button" class="w-round-btn" data-gallery-step="-1" aria-label="Previous image">‹</button>
      <div class="w-gallery__thumbs" data-gallery-thumbs>
        {{#each product.media.gallery}}
        <button type="button" class="w-thumb{{#if @first}} is-active{{/if}}" data-gallery-thumb="{{url}}" aria-label="Show image {{@index}}">
          {{!-- A video's thumbnail is its poster (else the platform turns the <img> into a playing video). --}}
          <img src="{{#if thumb_url}}{{thumb_url}}{{else}}{{#if is_video}}{{#if poster_url}}{{poster_url}}{{else}}{{url}}{{/if}}{{else}}{{url}}{{/if}}{{/if}}" alt="{{alt}}" loading="lazy">
        </button>
        {{/each}}
      </div>
      <button type="button" class="w-round-btn" data-gallery-step="1" aria-label="Next image">›</button>
    </div>
    {{/if}}
  </div>

  <div class="w-info">
    {{#if section.blocks.length}}
    {{#each section.blocks}}
      {{#if (eq this.type "award")}}
      <p class="w-award" {{{this.attributes}}}>🏆 {{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "rating")}}
      {{#if @root.product.reviews.summary.total_count}}
      <a class="w-rating" href="#reviews" {{{this.attributes}}}>
        <span class="w-stars" style="--r:{{@root.product.reviews.summary.average_rating}}" aria-hidden="true"></span>
        <strong>{{@root.product.reviews.summary.average_rating}}</strong>
        <span class="w-rating__sep">|</span>
        <span>{{@root.product.reviews.summary.total_count}} {{#if this.settings.label}}{{this.settings.label}}{{else}}reviews{{/if}}</span>
      </a>
      {{/if}}
      {{/if}}
      {{#if (eq this.type "title")}}
      <h1 class="w-info__title" {{{this.attributes}}}>{{@root.product.title}}</h1>
      {{/if}}
      {{#if (eq this.type "subtitle")}}
      <p class="w-subtitle" {{{this.attributes}}}>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "benefit")}}
      <p class="w-benefit" {{{this.attributes}}}><span class="w-check" aria-hidden="true">✓</span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "stock")}}
      <p class="w-stock" {{{this.attributes}}}><span class="w-stock__dot" aria-hidden="true"></span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "offer_heading")}}
      <p class="w-offer" {{{this.attributes}}}><span>{{this.settings.text}}</span></p>
      {{/if}}
      {{#if (eq this.type "price")}}
      <div {{{this.attributes}}}>{{> w-price}}</div>
      {{/if}}
      {{#if (eq this.type "variant_cards")}}
      {{> w-cards this}}
      {{/if}}
      {{#if (eq this.type "buy_buttons")}}
      <div class="w-buy" {{{this.attributes}}}>
        {{> w-options}}
        {{> w-buy-row label=this.settings.label mode=this.settings.mode show_qty=this.settings.show_qty}}
        {{#unless (eq this.settings.show_payments false)}}{{> w-pay}}{{/unless}}
      </div>
      {{/if}}
      {{#if (eq this.type "trust_icons")}}
      <ul class="w-trust" {{{this.attributes}}}>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" stroke="currentColor" stroke-width="1.6" fill="none"/></svg><span>{{this.settings.label_1}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="9" y="10.5" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M10.2 10.5V9.3a1.8 1.8 0 0 1 3.6 0v1.2" stroke="currentColor" stroke-width="1.4" fill="none"/></svg><span>{{this.settings.label_2}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/><circle cx="17" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/></svg><span>{{this.settings.label_3}}</span></li>
      </ul>
      {{/if}}
      {{#if (eq this.type "review")}}
      {{#each (limit @root.product.reviews.items 1)}}
      <figure class="w-quote" {{{../attributes}}}>
        {{#if image}}<img class="w-quote__img" src="{{image}}" alt="" loading="lazy">{{/if}}
        <figcaption>
          <span class="w-stars w-stars--sm" style="--r:{{rating}}" aria-label="{{rating}} out of 5"></span>
          <p class="w-quote__text">{{content}}</p>
          <p class="w-quote__who"><strong>{{name}}</strong>{{#if verified}} · <span class="w-verified">Verified buyer</span>{{/if}}</p>
        </figcaption>
      </figure>
      {{/each}}
      {{/if}}
      {{#if (eq this.type "accordion")}}
      <details class="w-acc" {{{this.attributes}}}{{#if this.settings.open}} open{{/if}}>
        <summary>{{this.settings.title}}</summary>
        <div class="w-acc__body w-rte">
          {{#if (eq this.settings.source "description")}}{{{@root.product.description_html}}}{{/if}}
          {{#if (eq this.settings.source "custom")}}{{{applyTokens this.settings.body}}}{{/if}}
        </div>
      </details>
      {{/if}}
      {{#if (eq this.type "text")}}
      <div class="w-rte w-block-text" {{{this.attributes}}}>{{{applyTokens this.settings.body}}}</div>
      {{/if}}
    {{/each}}
    {{else}}
    <h1 class="w-info__title">{{product.title}}</h1>
    {{> w-price}}
    <div class="w-buy">
      {{> w-options}}
      {{> w-buy-row}}
    </div>
    {{#if product.description_html}}<div class="w-rte w-block-text">{{{product.description_html}}}</div>{{/if}}
    {{/if}}
  </div>
</div>

{{!-- Sticky buy bar (mobile). theme.js shows it once the main button scrolls out of view. --}}
<div class="w-sticky" data-sticky hidden>
  <div class="w-sticky__info">
    <p class="w-sticky__title">{{product.title}}</p>
    <p class="w-sticky__price" data-sticky-price>{{product.price}}</p>
  </div>
  <button type="button" class="w-btn" data-testid="add-to-cart" data-add-to-cart data-sticky-btn>{{#if settings.atc_label}}{{settings.atc_label}}{{else}}Add to cart{{/if}}</button>
</div>
