{
  "name": "Product",
  "tag": "section",
  "limit": 1,
  "max_blocks": 40,
  "settings": [
    {
      "type": "paragraph",
      "content": "Gallery on the left; everything on the right is a block — reorder, hide or add them."
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Voted best travel gadget of the year"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label after the count",
          "default": "happy travelers",
          "info": "Real reviews only; hidden while the product has none."
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pack more and travel carry-on only"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit (check line)",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Frees up to 3x more space in any suitcase"
        }
      ]
    },
    {
      "type": "stock",
      "name": "Stock note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "In stock – ships within 24 hours",
          "info": "Keep it truthful: the theme does not read live stock."
        }
      ]
    },
    {
      "type": "offer_heading",
      "name": "Offer heading",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Holiday sale – up to 50% off"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_cards",
      "name": "Pack cards",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Cards show",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto: the product's variants (a Pack / Bundle / Set option if there is one, else the option below)"
            },
            {
              "value": "option",
              "label": "The option below"
            },
            {
              "value": "quantity",
              "label": "Quantity packs of the chosen variant (1 Pack, 2 Pack…)"
            }
          ],
          "info": "Variant cards show each option value as a card with that variant's real price. Quantity packs are priced with your live automatic discounts."
        },
        {
          "type": "number",
          "id": "option_index",
          "label": "Option shown as cards",
          "default": 0,
          "info": "0 = the product's first option (e.g. Color), 1 = the second… Used by Auto when the product has no Pack/Bundle option."
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Card style",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto: big cards for packs, compact tiles (price above) for other options"
            },
            {
              "value": "cards",
              "label": "Big cards with the price inside"
            },
            {
              "value": "tiles",
              "label": "Compact tiles, price shown above"
            }
          ]
        },
        {
          "type": "select",
          "id": "selected",
          "label": "Quantity pack selected by default",
          "default": "2",
          "options": [
            {
              "value": "1",
              "label": "Card 1"
            },
            {
              "value": "2",
              "label": "Card 2"
            },
            {
              "value": "3",
              "label": "Card 3"
            },
            {
              "value": "4",
              "label": "Card 4"
            },
            {
              "value": "5",
              "label": "Card 5"
            },
            {
              "value": "6",
              "label": "Card 6"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "currency_code",
          "label": "Show the currency code after prices (e.g. $57.95 AUD)",
          "default": true
        },
        {
          "type": "header",
          "content": "Card 1"
        },
        {
          "type": "number",
          "id": "card_1_qty",
          "label": "Quantity (quantity packs; 0 hides the card)",
          "default": 1
        },
        {
          "type": "text",
          "id": "card_1_title",
          "label": "Title (quantity packs)",
          "default": "1 Pack"
        },
        {
          "type": "image_picker",
          "id": "card_1_image",
          "label": "Image (quantity packs; empty = the chosen variant's photo)"
        },
        {
          "type": "text",
          "id": "card_1_sub",
          "label": "Subtitle",
          "default": ""
        },
        {
          "type": "text",
          "id": "card_1_badge",
          "label": "Badge",
          "default": ""
        },
        {
          "type": "richtext",
          "id": "card_1_includes",
          "label": "What's included (shown when selected)",
          "default": ""
        },
        {
          "type": "header",
          "content": "Card 2"
        },
        {
          "type": "number",
          "id": "card_2_qty",
          "label": "Quantity (quantity packs; 0 hides the card)",
          "default": 2
        },
        {
          "type": "text",
          "id": "card_2_title",
          "label": "Title (quantity packs)",
          "default": "2 Pack"
        },
        {
