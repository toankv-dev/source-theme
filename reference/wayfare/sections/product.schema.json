      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Add to cart"
        },
        {
          "type": "select",
          "id": "mode",
          "label": "After adding",
          "default": "cart",
          "options": [
            {
              "value": "cart",
              "label": "Open the cart"
            },
            {
              "value": "checkout",
              "label": "Go straight to checkout"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "show_qty",
          "label": "Show quantity selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_payments",
          "label": "Show accepted payments",
          "default": true
        }
      ]
    },
    {
      "type": "trust_icons",
      "name": "Trust icons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label_1",
          "label": "Heart icon",
          "default": "30-day risk-free trial"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Shield icon",
          "default": "Secure checkout"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Truck icon",
          "default": "Fast & free shipping"
        }
      ]
    },
    {
      "type": "review",
      "name": "Featured review",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the product's top real review."
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & delivery"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "default": "custom",
          "options": [
            {
              "value": "custom",
              "label": "Text below"
            },
            {
              "value": "description",
              "label": "Product description"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Text",
          "default": "<p>Orders ship within 1–3 business days. See our <a href=\"{{ShippingLink}}\">Shipping Policy</a>.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 4,
      "settings": [
        {
          "type": "richtext",
          "id": "body",
          "label": "Text",
          "default": "<p>Add a short note.</p>"
        }
      ]
    }
  ]
