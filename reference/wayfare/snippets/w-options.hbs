{{!-- Option pickers, one fieldset per option group (product.variants). theme.js maps the chosen labels to
      a variant through config.variants, and hides the group a Pack cards block already controls. --}}
{{#if @root.product.variants.length}}
<div class="w-options" data-options>
  {{#each @root.product.variants}}
  <fieldset class="w-opt" data-opt="{{@index}}">
    <legend class="w-opt__legend">{{name}}: <span data-opt-current>{{#each options}}{{#if active}}{{label}}{{/if}}{{/each}}</span></legend>
    {{#if (eq displayType "dropdown")}}
    <select class="w-select" data-opt-select aria-label="{{name}}">
      {{#each options}}<option value="{{label}}"{{#if active}} selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    {{else}}
    <div class="w-opt__values">
      {{#each options}}
      {{#if (eq ../displayType "swatches")}}
      <button type="button" class="w-swatch{{#if active}} is-active{{/if}}" data-opt-value="{{label}}" title="{{label}}" aria-label="{{label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" style="{{#if image}}background-image:url('{{image}}'){{else}}{{#if color}}background:{{color}}{{/if}}{{/if}}"></button>
      {{else}}
      <button type="button" class="w-pill{{#if active}} is-active{{/if}}" data-opt-value="{{label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
      {{/if}}
      {{/each}}
    </div>
    {{/if}}
  </fieldset>
  {{/each}}
</div>
{{/if}}
