{{!-- Single-item price; theme.js rewrites it when the variant changes. Reads @root so it works in a block. --}}
<div class="w-price" data-price-block>
  <span class="w-price__now" data-price>{{@root.product.price}}</span>
  {{#if @root.product.compare_at_price}}<s class="w-price__was" data-compare>{{@root.product.compare_at_price}}</s>{{/if}}
  {{#if @root.product.off_pct}}<span class="w-badge" data-off>Save {{@root.product.off_pct}}%</span>{{/if}}
</div>
