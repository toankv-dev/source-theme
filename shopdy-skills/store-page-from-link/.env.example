# Copy to .env (same folder, git-ignored) and fill in. Never paste these into chat, a ticket or a PR.
# The admin the browser signs in to. Production per .env.production.example; local dev: http://localhost:5173
SHOPDY_URL=https://app.adlux.io
SHOPDY_EMAIL=
SHOPDY_PASSWORD=
# 1 = no visible window. Leave 0 to watch the browser work.
SHOPDY_HEADLESS=0
