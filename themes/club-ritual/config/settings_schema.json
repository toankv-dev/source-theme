  {
    "name": "FAQ",
    "settings": [
      {
        "type": "paragraph",
        "content": "Default questions shown by every FAQ that has no questions of its own."
      },
      {
        "type": "text",
        "id": "faq_1_q",
        "label": "Question 1",
        "default": "How long does shipping take?"
      },
      {
        "type": "richtext",
        "id": "faq_1_a",
        "label": "Answer 1",
        "default": "<p>Orders are processed within 1–3 business days, then delivered in 5–10 business days. See our <a href=\"{{ShippingLink}}\">Shipping Policy</a>.</p>"
      },
      {
        "type": "text",
        "id": "faq_2_q",
        "label": "Question 2",
        "default": "How can I track my order?"
      },
      {
        "type": "richtext",
        "id": "faq_2_a",
        "label": "Answer 2",
        "default": "<p>As soon as your package ships we email you a tracking number. You can also check any time on the <a href=\"{{TrackOrderLink}}\">Track your order</a> page.</p>"
      },
      {
        "type": "text",
        "id": "faq_3_q",
        "label": "Question 3",
        "default": "Can I change or cancel my order?"
      },
      {
        "type": "richtext",
        "id": "faq_3_a",
        "label": "Answer 3",
        "default": "<p>Yes, within 12 hours of purchase. Email {{CompanyEmail}} with your order number.</p>"
      },
      {
        "type": "text",
        "id": "faq_4_q",
        "label": "Question 4",
        "default": "What is your return and refund policy?"
      },
      {
        "type": "richtext",
        "id": "faq_4_a",
        "label": "Answer 4",
        "default": "<p>You have 30 days from delivery to return an item. See our <a href=\"{{RefundLink}}\">Refund Policy</a>.</p>"
      },
      {
        "type": "text",
        "id": "faq_5_q",
        "label": "Question 5",
        "default": "My item arrived damaged or isn't what I ordered"
      },
      {
        "type": "richtext",
        "id": "faq_5_a",
        "label": "Answer 5",
        "default": "<p>We are sorry! <a href=\"{{ContactLink}}\">Contact us</a> with a photo and we will make it right.</p>"
      },
      {
        "type": "text",
        "id": "faq_6_q",
        "label": "Question 6",
        "default": "How can I reach customer support?"
      },
      {
        "type": "richtext",
        "id": "faq_6_a",
        "label": "Answer 6",
        "default": "<p>Email {{CompanyEmail}} — we reply within one business day.</p>"
      }
    ]
  },
