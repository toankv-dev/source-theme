{{!-- Club Ritual: radio circle + "£18.00 / Pair" pill (assets/js/cr.js fills it from the card price). One quantity-pack card (n = position 1–6). Hidden when its quantity is 0. --}}
{{#if qty}}
<div class="b-card{{#if (eq sel n)}} is-selected{{/if}}" role="radio" tabindex="0" data-qcard data-qty="{{qty}}" data-card-pos="{{n}}" aria-checked="{{#if (eq sel n)}}true{{else}}false{{/if}}">
  <span class="b-card__badge" data-card-badge hidden></span>
  <span class="b-card__row">
    <span class="cr-radio" aria-hidden="true"></span>
    <span class="b-card__img">{{#if img}}<img src="{{img}}" alt="" loading="lazy">{{else}}<img data-qcard-img alt="" hidden>{{/if}}{{#unless img}}<span class="b-card__qty" aria-hidden="true">×{{qty}}</span>{{/unless}}</span>
    <span class="b-card__text">
      <span class="cr-card__line"><span class="b-card__title">{{#if title}}{{title}}{{else}}{{qty}} Pack{{/if}}</span><span class="cr-unit" data-card-unit hidden></span></span>
      <span class="b-card__sub" data-card-sub></span>
      <span class="b-card__gift" data-card-gift hidden></span>
    </span>
    <span class="b-card__prices"><strong data-card-price></strong><s data-card-compare></s></span>
  </span>
  <div class="cr-units" data-unit-rows hidden></div>
  <div class="b-card__includes b-rte" data-card-includes hidden></div>
</div>
{{/if}}
