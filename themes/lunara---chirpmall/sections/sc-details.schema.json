        {
          "type": "range",
          "id": "t_size",
          "label": "Text: size on computers",
          "min": 0,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "t_size_m",
          "label": "Text: size on phones",
          "min": 0,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "color",
          "id": "t_color",
          "label": "Text: colour",
          "default": ""
