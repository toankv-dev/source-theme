          "id": "t_size",
          "label": "Line under the name: size on computers",
          "min": 0,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "t_size_m",
          "label": "Line under the name: size on phones",
          "min": 0,
          "max": 28,
          "step": 1,
