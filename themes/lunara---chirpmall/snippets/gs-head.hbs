<script>/*lu-cur*/window.LuCur=window.LuCur||(function(){var C={loc:0};function S(){var s=window.SFMoney;return s&&s.currency&&s.currency!=="USD"&&typeof s.convertUsd=="function"?s:null}function n(x){return typeof x=="number"?x:parseFloat(String(x==null?"":x).replace(/[^0-9.]/g,""))||0}function d(x){return"$"+(Math.round((Number(x)||0)*100)/100).toFixed(2)}C.on=function(){return!!S()};C.u=function(x){var s=S();x=n(x);return s?s.convertUsd(x):x};C.f=function(x){var s=S();return s?s.format(Number(x)||0):d(x)};C.fu=function(x){return C.f(C.u(x))};C.dn=function(x){var s=S();x=n(x);return s?Math.floor(x*(s.convertUsd(1e6)/1e6)*100+1e-6)/100:x};C.fx=function(x){return C.loc&&S()?C.dn(x):x};C.lbl=function(v){return S()?C.f(C.dn(v)):"$"+v};C.mk=function(e,x){if(!e)return;x==null||x===""?e.removeAttribute("data-price-usd"):e.setAttribute("data-price-usd",String(n(x)))};C.set=function(e,x,p){if(!e)return;p=p||"";if(x==null){e.textContent="";C.mk(e,null);return}e.textContent=p+C.fu(x)+p;C.mk(e,x)};C.h=function(x){return'<span data-price-usd="'+n(x)+'">'+C.fu(x)+"</span>"};C.cart=function(r){return S()?r.map(function(l){var o={},k;for(k in l)o[k]=l[k];o.price=C.u(l.price);o.compareAt=l.compareAt?C.u(l.compareAt):l.compareAt;o.bundlePrice=l.bundlePrice?C.u(l.bundlePrice):l.bundlePrice;return o}):r};window.addEventListener("sfmoney:change",function(){try{window.LuCartR&&window.LuCartR()}catch(e){}[].forEach.call(document.querySelectorAll("[data-lu-kaching]"),function(o){try{o.__luK&&o.__luK(o.__luA,o.__luP)}catch(e){}});[].forEach.call(document.querySelectorAll("[data-lu-cb-side]"),function(w){var s=w.querySelector("select");try{s&&s.dispatchEvent(new Event("change",{bubbles:true}))}catch(e){}})});return C})();</script>
