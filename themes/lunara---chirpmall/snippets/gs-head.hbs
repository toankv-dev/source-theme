<script>(function(){
/* "Complete the bundle" (SHOPDY-127): which units of each cart line an offer prices = the server's rule
   (shopdy-promax storefront/domain/companion-bundles.ts pairCompanionBundles). A line carries the offer key
   "<mainProductId>:<offerId>" (companionBundle) and its bundle unit price (bundlePrice). Per key, pairs = the smaller of
   the main product's units and the companion's; each side gives them out in cart order; the rest of a line is a normal
   line (catalog price, automatic discounts). units(lines) -> [bundle units per line]; gross(line, units) -> line price. */
function units(lines){var t={},side=[];(lines||[]).forEach(function(l,i){var k=l&&!l.gift&&l.companionBundle?String(l.companionBundle):"";if(!k){side[i]=null;return;}var r=String(l.productId||"").toLowerCase()===k.split(":")[0].toLowerCase()?"m":"c";side[i]={k:k,r:r};var x=t[k]||(t[k]={m:0,c:0});x[r]+=Math.max(0,parseInt(l.qty,10)||0);});
var left={};Object.keys(t).forEach(function(k){var p=Math.min(t[k].m,t[k].c);left[k]={m:p,c:p};});
return (lines||[]).map(function(l,i){var s=side[i];if(!s)return 0;var q=Math.max(0,parseInt(l.qty,10)||0),take=Math.min(q,left[s.k][s.r]);left[s.k][s.r]-=take;return take;});}
function gross(l,u){var q=Math.max(0,parseInt(l.qty,10)||0),b=Math.min(u||0,q);return (Number(l.price)||0)*(q-b)+(Number(l.bundlePrice)||0)*b;}
window.LuCB={units:units,gross:gross};
})();
</script>
<script>window.LuProt=function(p){var s=typeof p==="string"?p:p?(p.title||"")+" "+(p.handle||"")+" "+(p.url||""):"";return /(shipping|package|parcel|order|delivery)[\s_-]*(protect|insur)/i.test(s)};</script>
