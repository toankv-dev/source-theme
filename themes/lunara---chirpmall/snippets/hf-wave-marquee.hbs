{{!-- Wave + scrolling benefits strip under the home banner (clone of 2Tactic
      "waves" + "marquee" sections). Waves = 3 translucent layers of the wave
      colour + 1 solid layer of the strip colour, drawn over the banner bottom.
      Settings: Theme settings > Home page > "Wave strip" (hf_*). Empty colour =
      Primary colour. --}}
{{#unless (eq settings.hf_strip_show false)}}
<style>
  .hf-strip{--hf-w:{{#if settings.hf_wave_color}}{{settings.hf_wave_color}}{{else}}var(--lu-primary,#790236){{/if}};--hf-bg:{{#if settings.hf_strip_bg}}{{settings.hf_strip_bg}}{{else}}var(--lu-primary,#790236){{/if}};--hf-fg:{{#if settings.hf_strip_text}}{{settings.hf_strip_text}}{{else}}#FFFFFF{{/if}};--hf-speed:{{#if settings.hf_mq_duration}}{{settings.hf_mq_duration}}{{else}}40{{/if}}s}
  .hf-waves{position:relative;height:0}
  .hf-waves svg{position:absolute;left:0;bottom:-1px;width:100%;height:3vh;min-height:16px;max-height:90px;z-index:2;display:block;pointer-events:none}
  .hf-waves use{animation:hf-wave 25s cubic-bezier(.55,.5,.45,.5) infinite;fill:var(--hf-w)}
  .hf-waves use:nth-child(1){opacity:.8;animation-delay:-2s;animation-duration:6s}
  .hf-waves use:nth-child(2){opacity:.6;animation-delay:-3s;animation-duration:12s}
  .hf-waves use:nth-child(3){opacity:.4;animation-delay:-4s;animation-duration:18s}
  .hf-waves use:nth-child(4){fill:var(--hf-bg);animation-delay:-5s;animation-duration:24s}
  @keyframes hf-wave{0%{transform:translate3d(-90px,0,0)}100%{transform:translate3d(85px,0,0)}}
  .hf-marquee{background:var(--hf-bg);color:var(--hf-fg);overflow:hidden;padding:1rem 0;position:relative;z-index:1}
  .hf-marquee__track{display:flex;width:max-content;animation:hf-mq var(--hf-speed) linear infinite}
  .hf-marquee:hover .hf-marquee__track{animation-play-state:paused}
  .hf-marquee__group{display:flex;flex:0 0 auto;margin:0;padding:0;list-style:none}
  .hf-marquee__group li{flex:0 0 auto;padding:0 2rem;font-size:1.5rem;font-weight:600;line-height:1.2;text-transform:uppercase;white-space:nowrap;letter-spacing:.02em}
  @keyframes hf-mq{to{transform:translateX(-25%)}}
  @media (max-width:749px){.hf-waves svg{height:1.5vh;min-height:12px}.hf-marquee{padding:.8rem 0}.hf-marquee__group li{font-size:1.4rem;padding:0 1.6rem}}
  @media (prefers-reduced-motion:reduce){.hf-waves use,.hf-marquee__track{animation:none}}
</style>
<div class="hf-strip">
  {{#unless (eq settings.hf_wave_show false)}}<div class="hf-waves" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto"><defs><path id="hf-gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"/></defs><g><use xlink:href="#hf-gentle-wave" href="#hf-gentle-wave" x="48" y="0"/><use xlink:href="#hf-gentle-wave" href="#hf-gentle-wave" x="48" y="3"/><use xlink:href="#hf-gentle-wave" href="#hf-gentle-wave" x="48" y="5"/><use xlink:href="#hf-gentle-wave" href="#hf-gentle-wave" x="48" y="7"/></g></svg></div>{{/unless}}
  <div class="hf-marquee" aria-label="Benefits">
    <div class="hf-marquee__track">
      <ul class="hf-marquee__group">{{#if settings.hf_mq_1}}<li>{{settings.hf_mq_1}}</li>{{/if}}{{#if settings.hf_mq_2}}<li>{{settings.hf_mq_2}}</li>{{/if}}{{#if settings.hf_mq_3}}<li>{{settings.hf_mq_3}}</li>{{/if}}{{#if settings.hf_mq_4}}<li>{{settings.hf_mq_4}}</li>{{/if}}{{#if settings.hf_mq_5}}<li>{{settings.hf_mq_5}}</li>{{/if}}</ul><ul class="hf-marquee__group" aria-hidden="true">{{#if settings.hf_mq_1}}<li>{{settings.hf_mq_1}}</li>{{/if}}{{#if settings.hf_mq_2}}<li>{{settings.hf_mq_2}}</li>{{/if}}{{#if settings.hf_mq_3}}<li>{{settings.hf_mq_3}}</li>{{/if}}{{#if settings.hf_mq_4}}<li>{{settings.hf_mq_4}}</li>{{/if}}{{#if settings.hf_mq_5}}<li>{{settings.hf_mq_5}}</li>{{/if}}</ul><ul class="hf-marquee__group" aria-hidden="true">{{#if settings.hf_mq_1}}<li>{{settings.hf_mq_1}}</li>{{/if}}{{#if settings.hf_mq_2}}<li>{{settings.hf_mq_2}}</li>{{/if}}{{#if settings.hf_mq_3}}<li>{{settings.hf_mq_3}}</li>{{/if}}{{#if settings.hf_mq_4}}<li>{{settings.hf_mq_4}}</li>{{/if}}{{#if settings.hf_mq_5}}<li>{{settings.hf_mq_5}}</li>{{/if}}</ul><ul class="hf-marquee__group" aria-hidden="true">{{#if settings.hf_mq_1}}<li>{{settings.hf_mq_1}}</li>{{/if}}{{#if settings.hf_mq_2}}<li>{{settings.hf_mq_2}}</li>{{/if}}{{#if settings.hf_mq_3}}<li>{{settings.hf_mq_3}}</li>{{/if}}{{#if settings.hf_mq_4}}<li>{{settings.hf_mq_4}}</li>{{/if}}{{#if settings.hf_mq_5}}<li>{{settings.hf_mq_5}}</li>{{/if}}</ul>
    </div>
  </div>
</div>
{{/unless}}
