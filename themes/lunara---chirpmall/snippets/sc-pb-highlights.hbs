{{!-- Block "Highlights box" of the product section (Shapecurve look): Line 1-5, then every "Highlight line" block.
      Layout "check" (default, vesnacharm user 2026-11-19): one line per row, icon + text in the highlight colour.
      Layout "grid" (user 2026-11-26, their picture "Up to 150ml Protection | Discreet Fit"): two columns, thin lines above
      and below, dark grey text, line icons. Both: icon of every line (`icon`, default the round check) or a line's own
      icon (`icon_n`, "same" = the box's) or picture (`image_n`, wins); an emoji at the start of a line is dropped
      (inline script, runs while the page is parsed, so nothing flashes).
      Layout "box": the grey box where an emoji at the start of a line is its icon (no icons / pictures).
      More lines (user 2026-11-26, "a + line button"; the editor has no repeater and a block holds no blocks): block type
      `sc_hl_line` (text, icon, picture), added with the section's "Add block" (appended at the end). `hl_more` prints,
      inside this <ul>, every line block AFTER this box (@index of product.hbs's block loop) with its {{{attributes}}}, so
      the editor selects it on the <li> (first in the page; its own .lu-pb wrapper is an empty div = hidden by base.css).
      A line past a LATER Highlights box belongs to that box: for each such box between, the line is wrapped in a
      <template> (inert, never shown) — no "any" / counter helper in the engine. Needs the engine's `limit` + `gt`.
      Sizes and colours = CSS variables on the <ul>, printed only when set (0 / empty = sc-product.css fallbacks).
      No whitespace between tags on purpose: with no line the list is truly empty and sc-product.css hides it.
      Any look: outside the bodysuit look the block links sc-product.css itself (rules under .sc-any; user 2026-11-20). --}}
{{#*inline "hl_ck"}}<svg class="sc-hlbox__ic" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.3 11.4l3.1 3.1 6.3-6.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{/inline}}
{{#*inline "hl_ic"}}{{#if (eq ic "none")}}{{else if (eq ic "check")}}{{> hl_ck}}{{else if ic}}{{> sc-icon name=ic}}{{else}}{{> hl_ck}}{{/if}}{{/inline}}
{{#*inline "hl_li"}}{{#if tx}}<li{{#if attrs}} {{{attrs}}}{{/if}}>{{#if img}}<img class="sc-hlbox__ic" src="{{img}}" alt="" width="22" height="22" loading="lazy" decoding="async">{{else if (eq ico "same")}}{{> hl_ic ic=bic}}{{else if ico}}{{> hl_ic ic=ico}}{{else}}{{> hl_ic ic=bic}}{{/if}}<span>{{tx}}</span></li>{{/if}}{{/inline}}
{{#*inline "hl_more"}}{{#each @root.section.blocks}}{{#if (eq type "sc_hl_line")}}{{#if (gt @index @../index)}}{{#each (limit @root.section.blocks @index)}}{{#if (eq type "sc_highlights")}}{{#if (gt @index @../../index)}}<template>{{/if}}{{/if}}{{/each}}{{#if ../box}}{{#if settings.text}}<li {{{attributes}}}>{{settings.text}}</li>{{/if}}{{else}}{{> hl_li tx=settings.text ico=settings.icon img=settings.image bic=../settings.icon attrs=attributes}}{{/if}}{{#each (limit @root.section.blocks @index)}}{{#if (eq type "sc_highlights")}}{{#if (gt @index @../../index)}}</template>{{/if}}{{/if}}{{/each}}{{/if}}{{/if}}{{/each}}{{/inline}}
{{#unless (eq @root.section.settings.skin "shapecurve")}}<link rel="stylesheet" href="{{@root.assets_url}}/css/sc-product.css">{{/unless}}{{#if (eq settings.style "box")}}<ul class="sc-hlbox{{#if settings.bg}} sc-hlbox--bg{{/if}}" style="{{#if settings.text_color}}--hl-tx:{{settings.text_color}};{{/if}}{{#if settings.text_size}}--hl-fs:{{settings.text_size}}px;{{/if}}{{#if settings.text_size_m}}--hl-fsm:{{settings.text_size_m}}px;{{/if}}{{#if settings.bg}}--hl-bg:{{settings.bg}};{{/if}}">{{#if settings.line_1}}<li>{{settings.line_1}}</li>{{/if}}{{#if settings.line_2}}<li>{{settings.line_2}}</li>{{/if}}{{#if settings.line_3}}<li>{{settings.line_3}}</li>{{/if}}{{#if settings.line_4}}<li>{{settings.line_4}}</li>{{/if}}{{#if settings.line_5}}<li>{{settings.line_5}}</li>{{/if}}{{> hl_more box=1}}</ul>{{else}}<ul class="sc-hlbox {{#if (eq settings.style "grid")}}sc-hlbox--grid{{#if settings.no_lines}} sc-hlbox--nolines{{/if}}{{#if (eq settings.mobile_cols "1")}} sc-hlbox--m1{{/if}}{{else}}sc-hlbox--check{{/if}}{{#if settings.bg}} sc-hlbox--bg{{/if}}" style="{{#if settings.text_color}}--hl-tx:{{settings.text_color}};{{/if}}{{#if settings.text_size}}--hl-fs:{{settings.text_size}}px;{{/if}}{{#if settings.text_size_m}}--hl-fsm:{{settings.text_size_m}}px;{{/if}}{{#if settings.icon_color}}--hl-ic:{{settings.icon_color}};{{/if}}{{#if settings.icon_size}}--hl-is:{{settings.icon_size}}px;{{/if}}{{#if settings.bg}}--hl-bg:{{settings.bg}};{{/if}}{{#if settings.line_color}}--hl-ln:{{settings.line_color}};{{/if}}">{{> hl_li tx=settings.line_1 ico=settings.icon_1 img=settings.image_1 bic=settings.icon}}{{> hl_li tx=settings.line_2 ico=settings.icon_2 img=settings.image_2 bic=settings.icon}}{{> hl_li tx=settings.line_3 ico=settings.icon_3 img=settings.image_3 bic=settings.icon}}{{> hl_li tx=settings.line_4 ico=settings.icon_4 img=settings.image_4 bic=settings.icon}}{{> hl_li tx=settings.line_5 ico=settings.icon_5 img=settings.image_5 bic=settings.icon}}{{> hl_more}}</ul><script>(function(u){try{var re=new RegExp('^\\s*[\\p{Extended_Pictographic}\\u200D\\uFE0F]+\\s*','u');[].forEach.call(u.querySelectorAll('li > span'),function(s){s.textContent=s.textContent.replace(re,'');});}catch(e){}})(document.currentScript.previousElementSibling);</script>{{/if}}
