{{!-- Block "Info rows (accordion)" of the product section (Shapecurve look): grey rows that open on tap (<details>, no
      script). Rich text goes through applyTokens ({{CompanyEmail}} …). The size chart row keeps its table as text in
      data-sc-chart (lines, cells split by |); assets/js/sc-product.js turns it into a <table>.
      Any look: outside the bodysuit look the block links sc-product.css + sc-product.js itself (rules under .sc-any; the
      script only builds the size chart there; user 2026-11-20). --}}
{{#unless (eq @root.section.settings.skin "shapecurve")}}<link rel="stylesheet" href="{{@root.assets_url}}/css/sc-product.css"><script src="{{@root.assets_url}}/js/sc-product.js" defer></script>{{/unless}}<div class="sc-tabs">{{#if settings.tab_1_title}}<details class="sc-tab"><summary>{{settings.tab_1_title}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body">{{{applyTokens settings.tab_1_body}}}</div></details>{{/if}}{{#if settings.tab_2_title}}<details class="sc-tab"><summary>{{settings.tab_2_title}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body">{{{applyTokens settings.tab_2_body}}}</div></details>{{/if}}{{#if settings.tab_3_title}}<details class="sc-tab"><summary>{{settings.tab_3_title}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body">{{{applyTokens settings.tab_3_body}}}</div></details>{{/if}}{{#if settings.chart}}<details class="sc-tab"><summary>{{#if settings.chart_title}}{{settings.chart_title}}{{else}}Size Chart{{/if}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body"><div class="sc-chart" data-sc-chart="{{settings.chart}}"></div>{{#if settings.chart_note}}<p class="sc-chart__note">{{settings.chart_note}}</p>{{/if}}</div></details>{{/if}}</div>
