{
  "name": "Product",
  "tag": "div",
  "limit": 1,
  "max_blocks": 25,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating (real reviews)",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating label",
      "default": "Excellent",
      "info": "Shown before the average, e.g. Excellent 4.8 | 1368 reviews."
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust line under Add to cart",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "60 Day Fit Guarantee"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "Easy Returns & Exchanges"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "",
      "info": "Optional third item (empty = hidden)."
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "Show variant pickers when there is no Kaching bundle",
      "default": true,
      "info": "With a Kaching bundle block every item gets its own Color / Size pickers inside the selected pack."
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Variant picker style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Lunara pills"
        },
        {
          "value": "walmart",
          "label": "Tiles (Walmart)"
        },
        {
          "value": "shapermint",
          "label": "Size buttons (Shapermint)"
        }
      ],
      "info": "Look of the Color / Size choices. The templates 'Variant tiles (Walmart)' and 'Size buttons (Shapermint)' set this for you."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },
    {
      "type": "header",
      "content": "Size finder"
    },
    {
      "type": "checkbox",
      "id": "show_size_finder",
      "label": "Show \"Find my size\"",
      "default": true,
      "info": "Appears only when the product has a size it can recognise: bra (34B, Band + Cup), pants W29 / L28, or letter sizes XS-5XL (with Petite / Regular / Tall inseam)."
    },
    {
      "type": "select",
      "id": "sf_mode",
      "label": "Size finder type",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (from the product options)"
        },
        {
          "value": "bra",
          "label": "Bra (Band + Cup)"
        },
        {
          "value": "bottoms",
          "label": "Pants / bottoms (waist, hips, W-L)"
        },
        {
          "value": "tops",
          "label": "Tops / dresses (bust, waist, hips)"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ]
    },
    {
      "type": "select",
      "id": "sf_popup",
      "label": "Popup content",
      "default": "finder",
      "options": [
        {
          "value": "finder",
          "label": "Size finder (questions + recommended size)"
        },
        {
          "value": "image",
          "label": "Size chart image only"
        },
        {
          "value": "both",
          "label": "Size chart image + size finder"
        }
      ],
      "info": "Image only: the link shows on every product with sizes and the popup just shows the image below."
    },
    {
      "type": "image_picker",
      "id": "sf_chart_image",
      "label": "Size chart image",
      "default": ""
    },
    {
      "type": "text",
      "id": "sf_option_name",
      "label": "Preferred size option name",
      "default": "Size",
      "info": "Used first when a product has several letter-size options. Other names (Sizes, Waist, Length, Inseam, Band, Cup...) are recognised automatically."
    },
    {
      "type": "text",
      "id": "sf_link_label",
      "label": "Link text",
      "default": "Size guide"
    },
    {
      "type": "text",
      "id": "sf_title",
      "label": "Popup title",
      "default": "Find your perfect size"
    },
    {
      "type": "text",
      "id": "sf_band_label",
      "label": "Band question",
      "default": "What is your closest Band Size?"
    },
    {
      "type": "text",
      "id": "sf_cup_label",
      "label": "Cup question",
      "default": "What is your closest Cup Size?"
    },
    {
      "type": "text",
      "id": "sf_bands",
      "label": "Band sizes",
      "default": "30, 32, 34, 36, 38, 40, 42, 44, 46, 48",
      "info": "Comma separated."
    },
    {
      "type": "text",
      "id": "sf_cups",
      "label": "Cup sizes",
      "default": "A, B, C, D, DD/E, DDD/F, G, H/I",
      "info": "Comma separated, same order as the columns of the chart."
    },
    {
      "type": "textarea",
      "id": "sf_map",
      "label": "Bra chart for letter sizes (band: size per cup)",
      "default": "30: S, S, S, S, M, M, L, L\n32: S, S, S, M, M, L, L, XL\n34: S, M, M, M, L, L, XL, XL\n36: M, M, L, L, L, XL, XL, XXL\n38: L, L, L, XL, XL, XL, XXL, XXL\n40: XL, XL, XL, XL, XXL, XXL, XXL, XXL\n42: XL, XXL, XXL, XXL, XXL, XXL, XXL, XXL\n44: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL\n46: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL\n48: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL",
      "info": "One line per band: 34: S, M, M, M, L, L, XL, XL - one size per cup, in the cup order above. Sizes must match the product's size values (XXL = 2XL)."
    },
    {
      "type": "textarea",
      "id": "sf_letter_map",
      "label": "Letter size chart (size: bust, waist, hips)",
      "default": "XXS: 31, 24, 34\nXS: 33, 26, 36\nS: 35, 28, 38\nM: 37, 30, 40\nL: 40, 33, 43\nXL: 43, 36, 46\n2XL: 46, 39, 49\n3XL: 49, 42, 52\n4XL: 52, 45, 55\n5XL: 55, 48, 58",
      "info": "Maximum body measurement in inches for each size, US standard. One size per line, e.g. M: 37, 30, 40."
    },
    {
      "type": "header",
      "content": "Template look"
    },
    {
      "type": "select",
      "id": "skin",
      "label": "Look of this product section",
      "default": "lunara",
      "options": [
        {
          "value": "lunara",
          "label": "Lunara (default)"
        },
        {
          "value": "shapecurve",
          "label": "Shapecurve (picture colour tiles, size pills, soft cards)"
        }
      ],
      "info": "Shapecurve loads assets/css/sc-product.css and assets/js/sc-product.js for this section only."
    },
    {
      "type": "color",
      "id": "skin_highlight",
      "label": "Shapecurve: highlight colour",
      "default": "#790236",
      "info": "Radio, selected pack frame, badges, Find My Size, tinted backgrounds."
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Second button (straight to checkout)",
      "default": "",
      "info": "e.g. Express checkout now. Empty = no second button. Adds the same items as Add to cart, then opens the checkout."
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": []
