{{!-- Feature cards (sections/sc-features.schema.json) — Shapecurve template. White cards on a tinted band: a square picture
      (animated GIF / WebP plays) on one side, tag + heading + rich text on the other; cards alternate sides on desktop and
      stack on phones. Picture = picked file, else the theme file in default_image, else an empty frame (hint in the editor
      only; a <span>, because base.css hides empty <div>s). Tag gradient = tints of the highlight colour. Own <style>. --}}
<style>
  .scf{letter-spacing:normal;--sc-hl:#790236;--sc-grad:linear-gradient(120deg,#f6edf1 0,#e4ccd7 20%,#efdde5 80%,#f2e6eb 100%);background:var(--scf-bg,#f6edf1);color:#333}
  @supports (background:color-mix(in srgb,red 50%,#fff)){.scf{--sc-grad:linear-gradient(120deg,color-mix(in srgb,var(--sc-hl) 7%,#fff) 0,color-mix(in srgb,var(--sc-hl) 20%,#fff) 20%,color-mix(in srgb,var(--sc-hl) 13%,#fff) 80%,color-mix(in srgb,var(--sc-hl) 10%,#fff) 100%)}}
  .scf__list{display:flex;flex-direction:column;gap:20px;max-width:1200px;margin:0 auto;padding:0 15px;box-sizing:border-box}
  .scf__card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:30px;align-items:center;padding:15px;border-radius:20px;background:rgba(255,255,255,.8);box-shadow:2px 2px 10px rgba(0,0,0,.25)}
  .scf__card:nth-child(even) .scf__media{order:2}
  .scf__media{position:relative;aspect-ratio:1/1;overflow:hidden;border-radius:15px;background:#e9e9e9}
  .scf__img,.scf__ph{position:absolute;top:0;left:0;width:100%!important;height:100%!important;max-width:none!important;margin:0;display:block;object-fit:cover}
  .scf__ph{display:flex;align-items:center;justify-content:center;padding:16px;box-sizing:border-box;font-size:14px;color:#666;text-align:center}
  .scf__text{padding:0 40px}
  .scf .sc-tag{display:inline-block;margin:0 0 12px;padding:5px 10px;border-radius:5px;background:var(--sc-grad);font-size:14px;line-height:21px;font-weight:700;letter-spacing:.28px;color:#333}
  .scf__h{margin:0 0 20px;font-size:30px;line-height:45px;font-weight:700;letter-spacing:.6px;color:#333}
  .scf__body{font-size:16px;line-height:24px;color:#333}
  .scf__body p{margin:0 0 12px}
  .scf__body p:last-child{margin-bottom:0}
  .scf__body strong{font-weight:700}
  @media (max-width:749px){
    .scf__list{gap:30px}
    .scf__card{grid-template-columns:minmax(0,1fr);gap:0;padding:12px}
    .scf__card:nth-child(even) .scf__media{order:0}
    .scf__text{padding:30px 10px 22px}
    .scf .sc-tag{font-size:12px;line-height:22px;letter-spacing:.24px}
    .scf__h{margin-bottom:16px;font-size:22px;line-height:28px;letter-spacing:.44px}
    .scf__body{font-size:14px;line-height:21px}
  }
</style>
<div class="scf" style="--scf-bg:{{#if section.settings.bg}}{{section.settings.bg}}{{else}}#F6EDF1{{/if}};--sc-hl:{{#if section.settings.highlight}}{{section.settings.highlight}}{{else}}#790236{{/if}};padding-top:{{#if section}}{{section.settings.pad_top}}{{else}}50{{/if}}px;padding-bottom:{{#if section}}{{section.settings.pad_bottom}}{{else}}10{{/if}}px">
  <div class="scf__list">
    {{#each section.blocks}}
    <div class="scf__card" {{{this.attributes}}}>
      <div class="scf__media">{{#if this.settings.image}}<img class="scf__img" src="{{this.settings.image}}" alt="{{this.settings.heading}}" width="555" height="555" loading="lazy">{{else if this.settings.default_image}}<img class="scf__img" src="{{@root.assets_url}}/{{this.settings.default_image}}" alt="{{this.settings.heading}}" width="555" height="555" loading="lazy">{{else}}<span class="scf__ph">{{#if @root.__designMode}}Pick a square picture or GIF{{/if}}</span>{{/if}}</div>
      <div class="scf__text">{{#if this.settings.tag}}<p class="sc-tag">{{this.settings.tag}}</p>{{/if}}{{#if this.settings.heading}}<h3 class="scf__h">{{this.settings.heading}}</h3>{{/if}}{{#if this.settings.body}}<div class="scf__body">{{{applyTokens this.settings.body}}}</div>{{/if}}</div>
    </div>
    {{/each}}
  </div>
</div>
