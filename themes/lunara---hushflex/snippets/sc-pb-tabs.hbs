{{!-- Block "Info rows (accordion)" of the product section (Shapecurve look): grey rows that open on tap (<details>, no
      script). Rich text goes through applyTokens ({{CompanyEmail}} …). The size chart row keeps its table as text in
      data-sc-chart (lines, cells split by |); assets/js/sc-product.js turns it into a <table>. --}}
<div class="sc-tabs">{{#if settings.tab_1_title}}<details class="sc-tab"><summary>{{settings.tab_1_title}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body">{{{applyTokens settings.tab_1_body}}}</div></details>{{/if}}{{#if settings.tab_2_title}}<details class="sc-tab"><summary>{{settings.tab_2_title}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body">{{{applyTokens settings.tab_2_body}}}</div></details>{{/if}}{{#if settings.tab_3_title}}<details class="sc-tab"><summary>{{settings.tab_3_title}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body">{{{applyTokens settings.tab_3_body}}}</div></details>{{/if}}{{#if settings.chart}}<details class="sc-tab"><summary>{{#if settings.chart_title}}{{settings.chart_title}}{{else}}Size Chart{{/if}}{{> sc-icon name="chev"}}</summary><div class="sc-tab__body"><div class="sc-chart" data-sc-chart="{{settings.chart}}"></div>{{#if settings.chart_note}}<p class="sc-chart__note">{{settings.chart_note}}</p>{{/if}}</div></details>{{/if}}</div>
