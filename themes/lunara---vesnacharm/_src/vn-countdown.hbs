{{#if (eq settings.topbar_style "countdown")}}<div id="lunara-topbar" class="shopify-section-group-header-group lt-cd vn-cd" role="region" aria-label="Announcement"><style>#lunara-topbar.vn-cd{--cd-bg:{{#if settings.vn_cd_bg}}{{settings.vn_cd_bg}}{{else}}{{#if settings.topbar_bg}}{{settings.topbar_bg}}{{else}}var(--vn-hl,#790236){{/if}}{{/if}};--cd-ac:{{#if settings.vn_cd_accent}}{{settings.vn_cd_accent}}{{else}}#f58634{{/if}};--cd-fg:{{#if settings.topbar_color}}{{settings.topbar_color}}{{else}}#fff{{/if}};box-sizing:border-box;width:100%;margin:0;background:var(--cd-bg);border-bottom:2px solid var(--cd-ac);color:var(--cd-fg);font-family:var(--font-body-family,inherit);line-height:1.2}#lunara-topbar .cd-bar{display:flex;align-items:center;justify-content:center;gap:6px 16px;max-width:1400px;min-height:45px;margin:0 auto;padding:4px 20px;box-sizing:border-box;color:inherit;text-decoration:none;text-align:center}#lunara-topbar .cd-head{margin:0;min-width:0;font-weight:700;text-transform:uppercase;text-wrap:balance}#lunara-topbar .cd-title{color:var(--cd-ac);font-size:17px;letter-spacing:.12em}#lunara-topbar .cd-sub{font-size:14px;letter-spacing:.04em}#lunara-topbar .cd-dot{display:inline-block;flex:0 0 auto;width:5px;height:5px;margin:0 14px;border-radius:50%;background:currentColor;opacity:.45;vertical-align:middle}#lunara-topbar .cd-bar>.cd-dot,#lunara-topbar .cd-tail>.cd-dot{margin:0}#lunara-topbar .cd-tail{display:flex;flex:0 0 auto;align-items:center;justify-content:center;flex-wrap:wrap;gap:6px 16px}#lunara-topbar .lt-cdn{display:flex;align-items:flex-start;gap:4px;color:var(--cd-ac);white-space:nowrap}#lunara-topbar .lt-item{display:flex;flex-direction:column;align-items:center;min-width:30px}#lunara-topbar .lt-item[hidden],#lunara-topbar .lt-sep[hidden]{display:none}#lunara-topbar .lt-time{font-size:20px;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}#lunara-topbar .lt-lbl{margin-top:3px;font-size:9px;line-height:1;font-weight:600;letter-spacing:.08em;text-transform:uppercase}#lunara-topbar .lt-sep{font-size:18px;line-height:1;font-weight:700}#lunara-topbar .cd-cta{font-size:14px;font-weight:700;white-space:nowrap}#lunara-topbar .cd-cta u{text-decoration:underline;text-underline-offset:3px}#lunara-topbar .cd-cta svg{margin-left:8px;vertical-align:-1px}#lunara-topbar a.cd-bar:hover .cd-cta u,#lunara-topbar a.cd-bar:focus-visible .cd-cta u{text-decoration-thickness:2px}@media screen and (max-width:989px){#lunara-topbar .cd-bar{flex-direction:column;gap:6px;padding:7px 16px 8px}#lunara-topbar .cd-bar>.cd-dot{display:none}}@media screen and (max-width:749px){#lunara-topbar .cd-bar{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:1fr auto auto auto 1fr;gap:0 8px;min-height:46px;padding:5px 12px;text-align:left}#lunara-topbar .cd-head,#lunara-topbar .cd-tail{display:contents}#lunara-topbar .cd-dot{display:none}#lunara-topbar .cd-title{grid-column:1;grid-row:2;font-size:13px;line-height:1.25;letter-spacing:.02em;text-wrap:balance}#lunara-topbar .cd-sub{grid-column:1;grid-row:3;margin-top:2px;font-size:12px;line-height:1.3;letter-spacing:.02em}#lunara-topbar .cd-cta{grid-column:1;grid-row:4;margin-top:2px;font-size:12px;line-height:1.3;font-weight:600;white-space:normal}#lunara-topbar .cd-cta u{text-decoration:none}#lunara-topbar .cd-cta svg{display:none}#lunara-topbar .lt-cdn{grid-column:2;grid-row:1/6;align-self:center;gap:1px}#lunara-topbar .lt-item{min-width:28px}#lunara-topbar .lt-time{font-size:17px}#lunara-topbar .lt-lbl{margin-top:2px;font-size:12px;letter-spacing:0;font-weight:500}#lunara-topbar .lt-sep{font-size:15px}}</style>
{{#if settings.vn_cd_link}}<a class="cd-bar" href="{{settings.vn_cd_link}}">{{else}}{{#if settings.vn_cd_link_text}}<a class="cd-bar" href="{{config.homeUrl}}#collection/all">{{else}}<div class="cd-bar">{{/if}}{{/if}}<p class="cd-head"><span class="cd-title">{{#if settings.countdown_title}}{{settings.countdown_title}}{{else}}🍁 FALL SALE{{/if}}</span>{{#if settings.countdown_subtitle}}<span class="cd-dot" aria-hidden="true"></span><span class="cd-sub">{{settings.countdown_subtitle}}</span>{{/if}}</p><span class="cd-dot" aria-hidden="true"></span><span class="cd-tail"><span class="lt-cdn" role="timer" aria-label="Sale ends in" data-lt-days="{{settings.vn_cd_days}}" data-lt-hours="{{settings.countdown_hours}}" data-lt-end="{{settings.vn_cd_end}}"><span class="lt-item" data-lt-dbox hidden><span class="lt-time" data-lt-d>00</span><span class="lt-lbl">Days</span></span><span class="lt-sep" aria-hidden="true" data-lt-dbox hidden>:</span><span class="lt-item"><span class="lt-time" data-lt-h>00</span><span class="lt-lbl">Hrs</span></span><span class="lt-sep" aria-hidden="true">:</span><span class="lt-item"><span class="lt-time" data-lt-m>00</span><span class="lt-lbl">Mins</span></span><span class="lt-sep" aria-hidden="true">:</span><span class="lt-item"><span class="lt-time" data-lt-s>00</span><span class="lt-lbl">Secs</span></span></span>{{#if settings.vn_cd_link_text}}<span class="cd-dot" aria-hidden="true"></span><span class="cd-cta"><u>{{settings.vn_cd_link_text}}</u><svg width="12" height="10" viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 5h10M7 1l4 4-4 4"/></svg></span>{{/if}}</span>{{#if settings.vn_cd_link}}</a>{{else}}{{#if settings.vn_cd_link_text}}</a>{{else}}</div>{{/if}}{{/if}}
<script>(function(){var bar=document.getElementById("lunara-topbar");if(!bar||bar.__lu)return;bar.__lu=1;var t=bar.querySelector(".lt-cdn");if(!t)return;function q(k){return t.querySelector("[data-lt-"+k+"]");}var D=q("d"),h=q("h"),m=q("m"),s=q("s");
/* length per visitor = days + hours (restarts at zero); a fixed end ("2026-11-30 23:59", the visitor's own time) wins until it passes */
var days=Math.max(0,parseFloat(t.getAttribute("data-lt-days"))||0),hv=t.getAttribute("data-lt-hours"),hrs=hv===""?(days?0:2):Math.max(0,parseFloat(hv)||0),DUR=(days*24+hrs)*3.6e6||7.2e6,KEY="lunara_sale_end",mem=0;
function fixed(){var v=(t.getAttribute("data-lt-end")||"").trim(),a=v.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{2}))?$/);if(!v)return 0;if(a)return(a[4]?new Date(+a[1],a[2]-1,+a[3],+a[4],+a[5]):new Date(+a[1],a[2]-1,+a[3],23,59,59)).getTime();return Date.parse(v)||0;}
function getEnd(){var f=fixed();if(f>Date.now())return f;var e=0;try{e=parseInt(localStorage.getItem(KEY),10)||0;}catch(x){e=mem;}if(!e||e<=Date.now()||e-Date.now()>DUR){e=Date.now()+DUR;mem=e;try{localStorage.setItem(KEY,e);}catch(x){}}return e;}
var end=getEnd(),showD=false;
/* the DAYS box appears once a whole day is left and then stays (no jump when it reaches 00) */
function p(n){return(n<10?"0":"")+n;}function tick(){var d=end-Date.now();if(d<=0){end=getEnd();d=end-Date.now();}if(!showD&&D&&d>=864e5){showD=true;Array.prototype.forEach.call(t.querySelectorAll("[data-lt-dbox]"),function(b){b.hidden=false;});}var H=Math.floor(d/3.6e6);if(showD){D.textContent=p(Math.floor(H/24));H%=24;}h.textContent=p(H);m.textContent=p(Math.floor((d%3.6e6)/6e4));s.textContent=p(Math.floor((d%6e4)/1000));}tick();setInterval(tick,1000);})();</script></div>
