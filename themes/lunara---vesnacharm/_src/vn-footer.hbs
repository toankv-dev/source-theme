{{!-- Inner part of footer#lu-ft, written into sections/footer.hbs by _work/patch-vn.js (layout of shape-curve.com's footer:
      logo + email, Shop By, Information, Customer Service, Stay In The Know; bottom bar with © and payment icons).
      Links come from the platform (collections, policyLinks, config.trackUrl); texts from Theme settings > Footer. --}}
<div class="ft-shell vn-ft"><div class="page-width vn-ft__in"><div class="vn-ft__main">
<div class="vn-ft__brand">
<a class="vn-ft__logo" href="{{config.homeUrl}}">{{#if settings.vn_footer_logo}}<img src="{{settings.vn_footer_logo}}" alt="{{brand.name}}" width="230" height="60" loading="lazy" decoding="async">{{else}}<span class="vn-ft__name">{{brand.name}}</span>{{/if}}</a>
{{#if settings.vn_ft_tagline}}<p class="vn-ft__tag">{{settings.vn_ft_tagline}}</p>{{/if}}
{{#if brand.email}}<p class="vn-ft__mail"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v.4l-10 6.3L2 5.9zm0 2.7 9.47 5.96a1 1 0 0 0 1.06 0L22 8.2v10.3a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5z"/></svg><a href="mailto:{{brand.email}}">{{brand.email}}</a></p>{{/if}}
</div>
<nav class="vn-ft__col" aria-label="{{#if settings.vn_ft_shop}}{{settings.vn_ft_shop}}{{else}}Shop By{{/if}}"><h2 class="vn-ft__h"><button type="button" class="vn-ft__tg">{{#if settings.vn_ft_shop}}{{settings.vn_ft_shop}}{{else}}Shop By{{/if}}<svg class="vn-ft__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></h2><ul class="vn-ft__list">{{#if @root.collections.length}}{{#each @root.collections}}<li><a href="{{@root.config.homeUrl}}#collection/{{handle}}">{{title}}</a></li>{{/each}}{{else}}<li><a href="{{config.homeUrl}}#collection/all">Shop All</a></li>{{/if}}</ul></nav>
<nav class="vn-ft__col" aria-label="{{#if settings.vn_ft_info}}{{settings.vn_ft_info}}{{else}}Information{{/if}}"><h2 class="vn-ft__h"><button type="button" class="vn-ft__tg">{{#if settings.vn_ft_info}}{{settings.vn_ft_info}}{{else}}Information{{/if}}<svg class="vn-ft__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></h2><ul class="vn-ft__list">{{#if policies.about}}<li><a href="{{policyLinks.about}}">About Us</a></li>{{/if}}{{#if policies.terms}}<li><a href="{{policyLinks.terms}}">Terms Of Service</a></li>{{/if}}{{#if policies.privacy}}<li><a href="{{policyLinks.privacy}}">Privacy Policy</a></li>{{/if}}</ul></nav>
<nav class="vn-ft__col" aria-label="{{#if settings.vn_ft_service}}{{settings.vn_ft_service}}{{else}}Customer Service{{/if}}"><h2 class="vn-ft__h"><button type="button" class="vn-ft__tg">{{#if settings.vn_ft_service}}{{settings.vn_ft_service}}{{else}}Customer Service{{/if}}<svg class="vn-ft__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></h2><ul class="vn-ft__list"><li><a href="{{#if policyLinks.contact}}{{policyLinks.contact}}{{else}}/contact{{/if}}">Contact Us</a></li>{{#if policies.shipping}}<li><a href="{{policyLinks.shipping}}">Shipping Policy</a></li>{{/if}}{{#if policies.refund}}<li><a href="{{policyLinks.refund}}">Return &amp; Refunds</a></li>{{/if}}<li><a href="{{#if config.trackUrl}}{{config.trackUrl}}{{else}}/pages/track-your-order{{/if}}">Track Order</a></li></ul></nav>
<div class="vn-ft__col vn-ft__news"><h2 class="vn-ft__h">{{#if settings.vn_ft_news_title}}{{settings.vn_ft_news_title}}{{else}}Stay In The Know{{/if}}</h2>{{#if settings.vn_ft_news_text}}<p class="vn-ft__p">{{settings.vn_ft_news_text}}</p>{{/if}}<div class="vn-ft__form"><label for="lu-newsletter-email" class="srOnly">Email</label><input id="lu-newsletter-email" type="email" required placeholder="{{#if settings.vn_ft_news_placeholder}}{{settings.vn_ft_news_placeholder}}{{else}}Enter your email{{/if}}" aria-label="Email" aria-invalid="false" autocomplete="email" class="vn-ft__email" value=""><button class="vn-ft__btn" type="button" data-lu-newsletter>{{#if settings.vn_ft_news_button}}{{settings.vn_ft_news_button}}{{else}}SUBMIT{{/if}}</button></div></div>
</div></div>
<script>(function(){var r=document.currentScript.parentNode,mq=window.matchMedia("(max-width:749px)");function sync(){var on=mq.matches;r.classList.toggle("vn-ft--acc",on);r.querySelectorAll(".vn-ft__tg").forEach(function(b){if(on){b.setAttribute("aria-expanded",b.closest(".vn-ft__col").classList.contains("is-open")?"true":"false");b.removeAttribute("tabindex")}else{b.removeAttribute("aria-expanded");b.setAttribute("tabindex","-1")}})}r.addEventListener("click",function(e){var b=e.target.closest&&e.target.closest(".vn-ft__tg");if(!b||!mq.matches)return;var c=b.closest(".vn-ft__col"),o=c.classList.toggle("is-open");b.setAttribute("aria-expanded",o?"true":"false")});sync();mq.addEventListener?mq.addEventListener("change",sync):mq.addListener(sync)})();</script>
<div class="vn-ft__bottom"><div class="page-width vn-ft__bin"><p class="vn-ft__copy">&copy; <span data-ms-year>2026</span> <a href="{{config.homeUrl}}">{{brand.name}}</a>.{{#if settings.legal_company_name}} Operated by {{settings.legal_company_name}}.{{else}} All Rights Reserved.{{/if}}</p><div class="ft-pay vn-ft__pay" role="list" aria-label="Accepted payment methods"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/visa.svg" alt="Visa" loading="lazy" decoding="async" width="41" height="26"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/master.svg" alt="Mastercard" loading="lazy" decoding="async" width="41" height="26"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/amex.svg" alt="American Express" loading="lazy" decoding="async" width="41" height="26"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/apple_pay.svg" alt="Apple Pay" loading="lazy" decoding="async" width="41" height="26"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/discover.svg" alt="Discover" loading="lazy" decoding="async" width="41" height="26"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/paypal.svg" alt="PayPal" loading="lazy" decoding="async" width="41" height="26"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/google_pay.svg" alt="Google Pay" loading="lazy" decoding="async" width="41" height="26"><img class="ft-pay-icon" role="listitem" src="{{assets_url}}/images/pay/diners.svg" alt="Diners Club" loading="lazy" decoding="async" width="41" height="26"></div></div></div>
</div>
