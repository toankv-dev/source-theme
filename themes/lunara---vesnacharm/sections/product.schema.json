{
  "name": "Product",
  "tag": "div",
  "limit": 1,
  "max_blocks": 25,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating (real reviews)",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating label",
      "default": "Excellent",
      "info": "Shown before the average, e.g. Excellent 4.8 | 1368 reviews."
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust line under Add to cart",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "60 Day Fit Guarantee"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "Easy Returns & Exchanges"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "",
      "info": "Optional third item (empty = hidden)."
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "Show variant pickers when there is no Kaching bundle",
      "default": true,
      "info": "With a Kaching bundle block every item gets its own Color / Size pickers inside the selected pack. Bodysuit look: unchecked also hides the Color / Size picker above the packs."
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Variant picker style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Lunara pills"
        },
        {
          "value": "walmart",
          "label": "Tiles (Walmart)"
        },
        {
          "value": "shapermint",
          "label": "Size buttons (Shapermint)"
        }
      ],
      "info": "Look of the Color / Size choices. The templates 'Variant tiles (Walmart)' and 'Size buttons (Shapermint)' set this for you."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },
    {
      "type": "header",
      "content": "Size finder"
    },
    {
      "type": "checkbox",
      "id": "show_size_finder",
      "label": "Show \"Find my size\"",
      "default": true,
      "info": "Appears only when the product has a size it can recognise: bra (34B, Band + Cup), pants W29 / L28, or letter sizes XS-5XL (with Petite / Regular / Tall inseam)."
    },
    {
      "type": "select",
      "id": "sf_mode",
      "label": "Size finder type",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (from the product options)"
        },
        {
          "value": "bra",
          "label": "Bra (Band + Cup)"
        },
        {
          "value": "bottoms",
          "label": "Pants / bottoms (waist, hips, W-L)"
        },
        {
          "value": "tops",
          "label": "Tops / dresses (bust, waist, hips)"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ]
    },
    {
      "type": "select",
      "id": "sf_popup",
      "label": "Popup content",
      "default": "finder",
      "options": [
        {
          "value": "finder",
          "label": "Size finder (questions + recommended size)"
        },
        {
          "value": "image",
          "label": "Size chart image only"
        },
        {
          "value": "both",
          "label": "Size chart image + size finder"
        }
      ],
      "info": "Image only: the link shows on every product with sizes and the popup just shows the image below."
    },
    {
      "type": "image_picker",
      "id": "sf_chart_image",
      "label": "Size chart image",
      "default": ""
    },
    {
      "type": "text",
      "id": "sf_option_name",
      "label": "Preferred size option name",
      "default": "Size",
      "info": "Used first when a product has several letter-size options. Other names (Sizes, Waist, Length, Inseam, Band, Cup...) are recognised automatically."
    },
    {
      "type": "text",
      "id": "sf_link_label",
      "label": "Link text",
      "default": "Size guide"
    },
    {
      "type": "text",
      "id": "sf_title",
      "label": "Popup title",
      "default": "Find your perfect size"
    },
    {
      "type": "text",
      "id": "sf_band_label",
      "label": "Band question",
      "default": "What is your closest Band Size?"
    },
    {
      "type": "text",
      "id": "sf_cup_label",
      "label": "Cup question",
      "default": "What is your closest Cup Size?"
    },
    {
      "type": "text",
      "id": "sf_bands",
      "label": "Band sizes",
      "default": "30, 32, 34, 36, 38, 40, 42, 44, 46, 48",
      "info": "Comma separated."
    },
    {
      "type": "text",
      "id": "sf_cups",
      "label": "Cup sizes",
      "default": "A, B, C, D, DD/E, DDD/F, G, H/I",
      "info": "Comma separated, same order as the columns of the chart."
    },
    {
      "type": "textarea",
      "id": "sf_map",
      "label": "Bra chart for letter sizes (band: size per cup)",
      "default": "30: S, S, S, S, M, M, L, L\n32: S, S, S, M, M, L, L, XL\n34: S, M, M, M, L, L, XL, XL\n36: M, M, L, L, L, XL, XL, XXL\n38: L, L, L, XL, XL, XL, XXL, XXL\n40: XL, XL, XL, XL, XXL, XXL, XXL, XXL\n42: XL, XXL, XXL, XXL, XXL, XXL, XXL, XXL\n44: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL\n46: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL\n48: XXL, XXL, XXL, XXL, XXL, XXL, XXL, XXL",
      "info": "One line per band: 34: S, M, M, M, L, L, XL, XL - one size per cup, in the cup order above. Sizes must match the product's size values (XXL = 2XL)."
    },
    {
      "type": "textarea",
      "id": "sf_letter_map",
      "label": "Letter size chart (size: bust, waist, hips)",
      "default": "XXS: 31, 24, 34\nXS: 33, 26, 36\nS: 35, 28, 38\nM: 37, 30, 40\nL: 40, 33, 43\nXL: 43, 36, 46\n2XL: 46, 39, 49\n3XL: 49, 42, 52\n4XL: 52, 45, 55\n5XL: 55, 48, 58",
      "info": "Maximum body measurement in inches for each size, US standard. One size per line, e.g. M: 37, 30, 40."
    },
    {
      "type": "header",
      "content": "Template look"
    },
    {
      "type": "select",
      "id": "skin",
      "label": "Look of this product section",
      "default": "lunara",
      "options": [
        {
          "value": "lunara",
          "label": "Lunara (default)"
        },
        {
          "value": "shapecurve",
          "label": "Bodysuit (picture colour tiles, size pills, soft cards)"
        }
      ],
      "info": "Bodysuit loads assets/css/sc-product.css and assets/js/sc-product.js for this section only."
    },
    {
      "type": "color",
      "id": "skin_highlight",
      "label": "Bodysuit look: highlight colour",
      "default": "#790236",
      "info": "Radio, selected pack frame, badges, Find My Size, tinted backgrounds."
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Second button (straight to checkout)",
      "default": "",
      "info": "e.g. Express checkout now. Empty = no second button. Adds the same items as Add to cart, then opens the checkout."
    },
    {
      "type": "header",
      "content": "Under the buttons"
    },
    {
      "type": "checkbox",
      "id": "vn_trust_any",
      "label": "Show them in the Lunara look too",
      "default": false,
      "info": "The bodysuit look always shows them (each one has its own switch below). On = also with the Lunara look, right under the Buy buttons block."
    },
    {
      "type": "checkbox",
      "id": "vn_safe_show",
      "label": "Show the \"Guaranteed safe checkout\" box",
      "default": true,
      "info": "The payment icons under a heading; the middle word in the main colour."
    },
    {
      "type": "text",
      "id": "vn_safe_before",
      "label": "Heading: first words",
      "default": "Guaranteed"
    },
    {
      "type": "text",
      "id": "vn_safe_em",
      "label": "Heading: highlighted word",
      "default": "safe"
    },
    {
      "type": "text",
      "id": "vn_safe_after",
      "label": "Heading: last words",
      "default": "checkout"
    },
    {
      "type": "checkbox",
      "id": "vn_mbg_show",
      "label": "Show the money-back guarantee box",
      "default": true,
      "info": "Grey box with a dashed border: a seal, a bold title and a short line."
    },
    {
      "type": "text",
      "id": "vn_mbg_title",
      "label": "Guarantee: title",
      "default": "45-Day Money Back Guarantee"
    },
    {
      "type": "text",
      "id": "vn_mbg_text",
      "label": "Guarantee: line under it",
      "default": "Less than 1% of customers have used our Money Back Guarantee"
    },
    {
      "type": "number",
      "id": "vn_mbg_days",
      "label": "Guarantee: days on the seal",
      "default": 45
    },
    {
      "type": "image_picker",
      "id": "vn_mbg_badge",
      "label": "Guarantee: seal picture",
      "info": "Empty = the gold seal with the days above. Square, at least 96 x 96."
    },
    {
      "type": "checkbox",
      "id": "vn_mbg_shine",
      "label": "Guarantee: gold shine crossing the box",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "size_finder",
      "name": "Size finder",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": []
    },
    {
      "type": "trust",
      "name": "Trust line",
      "limit": 1,
      "settings": []
    },
    {
      "type": "payment_badges",
      "name": "Payment icons",
      "limit": 1,
      "settings": []
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "kaching",
      "name": "Kaching bundle",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "SALE ENDS TONIGHT"
        },
        {
          "type": "number",
          "id": "selected",
          "label": "Pack selected at first",
          "min": 1,
          "max": 4,
          "default": 2
        },
        {
          "type": "select",
          "id": "save_style",
          "label": "SAVE style",
          "default": "percent",
          "options": [
            {
              "value": "percent",
              "label": "Discount % (SAVE 10%)"
            },
            {
              "value": "amount",
              "label": "Discount amount (SAVE $10.50)"
            },
            {
              "value": "compare",
              "label": "Saving vs compare-at price (SAVE $85.00)"
            },
            {
              "value": "compare_pct",
              "label": "Saving vs compare-at price, as % (SAVE 70%)"
            }
          ],
          "info": "What {save} prints in a pack subtitle. Compare-at styles = compare-at price minus pack price ($ or % of the compare-at price). % and amount come from the live Adlux discount the pack gets (Theme settings > Discounts picks which types count); hidden when the pack gets none."
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Accent colour (border, radio, badge, heading)",
          "default": "",
          "info": "Empty = the theme primary colour."
        },
        {
          "type": "color",
          "id": "price_color",
          "label": "Price colour",
          "default": "",
          "info": "Empty = accent colour."
        },
        {
          "type": "color",
          "id": "bar_bg",
          "label": "Pack background",
          "default": "#EDEDED"
        },
        {
          "type": "color",
          "id": "selected_bg",
          "label": "Selected pack background",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Pack title colour",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "badge_text_color",
          "label": "Badge text colour",
          "default": "#FFFFFF"
        },
        {
          "type": "header",
          "content": "Pack 1"
        },
        {
          "type": "number",
          "id": "pack1_qty",
          "label": "Quantity (0 hides the pack)",
          "info": "Total items = Buy + Get (e.g. Buy 3, get 2 FREE = 5; Buy 5, get 5 FREE = 10).",
          "min": 0,
          "max": 20,
          "default": 1
        },
        {
          "type": "text",
          "id": "pack1_title",
          "label": "Title",
          "default": "Buy 1"
        },
        {
          "type": "text",
          "id": "pack1_subtitle",
          "label": "Subtitle",
          "default": "SAVE {save}",
          "info": "{each} = price per item, {total} = pack price, {save} = the saving in the SAVE style above (\"SAVE {save}\" is highlighted and hidden when nothing is saved), {qty} = quantity (prices from your Adlux discount)."
        },
        {
          "type": "text",
          "id": "pack1_badge",
          "label": "Badge (ribbon on the top right)",
          "default": ""
        },
        {
          "type": "text",
          "id": "pack1_cart_msg",
          "label": "Cart message (above the cart footer)",
          "default": "",
          "info": "Shows above the cart footer when the cart reaches this pack quantity (e.g. qty 3 = Buy 2, get 1). Highest pack reached wins. Empty = nothing."
        },
        {
          "type": "text",
          "id": "pack1_gift",
          "label": "Gift line (optional, display only)",
          "default": ""
        },
        {
          "type": "image_picker",
