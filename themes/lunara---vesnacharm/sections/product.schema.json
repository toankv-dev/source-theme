    {
      "type": "custom-html",
      "name": "Custom HTML",
      "limit": 10,
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "HTML",
          "info": "Printed as is where the block sits in the product column (drag it in the outline). Store tokens such as {{CompanyEmail}} or {{ShippingInfo}} are filled in.",
          "default": "<p style=\"text-align:center\">Your HTML here</p>"
        },
        {
          "type": "css",
          "id": "css",
          "label": "CSS",
          "info": "Printed in a <style> tag with the block. Prefix selectors with .pd-custom-html to keep them to it.",
          "default": ""
        },
        {
          "type": "javascript",
          "id": "js",
          "label": "JavaScript",
          "info": "Printed in a <script> tag after the block.",
          "default": ""
        }
      ]
    },
    {
      "type": "media_slider",
      "name": "Image / video slider",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (optional)",
          "default": ""
        },
        {
          "type": "range",
          "id": "per_view",
          "label": "Items per view on desktop",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 3,
          "info": "More items than this = horizontal slider with arrows."
        },
        {
          "type": "select",
          "id": "per_view_mobile",
          "label": "Items per view on mobile",
          "default": "1.5",
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "1.2",
              "label": "1.2 (peek next)"
            },
            {
              "value": "1.5",
              "label": "1.5 (peek next)"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "2.5",
              "label": "2.5"
            },
            {
              "value": "3",
              "label": "3"
            }
          ]
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Shape",
          "default": "9/16",
          "options": [
            {
              "value": "9/16",
              "label": "Portrait 9:16 (Reels / TikTok)"
            },
            {
              "value": "3/4",
              "label": "Portrait 3:4"
            },
            {
              "value": "4/5",
              "label": "Portrait 4:5"
            },
            {
              "value": "1/1",
              "label": "Square"
            },
            {
              "value": "16/9",
              "label": "Landscape 16:9"
            }
          ]
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Space between items (px)",
          "min": 0,
          "max": 40,
          "step": 2,
          "default": 12
        },
        {
          "type": "range",
          "id": "radius",
          "label": "Corner radius (px)",
          "min": 0,
          "max": 30,
          "step": 1,
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "show_arrows",
          "label": "Show arrows",
          "default": true
        },
