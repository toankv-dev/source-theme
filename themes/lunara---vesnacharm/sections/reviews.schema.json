{
  "name": "Reviews",
  "tag": "div",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small title",
      "default": "Customer reviews",
      "info": "Home page only."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say",
      "info": "Home page only."
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show average rating",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star & badge colour",
      "default": "#03AA6D",
      "info": "Stars and the Verified purchase tick."
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button colour",
      "default": "",
      "info": "Empty = the theme primary colour."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text colour",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_write",
      "label": "Show \"Write a review\"",
      "default": true,
      "info": "Off = reviews are shown only (they are added in the admin)."
    },
    {
      "type": "header",
      "content": "Text sizes and colours"
    },
    {
      "type": "paragraph",
      "content": "Size 0 = as designed, empty colour = as designed. On phones a size never goes under 12 px."
    },
    {
      "type": "range",
      "id": "h_size",
      "label": "Heading: size on computers",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "h_size_m",
      "label": "Heading: size on phones",
      "min": 0,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "h_color",
      "label": "Heading: colour",
      "default": ""
    },
    {
      "type": "range",
      "id": "s_size",
      "label": "Names and review titles: size on computers",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "s_size_m",
      "label": "Names and review titles: size on phones",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "s_color",
      "label": "Names and review titles: colour",
      "default": ""
    },
    {
      "type": "range",
      "id": "t_size",
      "label": "Review text: size on computers",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "t_size_m",
      "label": "Review text: size on phones",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "t_color",
      "label": "Review text: colour",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "category": "Trust",
      "description": "Star rating summary, real reviews and a Write a review form."
    }
  ]
