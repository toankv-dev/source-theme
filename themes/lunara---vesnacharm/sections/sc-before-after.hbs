{{#*inline "scba_body"}}<style>
  .scba{padding:calc(var(--scba-pt,36px) * .75) 0 calc(var(--scba-pb,36px) * .75);letter-spacing:normal;background:var(--scba-bg,#f6edf1);color:#222}
  .scba--grad{--scba-g1:#f8f2f5;--scba-g2:#efe1e7;--scba-g3:#eedee5;--scba-g4:#f4ebef;background:#fff linear-gradient(120deg,var(--scba-g1) 0,var(--scba-g2) 20%,var(--scba-g3) 80%,var(--scba-g4) 100%)}
  @supports (background:color-mix(in srgb,red 50%,#fff)){
    .scba--grad{--scba-g1:color-mix(in srgb,var(--sc-hl) 5%,#fff);--scba-g2:color-mix(in srgb,var(--sc-hl) 12%,#fff);--scba-g3:color-mix(in srgb,var(--sc-hl) 13%,#fff);--scba-g4:color-mix(in srgb,var(--sc-hl) 8%,#fff)}
