  .scba__wrap{max-width:1600px;margin:0 auto;padding:0 15px;box-sizing:border-box}
  .lu-ba{display:flex;flex-direction:column;gap:24px}
  .lu-ba__media,.lu-ba__text{width:100%;min-width:0}
  .lu-ba--solo .lu-ba__media{max-width:640px;margin:0 auto}
  .lu-ba__box{position:relative;aspect-ratio:var(--ar,4/3);overflow:hidden;background:#e9e9e9;cursor:ew-resize;touch-action:pan-y;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
  .lu-ba__box--natural{aspect-ratio:auto}
  .lu-ba__img,.lu-ba__ph{position:absolute;top:0;left:0;width:100%!important;height:100%!important;max-width:none!important;margin:0;display:block;object-fit:cover;pointer-events:none;-webkit-user-drag:none}
  .lu-ba__box--natural .lu-ba__after{position:relative;height:auto!important}
  .lu-ba__box--natural .lu-ba__ph--after{position:relative;height:auto!important;aspect-ratio:4/3}
  .lu-ba__before{-webkit-clip-path:inset(0 calc(100% - var(--pos,50%)) 0 0);clip-path:inset(0 calc(100% - var(--pos,50%)) 0 0)}
