    .lu-ba__h{font-size:36px}
    .lu-ba__body{font-size:16px}
    .lu-ba__body li{margin-top:6px;padding-left:30px}
    .lu-ba__body li:before{top:2px;width:20px;height:20px}
    .lu-ba__rv{padding:20px}
    .lu-ba__stars svg{width:20px;height:20px}
    .lu-ba__rvt{margin-top:12px;font-size:20px}
    .lu-ba__rvq{margin-top:12px;font-size:16px}
    .lu-ba__rva{margin-top:16px;font-size:14px}
  }
</style>
<div class="scba{{#unless (eq section.settings.bg_style "solid")}} scba--grad{{/unless}}" style="--scba-bg:{{#if section.settings.bg}}{{section.settings.bg}}{{else}}#F6EDF1{{/if}};--sc-hl:{{#if section.settings.highlight}}{{section.settings.highlight}}{{else}}#790236{{/if}};{{#if section.settings.review_star_color}}--scba-star:{{section.settings.review_star_color}};{{/if}}--scba-pt:{{#if section}}{{section.settings.pad_top}}{{else}}36{{/if}}px;--scba-pb:{{#if section}}{{section.settings.pad_bottom}}{{else}}36{{/if}}px">
<div class="scba__wrap">
<div class="lu-ba{{#if (eq section.settings.image_side "right")}} lu-ba--right{{/if}}{{#unless section.settings.heading}}{{#unless section.settings.heading_em}}{{#unless section.settings.body}}{{#unless section.settings.review_title}}{{#unless section.settings.review_text}} lu-ba--solo{{/unless}}{{/unless}}{{/unless}}{{/unless}}{{/unless}}">
  <div class="lu-ba__media">
    <div class="lu-ba__box{{#if (eq section.settings.ratio "natural")}} lu-ba__box--natural{{/if}}" data-start="{{#if section.settings.start}}{{section.settings.start}}{{else}}50{{/if}}" style="--pos:{{#if section.settings.start}}{{section.settings.start}}{{else}}50{{/if}}%{{#unless (eq section.settings.ratio "natural")}};--ar:{{#if section.settings.ratio}}{{section.settings.ratio}}{{else}}4/3{{/if}}{{/unless}}{{#if section.settings.line_color}};--line:{{section.settings.line_color}}{{/if}}">
      {{#if section.settings.after_image}}<img class="lu-ba__img lu-ba__after" src="{{section.settings.after_image}}" alt="{{#if section.settings.after_label}}{{section.settings.after_label}}{{else}}After{{/if}}" width="1200" height="900" loading="lazy" draggable="false">{{else if section.settings.default_after_image}}<img class="lu-ba__img lu-ba__after" src="{{@root.assets_url}}/{{section.settings.default_after_image}}" alt="{{#if section.settings.after_label}}{{section.settings.after_label}}{{else}}After{{/if}}" width="1200" height="900" loading="lazy" draggable="false">{{else}}<span class="lu-ba__ph lu-ba__ph--after">{{#if @root.__designMode}}Pick the after picture{{/if}}</span>{{/if}}
      {{#if section.settings.before_image}}<img class="lu-ba__img lu-ba__before" src="{{section.settings.before_image}}" alt="{{#if section.settings.before_label}}{{section.settings.before_label}}{{else}}Before{{/if}}" width="1200" height="900" loading="lazy" draggable="false">{{else if section.settings.default_before_image}}<img class="lu-ba__img lu-ba__before" src="{{@root.assets_url}}/{{section.settings.default_before_image}}" alt="{{#if section.settings.before_label}}{{section.settings.before_label}}{{else}}Before{{/if}}" width="1200" height="900" loading="lazy" draggable="false">{{else}}<span class="lu-ba__ph lu-ba__ph--before lu-ba__before">{{#if @root.__designMode}}Pick the before picture{{/if}}</span>{{/if}}
      {{#if section.settings.before_label}}<span class="lu-ba__lb lu-ba__lb--b">{{section.settings.before_label}}</span>{{/if}}
