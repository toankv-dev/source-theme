{{!-- Details (sections/sc-details.schema.json) — Shapecurve template "Crafted In Every Detail". Heading, a large 4:5 picture
      on the left (desktop only, as on the original) and cards with a round picture whose side alternates. Pictures =
      picked file, else default_image (theme file), else an empty frame (<span>, hint in the editor only). Own <style>. --}}
<style>
  .scd{letter-spacing:normal;--sc-hl:#790236;background:var(--scd-bg,#f6edf1);color:#333}
  .scd__wrap{max-width:1200px;margin:0 auto;padding:0 15px;box-sizing:border-box}
  .scd__h{margin:21px 0 29px;font-size:36px;line-height:50.4px;font-weight:700;letter-spacing:.72px;text-align:center;color:#333}
  .scd__grid{display:grid;grid-template-columns:minmax(0,525fr) minmax(0,545fr);gap:60px;align-items:center;padding:0 25px 0 15px}
  .scd__grid--solo{grid-template-columns:minmax(0,545px);justify-content:center}
  .scd__big{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:20px;background:#e9e9e9;box-shadow:2px 2px 10px rgba(0,0,0,.25)}
  .scd__list{display:flex;flex-direction:column;gap:20px}
  .scd__card{display:flex;align-items:center;gap:30px;min-height:182px;padding:15px 60px;box-sizing:border-box;border-radius:20px;background:rgba(255,255,255,.8);box-shadow:2px 2px 10px rgba(0,0,0,.25)}
  .scd__card:nth-child(even){flex-direction:row-reverse}
  .scd__round{position:relative;flex:0 0 152px;width:152px;height:152px;overflow:hidden;border-radius:50%;background:#e9e9e9;box-shadow:4px 4px 5px rgba(0,0,0,.25)}
  .scd__img,.scd__ph{position:absolute;top:0;left:0;width:100%!important;height:100%!important;max-width:none!important;margin:0;display:block;object-fit:cover}
  .scd__ph{display:flex;align-items:center;justify-content:center;padding:12px;box-sizing:border-box;font-size:13px;color:#666;text-align:center}
  .scd__text{flex:1 1 auto;min-width:0}
  .scd__t{margin:0 0 14px;font-size:18px;line-height:27px;font-weight:700;letter-spacing:.36px;color:#333}
  .scd__p{margin:0;font-size:16px;line-height:18px;color:#000}
  @media (max-width:749px){
    .scd__wrap{padding:0 10px}
    .scd__h{margin:10px 0 16px;font-size:24px;line-height:33.6px;letter-spacing:.48px}
    .scd__grid{grid-template-columns:minmax(0,1fr);gap:0;padding:0}
    .scd__bigwrap{display:none}
    .scd__list{gap:12px}
    .scd__card{gap:24px;min-height:144px;padding:12px 20px 12px 24px}
    .scd__card:nth-child(even){padding:12px 24px 12px 20px}
    .scd__round{flex-basis:110px;width:110px;height:110px}
    .scd__t{margin-bottom:8px;font-size:14px;line-height:18px;letter-spacing:.28px}
    .scd__p{font-size:12px;line-height:18px}
  }
</style>
<div class="scd" style="--scd-bg:{{#if section.settings.bg}}{{section.settings.bg}}{{else}}#F6EDF1{{/if}};--sc-hl:{{#if section.settings.highlight}}{{section.settings.highlight}}{{else}}#790236{{/if}};padding-top:{{#if section}}{{section.settings.pad_top}}{{else}}20{{/if}}px;padding-bottom:{{#if section}}{{section.settings.pad_bottom}}{{else}}20{{/if}}px">
  <div class="scd__wrap">
    {{#if section.settings.heading}}<h2 class="scd__h" {{{editable "heading"}}}>{{section.settings.heading}}</h2>{{/if}}
    <div class="scd__grid">
      <div class="scd__bigwrap"><div class="scd__big">{{#if section.settings.image}}<img class="scd__img" src="{{section.settings.image}}" alt="{{section.settings.heading}}" width="525" height="656" loading="lazy">{{else if section.settings.default_image}}<img class="scd__img" src="{{@root.assets_url}}/{{section.settings.default_image}}" alt="{{section.settings.heading}}" width="525" height="656" loading="lazy">{{else}}<span class="scd__ph">{{#if @root.__designMode}}Pick a 4:5 picture{{/if}}</span>{{/if}}</div></div>
      <div class="scd__list">
        {{#each section.blocks}}
        <div class="scd__card" {{{this.attributes}}}>
          <div class="scd__round">{{#if this.settings.image}}<img class="scd__img" src="{{this.settings.image}}" alt="{{this.settings.title}}" width="152" height="152" loading="lazy">{{else if this.settings.default_image}}<img class="scd__img" src="{{@root.assets_url}}/{{this.settings.default_image}}" alt="{{this.settings.title}}" width="152" height="152" loading="lazy">{{else}}<span class="scd__ph">{{#if @root.__designMode}}Square picture{{/if}}</span>{{/if}}</div>
          <div class="scd__text">{{#if this.settings.title}}<h3 class="scd__t">{{this.settings.title}}</h3>{{/if}}{{#if this.settings.text}}<p class="scd__p">{{this.settings.text}}</p>{{/if}}</div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>
