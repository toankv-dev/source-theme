{
  "name": "Feature cards (picture + text)",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#F6EDF1"
    },
    {
      "type": "color",
      "id": "highlight",
      "label": "Highlight colour",
      "default": "#790236",
      "info": "Tag / icon gradients are tints of it."
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Space above",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Space below",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Text sizes and colours"
    },
    {
      "type": "paragraph",
      "content": "Size 0 = as designed, empty colour = as designed. On phones a size never goes under 12 px."
    },
    {
      "type": "range",
      "id": "h_size",
      "label": "Tags: size on computers",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "h_size_m",
      "label": "Tags: size on phones",
      "min": 0,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "h_color",
      "label": "Tags: colour",
      "default": ""
    },
    {
      "type": "range",
      "id": "s_size",
      "label": "Card headings: size on computers",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "s_size_m",
      "label": "Card headings: size on phones",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "s_color",
      "label": "Card headings: colour",
      "default": ""
    },
    {
      "type": "range",
      "id": "t_size",
      "label": "Card text: size on computers",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "t_size_m",
      "label": "Card text: size on phones",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "t_color",
      "label": "Card text: colour",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture or GIF",
          "info": "Square, 1110 x 1110 recommended. Animated GIF / WebP plays. Cards alternate sides on desktop."
        },
        {
          "type": "text",
          "id": "default_image",
          "label": "Theme file while empty",
          "info": "Path inside assets/, e.g. images/sc-sections/photo.webp. Shown until a file is picked above."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Text",
          "default": "<p>Describe the benefit in one or two sentences.</p>"
        },
        {
          "type": "header",
          "content": "Text sizes and colours"
        },
        {
          "type": "paragraph",
          "content": "Only this one; the section settings apply to all. Size 0 = as designed, empty colour = as designed. On phones a size never goes under 12 px."
        },
        {
          "type": "range",
          "id": "h_size",
          "label": "Tag: size on computers",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 0
