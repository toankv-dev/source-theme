          "default": ""
        },
        {
          "type": "range",
          "id": "s_size",
          "label": "Heading: size on computers",
          "min": 0,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
