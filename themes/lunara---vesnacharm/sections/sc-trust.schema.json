{
  "name": "Trust badges card",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#F6EDF1"
    },
    {
      "type": "color",
      "id": "highlight",
      "label": "Highlight colour",
      "default": "#790236",
      "info": "Tag / icon gradients are tints of it."
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Space above",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Space below",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "money",
              "label": "Money back"
            },
            {
              "value": "card",
              "label": "Card"
            },
            {
              "value": "support",
              "label": "Support (phone)"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "returns",
              "label": "Returns"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Own icon (optional)",
          "info": "Replaces the icon above. Square PNG / SVG, 96 x 96."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Short line about it.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "category": "Content",
      "description": "A white card with 4 round icons, titles and short lines."
    }
  ]
