{{!-- Block "Highlights box" of the product section (Shapecurve look): up to 5 short lines.
      Style "check" (default, vesnacharm user 2026-11-19): a list with a round check icon in the highlight colour; an emoji
      at the start of a line is dropped (inline script, runs while the page is parsed, so nothing flashes).
      Style "box": the grey box where an emoji at the start of a line is its icon.
      No whitespace between tags on purpose: with no line the list is truly empty and sc-product.css hides it.
      Any look: outside the bodysuit look the block links sc-product.css itself (rules under .sc-any; user 2026-11-20). --}}
{{#unless (eq @root.section.settings.skin "shapecurve")}}<link rel="stylesheet" href="{{@root.assets_url}}/css/sc-product.css">{{/unless}}{{#if (eq settings.style "box")}}<ul class="sc-hlbox">{{#if settings.line_1}}<li>{{settings.line_1}}</li>{{/if}}{{#if settings.line_2}}<li>{{settings.line_2}}</li>{{/if}}{{#if settings.line_3}}<li>{{settings.line_3}}</li>{{/if}}{{#if settings.line_4}}<li>{{settings.line_4}}</li>{{/if}}{{#if settings.line_5}}<li>{{settings.line_5}}</li>{{/if}}</ul>{{else}}<ul class="sc-hlbox sc-hlbox--check">{{#if settings.line_1}}<li><svg class="sc-hlbox__ic" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.3 11.4l3.1 3.1 6.3-6.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{settings.line_1}}</span></li>{{/if}}{{#if settings.line_2}}<li><svg class="sc-hlbox__ic" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.3 11.4l3.1 3.1 6.3-6.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{settings.line_2}}</span></li>{{/if}}{{#if settings.line_3}}<li><svg class="sc-hlbox__ic" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.3 11.4l3.1 3.1 6.3-6.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{settings.line_3}}</span></li>{{/if}}{{#if settings.line_4}}<li><svg class="sc-hlbox__ic" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.3 11.4l3.1 3.1 6.3-6.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{settings.line_4}}</span></li>{{/if}}{{#if settings.line_5}}<li><svg class="sc-hlbox__ic" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.3 11.4l3.1 3.1 6.3-6.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{settings.line_5}}</span></li>{{/if}}</ul><script>(function(u){try{var re=new RegExp('^\\s*[\\p{Extended_Pictographic}\\u200D\\uFE0F]+\\s*','u');[].forEach.call(u.querySelectorAll('li > span'),function(s){s.textContent=s.textContent.replace(re,'');});}catch(e){}})(document.currentScript.previousElementSibling);</script>{{/if}}
