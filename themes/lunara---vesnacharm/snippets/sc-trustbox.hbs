{{!-- Under the Add to cart of the bodysuit look (rendered by sections/product.hbs right after the buy_buttons block; in
      the Lunara look too when vn_trust_any is on). Context = the product section's (passed as ..). Own <style>.
      1. "Guaranteed safe checkout" box with the payment icons (user 2026-11-19, as tammycharm.com; vn_safe_*).
      2. Money-back guarantee box (user 2026-11-20, as brixpant.com/compression-tank; vn_mbg_*), in place of the grey
         delivery estimate + guarantee line box of 2026-11-19 (removed at the user's request): the background and
         border of a Kaching pack row (user 2026-11-20, "in line with the bundle"; brixpant's was grey #efefef, 1 px
         dashed #555): 5 % of the highlight, 1 px of it at 30 %, radius 8, a 48 px seal (40 on phones; drawn here in
         gold with the number of days, or a picture picked in the editor), title 15 px bold (13), line 13 px (12), a gold shine crossing it every 6 s (off with
         prefers-reduced-motion or vn_mbg_shine). The 3 videos under it are the "Image / video slider" block. --}}
<style>
  /* Measured on the user's screenshot (640 px): box border #e3e3e3 r8, legend 15px/700 #222 with the highlighted word in
     the main colour, icons 38 x 24. */
  .sc-safe{min-width:0;margin:16px 0 0;padding:4px 14px 14px;border:1px solid #e3e3e3;border-radius:8px}
  .sc-safe legend{margin:0 auto;padding:0 8px;font-size:15px;line-height:20px;font-weight:700;letter-spacing:normal;color:#222;text-align:center}
  .sc-safe legend em{font-style:normal;color:var(--sc-hl,#790236)}
  .sc-safe__pay{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin:8px 0 0;padding:0;list-style:none}
  .sc-safe__pay li{margin:0}
  .sc-safe__pay img{display:block;width:38px;height:24px;object-fit:contain}
  /* Measured on brixpant.com (offline copy, 1440 / 390): see the comment above. */
  .sc-mbg{position:relative;isolation:isolate;overflow:hidden;display:flex;align-items:center;gap:14px;margin:16px 0 0;padding:12px 16px;border:1px solid #d7b3c3;border-radius:8px;background:#f8f2f5;letter-spacing:normal}
  /* = an unselected pack row (Kaching: bar background 5 % of the accent, inset 1 px of it at 30 %); fallbacks = #790236 */
  @supports (background:color-mix(in srgb,red 50%,#fff)){.sc-mbg{border-color:color-mix(in srgb,var(--sc-hl,var(--vn-hl,#790236)) 30%,transparent);background-color:color-mix(in srgb,var(--sc-hl,var(--vn-hl,#790236)) 5%,#fff)}}
  .sc-mbg__seal{flex:0 0 auto;display:block;width:48px;height:48px}
  .sc-mbg__seal img,.sc-mbg__seal svg{display:block;width:100%;height:100%;object-fit:contain}
  .sc-mbg__txt{display:flex;align-items:center;flex-wrap:wrap;gap:4px 8px;min-width:0}
  .sc-mbg__h{margin:0;font-size:15px;line-height:1.3;font-weight:700;color:#000}
  .sc-mbg__p{margin:0;font-size:13px;line-height:1.3;color:#121212}
  .sc-mbg--shine:after{content:"";position:absolute;z-index:2;top:0;left:0;width:55%;height:100%;background:linear-gradient(90deg,rgba(212,175,55,0) 0,rgba(212,175,55,.38) 38%,rgba(255,241,196,.9) 50%,rgba(212,175,55,.38) 62%,rgba(212,175,55,0) 100%);transform:translateX(-200%) skewX(-20deg);animation:sc-mbg-shine 6s ease-in-out infinite;pointer-events:none}
  @keyframes sc-mbg-shine{0%,65%{transform:translateX(-200%) skewX(-20deg)}100%{transform:translateX(300%) skewX(-20deg)}}
  @media (prefers-reduced-motion:reduce){.sc-mbg--shine:after{display:none}}
  @media (max-width:749px){
    .sc-safe legend{font-size:14px}
    .sc-mbg{gap:10px;padding:10px 12px}
    .sc-mbg__seal{width:40px;height:40px}
    .sc-mbg__txt{gap:3px 6px}
    .sc-mbg__h{font-size:13px}
    .sc-mbg__p{font-size:12px}
  }
</style>
{{#unless (eq section.settings.vn_safe_show false)}}<fieldset class="sc-safe"><legend>{{#if section.settings.vn_safe_before}}{{section.settings.vn_safe_before}}{{else}}Guaranteed{{/if}} <em>{{#if section.settings.vn_safe_em}}{{section.settings.vn_safe_em}}{{else}}safe{{/if}}</em> {{#if section.settings.vn_safe_after}}{{section.settings.vn_safe_after}}{{else}}checkout{{/if}}</legend><ul class="sc-safe__pay" aria-label="Accepted payment methods"><li><img src="{{@root.assets_url}}/images/pay/visa.svg" alt="Visa" width="38" height="24" loading="lazy"></li><li><img src="{{@root.assets_url}}/images/pay/master.svg" alt="Mastercard" width="38" height="24" loading="lazy"></li><li><img src="{{@root.assets_url}}/images/pay/amex.svg" alt="American Express" width="38" height="24" loading="lazy"></li><li><img src="{{@root.assets_url}}/images/pay/discover.svg" alt="Discover" width="38" height="24" loading="lazy"></li><li><img src="{{@root.assets_url}}/images/pay/apple_pay.svg" alt="Apple Pay" width="38" height="24" loading="lazy"></li><li><img src="{{@root.assets_url}}/images/pay/google_pay.svg" alt="Google Pay" width="38" height="24" loading="lazy"></li><li><img src="{{@root.assets_url}}/images/pay/paypal.svg" alt="PayPal" width="38" height="24" loading="lazy"></li></ul></fieldset>{{/unless}}
{{#unless (eq section.settings.vn_mbg_show false)}}<div class="sc-mbg{{#unless (eq section.settings.vn_mbg_shine false)}} sc-mbg--shine{{/unless}}"><span class="sc-mbg__seal">{{#if section.settings.vn_mbg_badge}}<img src="{{section.settings.vn_mbg_badge}}" alt="" width="48" height="48" loading="lazy">{{else}}<svg viewBox="0 0 48 48" aria-hidden="true"><defs><linearGradient id="sc-mbg-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fbe7a1"/><stop offset=".45" stop-color="#e0b44a"/><stop offset="1" stop-color="#a8761a"/></linearGradient></defs><path d="M15 29L9.5 45l5.6-2.6L19 47l4.6-14z" fill="#a8761a"/><path d="M33 29l5.5 16-5.6-2.6L29 47l-4.6-14z" fill="#a8761a"/><polygon points="24.0,1.0 27.0,3.7 30.9,2.4 32.7,6.0 36.7,6.3 37.0,10.3 40.6,12.1 39.3,16.0 42.0,19.0 39.3,22.0 40.6,25.9 37.0,27.7 36.7,31.7 32.7,32.0 30.9,35.6 27.0,34.3 24.0,37.0 21.0,34.3 17.1,35.6 15.3,32.0 11.3,31.7 11.0,27.7 7.4,25.9 8.7,22.0 6.0,19.0 8.7,16.0 7.4,12.1 11.0,10.3 11.3,6.3 15.3,6.0 17.1,2.4 21.0,3.7" fill="url(#sc-mbg-gold)"/><circle cx="24" cy="19" r="12" fill="#2a2116" stroke="#f5d77c" stroke-width="1"/><text x="24" y="21.5" text-anchor="middle" font-size="11" font-weight="700" fill="#f5d77c">{{#if section.settings.vn_mbg_days}}{{section.settings.vn_mbg_days}}{{else}}45{{/if}}</text><text x="24" y="28" text-anchor="middle" font-size="5.2" font-weight="700" letter-spacing=".4" fill="#f5d77c">DAY</text></svg>{{/if}}</span><div class="sc-mbg__txt"><p class="sc-mbg__h">{{#if section.settings.vn_mbg_title}}{{section.settings.vn_mbg_title}}{{else}}45-Day Money Back Guarantee{{/if}}</p><p class="sc-mbg__p">{{#if section.settings.vn_mbg_text}}{{section.settings.vn_mbg_text}}{{else}}Less than 1% of customers have used our Money Back Guarantee{{/if}}</p></div></div>{{/unless}}
