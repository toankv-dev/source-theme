      },
      {
        "type": "select",
        "id": "home_banner_fit",
        "label": "Banner size",
        "default": "image",
        "options": [
          {
            "value": "image",
            "label": "Fit the image (show the whole image, height follows its ratio)"
          },
          {
            "value": "cover",
            "label": "Fixed height (fills the frame, crops the image)"
          }
