{{!-- Thanh thong bao / dem nguoc cua theme (Theme settings > Top bar). Tach khoi sections/header.hbs thanh partial rieng: store page dung "header cua theme" se chi lay header, khong lay thanh nay. --}}
{{#unless (eq settings.show_topbar false)}}{{#if (eq settings.topbar_style "countdown")}}<div id="lunara-topbar" class="shopify-section-group-header-group lt-cd lt-sm" role="region" aria-label="Announcement"><style>#lunara-topbar.lt-sm{--lt-c:{{#if settings.topbar_bg}}{{settings.topbar_bg}}{{else}}var(--lu-primary,#000000){{/if}};--lt-fg:{{#if settings.topbar_color}}{{settings.topbar_color}}{{else}}#fff{{/if}};position:relative;overflow:hidden;box-sizing:border-box;width:100%;margin:0;padding:6px 12px;display:flex;justify-content:center;align-items:center;gap:12px;text-align:center;line-height:1;font-family:var(--font-body-family,inherit);background:linear-gradient(-45deg,color-mix(in srgb,var(--lt-c) 60%,#000),var(--lt-c),color-mix(in srgb,var(--lt-c) 60%,#000),var(--lt-c));background-size:400% 400%;animation:ltGrad 15s ease infinite}@keyframes ltGrad{0%{background-position:0% 50%}50%{background-position:100% 50%}to{background-position:0% 50%}}#lunara-topbar.lt-sm:after{content:"";position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgb(255 255 255 / .07),transparent);animation:ltShine 3s infinite;pointer-events:none}@keyframes ltShine{0%{left:-100%}to{left:200%}}#lunara-topbar .lt-copy{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;justify-content:center;gap:2px;min-width:0;color:var(--lt-fg)}#lunara-topbar .lt-text{white-space:nowrap;font-size:17px;font-weight:700;letter-spacing:.02em;line-height:1.15}#lunara-topbar .lt-sub{font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;line-height:1.1;white-space:nowrap}#lunara-topbar .lt-cdn{position:relative;z-index:1;flex:0 0 auto;display:flex;align-items:center;gap:3px;white-space:nowrap;line-height:1}#lunara-topbar .lt-item{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:28px;padding:2px 3px;border-radius:5px;background:#fff}#lunara-topbar .lt-time{font-size:14px;line-height:1.1;font-weight:700;font-variant-numeric:tabular-nums;color:#000}#lunara-topbar .lt-lbl{font-size:8px;line-height:1;margin-top:1px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;color:var(--lt-c)}#lunara-topbar .lt-sep{font-size:12px;font-weight:700;color:var(--lt-fg)}@media screen and (min-width:750px){#lunara-topbar .lt-copy{flex-direction:row;align-items:center;gap:10px}#lunara-topbar .lt-text,#lunara-topbar .lt-sub{font-size:24px;line-height:28px;font-weight:700;letter-spacing:.02em}#lunara-topbar .lt-sub:before{content:"|";margin-right:10px;font-weight:400;opacity:.8}}@media screen and (max-width:749px){#lunara-topbar.lt-sm{padding:5px 10px;gap:9px}#lunara-topbar .lt-text{font-size:clamp(13px,4vw,15px)}#lunara-topbar .lt-sub{font-size:10px}#lunara-topbar .lt-cdn{gap:2px}#lunara-topbar .lt-item{min-width:24px;padding:2px 2px 1px;border-radius:4px}#lunara-topbar .lt-time{font-size:12px}#lunara-topbar .lt-lbl{font-size:7px;margin-top:1px;letter-spacing:.05em}#lunara-topbar .lt-sep{font-size:10px}}@media screen and (max-width:749px){#lunara-topbar.lt-sm{flex-direction:row;gap:8px;padding:6px 8px}#lunara-topbar .lt-copy{flex-direction:row;align-items:center;gap:5px}#lunara-topbar .lt-text,#lunara-topbar .lt-sub{font-size:clamp(12px,3.6vw,16px);line-height:1.2;font-weight:700;letter-spacing:0}#lunara-topbar .lt-sub:before{content:"|";margin-right:5px;font-weight:400;opacity:.8}}@media (prefers-reduced-motion:reduce){#lunara-topbar.lt-sm{animation:none}#lunara-topbar.lt-sm:after{animation:none;content:none}}#lunara-topbar.lt-sm{padding:11px 12px}@media screen and (max-width:749px){#lunara-topbar.lt-sm{padding:10px 8px}}</style><div class="lt-copy"><div class="lt-text">{{#if settings.countdown_title_bf}}{{settings.countdown_title_bf}}{{else}}BLACK FRIDAY 70%{{/if}}</div>{{#if settings.countdown_subtitle_bf}}<span class="lt-sub">{{settings.countdown_subtitle_bf}}</span>{{/if}}</div><div class="lt-cdn" aria-label="Sale ends in" data-lt-hours="{{#if settings.countdown_hours}}{{settings.countdown_hours}}{{else}}2{{/if}}"><div class="lt-item"><span class="lt-time" data-lt-h>00</span><span class="lt-lbl">HRS</span></div><span class="lt-sep" aria-hidden="true">:</span><div class="lt-item"><span class="lt-time" data-lt-m>00</span><span class="lt-lbl">MIN</span></div><span class="lt-sep" aria-hidden="true">:</span><div class="lt-item"><span class="lt-time" data-lt-s>00</span><span class="lt-lbl">SEC</span></div></div><script>(function(){var bar=document.getElementById("lunara-topbar");if(!bar||bar.__lu)return;bar.__lu=1;var t=bar.querySelector(".lt-cdn"),h=bar.querySelector("[data-lt-h]"),m=bar.querySelector("[data-lt-m]"),s=bar.querySelector("[data-lt-s]");if(!t||!h)return;var hrs=parseFloat(t.getAttribute("data-lt-hours"))||2,KEY="lunara_sale_end",DUR=Math.max(1/60,hrs)*3.6e6,mem=0;function getEnd(){var e=0;try{e=parseInt(localStorage.getItem(KEY),10)||0;}catch(x){e=mem;}if(!e||e<=Date.now()||e-Date.now()>DUR){e=Date.now()+DUR;mem=e;try{localStorage.setItem(KEY,e);}catch(x){}}return e;}var end=getEnd();function p(n){return(n<10?"0":"")+n;}function tick(){var d=end-Date.now();if(d<=0){end=getEnd();d=end-Date.now();}h.textContent=p(Math.floor(d/3.6e6));m.textContent=p(Math.floor((d%3.6e6)/6e4));s.textContent=p(Math.floor((d%6e4)/1000));}tick();setInterval(tick,1000);})();</script></div>{{else}}<div id="lunara-topbar" class="shopify-section-group-header-group" role="region" aria-label="Announcement"><style>#lunara-topbar{background:{{#if settings.topbar_bg}}{{settings.topbar_bg}}{{else}}var(--lu-primary,#000000){{/if}};color:{{#if settings.topbar_color}}{{settings.topbar_color}}{{else}}#fff{{/if}};font-family:var(--font-body-family,inherit);} #lunara-topbar .lt-in{position:relative;height:30px;overflow:hidden;max-width:1200px;margin:0 auto;padding:0 16px;} #lunara-topbar .lt-msg{position:absolute;inset:0 16px;display:flex;align-items:center;justify-content:center;text-align:center;margin:0;font-size:13px;font-weight:500;letter-spacing:.04em;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transform:translateY(6px);transition:opacity .45s,transform .45s;} #lunara-topbar .lt-msg.on{opacity:1;transform:none;} @media (max-width:749px){#lunara-topbar .lt-in{height:30px;} #lunara-topbar .lt-msg{font-size:12px;letter-spacing:.02em;}}</style><div class="lt-in" data-lt-text="{{#if settings.topbar_text}}{{settings.topbar_text}}{{else}}🍁 FALL SALE - Up To 70% Off|Free Shipping On All Orders{{/if}}"></div><script>
(function(){
  var bar=document.getElementById('lunara-topbar');if(!bar||bar.__lu)return;bar.__lu=1;
  var box=bar.querySelector('.lt-in'),list=(box.getAttribute('data-lt-text')||'').split('|').map(function(t){return t.trim();}).filter(Boolean);
  if(!list.length){bar.style.display='none';return;}
  var els=list.map(function(t,i){var p=document.createElement('p');p.className='lt-msg'+(i?'':' on');p.textContent=t;box.appendChild(p);return p;});
  if(els.length<2)return;
  var i=0;setInterval(function(){els[i].classList.remove('on');i=(i+1)%els.length;els[i].classList.add('on');},4000);
})();
</script></div>{{/if}}{{/unless}}
