{{!-- Benefits with icons + USP box, printed right under the product title. Product SECTION settings (bnf_*, usp_*),
      not blocks, so they show with their defaults on stores whose saved block list is older. Called with the root
      context ({{> lu-benefits-usp}} / {{> lu-benefits-usp ..}} inside the blocks loop). Icons: snippets/lu-icon.hbs. --}}
{{#unless (eq section.settings.bnf_show false)}}<ul class="lu-bnf">{{#if section.settings.bnf_text_1}}<li>{{#if section.settings.bnf_image_1}}<img src="{{section.settings.bnf_image_1}}" alt="" width="24" height="24" loading="lazy">{{else}}{{> lu-icon name=section.settings.bnf_icon_1}}{{/if}}<span>{{section.settings.bnf_text_1}}</span></li>{{/if}}{{#if section.settings.bnf_text_2}}<li>{{#if section.settings.bnf_image_2}}<img src="{{section.settings.bnf_image_2}}" alt="" width="24" height="24" loading="lazy">{{else}}{{> lu-icon name=section.settings.bnf_icon_2}}{{/if}}<span>{{section.settings.bnf_text_2}}</span></li>{{/if}}{{#if section.settings.bnf_text_3}}<li>{{#if section.settings.bnf_image_3}}<img src="{{section.settings.bnf_image_3}}" alt="" width="24" height="24" loading="lazy">{{else}}{{> lu-icon name=section.settings.bnf_icon_3}}{{/if}}<span>{{section.settings.bnf_text_3}}</span></li>{{/if}}{{#if section.settings.bnf_text_4}}<li>{{#if section.settings.bnf_image_4}}<img src="{{section.settings.bnf_image_4}}" alt="" width="24" height="24" loading="lazy">{{else}}{{> lu-icon name=section.settings.bnf_icon_4}}{{/if}}<span>{{section.settings.bnf_text_4}}</span></li>{{/if}}{{#if section.settings.bnf_text_5}}<li>{{#if section.settings.bnf_image_5}}<img src="{{section.settings.bnf_image_5}}" alt="" width="24" height="24" loading="lazy">{{else}}{{> lu-icon name=section.settings.bnf_icon_5}}{{/if}}<span>{{section.settings.bnf_text_5}}</span></li>{{/if}}{{#if section.settings.bnf_text_6}}<li>{{#if section.settings.bnf_image_6}}<img src="{{section.settings.bnf_image_6}}" alt="" width="24" height="24" loading="lazy">{{else}}{{> lu-icon name=section.settings.bnf_icon_6}}{{/if}}<span>{{section.settings.bnf_text_6}}</span></li>{{/if}}</ul>{{/unless}}{{#unless (eq section.settings.usp_show false)}}<div class="lu-usp" style="--lu-usp-bg:{{#if section.settings.usp_bg}}{{section.settings.usp_bg}}{{else}}#EEEEEE{{/if}};--lu-usp-bd:{{#if section.settings.usp_border}}{{section.settings.usp_border}}{{else}}#D9D9D9{{/if}}">{{#if section.settings.usp_image}}<img class="lu-usp__img" src="{{section.settings.usp_image}}" alt="" width="48" height="48" loading="lazy" decoding="async">{{else}}<img class="lu-usp__img" src="{{assets_url}}/images/lu-usp.webp" alt="" width="48" height="48" loading="lazy" decoding="async">{{/if}}<div>{{#if section.settings.usp_title}}<p class="lu-usp__h">{{section.settings.usp_title}}</p>{{/if}}{{#if section.settings.usp_text}}<p class="lu-usp__p">{{section.settings.usp_text}}</p>{{/if}}</div></div>{{/unless}}
