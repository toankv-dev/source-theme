})();
{{!-- Kieu Cards: khong chon bien the tung mon trong card (an [data-lu-units]); bo chon bien the chinh (.lu-variants) hien lai, doi o do -> copy gia tri vao moi mon cua goi (gio / gia doc tu cac mon nay). --}}
(function () {
  if (window.__luCardsSync) return;
  window.__luCardsSync = 1;
  document.addEventListener('change', function (e) {
    var t = e.target;
    if (!t || !t.closest || !t.closest('.lu-variants')) return;
    var root = t.closest('[data-ms-pdp]') || document;
    var k = root.querySelector('.lu-k-cards[data-lu-kaching], .lu-k-list[data-lu-kaching]');
    if (!k) return;
    setTimeout(function () {
      var vals = [].map.call(root.querySelectorAll('.ms-variant-group'), function (g) {
        var sel = g.querySelector('select');
        if (sel) return sel.value;
        var r = g.querySelector('input[type=radio]:checked');
        return r ? r.value : '';
      });
      k.querySelectorAll('[data-lu-unit]').forEach(function (u) {
        u.querySelectorAll('select').forEach(function (sel, i) {
          if (vals[i] && sel.value !== vals[i]) {
            sel.value = vals[i];
            sel.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    }, 0);
  });
})();
</script>
