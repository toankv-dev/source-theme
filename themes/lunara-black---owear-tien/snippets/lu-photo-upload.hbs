{{!-- Block "Upload image" (sections/product.schema.json). The shopper picks a photo; assets/js/lu-atc-extras.js sends
      it to Cloudinary (Theme settings > Photo upload: cloud name + unsigned preset) and adds the image link to every
      line the main Add to cart adds, as option "<Name on the order>: <link>" (the order receives it in the variant
      text). Required = Add to cart waits for a photo. Not set up = hidden on the store, a hint in the editor. --}}
{{#if @root.settings.upload_cloud_name}}{{#if @root.settings.upload_preset}}
<div class="lu-ph" data-lu-ph data-cloud="{{@root.settings.upload_cloud_name}}" data-preset="{{@root.settings.upload_preset}}" data-name="{{#if settings.option_name}}{{settings.option_name}}{{else}}Photo{{/if}}" data-max="{{#if settings.max_mb}}{{settings.max_mb}}{{else}}10{{/if}}"{{#if settings.required}} data-required{{/if}} data-msg-required="{{#if settings.required_msg}}{{settings.required_msg}}{{else}}Please upload your image first.{{/if}}" data-msg-wait="{{#if settings.wait_msg}}{{settings.wait_msg}}{{else}}Your image is still uploading...{{/if}}" data-msg-size="{{#if settings.size_msg}}{{settings.size_msg}}{{else}}This file is too large.{{/if}}" data-msg-fail="{{#if settings.fail_msg}}{{settings.fail_msg}}{{else}}Upload failed, please try again.{{/if}}">
{{#if settings.heading}}<p class="lu-ph__h">{{settings.heading}}{{#if settings.required}} <span class="lu-ph__req" aria-hidden="true">*</span>{{/if}}</p>{{/if}}
<label class="lu-ph__btn" data-lu-ph-btn><input type="file" class="lu-ph__file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,image/gif" data-lu-ph-file><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg><span data-lu-ph-label data-first="{{#if settings.button_label}}{{settings.button_label}}{{else}}Upload image{{/if}}" data-again="{{#if settings.change_label}}{{settings.change_label}}{{else}}Change image{{/if}}">{{#if settings.button_label}}{{settings.button_label}}{{else}}Upload image{{/if}}</span></label>
<div class="lu-ph__preview" data-lu-ph-preview hidden><img class="lu-ph__img" alt="" width="56" height="56" data-lu-ph-img><span class="lu-ph__status" data-lu-ph-status data-busy="{{#if settings.busy_label}}{{settings.busy_label}}{{else}}Uploading...{{/if}}" data-done="{{#if settings.done_label}}{{settings.done_label}}{{else}}Image uploaded{{/if}}"></span><button type="button" class="lu-ph__rm" data-lu-ph-rm aria-label="{{#if settings.remove_label}}{{settings.remove_label}}{{else}}Remove image{{/if}}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
{{#if settings.help}}<p class="lu-ph__help">{{settings.help}}</p>{{/if}}
<p class="lu-ph__err" role="alert" data-lu-ph-err hidden></p>
</div>
{{/if}}{{else}}{{#if @root.__designMode}}<p class="lu-ph-setup">Upload image: set the Cloudinary cloud name and unsigned upload preset in Theme settings &gt; Photo upload. The block stays hidden on the store until then.</p>{{/if}}{{/if}}
