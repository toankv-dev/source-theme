  {
    "name": "Product cards",
    "settings": [
      {
        "type": "paragraph",
        "content": "Product cards (home, Products, You may also like) use the Ritual Club look: 4:5 image, left-aligned name and price."
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Card image shape",
        "default": "portrait",
        "options": [
          {
            "value": "portrait",
            "label": "Portrait 4:5 (Ritual Club)"
          },
          {
            "value": "square",
            "label": "Square 1:1 (old look, square photos not cropped)"
          }
        ],
        "info": "Portrait crops square photos a little on the left and right."
      },
      {
        "type": "checkbox",
        "id": "card_sale_badge",
        "label": "Sale badge on the image (e.g. 46% OFF)",
        "default": true,
        "info": "Shown only when the product has a compare-at price above its price. % = (compare-at − price) / compare-at."
      },
      {
        "type": "text",
        "id": "card_sale_badge_text",
        "label": "Sale badge text",
        "default": "{pct}% OFF",
        "info": "{pct} = the saving in %."
      },
      {
        "type": "select",
        "id": "card_rating_empty",
        "label": "Stars above the name when a product has no reviews yet",
        "default": "show",
        "options": [
          {
            "value": "show",
            "label": "Show 5 stars (no count)"
          },
          {
            "value": "hide",
            "label": "Hide the star row"
          }
        ],
        "info": "The review count (e.g. (1829)) shows only when the product has real reviews."
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show Add to cart button on product cards",
        "default": false,
        "info": "Off = like Ritual Club: the card has no button, tapping the card opens the product page."
      }
    ]
  },
  {
    "name": "Cart & checkout",
    "settings": [
      {
        "type": "text",
        "id": "atc_label",
        "label": "Add-to-cart label",
