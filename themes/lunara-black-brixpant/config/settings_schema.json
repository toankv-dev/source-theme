  {
    "name": "FAQ",
    "settings": [
      {
        "type": "text",
        "id": "faq_1_q",
        "label": "Question 1",
        "default": "How long does shipping take?",
        "info": "Six question/answer pairs shown on every product page (Sections → Show FAQ). Clear a question or its answer to hide that pair. Answers may link to the store's own pages with {{ShippingLink}}, {{RefundLink}}, {{ContactLink}}, {{TrackOrderLink}}, {{PrivacyLink}}, {{TermsLink}} and print the support email with {{CompanyEmail}} — each is filled in per store."
      },
      {
        "type": "richtext",
        "id": "faq_1_a",
        "label": "Answer 1",
        "default": "<p>Orders are processed within 1–3 business days. Delivery usually takes 7–15 business days depending on your location, and every order is tracked. See our <a href=\"{{ShippingLink}}\">Shipping Policy</a>.</p>"
      },
      {
        "type": "text",
        "id": "faq_2_q",
        "label": "Question 2",
        "default": "How can I track my order?"
      },
      {
        "type": "richtext",
        "id": "faq_2_a",
        "label": "Answer 2",
        "default": "<p>As soon as your package ships we email you the tracking number. You can also check the status any time on our <a href=\"{{TrackOrderLink}}\">Track your order</a> page.</p>"
      },
      {
        "type": "text",
        "id": "faq_3_q",
        "label": "Question 3",
        "default": "Can I change or cancel my order?"
      },
      {
        "type": "richtext",
        "id": "faq_3_a",
        "label": "Answer 3",
