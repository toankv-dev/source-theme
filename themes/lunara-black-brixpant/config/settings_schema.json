  },
  {
    "name": "Discounts",
    "settings": [
      {
        "type": "paragraph",
        "content": "Automatic discounts from Adlux (Discounts → Automatic) apply to this theme ONLY when switched on here. Off = no automatic discount on the product page, cart or checkout. Discount codes always work."
      },
      {
        "type": "checkbox",
        "id": "allow_amount_off_discount",
        "label": "Allow Amount off products discount",
        "default": true,
        "info": "Uses the live automatic AMOUNT_OFF_PRODUCTS discounts (e.g. 5% off from 2 items, 10% off from 3)."
      },
      {
        "type": "checkbox",
        "id": "allow_tiered_discount",
        "label": "Allow tiered discount (Next item progressive)",
        "default": false,
        "info": "Uses the live automatic TIERED_NEXT_ITEM discount, e.g. #2 −10%, #3 −15%."
      },
      {
        "type": "checkbox",
        "id": "allow_bxgy_discount",
        "label": "Allow Buy X Get Y discount",
        "default": false,
        "info": "Uses the live automatic BUY_X_GET_Y discounts (e.g. Buy 3 / Get 1 FREE)."
      }
    ]
  },
