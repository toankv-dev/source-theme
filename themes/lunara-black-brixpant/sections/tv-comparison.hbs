      <div role="cell" class="b-compare__mid">{{this.settings.label}}</div>
      <div role="cell" class="b-compare__side">{{#if this.settings.theirs_text}}<span class="b-compare__val">{{this.settings.theirs_text}}</span>{{else}}{{#if this.settings.theirs}}<span class="b-yes" aria-label="Yes">✓</span>{{else}}<span class="b-no" aria-label="No">✕</span>{{/if}}{{/if}}</div>
