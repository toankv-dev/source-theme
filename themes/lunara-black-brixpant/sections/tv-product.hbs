{{!-- GENERATED by _work/build-tvb.js from themes/tredvik/sections/product.hbs — edit the build, not this file. --}}
<div class="tvb" data-tvb-page>
<link rel="stylesheet" href="{{@root.assets_url}}/css/tv-bundle.css">
{{> tv-fonts}}
{{> tv-vars}}
<script type="application/json" id="b-offers">{ "tiers": {{#if @root.settings.allow_tiered_discount}}{{{json @root.nextItemTiers}}}{{else}}null{{/if}}, "bxgy": {{#if @root.settings.allow_bxgy_discount}}{{{json @root.bxgyOffers}}}{{else}}null{{/if}}, "amountOff": {{#unless (eq @root.settings.allow_amount_off_discount false)}}{{{json @root.amountOffOffers}}}{{else}}null{{/unless}} }</script>
{{#if @root.product.gift_offers}}<script type="application/json" id="sf-gifts-data">{{{json @root.product.gift_offers}}}</script>{{/if}}
<script>window.__bCart = { open: false };</script>
{{!-- Main product section. Gallery on one side; every element of the info column is a block rendered in the
      merchant's order. From the legacy entry (templates/product.hbs) `section` is undefined, so the {{else}}
      branch renders title, price, options and the buy button — the page still sells without a template
      document. Pickers / buy row are wired by ui.js through data-* attributes only. --}}
<div class="b-wrap b-pdp b-pdp--gallery-{{#if section.settings.gallery_side}}{{section.settings.gallery_side}}{{else}}left{{/if}}" data-pdp>
  <div class="b-gallery b-gallery--{{#if section.settings.gallery_layout}}{{section.settings.gallery_layout}}{{else}}thumbs{{/if}}" data-gallery>
    <div class="b-gallery__main">
      {{#if product.media.main_image}}
      <img data-gallery-main src="{{product.media.main_image}}" alt="{{product.title}}" fetchpriority="high">
      {{/if}}
      {{#if product.off_pct}}{{#unless (eq section.settings.show_sale_badge false)}}<span class="b-badge b-gallery__badge" data-off-badge>{{#if (eq section.settings.sale_badge_style "off")}}{{product.off_pct}}% OFF{{else}}-{{product.off_pct}}%{{/if}}</span>{{/unless}}{{/if}}
    </div>
    {{#if product.media.gallery.length}}
    <div class="b-gallery__strip">
      <button type="button" class="b-round-btn" data-gallery-step="-1" aria-label="Previous image">‹</button>
      <div class="b-gallery__thumbs" data-gallery-thumbs>
        {{#each product.media.gallery}}
        <button type="button" class="b-thumb{{#if @first}} is-active{{/if}}" data-gallery-thumb="{{url}}" aria-label="Show image {{@index}}">
          {{!-- A video's thumbnail is its poster (else the platform turns the <img> into a playing video). --}}
          <img src="{{#if thumb_url}}{{thumb_url}}{{else}}{{#if is_video}}{{#if poster_url}}{{poster_url}}{{else}}{{url}}{{/if}}{{else}}{{url}}{{/if}}{{/if}}" alt="{{alt}}" loading="lazy">
        </button>
        {{/each}}
      </div>
      <button type="button" class="b-round-btn" data-gallery-step="1" aria-label="Next image">›</button>
    </div>
    {{/if}}
  </div>

  <div class="b-info">
    {{#if section.blocks.length}}
    {{#each section.blocks}}
      {{#if (eq this.type "award")}}
      <p class="b-award" {{{this.attributes}}}>{{#if this.settings.icon}}{{this.settings.icon}} {{/if}}{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "rating")}}
      {{#if @root.product.reviews.summary.total_count}}
      <a class="b-rating" href="#reviews" {{{this.attributes}}}>
        <span class="b-stars" style="--r:{{@root.product.reviews.summary.average_rating}}" aria-hidden="true"></span>
        {{#if this.settings.suffix}}<span class="tv-rating__text">{{#if this.settings.prefix}}{{this.settings.prefix}} {{/if}}{{@root.product.reviews.summary.total_count}}{{this.settings.suffix}}</span>{{else}}
        <strong>{{@root.product.reviews.summary.average_rating}}</strong>
        <span class="b-rating__sep">|</span>
        <span>{{@root.product.reviews.summary.total_count}} {{#if this.settings.label}}{{this.settings.label}}{{else}}reviews{{/if}}</span>{{/if}}
      </a>
      {{/if}}
      {{/if}}
      {{#if (eq this.type "title")}}
      <h1 class="b-info__title" {{{this.attributes}}}>{{@root.product.title}}</h1>
      {{/if}}
      {{#if (eq this.type "subtitle")}}
      <p class="b-subtitle" {{{this.attributes}}}>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "benefit")}}
      {{!-- Tredvik: `icon` = a line icon (walk / stairs / move / feather) in place of the ✓. --}}
      <p class="b-benefit{{#if this.settings.icon}} tv-ben{{/if}}" {{{this.attributes}}}>{{#if this.settings.icon}}{{#if (eq this.settings.icon "walk")}}<svg class="tv-ben__icon" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="3.6" r="1.9"/><path d="M12.6 7.2 10 13l2.6 3.2-1.2 5.3M12.6 7.2l1.6 4.6 3.3 1.4M12.6 7.2 9.3 8.6 7.4 12.4M12.6 16.2l3 2.6.9 2.7"/></svg>{{/if}}{{#if (eq this.settings.icon "stairs")}}<svg class="tv-ben__icon" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20.5h4.5V16H12v-4.5h4.5V7H21M10.5 9.5 16 4M12.5 3.5H16.5v4"/></svg>{{/if}}{{#if (eq this.settings.icon "move")}}<svg class="tv-ben__icon" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9.2" r="1.5"/><path d="M10.6 11.6h2.8v4.6h-2.8zM12 1.8v4M10.4 3.4 12 1.8l1.6 1.6M12 22.2v-3.6M10.4 20.6 12 22.2l1.6-1.6M1.8 12h4.4M3.4 10.4 1.8 12l1.6 1.6M22.2 12h-4.4M20.6 10.4 22.2 12l-1.6 1.6"/></svg>{{/if}}{{#if (eq this.settings.icon "feather")}}<svg class="tv-ben__icon" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 3.2C13 3.6 7.6 9 6.6 16.4L4 21M20.5 3.2c-.4 7.3-5.3 12.8-12.6 13.6M8.4 15.4l6.8-6.8M11.3 7.8l.4 3.9M14.6 11.1l3.4.2"/></svg>{{/if}}{{else}}<span class="b-check" aria-hidden="true">✓</span>{{/if}}{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "stock")}}
      <p class="b-stock" {{{this.attributes}}}><span class="b-stock__dot" aria-hidden="true"></span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "urgency")}}
      {{!-- "{n}" in the text becomes a number between min and max that drifts a little (people viewing now). --}}
      <p class="b-urgency" {{{this.attributes}}} data-urgency data-min="{{this.settings.min}}" data-max="{{this.settings.max}}" data-text="{{this.settings.text}}">{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "offer_heading")}}
      <p class="b-offer" {{{this.attributes}}}><span>{{this.settings.text}}</span></p>
      {{/if}}
      {{#if (eq this.type "price")}}
      <div {{{this.attributes}}}>{{> tv-price}}</div>
      {{/if}}
      {{#if (eq this.type "variant_picker")}}
      <div class="b-picker" {{{this.attributes}}}>{{> tv-options}}</div>
      {{/if}}
      {{#if (eq this.type "variant_cards")}}
      {{> tv-pack-cards this}}
      {{/if}}
      {{#if (eq this.type "buy_buttons")}}
      <div class="b-buy" {{{this.attributes}}}>
        {{#unless (eq this.settings.show_options false)}}{{> tv-options hide_pickers=this.settings.hide_options}}{{/unless}}
        {{> tv-buy-row label=this.settings.label mode=this.settings.mode show_qty=this.settings.show_qty}}
        {{#if this.settings.note}}<p class="b-buy__note">{{this.settings.note}}</p>{{/if}}
        {{#unless (eq this.settings.show_payments false)}}{{> tv-pay-icons}}{{/unless}}
      </div>
      {{/if}}
      {{#if (eq this.type "trust_icons")}}
      <ul class="b-trust" {{{this.attributes}}}>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" stroke="currentColor" stroke-width="1.6" fill="none"/></svg><span>{{this.settings.label_1}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="9" y="10.5" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M10.2 10.5V9.3a1.8 1.8 0 0 1 3.6 0v1.2" stroke="currentColor" stroke-width="1.4" fill="none"/></svg><span>{{this.settings.label_2}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/><circle cx="17" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/></svg><span>{{this.settings.label_3}}</span></li>
      </ul>
      {{/if}}
      {{#if (eq this.type "review")}}
      {{#each (limit @root.product.reviews.items 1)}}
      <figure class="b-quote" {{{../attributes}}}>
        {{#if image}}<img class="b-quote__img" src="{{image}}" alt="" loading="lazy">{{/if}}
        <figcaption>
          <span class="b-stars b-stars--sm" style="--r:{{rating}}" aria-label="{{rating}} out of 5"></span>
          <p class="b-quote__text">{{content}}</p>
          <p class="b-quote__who"><strong>{{name}}</strong>{{#if verified}} · <span class="b-verified">Verified buyer</span>{{/if}}</p>
        </figcaption>
      </figure>
      {{/each}}
      {{/if}}
      {{#if (eq this.type "accordion")}}
      <details class="b-acc" {{{this.attributes}}}{{#if this.settings.open}} open{{/if}}>
        <summary>{{#if (eq this.settings.icon "help")}}<svg class="tv-acc__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9.2"/><path d="M9.6 9.4a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .8-1 1.5v.6"/><circle cx="12" cy="16.9" r=".4" fill="currentColor"/></svg>{{/if}}<span>{{this.settings.title}}</span></summary>
        <div class="b-acc__body b-rte">
          {{#if (eq this.settings.source "description")}}{{{@root.product.description_html}}}{{/if}}
          {{#if (eq this.settings.source "custom")}}{{{applyTokens this.settings.body}}}{{/if}}
        </div>
      </details>
      {{/if}}
      {{#if (eq this.type "description")}}
      <div class="b-rte b-block-text b-description" {{{this.attributes}}}>{{{@root.product.description_html}}}</div>
      {{/if}}
      {{#if (eq this.type "text")}}
      <div class="b-rte b-block-text" {{{this.attributes}}}>{{{applyTokens this.settings.body}}}</div>
      {{/if}}
      {{#if (eq this.type "image")}}
      {{#if this.settings.image}}<img class="b-block-image" {{{this.attributes}}} src="{{this.settings.image}}" alt="{{this.settings.alt}}" loading="lazy"{{#if this.settings.ratio}} style="aspect-ratio:{{this.settings.ratio}};object-fit:cover"{{/if}}>{{else if this.settings.default_image}}<img class="b-block-image" {{{this.attributes}}} src="{{@root.assets_url}}/{{this.settings.default_image}}" alt="{{this.settings.alt}}" loading="lazy"{{#if this.settings.ratio}} style="aspect-ratio:{{this.settings.ratio}};object-fit:cover"{{/if}}>{{else}}<div class="b-block-image b-ph b-ph--block" {{{this.attributes}}}{{#if this.settings.ratio}} style="aspect-ratio:{{this.settings.ratio}}"{{/if}}>{{#if @root.__designMode}}Upload an image{{/if}}</div>{{/if}}
      {{/if}}
      {{#if (eq this.type "divider")}}
      <hr class="b-divider" {{{this.attributes}}}>
      {{/if}}
      {{#if (eq this.type "custom_html")}}
      <div class="b-custom-html" {{{this.attributes}}}>{{{this.settings.html}}}</div>
      {{/if}}
      {{#if (eq this.type "media_slider")}}
      {{!-- Up to 10 images / videos side by side (data-reels in ui.js). A video file picked in an image slot
            is turned into a muted looping <video> (by the server, else by ui.js). Slots 1..`slots` with no file
            keep an empty frame (upload hint in the editor); empty slots past `slots` are skipped. --}}
      <div class="b-mslider" {{{this.attributes}}} data-reels style="--pv:{{#if this.settings.per_view}}{{this.settings.per_view}}{{else}}3{{/if}};--pvm:{{#if this.settings.per_view_mobile}}{{this.settings.per_view_mobile}}{{else}}1.5{{/if}};--gap:{{#if this.settings.gap}}{{this.settings.gap}}{{else}}0{{/if}}px;--r:{{#if this.settings.radius}}{{this.settings.radius}}{{else}}0{{/if}}px;--ar:{{#if this.settings.ratio}}{{this.settings.ratio}}{{else}}9/16{{/if}}">
        {{#if this.settings.heading}}<h3 class="b-mslider__h">{{this.settings.heading}}</h3>{{/if}}
        <div class="b-mslider__vp">
          <div class="b-mslider__track" data-reels-track>
            {{#if this.settings.media_1}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_1}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_1}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_1}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 0)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_2}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_2}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_2}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_2}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 1)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_3}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_3}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_3}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_3}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 2)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_4}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_4}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_4}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_4}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 3)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_5}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_5}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_5}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_5}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 4)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_6}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_6}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_6}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_6}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 5)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_7}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_7}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_7}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_7}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 6)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_8}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_8}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_8}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_8}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 7)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_9}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_9}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_9}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_9}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 8)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_10}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_10}}" alt="" loading="lazy"></figure>{{else if this.settings.default_media_10}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{@root.assets_url}}/{{this.settings.default_media_10}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 9)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
          </div>
          {{#unless (eq this.settings.show_arrows false)}}
          <div class="b-mslider__nav" data-reels-nav hidden>
            <button type="button" class="b-round-btn" data-reels-step="-1" aria-label="Previous">‹</button>
            <button type="button" class="b-round-btn" data-reels-step="1" aria-label="Next">›</button>
          </div>
          {{/unless}}
        </div>
      </div>
      {{/if}}
      {{#if (eq this.type "faq")}}
      {{!-- Own questions when question 1 is filled, else the store's FAQ (snippets/faq-list.hbs). --}}
      <div class="b-pfaq" {{{this.attributes}}}>
        {{#if this.settings.heading}}<h3 class="b-pfaq__h">{{this.settings.heading}}</h3>{{/if}}
        {{#if this.settings.q_1}}
        {{> tv-faq-qa q=this.settings.q_1 a=this.settings.a_1}}
        {{> tv-faq-qa q=this.settings.q_2 a=this.settings.a_2}}
        {{> tv-faq-qa q=this.settings.q_3 a=this.settings.a_3}}
        {{> tv-faq-qa q=this.settings.q_4 a=this.settings.a_4}}
        {{> tv-faq-qa q=this.settings.q_5 a=this.settings.a_5}}
        {{> tv-faq-qa q=this.settings.q_6 a=this.settings.a_6}}
        {{else}}
        {{> tv-faq-list}}
        {{/if}}
      </div>
      {{/if}}
      {{#if (eq this.type "size_chart")}}
      {{!-- "Size guide" link + popup. With an option name set, it shows only on products that have that option. --}}
      <div class="b-sizechart" {{{this.attributes}}} data-size-chart data-option="{{this.settings.option_name}}" data-options="{{#each @root.product.variants}}{{name}}|{{/each}}">
        <button type="button" class="b-sizechart__link" data-modal-open>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2.5 8.5h19v7h-19z M6 8.5v3 M9.5 8.5v2 M13 8.5v3 M16.5 8.5v2 M20 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <span>{{#if this.settings.label}}{{this.settings.label}}{{else}}Size guide{{/if}}</span>
        </button>
        <div class="b-modal" data-modal hidden role="dialog" aria-modal="true" aria-label="{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}">
          <div class="b-modal__overlay" data-modal-close></div>
          <div class="b-modal__panel b-sizechart__panel">
            <button type="button" class="b-icon-btn b-modal__close" data-modal-close aria-label="Close">✕</button>
            <p class="b-sizechart__title">{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}</p>
            {{#if this.settings.image}}<img class="b-sizechart__img" src="{{this.settings.image}}" alt="{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}" loading="lazy">{{else if this.settings.default_image}}<img class="b-sizechart__img" src="{{@root.assets_url}}/{{this.settings.default_image}}" alt="{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}" loading="lazy">{{/if}}
            {{#if this.settings.body}}<div class="b-rte">{{{applyTokens this.settings.body}}}</div>{{/if}}
          </div>
        </div>
      </div>
      {{/if}}
    {{/each}}
    {{else}}
    <h1 class="b-info__title">{{product.title}}</h1>
    {{> tv-price}}
    <div class="b-buy">
      {{> tv-options}}
      {{> tv-buy-row}}
    </div>
    {{#if product.description_html}}<div class="b-rte b-block-text">{{{product.description_html}}}</div>{{/if}}
    {{/if}}
  </div>
</div>

{{!-- Sticky buy bar. ui.js shows it once the main button scrolls out of view. sticky_style "compact" = small card
      (bottom right on desktop); "full" = full-width bar with the was price, the SAVE badge and a variant select that
      drives the pickers above (ui.js initSticky). --}}
{{#unless (eq section.settings.sticky_atc false)}}
<div class="b-sticky{{#if (eq section.settings.sticky_style "full")}} b-sticky--full{{/if}}" data-sticky hidden>
  {{#if product.media.main_image}}<img class="b-sticky__img" src="{{product.media.main_image}}" alt="" loading="lazy">{{/if}}
  <div class="b-sticky__info">
    <p class="b-sticky__title">{{product.title}}</p>
    {{#if (eq section.settings.sticky_style "full")}}
    <p class="b-sticky__price"><span data-sticky-price>{{product.price}}</span>{{#if product.compare_at_price}} <s class="b-sticky__was" data-sticky-compare>{{product.compare_at_price}}</s>{{/if}}{{#if product.off_pct}} <span class="b-badge b-sticky__off" data-sticky-off>Save {{product.off_pct}}%</span>{{/if}}</p>
    {{else}}
    <p class="b-sticky__price" data-sticky-price>{{product.price}}</p>
    {{/if}}
  </div>
  {{#if (eq section.settings.sticky_style "full")}}{{#if product.variants.length}}
  <label class="b-sticky__variant"><span class="b-sr">Choose an option</span>
    <select class="b-select" data-sticky-variant>
      {{#each product.variants_list}}<option value="{{id}}">{{title}}</option>{{/each}}
    </select>
  </label>
  {{/if}}{{/if}}
  <button type="button" class="b-btn" data-testid="sticky-add-to-cart" data-add-to-cart data-sticky-btn>{{#if settings.tv_atc_label}}{{settings.tv_atc_label}}{{else}}Add to cart{{/if}}</button>
</div>
{{/unless}}
<script src="{{@root.assets_url}}/js/tv-core.js" defer></script>
<script src="{{@root.assets_url}}/js/tv-ui.js" defer></script>
<script src="{{@root.assets_url}}/js/tv-bridge.js" defer></script>
</div>
