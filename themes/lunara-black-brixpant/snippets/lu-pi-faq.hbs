{{!-- Block FAQ (product info): the block questions, else the listing FAQ, else the Theme settings FAQ. --}}
<div class="lu-pf">{{#if settings.heading}}<h3 class="lu-pf__h">{{settings.heading}}</h3>{{/if}}{{#if settings.q_1}}{{#if settings.q_1}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_1}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_1}}}</div></details>{{/if}}{{#if settings.q_2}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_2}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_2}}}</div></details>{{/if}}{{#if settings.q_3}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_3}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_3}}}</div></details>{{/if}}{{#if settings.q_4}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_4}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_4}}}</div></details>{{/if}}{{#if settings.q_5}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_5}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_5}}}</div></details>{{/if}}{{#if settings.q_6}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_6}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_6}}}</div></details>{{/if}}{{#if settings.q_7}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_7}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_7}}}</div></details>{{/if}}{{#if settings.q_8}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{settings.q_8}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens settings.a_8}}}</div></details>{{/if}}{{else}}{{#if @root.page.faqFromListing}}{{#each @root.page.faq}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{this.q}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens this.a}}}</div></details>{{/each}}{{else}}{{#each (faqItems @root.settings)}}<details class="lu-pf__it"><summary class="lu-pf__q"><span>{{this.q}}</span><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="lu-pf__a rte">{{{applyTokens this.a}}}</div></details>{{/each}}{{/if}}{{/if}}</div><style>.lu-pf{margin:1.5rem 0}.lu-pf__h{margin:0 0 .8rem;font-size:1.8rem}.lu-pf__it{border-bottom:1px solid rgba(var(--color-foreground),.12)}.lu-pf__it:first-of-type{border-top:1px solid rgba(var(--color-foreground),.12)}.lu-pf__q{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:1.2rem 0;cursor:pointer;list-style:none;font-weight:600;font-size:1.5rem}.lu-pf__q::-webkit-details-marker{display:none}.lu-pf__q svg{flex:0 0 auto;transition:transform .2s}.lu-pf__it[open] .lu-pf__q svg{transform:rotate(180deg)}.lu-pf__a{padding:0 0 1.2rem;font-size:1.4rem;line-height:1.6}.lu-pf__a>:first-child{margin-top:0}.lu-pf__a>:last-child{margin-bottom:0}</style>
