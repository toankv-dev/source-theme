    "items": [
      {
        "name": "Janet Mercer",
        "rating": 5,
        "title": "I used to stand at my dresser every morn",
        "content": "I used to stand at my dresser every morning trying to figure out which bra worked with what I was wearing. The padded one, the wireless one, the one that does not show under white. Now I grab a tank and I am dressed. That is the whole decision. I have not opened my bra drawer in months and I do not miss it for a second.",
        "date": "Oct 3, 2026",
        "verified": true
      },
      {
        "name": "Sarah Hartley",
        "rating": 5,
        "title": "For my whole adult life the first thing ",
        "content": "For my whole adult life the first thing I did walking in the door was reach back and unhook my bra. Every single day. I have been wearing this tank for two months and the other night I realized I get into bed and there is nothing to take off. I am already comfortable. I never thought I would say that about anything I wear all day.",
        "date": "Oct 4, 2026",
        "image": "/assets/sample/grey_tank.jpg",
        "verified": true
      },
      {
        "name": "Linda White",
        "rating": 5,
        "title": "I genuinely live in this thing now. I pu",
        "content": "I genuinely live in this thing now. I put one on first thing in the morning and I have it on all day around the house, cooking, cleaning, out to the mailbox, on the couch at night. It used to be that the minute I got home I would change into something soft. Now there is nothing to change into and nothing to take off. I wear it from the time I get up until I go to sleep. I bought one in every color so I always have a clean one in the drawer.",
        "date": "Oct 5, 2026",
        "verified": true
      },
      {
        "name": "Stephanie Foren",
        "rating": 5,
        "title": "I've hated bras my entire life. Underwir",
        "content": "I've hated bras my entire life. Underwire, tight bands, bra lines — I've dealt with it all for decades. A friend recommended this tank and honestly I was skeptical. But I ordered three  since it has fit guarantee. Best thing I've bought in years.",
        "date": "Oct 6, 2026",
        "verified": true
      },
      {
        "name": "Erin Elwell",
        "rating": 5,
        "title": "Best day ever with my grandkids 💕 So com",
        "content": "Best day ever with my grandkids 💕 So comfortable I can play on the floor all day without my bra killing me. These tanks are a GAME CHANGER! 78 and finally found something that actually supports me!",
        "date": "Oct 7, 2026",
        "image": "/assets/sample/rose_tank.jpg",
        "verified": true
      }
    ]
