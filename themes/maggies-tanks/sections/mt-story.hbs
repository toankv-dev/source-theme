{{!-- Maggie's: one of the home page's story blocks on a product page (template "Maggie's product page"). Texts and
      pictures come from Theme settings → Maggie's – Home top / bottom and FAQ, the same as the home page, so they are
      edited once. On the product page a before / after picture left empty stays an upload frame (never the theme's
      sample picture). Look: assets/css/mt-story.css (generated from mt-home.css), linked ONCE by the product section
      with Look = Maggie's (one link per story block would load and parse it 8 times). Without a part: before & after. --}}
<div class="mt-home mt-story">
{{#if (eq section.settings.part "changed")}}{{> mt-changed}}{{/if}}
{{#if (eq section.settings.part "routine")}}{{> mt-routine}}{{/if}}
{{#if (eq section.settings.part "compare")}}{{> mt-compare}}<script src="{{@root.assets_url}}/js/mt-home.js" defer></script>{{/if}}
{{#if (eq section.settings.part "comfort")}}{{> mt-comfort}}{{/if}}
{{#if (eq section.settings.part "faq")}}{{> mt-faq}}{{/if}}
{{#if (eq section.settings.part "last")}}{{> mt-last}}{{/if}}
{{#if (eq section.settings.part "before_after")}}{{> mt-ba slot=true nocta=true}}{{/if}}
{{#unless section.settings.part}}{{> mt-ba slot=true nocta=true}}{{/unless}}
</div>
