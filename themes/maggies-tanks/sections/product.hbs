{{!-- Main product section. Gallery on one side; every element of the info column is a block rendered in the
      merchant's order. From the legacy entry (templates/product.hbs) `section` is undefined, so the {{else}}
      branch renders title, price, options and the buy button — the page still sells without a template
      document. Pickers / buy row are wired by ui.js through data-* attributes only. --}}
{{!-- style "maggies" (template "Maggie's product page"): the home product block's look — mt-story.css (generated from
      mt-home.css) + the .mt-home variables, #mt-product for the story blocks' "Buy now" links. --}}
{{!-- "Has the landing blocks" (template "Maggie's landing"): mt-landing.css = the look of the home's hero, ticker,
      picture + text, why, list and video reviews blocks (sections/mt-story.hbs), linked once here — never by each block.
      Same line as mt-story.css on purpose: no blank line in pages without it. --}}
{{#if (eq section.settings.style "maggies")}}<link rel="stylesheet" href="{{@root.assets_url}}/css/mt-story.css">{{/if}}{{#if section.settings.landing}}<link rel="stylesheet" href="{{@root.assets_url}}/css/mt-landing.css">{{/if}}
<div class="b-wrap b-pdp b-pdp--gallery-{{#if section.settings.gallery_side}}{{section.settings.gallery_side}}{{else}}left{{/if}}{{#if (eq section.settings.style "maggies")}} b-pdp--mt mt-home{{/if}}" data-pdp>
  <div class="b-gallery b-gallery--{{#if section.settings.gallery_layout}}{{section.settings.gallery_layout}}{{else}}thumbs{{/if}}" data-gallery>
    <div class="b-gallery__main">
      {{#if product.media.main_image}}
      <img data-gallery-main src="{{product.media.main_image}}" alt="{{product.title}}" fetchpriority="high">
      {{/if}}
      {{#if section.settings.gallery_caption}}<span class="b-gallery__caption">{{section.settings.gallery_caption}}</span>{{/if}}
      {{#if product.off_pct}}{{#unless (eq section.settings.show_sale_badge false)}}<span class="b-badge b-gallery__badge" data-off-badge>{{#if (eq section.settings.sale_badge_style "off")}}{{product.off_pct}}% OFF{{else}}-{{product.off_pct}}%{{/if}}</span>{{/unless}}{{/if}}
    </div>
    {{#if product.media.gallery.length}}
    <div class="b-gallery__strip">
      <button type="button" class="b-round-btn" data-gallery-step="-1" aria-label="Previous image">‹</button>
      <div class="b-gallery__thumbs" data-gallery-thumbs>
        {{#each product.media.gallery}}
        <button type="button" class="b-thumb{{#if @first}} is-active{{/if}}" data-gallery-thumb="{{url}}" aria-label="Show image {{@index}}">
          {{!-- A video's thumbnail is its poster (else the platform turns the <img> into a playing video). --}}
          <img src="{{#if thumb_url}}{{thumb_url}}{{else}}{{#if is_video}}{{#if poster_url}}{{poster_url}}{{else}}{{url}}{{/if}}{{else}}{{url}}{{/if}}{{/if}}" alt="{{alt}}" loading="lazy">
        </button>
        {{/each}}
      </div>
      <button type="button" class="b-round-btn" data-gallery-step="1" aria-label="Next image">›</button>
    </div>
    {{/if}}
  </div>

  <div class="b-info"{{#if (eq section.settings.style "maggies")}} id="mt-product"{{/if}}>
    {{#if section.blocks.length}}
    {{#each section.blocks}}
      {{#if (eq this.type "award")}}
      <p class="b-award" {{{this.attributes}}}>{{#if this.settings.icon}}{{this.settings.icon}} {{/if}}{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "mt_intro")}}
      {{!-- Maggie's intro: #1 badge, headline, product name, ✓ lines. Empty settings → the home product block's
            (Theme settings → Maggie's – Home middle → Product). An empty badge is an upload frame, never a sample. --}}
      <div class="mt-intro" {{{this.attributes}}}>
        {{#if this.settings.badge}}<img class="mt-product__badge" src="{{this.settings.badge}}" alt="#1 Bestseller" width="320" height="65">{{else if @root.settings.mt_prod_badge}}<img class="mt-product__badge" src="{{@root.settings.mt_prod_badge}}" alt="#1 Bestseller" width="320" height="65">{{else}}<div class="mt-product__badge b-ph b-ph--mt-badge">{{#if @root.__designMode}}Upload the #1 badge picture (640 × 130){{/if}}</div>{{/if}}
        <p class="mt-product__title">{{#if this.settings.heading}}{{this.settings.heading}}{{else}}{{@root.settings.mt_prod_title}}{{/if}}</p>
        <h1 class="mt-product__name">{{@root.product.title}}</h1>
        <ul class="mt-product__ticks">
          {{#if this.settings.tick_1}}<li>{{{this.settings.tick_1}}}</li>{{else if @root.settings.mt_prod_tick_1}}<li>{{{@root.settings.mt_prod_tick_1}}}</li>{{/if}}
          {{#if this.settings.tick_2}}<li>{{{this.settings.tick_2}}}</li>{{else if @root.settings.mt_prod_tick_2}}<li>{{{@root.settings.mt_prod_tick_2}}}</li>{{/if}}
          {{#if this.settings.tick_3}}<li>{{{this.settings.tick_3}}}</li>{{else if @root.settings.mt_prod_tick_3}}<li>{{{@root.settings.mt_prod_tick_3}}}</li>{{/if}}
          {{#if this.settings.tick_4}}<li>{{{this.settings.tick_4}}}</li>{{else if @root.settings.mt_prod_tick_4}}<li>{{{@root.settings.mt_prod_tick_4}}}</li>{{/if}}
        </ul>
      </div>
      {{/if}}
      {{#if (eq this.type "mt_trust")}}
      {{!-- Maggie's trust lines under the button: ships row, 90-day guarantee (seal = trust icon), founder quote. Empty
            settings → the home product block's (Theme settings → Maggie's – Home middle → Product). --}}
      <div class="mt-trust" {{{this.attributes}}}>
        <p class="mt-product__ships"><span><i class="mt-dot" aria-hidden="true"></i>{{#if this.settings.ships}}{{this.settings.ships}}{{else}}{{@root.settings.mt_prod_ships}}{{/if}}</span><span>{{#if this.settings.free}}{{{this.settings.free}}}{{else}}{{{@root.settings.mt_prod_free}}}{{/if}}</span></p>
        <div class="mt-product__guarantee">
          <img src="{{@root.assets_url}}/images/mt/seal-90.webp" alt="" width="52" height="52" loading="lazy">
          <div><p class="mt-product__g-title">{{#if this.settings.g_title}}{{this.settings.g_title}}{{else}}{{@root.settings.mt_prod_g_title}}{{/if}}</p><p class="mt-product__g-text">{{#if this.settings.g_text}}{{{this.settings.g_text}}}{{else}}{{{@root.settings.mt_prod_g_text}}}{{/if}}</p></div>
        </div>
        {{!-- Each founder field falls back on its own (a name typed here shows even when the quote comes from Theme settings). --}}
        {{#if this.settings.quote}}{{> mt-founder quote=this.settings.quote name=this.settings.founder name_def=@root.settings.mt_prod_founder role=this.settings.role role_def=@root.settings.mt_prod_role avatar=this.settings.avatar}}{{else if @root.settings.mt_prod_quote}}{{> mt-founder quote=@root.settings.mt_prod_quote name=this.settings.founder name_def=@root.settings.mt_prod_founder role=this.settings.role role_def=@root.settings.mt_prod_role avatar=this.settings.avatar}}{{/if}}
      </div>
      {{/if}}
      {{#if (eq this.type "rating")}}
      {{#if @root.product.reviews.summary.total_count}}
      <a class="b-rating" href="#reviews" {{{this.attributes}}}>
        <span class="b-stars" style="--r:{{@root.product.reviews.summary.average_rating}}" aria-hidden="true"></span>
        <strong>{{@root.product.reviews.summary.average_rating}}</strong>
        <span class="b-rating__sep">|</span>
        <span>{{@root.product.reviews.summary.total_count}} {{#if this.settings.label}}{{this.settings.label}}{{else}}reviews{{/if}}</span>
      </a>
      {{/if}}
      {{/if}}
      {{#if (eq this.type "title")}}
      <h1 class="b-info__title" {{{this.attributes}}}>{{@root.product.title}}</h1>
      {{/if}}
      {{#if (eq this.type "subtitle")}}
      <p class="b-subtitle" {{{this.attributes}}}>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "benefit")}}
      <p class="b-benefit" {{{this.attributes}}}><span class="b-check" aria-hidden="true">✓</span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "stock")}}
      <p class="b-stock" {{{this.attributes}}}><span class="b-stock__dot" aria-hidden="true"></span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "urgency")}}
      {{!-- "{n}" in the text becomes a number between min and max that drifts a little (people viewing now). --}}
      <p class="b-urgency" {{{this.attributes}}} data-urgency data-min="{{this.settings.min}}" data-max="{{this.settings.max}}" data-text="{{this.settings.text}}">{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "offer_heading")}}
      <p class="b-offer" {{{this.attributes}}}><span>{{this.settings.text}}</span></p>
      {{/if}}
      {{#if (eq this.type "price")}}
      <div {{{this.attributes}}}>{{> price}}</div>
      {{/if}}
      {{#if (eq this.type "variant_picker")}}
      <div class="b-picker" {{{this.attributes}}}>{{> options}}</div>
      {{/if}}
      {{#if (eq this.type "variant_cards")}}
      {{> pack-cards this}}
      {{/if}}
      {{#if (eq this.type "buy_buttons")}}
      <div class="b-buy" {{{this.attributes}}}>
        {{#unless (eq this.settings.show_options false)}}{{> options hide_pickers=this.settings.hide_options}}{{/unless}}
        {{> buy-row label=this.settings.label mode=this.settings.mode show_qty=this.settings.show_qty}}
        {{#if this.settings.note}}<p class="b-buy__note">{{this.settings.note}}</p>{{/if}}
        {{#unless (eq this.settings.show_payments false)}}{{> pay-icons}}{{/unless}}
      </div>
      {{/if}}
      {{#if (eq this.type "trust_icons")}}
      <ul class="b-trust" {{{this.attributes}}}>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" stroke="currentColor" stroke-width="1.6" fill="none"/></svg><span>{{this.settings.label_1}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="9" y="10.5" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M10.2 10.5V9.3a1.8 1.8 0 0 1 3.6 0v1.2" stroke="currentColor" stroke-width="1.4" fill="none"/></svg><span>{{this.settings.label_2}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/><circle cx="17" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/></svg><span>{{this.settings.label_3}}</span></li>
      </ul>
      {{/if}}
      {{#if (eq this.type "review")}}
      {{#each (limit @root.product.reviews.items 1)}}
      <figure class="b-quote" {{{../attributes}}}>
        {{#if image}}<img class="b-quote__img" src="{{image}}" alt="" loading="lazy">{{/if}}
        <figcaption>
          <span class="b-stars b-stars--sm" style="--r:{{rating}}" aria-label="{{rating}} out of 5"></span>
          <p class="b-quote__text">{{content}}</p>
          <p class="b-quote__who"><strong>{{name}}</strong>{{#if verified}} · <span class="b-verified">Verified buyer</span>{{/if}}</p>
        </figcaption>
      </figure>
      {{/each}}
      {{/if}}
      {{#if (eq this.type "accordion")}}
      <details class="b-acc" {{{this.attributes}}}{{#if this.settings.open}} open{{/if}}>
        <summary>{{this.settings.title}}</summary>
        <div class="b-acc__body b-rte">
          {{#if (eq this.settings.source "description")}}{{{@root.product.description_html}}}{{/if}}
          {{#if (eq this.settings.source "custom")}}{{{applyTokens this.settings.body}}}{{/if}}
        </div>
      </details>
      {{/if}}
      {{#if (eq this.type "description")}}
      <div class="b-rte b-block-text b-description" {{{this.attributes}}}>{{{@root.product.description_html}}}</div>
      {{/if}}
      {{#if (eq this.type "text")}}
      <div class="b-rte b-block-text" {{{this.attributes}}}>{{{applyTokens this.settings.body}}}</div>
      {{/if}}
      {{#if (eq this.type "image")}}
      {{#if this.settings.image}}<img class="b-block-image" {{{this.attributes}}} src="{{this.settings.image}}" alt="{{this.settings.alt}}" loading="lazy">{{else}}<div class="b-block-image b-ph b-ph--block" {{{this.attributes}}}>{{#if @root.__designMode}}Upload an image{{/if}}</div>{{/if}}
      {{/if}}
      {{#if (eq this.type "divider")}}
      <hr class="b-divider" {{{this.attributes}}}>
      {{/if}}
      {{#if (eq this.type "custom_html")}}
      <div class="b-custom-html" {{{this.attributes}}}>{{{this.settings.html}}}</div>
      {{/if}}
      {{#if (eq this.type "media_slider")}}
      {{!-- Up to 10 images / videos side by side (data-reels in ui.js). A video file picked in an image slot
            is turned into a muted looping <video> (by the server, else by ui.js). Slots 1..`slots` with no file
            keep an empty frame (upload hint in the editor); empty slots past `slots` are skipped. --}}
      <div class="b-mslider" {{{this.attributes}}} data-reels style="--pv:{{#if this.settings.per_view}}{{this.settings.per_view}}{{else}}3{{/if}};--pvm:{{#if this.settings.per_view_mobile}}{{this.settings.per_view_mobile}}{{else}}1.5{{/if}};--gap:{{#if this.settings.gap}}{{this.settings.gap}}{{else}}0{{/if}}px;--r:{{#if this.settings.radius}}{{this.settings.radius}}{{else}}0{{/if}}px;--ar:{{#if this.settings.ratio}}{{this.settings.ratio}}{{else}}9/16{{/if}}">
        {{#if this.settings.heading}}<h3 class="b-mslider__h">{{this.settings.heading}}</h3>{{/if}}
        <div class="b-mslider__vp">
          <div class="b-mslider__track" data-reels-track>
            {{#if this.settings.media_1}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_1}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 0)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_2}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_2}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 1)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_3}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_3}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 2)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_4}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_4}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 3)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_5}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_5}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 4)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_6}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_6}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 5)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_7}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_7}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 6)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_8}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_8}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 7)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_9}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_9}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 8)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_10}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_10}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 9)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
          </div>
          {{#unless (eq this.settings.show_arrows false)}}
          <div class="b-mslider__nav" data-reels-nav hidden>
            <button type="button" class="b-round-btn" data-reels-step="-1" aria-label="Previous">‹</button>
            <button type="button" class="b-round-btn" data-reels-step="1" aria-label="Next">›</button>
          </div>
          {{/unless}}
        </div>
      </div>
      {{/if}}
      {{#if (eq this.type "faq")}}
      {{!-- Own questions when question 1 is filled, else the store's FAQ (snippets/faq-list.hbs). --}}
      <div class="b-pfaq" {{{this.attributes}}}>
        {{#if this.settings.heading}}<h3 class="b-pfaq__h">{{this.settings.heading}}</h3>{{/if}}
        {{#if this.settings.q_1}}
        {{> faq-qa q=this.settings.q_1 a=this.settings.a_1}}
        {{> faq-qa q=this.settings.q_2 a=this.settings.a_2}}
        {{> faq-qa q=this.settings.q_3 a=this.settings.a_3}}
        {{> faq-qa q=this.settings.q_4 a=this.settings.a_4}}
        {{> faq-qa q=this.settings.q_5 a=this.settings.a_5}}
        {{> faq-qa q=this.settings.q_6 a=this.settings.a_6}}
        {{else}}
        {{> faq-list}}
        {{/if}}
      </div>
      {{/if}}
      {{#if (eq this.type "size_chart")}}
      {{!-- Size chart. mode "finder" (default): the size finder that opens in place (snippets/mt-size-finder.hbs; size
            table + texts: Theme settings → Maggie's – Home middle → Size chart & size finder, shared with the home page;
            no table → hidden on the live store). mode "popup": "Size guide" link + popup (snippets/mt-size-chart.hbs;
            picture / text left empty → the same Theme settings; nothing anywhere → hidden on the live store). Both:
            with an option name set, only on products that have that option. Shown in the editor with a hint. --}}
      {{#if (eq this.settings.mode "popup")}}
      <div class="b-sizechart" {{{this.attributes}}} data-size-chart data-option="{{this.settings.option_name}}" data-options="{{#each @root.product.variants}}{{name}}|{{/each}}"{{#unless this.settings.image}}{{#unless this.settings.body}}{{#unless @root.settings.mt_size_image}}{{#unless @root.settings.mt_size_text}}{{#unless @root.__designMode}} hidden{{/unless}}{{/unless}}{{/unless}}{{/unless}}{{/unless}}>
        {{> mt-size-chart label=this.settings.label title=this.settings.title image=this.settings.image text=this.settings.body}}
      </div>
      {{else}}
      <div class="b-sizechart b-sizechart--finder" {{{this.attributes}}} data-size-chart data-option="{{this.settings.option_name}}" data-options="{{#each @root.product.variants}}{{name}}|{{/each}}"{{#unless @root.settings.mt_sf_table}}{{#unless @root.__designMode}} hidden{{/unless}}{{/unless}}>
        {{#if @root.settings.mt_sf_table}}{{> mt-size-finder label=this.settings.label}}{{else}}{{#if @root.__designMode}}<p class="b-sizechart__hint">Size finder: add your size table in Theme settings → Maggie's – Home middle → Size chart &amp; size finder. Hidden on the live store until then.</p>{{/if}}{{/if}}
      </div>
      {{/if}}
      {{/if}}
    {{/each}}
    {{else}}
    <h1 class="b-info__title">{{product.title}}</h1>
    {{> price}}
    <div class="b-buy">
      {{> options}}
      {{> buy-row}}
    </div>
    {{#if product.description_html}}<div class="b-rte b-block-text">{{{product.description_html}}}</div>{{/if}}
    {{/if}}
  </div>
</div>

{{!-- Sticky buy bar. ui.js shows it once the main button scrolls out of view. sticky_style "compact" = small card
      (bottom right on desktop); "full" = full-width bar with the was price, the SAVE badge and a variant select that
      drives the pickers above (ui.js initSticky). --}}
{{#unless (eq section.settings.sticky_atc false)}}
<div class="b-sticky{{#if (eq section.settings.sticky_style "full")}} b-sticky--full{{/if}}" data-sticky hidden>
  {{#if product.media.main_image}}<img class="b-sticky__img" src="{{product.media.main_image}}" alt="" loading="lazy">{{/if}}
  <div class="b-sticky__info">
    <p class="b-sticky__title">{{product.title}}</p>
    {{#if (eq section.settings.sticky_style "full")}}
    <p class="b-sticky__price"><span data-sticky-price>{{product.price}}</span>{{#if product.compare_at_price}} <s class="b-sticky__was" data-sticky-compare>{{product.compare_at_price}}</s>{{/if}}{{#if product.off_pct}} <span class="b-badge b-sticky__off" data-sticky-off>Save {{product.off_pct}}%</span>{{/if}}</p>
    {{else}}
    <p class="b-sticky__price" data-sticky-price>{{product.price}}</p>
    {{/if}}
  </div>
  {{#if (eq section.settings.sticky_style "full")}}{{#if product.variants.length}}
  <label class="b-sticky__variant"><span class="b-sr">Choose an option</span>
    <select class="b-select" data-sticky-variant>
      {{#each product.variants_list}}<option value="{{id}}">{{title}}</option>{{/each}}
    </select>
  </label>
  {{/if}}{{/if}}
  {{!-- Look = Maggie's has the buy box #mt-product: the bar's button goes there. Any other look keeps Add to cart. --}}
  {{#if (eq section.settings.style "maggies")}}
  {{> mt-sticky-go}}
  {{else}}
  <button type="button" class="b-btn" data-testid="sticky-add-to-cart" data-add-to-cart data-sticky-btn>{{#if settings.atc_label}}{{settings.atc_label}}{{else}}Add to cart{{/if}}</button>
  {{/if}}
</div>
{{/unless}}
