{{!-- Maggie's: founder quote of the product block "mt_trust" (quote = HTML, name, role, avatar = uploaded picture;
      empty → an empty round frame, never the theme's sample picture on the product page). name / role = the block's
      field, name_def / role_def = Theme settings → Maggie's – Home middle (used when the block's field is empty). --}}
<blockquote class="mt-product__quote">
  <p>{{{quote}}}</p>
  <footer>{{#if avatar}}<img src="{{avatar}}" alt="" width="44" height="44" loading="lazy">{{else}}<span class="b-ph b-ph--mt-avatar" aria-hidden="true"></span>{{/if}}<span><strong>{{#if name}}{{name}}{{else}}{{name_def}}{{/if}}</strong><small>{{#if role}}{{role}}{{else}}{{role_def}}{{/if}}</small></span></footer>
</blockquote>
