      whatever the home page shows. Same head / scripts as templates/index.hbs (Home page = Maggie's landing);
      items = the collection's products (the buy box sells the first). --}}
<!doctype html>
<html lang="en">
<head>
{{> head}}
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{assets_url}}/fonts/pxiEyp8kv8JHgFVrJJfecg.woff2">
<link rel="stylesheet" href="{{assets_url}}/css/mt-home.css">
</head>
<body class="b-body b-body--home b-body--landing">
{{{trackingBody}}}
<a class="b-skip" href="#MainContent">Skip to content</a>
{{> header}}
{{> mt-landing-main items=items}}
{{> footer}}
{{> scripts}}
<script src="{{assets_url}}/js/mt-home.js" defer></script>
</body>
</html>
