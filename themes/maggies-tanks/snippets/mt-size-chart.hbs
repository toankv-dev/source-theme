{{!-- Maggie's: "Size Chart" button + popup, used by the home product block (templates/index.hbs) and by the product
      section's size_chart block. label / title / image / text = the block's fields; each one left empty → Theme settings
      → Maggie's – Home middle → Size chart & size finder (mt_size_*; popup title = the button text), so the chart is uploaded once for both pages. Callers pass all
      four (empty string when none): a partial also sees the caller's context, where "title" is the product's title.
      The caller decides whether the button shows at all (no picture and no text anywhere = no button on the live site). --}}
<button type="button" class="b-sizechart__link" data-modal-open>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2.5 8.5h19v7h-19z M6 8.5v3 M9.5 8.5v2 M13 8.5v3 M16.5 8.5v2 M20 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  <span>{{#if label}}{{label}}{{else if @root.settings.mt_size_label}}{{@root.settings.mt_size_label}}{{else}}Size guide{{/if}}</span>
</button>
<div class="b-modal" data-modal hidden role="dialog" aria-modal="true" aria-label="{{#if title}}{{title}}{{else if @root.settings.mt_size_label}}{{@root.settings.mt_size_label}}{{else}}Size chart{{/if}}">
  <div class="b-modal__overlay" data-modal-close></div>
  <div class="b-modal__panel b-sizechart__panel">
    <button type="button" class="b-icon-btn b-modal__close" data-modal-close aria-label="Close">✕</button>
    <p class="b-sizechart__title">{{#if title}}{{title}}{{else if @root.settings.mt_size_label}}{{@root.settings.mt_size_label}}{{else}}Size chart{{/if}}</p>
    {{#if image}}<img class="b-sizechart__img" src="{{image}}" alt="Size chart" loading="lazy">{{else if @root.settings.mt_size_image}}<img class="b-sizechart__img" src="{{@root.settings.mt_size_image}}" alt="Size chart" loading="lazy">{{/if}}
    {{#if text}}<div class="b-rte">{{{applyTokens text}}}</div>{{else if @root.settings.mt_size_text}}<div class="b-rte">{{{applyTokens @root.settings.mt_size_text}}}</div>{{/if}}
    {{#unless image}}{{#unless text}}{{#unless @root.settings.mt_size_image}}{{#unless @root.settings.mt_size_text}}{{#if @root.__designMode}}<p class="b-sizechart__hint">No size chart yet: upload a picture in this block or in Theme settings → Maggie's – Home middle → Size chart &amp; size finder. Hidden on the live store until then.</p>{{/if}}{{/unless}}{{/unless}}{{/unless}}{{/unless}}
  </div>
</div>
