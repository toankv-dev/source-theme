{{!-- Main menu links, shared by the desktop nav and the mobile drawer. ui.js marks the current page.
      All products = the home page (the simple home lists every product) or, with Theme settings → Header → "Menu: All
      products goes to" = All products page, /collections/all-products. Then one link per collection (its page lists only
      its own products; Theme settings → Header → "Show collections in the menu"), never the Maggie's landing collection
      (Theme settings → Maggie's – Home layout → Landing link). Then Contact and Track order. The logo goes home. --}}
{{#if (eq @root.settings.nav_all_target "all")}}
<a href="{{#if @root.config.allProductsUrl}}{{@root.config.allProductsUrl}}{{else}}/collections/all-products{{/if}}" data-nav="shop" data-local-domain>{{#if @root.settings.nav_all_label}}{{@root.settings.nav_all_label}}{{else}}All products{{/if}}</a>
{{else}}
<a href="{{#if @root.config.homeUrl}}{{@root.config.homeUrl}}{{else}}{{#if @root.policyLinks.home}}{{@root.policyLinks.home}}{{else}}/{{/if}}{{/if}}" data-nav="home">{{#if @root.settings.nav_all_label}}{{@root.settings.nav_all_label}}{{else}}All products{{/if}}</a>
{{/if}}
{{#unless (eq @root.settings.nav_list_collections false)}}{{#each (limit @root.collections 6)}}{{#unless (eq handle @root.settings.mt_landing_collection)}}<a href="/collections/{{handle}}" data-nav="collection-{{handle}}" data-local-domain>{{title}}</a>{{/unless}}{{/each}}{{/unless}}
<a href="{{#if @root.policyLinks.contact}}{{@root.policyLinks.contact}}{{else}}/contact{{/if}}" data-nav="contact" data-local-domain>{{#if @root.settings.nav_contact_label}}{{@root.settings.nav_contact_label}}{{else}}Contact{{/if}}</a>
{{#unless (eq @root.settings.show_track_link false)}}<a href="{{#if @root.config.trackUrl}}{{@root.config.trackUrl}}{{else}}{{#if @root.policyLinks.track}}{{@root.policyLinks.track}}{{else}}/pages/track-your-order{{/if}}{{/if}}" data-nav="track" data-local-domain>{{#if @root.settings.nav_track_label}}{{@root.settings.nav_track_label}}{{else}}Track order{{/if}}</a>{{/unless}}
