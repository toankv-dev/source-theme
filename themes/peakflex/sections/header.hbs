{{!-- Rendered by the layout AND on its own for platform pages (contact, tracking result, order list…), where
      product is empty — read only brand / config / policyLinks / settings here. Those pages restyle a <header>
      element and hide [aria-label*="cart"], so the bar is a div role="banner" and cart labels are
      screen-reader text. The CSS variables, the cart drawer and #sf-chrome-config are printed here (not in
      the layout) so the platform's pages get them too.
      Sale bar: topbar_style "rotate" cycles messages split on "||"; "countdown" shows a title, a subtitle and
      a timer that restarts every countdown_hours hours (per visitor). --}}
{{> vars}}
{{> pf-fonts}}
{{#unless (eq settings.show_topbar false)}}
<div class="b-topbar b-topbar--{{#if (eq settings.topbar_style "countdown")}}countdown{{else}}rotate{{/if}}" role="region" aria-label="Announcements" data-topbar="{{settings.topbar_text}}" data-autoplay="{{#if (eq settings.topbar_autoplay false)}}false{{else}}true{{/if}}">
  {{#if (eq settings.topbar_style "countdown")}}
  <div class="b-wrap b-topbar__inner b-topbar__inner--countdown">
    <p class="b-topbar__title">{{#if settings.countdown_title}}{{settings.countdown_title}}{{else}}Flash sale{{/if}}</p>
    {{#if settings.countdown_subtitle}}<p class="b-topbar__sub">{{settings.countdown_subtitle}}</p>{{/if}}
    <p class="b-countdown" data-countdown data-hours="{{#if settings.countdown_hours}}{{settings.countdown_hours}}{{else}}2{{/if}}" aria-label="Time left">
      <span><b data-cd-h>00</b><small>Hours</small></span><i>:</i>
      <span><b data-cd-m>00</b><small>Min</small></span><i>:</i>
      <span><b data-cd-s>00</b><small>Sec</small></span>
    </p>
  </div>
  {{else}}
  <div class="b-wrap b-topbar__inner">
    <button type="button" class="b-topbar__arrow b-topbar__arrow--prev" data-topbar-step="-1" aria-label="Previous announcement">{{> icon-caret}}</button>
    <p class="b-topbar__text" aria-live="polite" data-topbar-text>{{#if settings.topbar_text}}{{settings.topbar_text}}{{else}}Free shipping on every order{{/if}}</p>
    <button type="button" class="b-topbar__arrow b-topbar__arrow--next" data-topbar-step="1" aria-label="Next announcement">{{> icon-caret}}</button>
  </div>
  {{/if}}
</div>
{{/unless}}
<div class="b-header{{#unless (eq settings.sticky_header false)}} b-header--sticky{{/unless}} b-header--logo-{{#if settings.logo_position}}{{settings.logo_position}}{{else}}left{{/if}}" role="banner" data-header>
  <div class="b-wrap b-header__inner">
    <button type="button" class="b-icon-btn b-header__burger" data-menu-open aria-label="Menu" aria-expanded="false" aria-controls="b-menu-drawer">
      <svg viewBox="0 0 18 16" width="20" height="20" aria-hidden="true"><path d="M1 1h16M1 8h16M1 15h16" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg>
    </button>
    <a class="b-logo" href="{{#if config.homeUrl}}{{config.homeUrl}}{{else}}{{#if policyLinks.home}}{{policyLinks.home}}{{else}}/{{/if}}{{/if}}">
      {{#if brand.logo}}<img src="{{brand.logo}}" alt="{{brand.name}}" width="140" height="40" style="max-height:{{#if settings.logo_height}}{{settings.logo_height}}{{else}}40{{/if}}px">{{else}}<span>{{brand.name}}</span>{{/if}}
    </a>
    <nav class="b-nav" aria-label="Main">{{> nav-links}}</nav>
    <div class="b-header__actions">
      {{#unless (eq settings.show_search false)}}
      <button type="button" class="b-icon-btn" data-search-open aria-label="Search" aria-haspopup="dialog">
        <svg viewBox="0 0 18 19" width="20" height="20" aria-hidden="true"><circle cx="7.5" cy="8" r="6.3" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="m12.2 12.8 5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </button>
      {{/unless}}
      {{#unless (eq settings.show_account false)}}
      <a class="b-icon-btn b-header__account" href="/pages/order-list" data-local-domain aria-label="Your orders">
        <svg viewBox="0 0 18 19" width="20" height="20" aria-hidden="true"><circle cx="9" cy="4.6" r="3.6" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M1 18c.1-5.3 2.8-6.6 8-6.6s7.9 1.3 8 6.6Z" stroke="currentColor" stroke-width="1.3" fill="none"/></svg>
      </a>
      {{/unless}}
      <button type="button" class="b-icon-btn" data-cart-open aria-haspopup="dialog"><span class="b-sr">Open cart</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 7h14l-1 12.2a1.5 1.5 0 0 1-1.5 1.3h-9a1.5 1.5 0 0 1-1.5-1.3L5 7Zm3.5 0V6a3.5 3.5 0 0 1 7 0v1" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/></svg>
        <span class="b-cart-count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>
</div>
{{> cart-drawer}}
{{!-- Platform pages have no <head> of ours: core.js falls back to this when #sf-config is missing. --}}
<script type="application/json" id="sf-chrome-config">{{{configJson}}}</script>

{{!-- Mobile menu drawer (slides in from the left). --}}
<div class="b-menu-drawer" id="b-menu-drawer" data-menu-drawer hidden>
  <div class="b-menu-drawer__overlay" data-menu-close></div>
  <nav class="b-menu-drawer__panel" aria-label="Menu">
    <button type="button" class="b-icon-btn b-menu-drawer__close" data-menu-close aria-label="Close menu">
      <svg viewBox="0 0 18 17" width="18" height="18" aria-hidden="true"><path d="m1 1 16 15M17 1 1 16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
    </button>
    <div class="b-menu-drawer__links">{{> nav-links}}</div>
    {{#unless (eq settings.show_account false)}}
    <a class="b-menu-drawer__account" href="/pages/order-list" data-local-domain>
      <svg viewBox="0 0 18 19" width="18" height="18" aria-hidden="true"><circle cx="9" cy="4.6" r="3.6" stroke="currentColor" stroke-width="1.1" fill="none"/><path d="M1 18c.1-5.3 2.8-6.6 8-6.6s7.9 1.3 8 6.6Z" stroke="currentColor" stroke-width="1.1" fill="none"/></svg>
      Your orders
    </a>
    {{/unless}}
  </nav>
</div>

{{!-- Search dialog: submits to the platform's /search page (templates/search.hbs filters by ?q=). --}}
{{#unless (eq settings.show_search false)}}
<div class="b-search" data-search hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="b-search__overlay" data-search-close></div>
  <form class="b-wrap b-search__form" action="{{#if config.searchUrl}}{{config.searchUrl}}{{else}}/search{{/if}}" method="get" role="search" data-search-form>
    {{#if config.domain}}<input type="hidden" name="domain" value="{{config.domain}}" data-local-only>{{/if}}
    <label class="b-search__field">
      <span class="b-search__label">Search</span>
      <input type="search" name="q" placeholder="Search" autocomplete="off" data-search-input>
    </label>
    <button type="submit" class="b-icon-btn" aria-label="Search">
      <svg viewBox="0 0 18 19" width="19" height="19" aria-hidden="true"><circle cx="7.5" cy="8" r="6.3" stroke="currentColor" stroke-width="1.1" fill="none"/><path d="m12.2 12.8 5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
    </button>
    <button type="button" class="b-icon-btn" data-search-close aria-label="Close search">
      <svg viewBox="0 0 18 17" width="16" height="16" aria-hidden="true"><path d="m1 1 16 15M17 1 1 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
    </button>
  </form>
</div>
{{/unless}}
