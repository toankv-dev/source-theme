{{!-- Write-a-review dialog. ui.js posts it with Base.reviews.post (fields: rating, name, email, title, body,
      recommend, photo) and shows the server's field errors under each input. --}}
<div class="b-modal" data-review-modal hidden role="dialog" aria-modal="true" aria-labelledby="b-review-form-title">
  <div class="b-modal__overlay" data-review-close></div>
  <form class="b-modal__panel b-rform" data-review-form novalidate>
    <button type="button" class="b-icon-btn b-modal__close" data-review-close aria-label="Close">✕</button>
    <p class="b-rform__eyebrow">{{@root.product.title}}</p>
    <h2 class="b-rform__title" id="b-review-form-title">Write a review</h2>
    <fieldset class="b-rform__stars" data-review-stars>
      <legend>Your rating</legend>
      <label><input type="radio" name="rating" value="1" class="b-sr"><span aria-hidden="true">★</span><span class="b-sr">1 star</span></label><label><input type="radio" name="rating" value="2" class="b-sr"><span aria-hidden="true">★</span><span class="b-sr">2 stars</span></label><label><input type="radio" name="rating" value="3" class="b-sr"><span aria-hidden="true">★</span><span class="b-sr">3 stars</span></label><label><input type="radio" name="rating" value="4" class="b-sr"><span aria-hidden="true">★</span><span class="b-sr">4 stars</span></label><label><input type="radio" name="rating" value="5" class="b-sr"><span aria-hidden="true">★</span><span class="b-sr">5 stars</span></label>
    </fieldset>
    <p class="b-rform__err" data-err="rating"></p>
    <div class="b-rform__row">
      <label>Name<input type="text" name="name" maxlength="80" autocomplete="name" required></label>
      <label>Email<input type="email" name="email" maxlength="120" autocomplete="email"></label>
    </div>
    <p class="b-rform__err" data-err="name"></p>
    <label>Review title<input type="text" name="title" maxlength="120"></label>
    <p class="b-rform__err" data-err="title"></p>
    <label>Your review<textarea name="body" rows="5" maxlength="4000" required></textarea></label>
    <p class="b-rform__err" data-err="body"></p>
    <label class="b-rform__file">Add a photo (optional)<input type="file" name="photo" accept="image/*"></label>
    <label class="b-rform__check"><input type="checkbox" name="recommend" value="1" checked> I recommend this product</label>
    <p class="b-form-msg" data-review-msg role="status"></p>
    <button type="submit" class="b-btn b-btn--block">Submit review</button>
  </form>
</div>
