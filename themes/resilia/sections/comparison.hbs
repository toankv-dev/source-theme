{{!-- Us vs. others table. Each row block says whether each side has the feature. Resilia: product pictures
      stand on the table's top edge, a coloured middle column with a "VS" badge, and a button under it. --}}
<div class="rs-compare-band">
<div class="b-wrap b-compare">
  {{#if section.settings.heading}}<h2 class="b-h2" {{{editable "heading"}}}>{{section.settings.heading}}</h2>{{/if}}
  <div class="b-compare__table" role="table">
    <div class="b-compare__head" role="row">
      <div role="columnheader" class="b-compare__side">{{#if section.settings.ours_image}}<img src="{{section.settings.ours_image}}" alt="" loading="lazy" width="150" height="150">{{else}}{{#if section.settings.ours_theme_image}}<img src="{{@root.assets_url}}/{{section.settings.ours_theme_image}}" alt="" loading="lazy" width="150" height="150">{{/if}}{{/if}}<span>{{#if section.settings.ours_label}}{{section.settings.ours_label}}{{else}}{{@root.brand.name}}{{/if}}</span></div>
      <div role="columnheader" class="b-compare__mid">{{#if section.settings.vs_label}}<span class="rs-vs">{{section.settings.vs_label}}</span>{{/if}}</div>
      <div role="columnheader" class="b-compare__side">{{#if section.settings.theirs_image}}<img src="{{section.settings.theirs_image}}" alt="" loading="lazy" width="150" height="150">{{else}}{{#if section.settings.theirs_theme_image}}<img src="{{@root.assets_url}}/{{section.settings.theirs_theme_image}}" alt="" loading="lazy" width="150" height="150">{{/if}}{{/if}}<span>{{section.settings.theirs_label}}</span></div>
    </div>
    {{#each section.blocks}}
    <div class="b-compare__row" role="row" {{{this.attributes}}}>
      <div role="cell" class="b-compare__side">{{#if this.settings.ours}}<span class="b-yes" aria-label="Yes">✓</span>{{else}}<span class="b-no" aria-label="No">✕</span>{{/if}}</div>
      <div role="cell" class="b-compare__mid">{{this.settings.label}}</div>
      <div role="cell" class="b-compare__side">{{#if this.settings.theirs}}<span class="b-yes" aria-label="Yes">✓</span>{{else}}<span class="b-no" aria-label="No">✕</span>{{/if}}</div>
    </div>
    {{/each}}
  </div>
  {{#if section.settings.button_label}}<p class="rs-cta"><a class="b-btn rs-pill rs-pill--lg" href="{{#if section.settings.button_url}}{{section.settings.button_url}}{{else}}#MainContent{{/if}}">{{section.settings.button_label}}</a></p>{{/if}}
</div>
</div>
