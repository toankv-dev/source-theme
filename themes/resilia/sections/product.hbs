{{!-- Main product section. Gallery on one side; every element of the info column is a block rendered in the
      merchant's order. From the legacy entry (templates/product.hbs) `section` is undefined, so the {{else}}
      branch renders title, price, options and the buy button — the page still sells without a template
      document. Pickers / buy row are wired by ui.js through data-* attributes only. --}}
{{!-- Resilia: page_color repaints this page's chrome (top bar, logo, buttons, footer) in the product's own
      colour — the cinnamon page is brown while the store is green. page_tint = chosen pack / soft fills. --}}
{{#if section.settings.page_color}}<style>:root{--c-ink:{{section.settings.page_color}};--c-accent:{{section.settings.page_color}};--c-check:{{section.settings.page_color}};--c-badge:{{section.settings.page_color}};--c-sale:{{section.settings.page_color}};--c-topbar-bg:{{section.settings.page_color}};--c-footer-bg:{{section.settings.page_color}};--c-header-text:{{section.settings.page_color}};--rs-head:{{section.settings.page_color}};{{#if section.settings.page_tint}}--rs-tint:{{section.settings.page_tint}};{{/if}} }</style>{{/if}}
<div class="b-wrap b-pdp b-pdp--gallery-{{#if section.settings.gallery_side}}{{section.settings.gallery_side}}{{else}}left{{/if}}" data-pdp>
  <div class="b-gallery b-gallery--{{#if section.settings.gallery_layout}}{{section.settings.gallery_layout}}{{else}}thumbs{{/if}}" data-gallery>
    <div class="b-gallery__main">
      {{#if product.media.main_image}}
      <img data-gallery-main src="{{product.media.main_image}}" alt="{{product.title}}" fetchpriority="high">
      {{/if}}
      {{#if product.off_pct}}{{#unless (eq section.settings.show_sale_badge false)}}<span class="b-badge b-gallery__badge" data-off-badge>{{#if (eq section.settings.sale_badge_style "off")}}{{product.off_pct}}% OFF{{else}}-{{product.off_pct}}%{{/if}}</span>{{/unless}}{{/if}}
    </div>
    {{#if product.media.gallery.length}}
    <div class="b-gallery__strip">
      <button type="button" class="b-round-btn" data-gallery-step="-1" aria-label="Previous image">‹</button>
      <div class="b-gallery__thumbs" data-gallery-thumbs>
        {{#each product.media.gallery}}
        <button type="button" class="b-thumb{{#if @first}} is-active{{/if}}" data-gallery-thumb="{{url}}" aria-label="Show image {{@index}}">
          {{!-- A video's thumbnail is its poster (else the platform turns the <img> into a playing video). --}}
          <img src="{{#if thumb_url}}{{thumb_url}}{{else}}{{#if is_video}}{{#if poster_url}}{{poster_url}}{{else}}{{url}}{{/if}}{{else}}{{url}}{{/if}}{{/if}}" alt="{{alt}}" loading="lazy">
        </button>
        {{/each}}
      </div>
      <button type="button" class="b-round-btn" data-gallery-step="1" aria-label="Next image">›</button>
    </div>
    {{/if}}
  </div>

  <div class="b-info">
    {{#if section.blocks.length}}
    {{#each section.blocks}}
      {{#if (eq this.type "award")}}
      <p class="b-award" {{{this.attributes}}}>{{#if this.settings.icon}}{{this.settings.icon}} {{/if}}{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "rs_rating")}}
      <p class="rs-rating" {{{this.attributes}}}>
        <span class="b-stars rs-rating__stars" style="--r:5" aria-hidden="true"></span>
        <span class="rs-rating__label">{{#if this.settings.label}}{{this.settings.label}}{{else}}Rated{{/if}} {{#if @root.product.reviews.summary.average_rating}}{{@root.product.reviews.summary.average_rating}}{{else}}{{this.settings.fallback}}{{/if}}</span>
        {{#if this.settings.avatars}}<img class="rs-rating__faces" src="{{this.settings.avatars}}" alt="" width="95" height="18">{{else}}{{#if this.settings.theme_avatars}}<img class="rs-rating__faces" src="{{@root.assets_url}}/{{this.settings.theme_avatars}}" alt="" width="95" height="18">{{/if}}{{/if}}
      </p>
      {{/if}}
      {{#if (eq this.type "rs_price")}}
      {{!-- Price row that follows the chosen pack (assets/js/rs.js): label · price · was · "<prefix> $saved". --}}
      <div class="rs-price" data-rs-price {{{this.attributes}}}>
        {{#if this.settings.label}}<span class="rs-price__label">{{this.settings.label}}</span>{{/if}}
        <span class="rs-price__box">
          <span class="rs-price__nums"><span class="rs-price__now" data-rs-now>{{@root.product.price}}</span>{{#if @root.product.compare_at_price}} <s class="rs-price__was" data-rs-was>{{@root.product.compare_at_price}}</s>{{/if}}</span>
          <span class="rs-price__badge" data-rs-save data-prefix="{{this.settings.badge_prefix}}" hidden></span>
        </span>
      </div>
      {{/if}}
      {{#if (eq this.type "rs_gifts")}}
      {{!-- "Gifts unlocked": a free-shipping tile + the product's free-gift tiers (product.gift_offers), locked
            until the chosen pack reaches them (assets/js/rs.js). --}}
      <div class="rs-gifts" data-rs-gifts data-locked="{{#if this.settings.locked_label}}{{this.settings.locked_label}}{{else}}Locked{{/if}}" {{{this.attributes}}}>
        <p class="rs-gifts__title">{{#if this.settings.title}}{{this.settings.title}}{{else}}Gifts unlocked{{/if}}</p>
        <div class="rs-gifts__row" data-rs-gifts-row>
          {{#if this.settings.ship_label}}
          <div class="rs-gift" data-rs-gift data-min="{{#if this.settings.ship_min}}{{this.settings.ship_min}}{{else}}1{{/if}}">
            <span class="rs-gift__img">{{#if this.settings.ship_image}}<img src="{{this.settings.ship_image}}" alt="" loading="lazy">{{else}}{{#if this.settings.ship_theme_image}}<img src="{{@root.assets_url}}/{{this.settings.ship_theme_image}}" alt="" loading="lazy">{{/if}}{{/if}}</span>
            {{#if this.settings.ship_was}}<s class="rs-gift__was">{{this.settings.ship_was}}</s>{{/if}}
            <span class="rs-gift__name">{{this.settings.ship_label}}</span>
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}
      {{#if (eq this.type "rs_delivery")}}
      <p class="rs-delivery" data-rs-delivery data-days="{{#if this.settings.days}}{{this.settings.days}}{{else}}3{{/if}}" {{{this.attributes}}}>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M10 5v5.2l3.2 2" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
        <span>{{#if this.settings.label}}{{this.settings.label}}{{else}}Order now for delivery by:{{/if}} <strong data-rs-date></strong></span>
      </p>
      {{/if}}
      {{#if (eq this.type "rs_note")}}
      <p class="rs-note" {{{this.attributes}}}>
        {{#if this.settings.text_1}}<span><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M13.5 8A5.5 5.5 0 1 1 11.9 4M13.6 2v3h-3" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>{{this.settings.text_1}}</span>{{/if}}
        {{#if this.settings.text_2}}<span class="rs-note__sep" aria-hidden="true">|</span><span><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><circle cx="8" cy="8" r="6.3" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M8 4.8v6.4M4.8 8h6.4" stroke="currentColor" stroke-width="1.3"/></svg>{{this.settings.text_2}}</span>{{/if}}
      </p>
      {{/if}}
      {{#if (eq this.type "rating")}}
      {{#if @root.product.reviews.summary.total_count}}
      <a class="b-rating" href="#reviews" {{{this.attributes}}}>
        <span class="b-stars" style="--r:{{@root.product.reviews.summary.average_rating}}" aria-hidden="true"></span>
        <strong>{{@root.product.reviews.summary.average_rating}}</strong>
        <span class="b-rating__sep">|</span>
        <span>{{@root.product.reviews.summary.total_count}} {{#if this.settings.label}}{{this.settings.label}}{{else}}reviews{{/if}}</span>
      </a>
      {{/if}}
      {{/if}}
      {{#if (eq this.type "title")}}
      <h1 class="b-info__title" {{{this.attributes}}}>{{@root.product.title}}</h1>
      {{/if}}
      {{#if (eq this.type "subtitle")}}
      <p class="b-subtitle" {{{this.attributes}}}>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "benefit")}}
      <p class="b-benefit" {{{this.attributes}}}><span class="b-check" aria-hidden="true">✓</span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "stock")}}
      <p class="b-stock" {{{this.attributes}}}><span class="b-stock__dot" aria-hidden="true"></span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "urgency")}}
      {{!-- "{n}" in the text becomes a number between min and max that drifts a little (people viewing now). --}}
      <p class="b-urgency" {{{this.attributes}}} data-urgency data-min="{{this.settings.min}}" data-max="{{this.settings.max}}" data-text="{{this.settings.text}}">{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "offer_heading")}}
      <p class="b-offer" {{{this.attributes}}}><span>{{this.settings.text}}</span></p>
      {{/if}}
      {{#if (eq this.type "price")}}
      <div {{{this.attributes}}}>{{> price}}</div>
      {{/if}}
      {{#if (eq this.type "variant_picker")}}
      <div class="b-picker" {{{this.attributes}}}>{{> options}}</div>
      {{/if}}
      {{#if (eq this.type "variant_cards")}}
      {{> pack-cards this}}
      {{/if}}
      {{#if (eq this.type "buy_buttons")}}
      <div class="b-buy" {{{this.attributes}}}>
        {{#unless (eq this.settings.show_options false)}}{{> options}}{{/unless}}
        {{> buy-row label=this.settings.label mode=this.settings.mode show_qty=this.settings.show_qty}}
        {{#if this.settings.note}}<p class="b-buy__note">{{this.settings.note}}</p>{{/if}}
        {{#unless (eq this.settings.show_payments false)}}{{> pay-icons}}{{/unless}}
      </div>
      {{/if}}
      {{#if (eq this.type "trust_icons")}}
      <ul class="b-trust" {{{this.attributes}}}>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" stroke="currentColor" stroke-width="1.6" fill="none"/></svg><span>{{this.settings.label_1}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="9" y="10.5" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M10.2 10.5V9.3a1.8 1.8 0 0 1 3.6 0v1.2" stroke="currentColor" stroke-width="1.4" fill="none"/></svg><span>{{this.settings.label_2}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/><circle cx="17" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/></svg><span>{{this.settings.label_3}}</span></li>
      </ul>
      {{/if}}
      {{#if (eq this.type "review")}}
      {{#each (limit @root.product.reviews.items 1)}}
      <figure class="b-quote" {{{../attributes}}}>
        {{#if image}}<img class="b-quote__img" src="{{image}}" alt="" loading="lazy">{{/if}}
        <figcaption>
          <span class="b-stars b-stars--sm" style="--r:{{rating}}" aria-label="{{rating}} out of 5"></span>
          <p class="b-quote__text">{{content}}</p>
          <p class="b-quote__who"><strong>{{name}}</strong>{{#if verified}} · <span class="b-verified">Verified buyer</span>{{/if}}</p>
        </figcaption>
      </figure>
      {{/each}}
      {{/if}}
      {{#if (eq this.type "accordion")}}
      <details class="b-acc" {{{this.attributes}}}{{#if this.settings.open}} open{{/if}}>
        <summary>{{this.settings.title}}</summary>
        <div class="b-acc__body b-rte">
          {{#if (eq this.settings.source "description")}}{{{@root.product.description_html}}}{{/if}}
          {{#if (eq this.settings.source "custom")}}{{{applyTokens this.settings.body}}}{{/if}}
        </div>
      </details>
      {{/if}}
      {{#if (eq this.type "description")}}
      <div class="b-rte b-block-text b-description" {{{this.attributes}}}>{{{@root.product.description_html}}}</div>
      {{/if}}
      {{#if (eq this.type "text")}}
      <div class="b-rte b-block-text" {{{this.attributes}}}>{{{applyTokens this.settings.body}}}</div>
      {{/if}}
      {{#if (eq this.type "image")}}
      {{#if this.settings.image}}<img class="b-block-image" {{{this.attributes}}} src="{{this.settings.image}}" alt="{{this.settings.alt}}" loading="lazy">{{/if}}
      {{/if}}
      {{#if (eq this.type "divider")}}
      <hr class="b-divider" {{{this.attributes}}}>
      {{/if}}
      {{#if (eq this.type "custom_html")}}
      <div class="b-custom-html" {{{this.attributes}}}>{{{this.settings.html}}}</div>
      {{/if}}
      {{#if (eq this.type "media_slider")}}
      {{!-- Up to 10 images / videos side by side (data-reels in ui.js). A video file picked in an image slot
            is turned into a muted looping <video> (by the server, else by ui.js). --}}
      <div class="b-mslider" {{{this.attributes}}} data-reels style="--pv:{{#if this.settings.per_view}}{{this.settings.per_view}}{{else}}3{{/if}};--pvm:{{#if this.settings.per_view_mobile}}{{this.settings.per_view_mobile}}{{else}}1.5{{/if}};--gap:{{#if this.settings.gap}}{{this.settings.gap}}{{else}}0{{/if}}px;--r:{{#if this.settings.radius}}{{this.settings.radius}}{{else}}0{{/if}}px;--ar:{{#if this.settings.ratio}}{{this.settings.ratio}}{{else}}9/16{{/if}}">
        {{#if this.settings.heading}}<h3 class="b-mslider__h">{{this.settings.heading}}</h3>{{/if}}
        <div class="b-mslider__vp">
          <div class="b-mslider__track" data-reels-track>
            {{#if this.settings.media_1}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_1}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_2}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_2}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_3}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_3}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_4}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_4}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_5}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_5}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_6}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_6}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_7}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_7}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_8}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_8}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_9}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_9}}" alt="" loading="lazy"></figure>{{/if}}
            {{#if this.settings.media_10}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_10}}" alt="" loading="lazy"></figure>{{/if}}
          </div>
          {{#unless (eq this.settings.show_arrows false)}}
          <div class="b-mslider__nav" data-reels-nav hidden>
            <button type="button" class="b-round-btn" data-reels-step="-1" aria-label="Previous">‹</button>
            <button type="button" class="b-round-btn" data-reels-step="1" aria-label="Next">›</button>
          </div>
          {{/unless}}
        </div>
      </div>
      {{/if}}
      {{#if (eq this.type "faq")}}
      {{!-- Own questions when question 1 is filled, else the store's FAQ (snippets/faq-list.hbs). --}}
      <div class="b-pfaq" {{{this.attributes}}}>
        {{#if this.settings.heading}}<h3 class="b-pfaq__h">{{this.settings.heading}}</h3>{{/if}}
        {{#if this.settings.q_1}}
        {{> faq-qa q=this.settings.q_1 a=this.settings.a_1}}
        {{> faq-qa q=this.settings.q_2 a=this.settings.a_2}}
        {{> faq-qa q=this.settings.q_3 a=this.settings.a_3}}
        {{> faq-qa q=this.settings.q_4 a=this.settings.a_4}}
        {{> faq-qa q=this.settings.q_5 a=this.settings.a_5}}
        {{> faq-qa q=this.settings.q_6 a=this.settings.a_6}}
        {{else}}
        {{> faq-list}}
        {{/if}}
      </div>
      {{/if}}
      {{#if (eq this.type "size_chart")}}
      {{!-- "Size guide" link + popup. With an option name set, it shows only on products that have that option. --}}
      <div class="b-sizechart" {{{this.attributes}}} data-size-chart data-option="{{this.settings.option_name}}" data-options="{{#each @root.product.variants}}{{name}}|{{/each}}">
        <button type="button" class="b-sizechart__link" data-modal-open>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2.5 8.5h19v7h-19z M6 8.5v3 M9.5 8.5v2 M13 8.5v3 M16.5 8.5v2 M20 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <span>{{#if this.settings.label}}{{this.settings.label}}{{else}}Size guide{{/if}}</span>
        </button>
        <div class="b-modal" data-modal hidden role="dialog" aria-modal="true" aria-label="{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}">
          <div class="b-modal__overlay" data-modal-close></div>
          <div class="b-modal__panel b-sizechart__panel">
            <button type="button" class="b-icon-btn b-modal__close" data-modal-close aria-label="Close">✕</button>
            <p class="b-sizechart__title">{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}</p>
            {{#if this.settings.image}}<img class="b-sizechart__img" src="{{this.settings.image}}" alt="{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}" loading="lazy">{{/if}}
            {{#if this.settings.body}}<div class="b-rte">{{{applyTokens this.settings.body}}}</div>{{/if}}
          </div>
        </div>
      </div>
      {{/if}}
    {{/each}}
    {{else}}
    <h1 class="b-info__title">{{product.title}}</h1>
    {{> price}}
    <div class="b-buy">
      {{> options}}
      {{> buy-row}}
    </div>
    {{#if product.description_html}}<div class="b-rte b-block-text">{{{product.description_html}}}</div>{{/if}}
    {{/if}}
  </div>
</div>

{{!-- Sticky buy bar. ui.js shows it once the main button scrolls out of view. sticky_style "compact" = small card
      (bottom right on desktop); "full" = full-width bar with the was price, the SAVE badge and a variant select that
      drives the pickers above (ui.js initSticky). --}}
{{#unless (eq section.settings.sticky_atc false)}}
<div class="b-sticky{{#if (eq section.settings.sticky_style "full")}} b-sticky--full{{/if}}" data-sticky hidden>
  {{#if product.media.main_image}}<img class="b-sticky__img" src="{{product.media.main_image}}" alt="" loading="lazy">{{/if}}
  <div class="b-sticky__info">
    <p class="b-sticky__title">{{product.title}}</p>
    {{#if (eq section.settings.sticky_style "full")}}
    <p class="b-sticky__price"><span data-sticky-price>{{product.price}}</span>{{#if product.compare_at_price}} <s class="b-sticky__was" data-sticky-compare>{{product.compare_at_price}}</s>{{/if}}{{#if product.off_pct}} <span class="b-badge b-sticky__off" data-sticky-off>Save {{product.off_pct}}%</span>{{/if}}</p>
    {{else}}
    <p class="b-sticky__price" data-sticky-price>{{product.price}}</p>
    {{/if}}
  </div>
  {{#if (eq section.settings.sticky_style "full")}}{{#if product.variants.length}}
  <label class="b-sticky__variant"><span class="b-sr">Choose an option</span>
    <select class="b-select" data-sticky-variant>
      {{#each product.variants_list}}<option value="{{id}}">{{title}}</option>{{/each}}
    </select>
  </label>
  {{/if}}{{/if}}
  <button type="button" class="b-btn" data-testid="sticky-add-to-cart" data-add-to-cart data-sticky-btn>{{#if settings.atc_label}}{{settings.atc_label}}{{else}}Add to cart{{/if}}</button>
</div>
{{/unless}}
