{{!-- Quantity + the add-to-cart button. mode "checkout" goes straight to checkout after adding.
      Resilia: the button also shows the chosen selection's price + was price ("ADD TO CART | $59.99 $144.98"),
      filled by assets/js/rs.js. --}}
<div class="b-buy-row">
  {{#unless (eq show_qty false)}}
  <div class="b-qty" data-qty>
    <button type="button" data-qty-step="-1" aria-label="Decrease quantity">−</button>
    <input type="number" min="1" max="999" value="1" data-qty-input aria-label="Quantity">
    <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
  </div>
  {{/unless}}
  <button type="button" class="b-btn b-btn--block b-btn--lg" id="addToCart" data-testid="add-to-cart" data-add-to-cart data-main-atc data-mode="{{#if mode}}{{mode}}{{else}}cart{{/if}}">
    <span class="rs-atc__label">{{#if label}}{{label}}{{else}}{{#if @root.settings.atc_label}}{{@root.settings.atc_label}}{{else}}Add to cart{{/if}}{{/if}}</span><span class="rs-atc__price" data-rs-atc hidden><span class="rs-atc__sep" aria-hidden="true">|</span><span data-rs-atc-now></span><s data-rs-atc-was></s></span>
  </button>
</div>
