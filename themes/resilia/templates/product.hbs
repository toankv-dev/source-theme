{{!-- Legacy (schema v1) entry: the upload validator renders this file, and a store without a template document
      falls back to it. Same shell as layout/theme.hbs with the key sections inlined (`section` is undefined,
      so each section renders its built-in defaults). --}}
<!doctype html>
<html lang="en">
<head>
{{> head}}
<link rel="stylesheet" href="{{assets_url}}/css/rs-product.css">
</head>
<body class="b-body b-body--product">
{{{trackingBody}}}
<a class="b-skip" href="#MainContent">Skip to content</a>
{{> header}}
<main id="MainContent" class="b-main">{{> product}}{{> reviews}}{{> faq}}{{> related}}</main>
{{> footer}}
{{> product-scripts}}
{{> scripts}}
</body>
</html>
