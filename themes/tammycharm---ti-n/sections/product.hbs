{{!-- Main product section. Gallery on one side; every element of the info column is a block rendered in the
      merchant's order. From the legacy entry (templates/product.hbs) `section` is undefined, so the {{else}}
      branch renders title, price, options and the buy button — the page still sells without a template
      document. Pickers / buy row are wired by ui.js through data-* attributes only. --}}
<div class="b-wrap b-pdp b-pdp--gallery-{{#if section.settings.gallery_side}}{{section.settings.gallery_side}}{{else}}left{{/if}}" data-pdp>
  <div class="b-gallery b-gallery--{{#if section.settings.gallery_layout}}{{section.settings.gallery_layout}}{{else}}thumbs{{/if}}" data-gallery>
    <div class="b-gallery__main">
      {{#if product.media.main_image}}
      <img data-gallery-main src="{{product.media.main_image}}" alt="{{product.title}}" fetchpriority="high">
      {{/if}}
      {{#if product.off_pct}}{{#unless (eq section.settings.show_sale_badge false)}}<span class="b-badge b-gallery__badge" data-off-badge>{{#if (eq section.settings.sale_badge_style "off")}}{{product.off_pct}}% OFF{{else}}-{{product.off_pct}}%{{/if}}</span>{{/unless}}{{/if}}
    </div>
    {{#if product.media.gallery.length}}
    <div class="b-gallery__strip">
      <button type="button" class="b-round-btn" data-gallery-step="-1" aria-label="Previous image">‹</button>
      <div class="b-gallery__thumbs" data-gallery-thumbs>
        {{#each product.media.gallery}}
        <button type="button" class="b-thumb{{#if @first}} is-active{{/if}}" data-gallery-thumb="{{url}}" aria-label="Show image {{@index}}">
          {{!-- A video's thumbnail is its poster (else the platform turns the <img> into a playing video). --}}
          <img src="{{#if thumb_url}}{{thumb_url}}{{else}}{{#if is_video}}{{#if poster_url}}{{poster_url}}{{else}}{{url}}{{/if}}{{else}}{{url}}{{/if}}{{/if}}" alt="{{alt}}" loading="lazy">
        </button>
        {{/each}}
      </div>
      <button type="button" class="b-round-btn" data-gallery-step="1" aria-label="Next image">›</button>
    </div>
    {{/if}}
  </div>

  <div class="b-info">
    {{#if section.blocks.length}}
    {{#each section.blocks}}
{{!-- PF:BEGIN PeakFlex blocks --}}
      {{#if (eq this.type "pf_rating")}}
      {{#if @root.product.reviews.summary.total_count}}
      <a class="pf-rating" href="#reviews" {{{this.attributes}}}>{{> lu-tp-stars rating=@root.product.reviews.summary.average_rating}} <span>({{@root.product.reviews.summary.average_rating}}/5) - {{@root.product.reviews.summary.total_count}} {{#if this.settings.label}}{{this.settings.label}}{{else}}Reviews{{/if}}</span></a>
      {{/if}}
      {{/if}}
      {{#if (eq this.type "pf_social")}}
      <div class="pf-social" {{{this.attributes}}}>
        {{#if this.settings.image}}<img class="pf-social__img" src="{{this.settings.image}}" alt="" width="120" height="40" loading="lazy">{{else}}<span class="pf-social__img b-ph" aria-hidden="true">{{#if @root.__designMode}}Upload{{/if}}</span>{{/if}}
        <p class="pf-social__text"><strong>{{this.settings.title}}</strong>{{#if this.settings.text}}<span>{{this.settings.text}}</span>{{/if}}</p>
      </div>
      {{/if}}
      {{#if (eq this.type "pf_hsa")}}
      <div class="pf-hsa" {{{this.attributes}}}>
        <p class="pf-hsa__line"><strong>{{this.settings.label}}</strong><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 5v14M5 12h14M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="1.2"/></svg><span>{{this.settings.text}}</span></p>
        <button type="button" class="pf-hsa__more" data-modal-open>{{#if this.settings.link_label}}{{this.settings.link_label}}{{else}}Learn more{{/if}}</button>
        <div class="b-modal" data-modal hidden role="dialog" aria-modal="true" aria-label="{{this.settings.popup_title}}">
          <div class="b-modal__overlay" data-modal-close></div>
          <div class="b-modal__panel pf-hsa__panel">
            <button type="button" class="b-icon-btn b-modal__close" data-modal-close aria-label="Close">✕</button>
            <p class="pf-hsa__title">{{this.settings.popup_title}}</p>
            <div class="b-rte">{{{this.settings.popup_body}}}</div>
          </div>
        </div>
      </div>
      {{/if}}
      {{#if (eq this.type "pf_comment")}}
      <div class="pf-comment" {{{this.attributes}}}>
        {{#if this.settings.avatar}}<img class="pf-comment__avatar" src="{{this.settings.avatar}}" alt="" width="56" height="56" loading="lazy">{{else}}<span class="pf-comment__avatar b-ph" aria-hidden="true"></span>{{/if}}
        <div class="pf-comment__body">
          <div class="pf-comment__bubble"><p class="pf-comment__name">{{this.settings.name}} <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#1877f2"/><path d="m4.5 8.2 2.3 2.2 4.7-4.8" fill="none" stroke="#fff" stroke-width="1.6"/></svg></p><p class="pf-comment__text">{{this.settings.text}}</p></div>
          <p class="pf-comment__meta"><span>{{this.settings.time}}</span><span class="pf-comment__like">Like</span><span>Reply</span><span class="pf-comment__count"><i aria-hidden="true">👍</i><i aria-hidden="true">❤️</i> {{this.settings.likes}}</span></p>
        </div>
      </div>
      {{/if}}
      {{!-- PF:END --}}
      {{!-- RF:BEGIN RANGEFORT blocks --}}
      {{#if (eq this.type "rf_proof")}}
      {{!-- Proof bar above the title: overlapping faces (picked in the editor; the theme's own pictures until then), a
            named buyer with a blue check, then the line. Empty line = the product's own review count, and the bar
            is then shown only when the product has reviews. --}}
      {{#if this.settings.text}}
      <a class="rf-proof" href="#reviews" {{{this.attributes}}}{{#if this.settings.bg}} style="--pr-bg:{{this.settings.bg}}"{{/if}}>
        <span class="rf-proof__faces" aria-hidden="true"><img src="{{#if this.settings.avatar_1}}{{this.settings.avatar_1}}{{else}}{{@root.assets_url}}/images/rf/face-1.webp{{/if}}" alt="" width="30" height="30" onerror="this.remove()"><img src="{{#if this.settings.avatar_2}}{{this.settings.avatar_2}}{{else}}{{@root.assets_url}}/images/rf/face-2.webp{{/if}}" alt="" width="30" height="30" onerror="this.remove()">{{#unless (eq this.settings.show_third false)}}<img src="{{#if this.settings.avatar_3}}{{this.settings.avatar_3}}{{else}}{{@root.assets_url}}/images/rf/face-3.webp{{/if}}" alt="" width="30" height="30" onerror="this.remove()">{{/unless}}</span>
        <span class="rf-proof__text">{{#if this.settings.name}}<b>{{this.settings.name}}</b> <svg class="rf-proof__check" viewBox="0 0 24 24" aria-label="Verified buyer" role="img"><path d="m20.8 8.838a1.445 1.445 0 0 1 -.419-1.012v-1.278a2.934 2.934 0 0 0 -2.931-2.930h-1.276a1.425 1.425 0 0 1 -1.012-.418l-1.090-1.091a2.934 2.934 0 0 0 -4.144 0l-1.090 1.091a1.425 1.425 0 0 1 -1.012.419h-1.277a2.934 2.934 0 0 0 -2.931 2.930v1.277a1.441 1.441 0 0 1 -.418 1.011l-1.092 1.091a2.934 2.934 0 0 0 0 4.144l1.092 1.090a1.445 1.445 0 0 1 .419 1.012v1.278a2.934 2.934 0 0 0 2.931 2.930h1.276a1.425 1.425 0 0 1 1.012.419l1.090 1.091a2.933 2.933 0 0 0 4.144 0l1.090-1.091a1.425 1.425 0 0 1 1.012-.419h1.277a2.934 2.934 0 0 0 2.931-2.930v-1.278a1.437 1.437 0 0 1 .419-1.011l1.091-1.091a2.934 2.934 0 0 0 0-4.144z" fill="#2196f3"/><circle cx="12" cy="12" fill="#29b3ff" r="6.75"/><path d="m11 14.75a.744.744 0 0 1 -.53-.22l-2-2a.75.75 0 0 1 1.060-1.060l1.470 1.469 3.470-3.469a.75.75 0 0 1 1.060 1.060l-4 4a.744.744 0 0 1 -.53.22z" fill="#fff"/></svg> {{/if}}{{{this.settings.text}}}</span>
      </a>
      {{else}}{{#if @root.product.reviews.summary.total_count}}
      <a class="rf-proof" href="#reviews" {{{this.attributes}}}{{#if this.settings.bg}} style="--pr-bg:{{this.settings.bg}}"{{/if}}>
        <span class="rf-proof__faces" aria-hidden="true"><img src="{{#if this.settings.avatar_1}}{{this.settings.avatar_1}}{{else}}{{@root.assets_url}}/images/rf/face-1.webp{{/if}}" alt="" width="30" height="30" onerror="this.remove()"><img src="{{#if this.settings.avatar_2}}{{this.settings.avatar_2}}{{else}}{{@root.assets_url}}/images/rf/face-2.webp{{/if}}" alt="" width="30" height="30" onerror="this.remove()">{{#unless (eq this.settings.show_third false)}}<img src="{{#if this.settings.avatar_3}}{{this.settings.avatar_3}}{{else}}{{@root.assets_url}}/images/rf/face-3.webp{{/if}}" alt="" width="30" height="30" onerror="this.remove()">{{/unless}}</span>
        <span class="rf-proof__text">{{#if this.settings.name}}<b>{{this.settings.name}}</b> <svg class="rf-proof__check" viewBox="0 0 24 24" aria-label="Verified buyer" role="img"><path d="m20.8 8.838a1.445 1.445 0 0 1 -.419-1.012v-1.278a2.934 2.934 0 0 0 -2.931-2.930h-1.276a1.425 1.425 0 0 1 -1.012-.418l-1.090-1.091a2.934 2.934 0 0 0 -4.144 0l-1.090 1.091a1.425 1.425 0 0 1 -1.012.419h-1.277a2.934 2.934 0 0 0 -2.931 2.930v1.277a1.441 1.441 0 0 1 -.418 1.011l-1.092 1.091a2.934 2.934 0 0 0 0 4.144l1.092 1.090a1.445 1.445 0 0 1 .419 1.012v1.278a2.934 2.934 0 0 0 2.931 2.930h1.276a1.425 1.425 0 0 1 1.012.419l1.090 1.091a2.933 2.933 0 0 0 4.144 0l1.090-1.091a1.425 1.425 0 0 1 1.012-.419h1.277a2.934 2.934 0 0 0 2.931-2.930v-1.278a1.437 1.437 0 0 1 .419-1.011l1.091-1.091a2.934 2.934 0 0 0 0-4.144z" fill="#2196f3"/><circle cx="12" cy="12" fill="#29b3ff" r="6.75"/><path d="m11 14.75a.744.744 0 0 1 -.53-.22l-2-2a.75.75 0 0 1 1.060-1.060l1.470 1.469 3.470-3.469a.75.75 0 0 1 1.060 1.060l-4 4a.744.744 0 0 1 -.53.22z" fill="#fff"/></svg> {{/if}}{{#unless this.settings.name}}{{#each (limit @root.product.reviews.items 1)}}<b>{{name}}</b> <svg class="rf-proof__check" viewBox="0 0 24 24" aria-label="Verified buyer" role="img"><path d="m20.8 8.838a1.445 1.445 0 0 1 -.419-1.012v-1.278a2.934 2.934 0 0 0 -2.931-2.930h-1.276a1.425 1.425 0 0 1 -1.012-.418l-1.090-1.091a2.934 2.934 0 0 0 -4.144 0l-1.090 1.091a1.425 1.425 0 0 1 -1.012.419h-1.277a2.934 2.934 0 0 0 -2.931 2.930v1.277a1.441 1.441 0 0 1 -.418 1.011l-1.092 1.091a2.934 2.934 0 0 0 0 4.144l1.092 1.090a1.445 1.445 0 0 1 .419 1.012v1.278a2.934 2.934 0 0 0 2.931 2.930h1.276a1.425 1.425 0 0 1 1.012.419l1.090 1.091a2.933 2.933 0 0 0 4.144 0l1.090-1.091a1.425 1.425 0 0 1 1.012-.419h1.277a2.934 2.934 0 0 0 2.931-2.930v-1.278a1.437 1.437 0 0 1 .419-1.011l1.091-1.091a2.934 2.934 0 0 0 0-4.144z" fill="#2196f3"/><circle cx="12" cy="12" fill="#29b3ff" r="6.75"/><path d="m11 14.75a.744.744 0 0 1 -.53-.22l-2-2a.75.75 0 0 1 1.060-1.060l1.470 1.469 3.470-3.469a.75.75 0 0 1 1.060 1.060l-4 4a.744.744 0 0 1 -.53.22z" fill="#fff"/></svg> {{/each}}{{/unless}}and <b>{{@root.product.reviews.summary.total_count}}+ others</b> love this product.</span>
      </a>
      {{/if}}{{/if}}
      {{/if}}
      {{#if (eq this.type "rf_stars")}}
      <a class="rf-stars" href="#rf-reviews" {{{this.attributes}}}>
        {{> lu-tp-stars rating=this.settings.rating}}
        <strong>{{this.settings.rating}}</strong><span class="rf-stars__sep">|</span><span>{{this.settings.count}} {{#if this.settings.label}}{{this.settings.label}}{{else}}reviews{{/if}}</span>
      </a>
      {{/if}}
      {{#if (eq this.type "rf_heading")}}
      <p class="rf-heading" {{{this.attributes}}}><span>{{this.settings.text}}</span></p>
      {{/if}}
      {{#if (eq this.type "rf_checkout")}}
      <fieldset class="rf-safe" {{{this.attributes}}}>
        <legend>{{#if this.settings.title}}{{{this.settings.title}}}{{else}}Guaranteed <em>safe</em> checkout{{/if}}</legend>
        {{> pay-icons}}
      </fieldset>
      {{/if}}
      {{#if (eq this.type "rf_quote")}}
      <figure class="rf-quote" {{{this.attributes}}}>
        <img class="rf-quote__img" src="{{#if this.settings.photo}}{{this.settings.photo}}{{else}}{{@root.assets_url}}/images/rf/{{#if this.settings.image}}{{this.settings.image}}{{else}}quote.webp{{/if}}{{/if}}" alt="Photo from {{this.settings.name}}" width="72" height="72" loading="lazy" onerror="this.remove()">
        <figcaption>
          <span class="b-stars b-stars--sm" style="--r:{{this.settings.rating}}" aria-label="{{this.settings.rating}} out of 5"></span>
          <p class="rf-quote__text">"{{this.settings.text}}"</p>
          <p class="rf-quote__who"><strong>{{this.settings.name}}</strong> <span>{{this.settings.meta}}</span></p>
        </figcaption>
      </figure>
      {{/if}}
      {{#if (eq this.type "rf_delivery")}}
      <ul class="rf-delivery" {{{this.attributes}}} data-rf-delivery data-min="{{this.settings.min_days}}" data-max="{{this.settings.max_days}}">
        <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M2 6h12v10H2zM14 9h4l3 3.5V16h-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="6" cy="17.5" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17.5" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.6"/></svg>
          <span data-rf-delivery-text>{{this.settings.fallback}}</span></li>
        {{#if this.settings.line_2}}<li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{{applyTokens this.settings.line_2}}}</span></li>{{/if}}
      </ul>
      {{/if}}
      {{#if (eq this.type "rf_desc")}}
      <details class="b-acc rf-acc rf-acc--desc" {{{this.attributes}}} data-accordion{{#unless (eq this.settings.open false)}} open{{/unless}}>
        <summary><span>{{#if this.settings.title}}{{this.settings.title}}{{else}}Description{{/if}}</span><span class="rf-acc__icon" aria-hidden="true"></span></summary>
        <div class="b-acc__body rf-desc">{{> rf-desc}}</div>
      </details>
      {{/if}}
      {{#if (eq this.type "rf_sizes")}}
      <details class="b-acc rf-acc" id="rf-size" {{{this.attributes}}} data-accordion{{#if this.settings.open}} open{{/if}}>
        <summary><span>{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}</span><span class="rf-acc__icon" aria-hidden="true"></span></summary>
        <div class="b-acc__body">{{> rf-sizes sz_table=this.settings.table}}</div>
      </details>
      {{/if}}
      {{#if (eq this.type "rf_acc")}}
      <details class="b-acc rf-acc" {{{this.attributes}}} data-accordion{{#if this.settings.open}} open{{/if}}>
        <summary><span>{{this.settings.title}}</span><span class="rf-acc__icon" aria-hidden="true"></span></summary>
        <div class="b-acc__body b-rte">{{{applyTokens this.settings.body}}}</div>
      </details>
      {{/if}}
      {{#if (eq this.type "rf_sizelink")}}
      {{!-- Size chart popup. ui.js moves [data-modal] to <body> and opens it from [data-modal-open]; rf.js opens it from any [data-rf-size] link. --}}
      <div class="b-sizechart rf-sizebtn" {{{this.attributes}}}>
        <button type="button" class="b-sizechart__link" data-modal-open data-rf-size-open><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2.5 8.5h19v7h-19z M6 8.5v3 M9.5 8.5v2 M13 8.5v3 M16.5 8.5v2 M20 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>{{#if this.settings.label}}{{this.settings.label}}{{else}}Size chart{{/if}}</span></button>
        <div class="b-modal rf-modal" data-modal hidden role="dialog" aria-modal="true" aria-labelledby="rf-modal-size-h">
          <div class="b-modal__overlay" data-modal-close></div>
          <div class="b-modal__panel rf-modal__panel">
            <div class="rf-modal__head">
              <span class="rf-modal__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2.5 8.5h19v7h-19z M6 8.5v3 M9.5 8.5v2 M13 8.5v3 M16.5 8.5v2 M20 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
              <div><p class="rf-modal__title" id="rf-modal-size-h">{{#if this.settings.label}}{{this.settings.label}}{{else}}Size chart{{/if}}</p><p class="rf-modal__sub">{{#if this.settings.subtitle}}{{this.settings.subtitle}}{{else}}Measure yourself, then match the chart.{{/if}}</p></div>
              <button type="button" class="b-icon-btn b-modal__close rf-modal__close" data-modal-close aria-label="Close">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
              </button>
            </div>
            <div class="rf-modal__body">{{> rf-sizes sz_table=this.settings.table}}</div>
          </div>
        </div>
      </div>
      {{/if}}
      {{#if (eq this.type "rf_price")}}
      {{!-- Unit price of the chosen variant. Not [data-price-block]: ui.js writes the bundle total there. rf.js keeps this one in sync. --}}
      <div class="b-price rf-unit-price" {{{this.attributes}}} data-rf-unit-price>
        <span class="b-price__now" data-rf-now>{{@root.product.price}}</span>
        {{#if @root.product.compare_at_price}}<s class="b-price__was" data-rf-was>{{@root.product.compare_at_price}}</s>{{/if}}
        {{#if @root.product.off_pct}}<span class="b-badge" data-rf-off>Save {{@root.product.off_pct}}%</span>{{/if}}
      </div>
      {{/if}}
      {{!-- RF:END --}}
      {{#if (eq this.type "award")}}
      <p class="b-award" {{{this.attributes}}}>{{#if this.settings.icon}}{{this.settings.icon}} {{/if}}{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "rating")}}
      {{#if @root.product.reviews.summary.total_count}}
      <a class="b-rating" href="#reviews" {{{this.attributes}}}>
        {{> lu-tp-stars rating=@root.product.reviews.summary.average_rating}}
        <strong>{{@root.product.reviews.summary.average_rating}}</strong>
        <span class="b-rating__sep">|</span>
        <span>{{@root.product.reviews.summary.total_count}} {{#if this.settings.label}}{{this.settings.label}}{{else}}reviews{{/if}}</span>
      </a>
      {{/if}}
      {{/if}}
      {{#if (eq this.type "title")}}
      <h1 class="b-info__title" {{{this.attributes}}}>{{@root.product.title}}</h1>
      {{/if}}
      {{#if (eq this.type "subtitle")}}
      <p class="b-subtitle" {{{this.attributes}}}>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "benefit")}}
      <p class="b-benefit" {{{this.attributes}}}><span class="b-check" aria-hidden="true">✓</span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "stock")}}
      <p class="b-stock" {{{this.attributes}}}><span class="b-stock__dot" aria-hidden="true"></span>{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "urgency")}}
      {{!-- "{n}" in the text becomes a number between min and max that drifts a little (people viewing now). --}}
      <p class="b-urgency" {{{this.attributes}}} data-urgency data-min="{{this.settings.min}}" data-max="{{this.settings.max}}" data-text="{{this.settings.text}}">{{this.settings.text}}</p>
      {{/if}}
      {{#if (eq this.type "offer_heading")}}
      <p class="b-offer" {{{this.attributes}}}><span>{{this.settings.text}}</span></p>
      {{/if}}
      {{#if (eq this.type "price")}}
      <div {{{this.attributes}}}>{{> price}}</div>
      {{/if}}
      {{#if (eq this.type "variant_picker")}}
      <div class="b-picker" {{{this.attributes}}}{{#if (eq this.settings.show false)}} style="display:none" data-picker-hidden{{/if}}>{{> options}}</div>
      {{/if}}
      {{#if (eq this.type "variant_cards")}}
      {{> pack-cards this}}
      {{/if}}
      {{#if (eq this.type "buy_buttons")}}
      <div class="b-buy" {{{this.attributes}}}>
        {{#unless (eq this.settings.show_options false)}}{{> options}}{{/unless}}
        {{> buy-row label=this.settings.label mode=this.settings.mode show_qty=this.settings.show_qty}}
        {{#if this.settings.note}}<p class="b-buy__note">{{this.settings.note}}</p>{{/if}}
        {{#unless (eq this.settings.show_payments false)}}{{> pay-icons}}{{/unless}}
      </div>
      {{/if}}
      {{#if (eq this.type "trust_icons")}}
      <ul class="b-trust" {{{this.attributes}}}>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" stroke="currentColor" stroke-width="1.6" fill="none"/></svg><span>{{this.settings.label_1}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="9" y="10.5" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M10.2 10.5V9.3a1.8 1.8 0 0 1 3.6 0v1.2" stroke="currentColor" stroke-width="1.4" fill="none"/></svg><span>{{this.settings.label_2}}</span></li>
        <li><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/><circle cx="17" cy="17.5" r="1.7" stroke="currentColor" stroke-width="1.5" fill="#fff"/></svg><span>{{this.settings.label_3}}</span></li>
      </ul>
      {{/if}}
      {{#if (eq this.type "review")}}
      {{#each (limit @root.product.reviews.items 1)}}
      <figure class="b-quote" {{{../attributes}}}>
        {{#if image}}<img class="b-quote__img" src="{{image}}" alt="" loading="lazy">{{/if}}
        <figcaption>
          <span class="b-stars b-stars--sm" style="--r:{{rating}}" aria-label="{{rating}} out of 5"></span>
          <p class="b-quote__text">{{content}}</p>
          <p class="b-quote__who"><strong>{{name}}</strong>{{#if verified}} · <span class="b-verified">Verified buyer</span>{{/if}}</p>
        </figcaption>
      </figure>
      {{/each}}
      {{/if}}
      {{#if (eq this.type "accordion")}}
      <details class="b-acc" {{{this.attributes}}}{{#if this.settings.open}} open{{/if}}>
        <summary>{{#if (eq this.settings.icon "research")}}<span class="pf-acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3v18M7 7c2 0 3-1.5 5-1.5S15 7 17 7M5 11h14M8 21h8M4 14l3-7 3 7a3 3 0 0 1-6 0Zm10 0 3-7 3 7a3 3 0 0 1-6 0Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span>{{/if}}{{#if (eq this.settings.icon "return")}}<span class="pf-acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 8 4 12l5 4M4 12h11a5 5 0 0 1 0 10h-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{/if}}{{#if (eq this.settings.icon "truck")}}<span class="pf-acc-icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M2 6h12v10H2zM14 9h4l3 3.5V16h-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="6" cy="17.5" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="17.5" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.5"/></svg></span>{{/if}}<span>{{this.settings.title}}</span></summary>
        <div class="b-acc__body b-rte">
          {{#if (eq this.settings.source "description")}}{{{@root.product.description_html}}}{{/if}}
          {{#if (eq this.settings.source "custom")}}{{{applyTokens this.settings.body}}}{{/if}}
        </div>
      </details>
      {{/if}}
      {{#if (eq this.type "description")}}
      <div class="b-rte b-block-text b-description" {{{this.attributes}}}>{{{@root.product.description_html}}}</div>
      {{/if}}
      {{#if (eq this.type "text")}}
      <div class="b-rte b-block-text" {{{this.attributes}}}>{{{applyTokens this.settings.body}}}</div>
      {{/if}}
      {{#if (eq this.type "image")}}
      {{#if this.settings.image}}<img class="b-block-image" {{{this.attributes}}} src="{{this.settings.image}}" alt="{{this.settings.alt}}" loading="lazy">{{else}}<div class="b-block-image b-ph b-ph--block" {{{this.attributes}}}>{{#if @root.__designMode}}Upload an image{{/if}}</div>{{/if}}
      {{/if}}
      {{#if (eq this.type "divider")}}
      <hr class="b-divider" {{{this.attributes}}}>
      {{/if}}
      {{#if (eq this.type "custom_html")}}
      <div class="b-custom-html" {{{this.attributes}}}>{{{this.settings.html}}}</div>
      {{/if}}
      {{#if (eq this.type "media_slider")}}
      {{!-- Up to 10 images / videos side by side (data-reels in ui.js). A video file picked in an image slot
            is turned into a muted looping <video> (by the server, else by ui.js). Slots 1..`slots` with no file
            keep an empty frame (upload hint in the editor); empty slots past `slots` are skipped. --}}
      <div class="b-mslider" {{{this.attributes}}} data-reels style="--pv:{{#if this.settings.per_view}}{{this.settings.per_view}}{{else}}3{{/if}};--pvm:{{#if this.settings.per_view_mobile}}{{this.settings.per_view_mobile}}{{else}}1.5{{/if}};--gap:{{#if this.settings.gap}}{{this.settings.gap}}{{else}}0{{/if}}px;--r:{{#if this.settings.radius}}{{this.settings.radius}}{{else}}0{{/if}}px;--ar:{{#if this.settings.ratio}}{{this.settings.ratio}}{{else}}9/16{{/if}}">
        {{#if this.settings.heading}}<h3 class="b-mslider__h">{{this.settings.heading}}</h3>{{/if}}
        <div class="b-mslider__vp">
          <div class="b-mslider__track" data-reels-track>
            {{#if this.settings.media_1}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_1}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 0)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_2}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_2}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 1)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_3}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_3}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 2)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_4}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_4}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 3)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_5}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_5}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 4)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_6}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_6}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 5)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_7}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_7}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 6)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_8}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_8}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 7)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_9}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_9}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 8)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
            {{#if this.settings.media_10}}<figure class="b-mslider__item" data-reel><img class="b-mslider__media" data-reel-video src="{{this.settings.media_10}}" alt="" loading="lazy"></figure>{{else if (gt this.settings.slots 9)}}<figure class="b-mslider__item" data-reel><div class="b-mslider__ph">{{#if @root.__designMode}}Upload an image or video{{/if}}</div></figure>{{/if}}
          </div>
          {{#unless (eq this.settings.show_arrows false)}}
          <div class="b-mslider__nav" data-reels-nav hidden>
            <button type="button" class="b-round-btn" data-reels-step="-1" aria-label="Previous">‹</button>
            <button type="button" class="b-round-btn" data-reels-step="1" aria-label="Next">›</button>
          </div>
          {{/unless}}
        </div>
      </div>
      {{/if}}
      {{#if (eq this.type "faq")}}
      {{!-- Own questions when question 1 is filled, else the store's FAQ (snippets/faq-list.hbs). --}}
      <div class="b-pfaq" {{{this.attributes}}}>
        {{#if this.settings.heading}}<h3 class="b-pfaq__h">{{this.settings.heading}}</h3>{{/if}}
        {{#if this.settings.q_1}}
        {{> faq-qa q=this.settings.q_1 a=this.settings.a_1}}
        {{> faq-qa q=this.settings.q_2 a=this.settings.a_2}}
        {{> faq-qa q=this.settings.q_3 a=this.settings.a_3}}
        {{> faq-qa q=this.settings.q_4 a=this.settings.a_4}}
        {{> faq-qa q=this.settings.q_5 a=this.settings.a_5}}
        {{> faq-qa q=this.settings.q_6 a=this.settings.a_6}}
        {{else}}
        {{> faq-list}}
        {{/if}}
      </div>
      {{/if}}
      {{#if (eq this.type "size_chart")}}
      {{!-- "Size guide" link + popup. With an option name set, it shows only on products that have that option. --}}
      <div class="b-sizechart" {{{this.attributes}}} data-size-chart data-option="{{this.settings.option_name}}" data-options="{{#each @root.product.variants}}{{name}}|{{/each}}">
        <button type="button" class="b-sizechart__link" data-modal-open>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2.5 8.5h19v7h-19z M6 8.5v3 M9.5 8.5v2 M13 8.5v3 M16.5 8.5v2 M20 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <span>{{#if this.settings.label}}{{this.settings.label}}{{else}}Size guide{{/if}}</span>
        </button>
        {{!-- Same popup frame as "RF: size chart button + popup"; content is this block's own (image, Size table, text). --}}
        <div class="b-modal rf-modal" data-modal hidden role="dialog" aria-modal="true" aria-label="{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}">
          <div class="b-modal__overlay" data-modal-close></div>
          <div class="b-modal__panel rf-modal__panel">
            <div class="rf-modal__head">
              <span class="rf-modal__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2.5 8.5h19v7h-19z M6 8.5v3 M9.5 8.5v2 M13 8.5v3 M16.5 8.5v2 M20 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
              <div><p class="rf-modal__title">{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}</p>{{#if this.settings.subtitle}}<p class="rf-modal__sub">{{this.settings.subtitle}}</p>{{/if}}</div>
              <button type="button" class="b-icon-btn b-modal__close rf-modal__close" data-modal-close aria-label="Close">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
              </button>
            </div>
            <div class="rf-modal__body">
            <div class="rf-sizes">
            {{#if this.settings.image}}<img class="rf-sizes__img" src="{{this.settings.image}}" alt="{{#if this.settings.title}}{{this.settings.title}}{{else}}Size chart{{/if}}" loading="lazy" style="display:block;max-width:100%;height:auto;margin:0 auto 10px">{{/if}}
            {{#if this.settings.table}}<div class="rf-sizes__scroll" data-sg-src="{{this.settings.table}}"></div><script>(function(){var s=document.currentScript.previousElementSibling,t=s.getAttribute("data-sg-src")||"",e=function(x){var d=document.createElement("div");d.textContent=x;return d.innerHTML},c=function(x,tag){var p=x.split("/"),h=e(p[0].trim());if(p.length>1)h+="<small>"+e(p.slice(1).join("/").trim())+"</small>";return"<"+tag+">"+h+"</"+tag+">"},rows=t.split(/\r?\n/).map(function(l){return l.trim()}).filter(Boolean);if(!rows.length)return;var h="<table class=\"rf-sizes__table\"><thead><tr>"+rows[0].split("|").map(function(x){return"<th>"+e(x.trim())+"</th>"}).join("")+"</tr></thead><tbody>";rows.slice(1).forEach(function(r){h+="<tr>"+r.split("|").map(function(x,i){return c(x,i?"td":"th")}).join("")+"</tr>"});s.innerHTML=h+"</tbody></table>"})();</script>{{/if}}
            {{#if this.settings.body}}<div class="rf-sizes__note">{{{applyTokens this.settings.body}}}</div>{{/if}}
            </div>
            </div>
          </div>
        </div>
      </div>
      {{/if}}
    {{/each}}
    {{else}}
    <h1 class="b-info__title">{{product.title}}</h1>
    {{> price}}
    <div class="b-buy">
      {{> options}}
      {{> buy-row}}
    </div>
    {{#if product.description_html}}<div class="b-rte b-block-text">{{{product.description_html}}}</div>{{/if}}
    {{/if}}
  </div>
</div>

{{!-- Sticky buy bar. ui.js shows it once the main button scrolls out of view. sticky_style "compact" = small card
      (bottom right on desktop); "full" = full-width bar with the was price, the SAVE badge and a variant select that
      drives the pickers above (ui.js initSticky). --}}
{{#unless (eq section.settings.sticky_atc false)}}
<div class="b-sticky{{#if (eq section.settings.sticky_style "full")}} b-sticky--full{{/if}}" data-sticky hidden>
  {{#if product.media.main_image}}<img class="b-sticky__img" src="{{product.media.main_image}}" alt="" loading="lazy">{{/if}}
  <div class="b-sticky__info">
    <p class="b-sticky__title">{{product.title}}</p>
    {{#if (eq section.settings.sticky_style "full")}}
    <p class="b-sticky__price"><span data-sticky-price>{{product.price}}</span>{{#if product.compare_at_price}} <s class="b-sticky__was" data-sticky-compare>{{product.compare_at_price}}</s>{{/if}}{{#if product.off_pct}} <span class="b-badge b-sticky__off" data-sticky-off>Save {{product.off_pct}}%</span>{{/if}}</p>
    {{else}}
    <p class="b-sticky__price" data-sticky-price>{{product.price}}</p>
    {{/if}}
  </div>
  {{#if (eq section.settings.sticky_style "full")}}{{#if product.variants.length}}
  <label class="b-sticky__variant"><span class="b-sr">Choose an option</span>
    <select class="b-select" data-sticky-variant>
      {{#each product.variants_list}}<option value="{{id}}">{{title}}</option>{{/each}}
    </select>
  </label>
  {{/if}}{{/if}}
  <button type="button" class="b-btn" data-testid="sticky-add-to-cart" data-add-to-cart data-sticky-btn>{{#if settings.atc_label}}{{settings.atc_label}}{{else}}Add to cart{{/if}}</button>
</div>
{{/unless}}
{{#unless (eq settings.lu_mbuy false)}}{{> lu-mbuy}}{{/unless}}
