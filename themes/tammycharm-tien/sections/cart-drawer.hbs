{{!-- Filled by ui.js from localStorage "sf-cart:<domain>" (core.js). The platform /checkout reads the same key.
      Hooks kept for pixels: #CartDrawer-Checkout + data-testid="checkout-button". --}}
<div class="b-drawer" id="CartDrawer" data-cart-drawer hidden>
  <div class="b-drawer__overlay" data-cart-close></div>
  <aside class="b-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawer-Title">
    <div class="b-drawer__head">
      {{#if settings.cart_show_logo}}
      <p class="b-sr" id="CartDrawer-Title">{{#if settings.cart_title}}{{settings.cart_title}}{{else}}Your cart{{/if}}</p>
      <span class="b-drawer__logo">{{#if brand.logo}}<img src="{{brand.logo}}" alt="{{brand.name}}" width="110" height="39">{{else}}{{brand.name}}{{/if}}</span>
      {{else}}
      <p class="b-drawer__title" id="CartDrawer-Title">{{#if settings.cart_title}}{{settings.cart_title}}{{else}}Your cart{{/if}} <span class="b-drawer__count" data-cart-count-text></span></p>
      {{/if}}
      <button type="button" class="b-icon-btn" data-cart-close><span aria-hidden="true">✕</span><span class="b-sr">Close cart</span></button>
    </div>
    {{#if settings.cart_notice}}<p class="b-drawer__notice">{{settings.cart_notice}}</p>{{/if}}
    <div class="b-drawer__body" data-cart-lines></div>
    <div class="b-drawer__empty" data-cart-empty>
      <p>{{#if settings.empty_cart_text}}{{settings.empty_cart_text}}{{else}}Your cart is empty.{{/if}}</p>
      <a class="b-btn" href="{{#if config.allProductsUrl}}{{config.allProductsUrl}}{{else}}/collections/all-products{{/if}}" data-local-domain>{{#if settings.empty_cart_button}}{{settings.empty_cart_button}}{{else}}Continue shopping{{/if}}</a>
    </div>
    <div class="b-drawer__foot" data-cart-foot hidden>
      {{!-- Shipping protection / add-ons (settings.cart_upsells = this store's picked products, resolved by the
            server). ui.js adds each as a real cart line, switched ON; the buyer can switch it off. --}}
      {{#if settings.cart_upsells.length}}
      <div class="b-ups" data-b-ups data-as-line="{{#if settings.cart_upsell_as_line}}1{{/if}}" style="--b-up-bg:{{#if settings.cart_upsell_bg}}{{settings.cart_upsell_bg}}{{else}}#f4f5f7{{/if}};--b-up-color:{{#if settings.cart_upsell_color}}{{settings.cart_upsell_color}}{{else}}var(--c-text){{/if}};--b-up-accent:{{#if settings.cart_upsell_accent}}{{settings.cart_upsell_accent}}{{else}}var(--c-ink){{/if}}" hidden>
        {{#if settings.cart_upsell_heading}}<p class="b-ups__h">{{settings.cart_upsell_heading}}</p>{{/if}}
        {{#each settings.cart_upsells}}
        <div class="b-up" data-b-up data-pid="{{productId}}" data-handle="{{handle}}" data-title="{{title}}" data-image="{{image}}">
          <span class="b-up__img">{{#if image}}<img src="{{image}}" alt="" loading="lazy" data-b-up-img>{{/if}}</span>
          <span class="b-up__txt"><strong>{{title}}</strong>{{#if description}}<small class="b-up__desc">{{description}}</small>{{/if}}
            {{#if (gt variants.length 1)}}<select class="b-up__var" data-b-up-var aria-label="{{title}} option">{{#each variants}}<option value="{{id}}" data-price="{{price}}" data-compare="{{compareAtPrice}}" data-image="{{image}}" data-title="{{title}}">{{title}}</option>{{/each}}</select>{{else}}{{#each variants}}<input type="hidden" data-b-up-var value="{{id}}" data-price="{{price}}" data-compare="{{compareAtPrice}}" data-image="{{image}}" data-title="{{title}}">{{/each}}{{/if}}
          </span>
          <span class="b-up__price"><b data-b-up-amt></b><s data-b-up-was hidden></s></span>
          <button type="button" class="b-up__sw" role="switch" aria-checked="true" aria-label="Add {{title}}" data-b-up-sw><i></i></button>
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{!-- Prices and the discount come from the server's own cart quote (/api/storefront/cart/price), the
            same numbers the checkout charges; shipping is added at checkout. --}}
      <div class="b-drawer__row b-drawer__row--discount" data-cart-discount-row hidden>
        <span data-cart-discount-title>Discount</span><span data-cart-discount></span>
      </div>
      <div class="b-drawer__row b-drawer__row--total"><span>{{#if settings.cart_subtotal_label}}{{settings.cart_subtotal_label}}{{else}}Subtotal{{/if}}</span><strong><s class="b-drawer__was" data-cart-subtotal-was hidden></s> <span data-cart-subtotal></span></strong></div>
      <p class="b-drawer__note">{{#if settings.cart_footer_note}}{{settings.cart_footer_note}}{{else}}Shipping is calculated at checkout.{{/if}}</p>
      <button type="button" class="b-btn b-btn--block b-btn--lg b-btn--checkout" id="CartDrawer-Checkout" data-testid="checkout-button" data-cart-checkout>{{#if settings.cart_checkout_label}}{{settings.cart_checkout_label}}{{else}}Checkout{{/if}}</button>
      {{#if settings.cart_trust_1}}
      <ul class="b-drawer__trust">
        <li>{{settings.cart_trust_1}}</li>
        {{#if settings.cart_trust_2}}<li>{{settings.cart_trust_2}}</li>{{/if}}
        {{#if settings.cart_trust_3}}<li>{{settings.cart_trust_3}}</li>{{/if}}
      </ul>
      {{/if}}
      {{#unless (eq settings.cart_show_payment false)}}{{> pay-icons}}{{/unless}}
    </div>
  </aside>
</div>
{{!-- Compact cart lines + colour / size / quantity sheet, as lunara---vesnacharm (user 2026-11-25, Shopee's cart):
      line = title / [colour, size box (cart-sheet.js) | − qty +] / price. Box + quantity 28 px high (lunara's size),
      each keeps a 44 px tap area (::after). #CartDrawer ids beat base / sections / zz-skin. --}}
<style>
#CartDrawer .b-drawer__head{padding-top:2px;padding-bottom:2px}#CartDrawer .b-drawer__title{font-size:18px}
#CartDrawer .b-drawer__body{padding:4px 16px}
#CartDrawer .b-line{position:relative;grid-template-columns:72px minmax(0,1fr);gap:0 12px;padding:12px 0}
#CartDrawer .b-line img{width:72px;height:72px;border-radius:6px}
#CartDrawer .b-line__meta{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:6px 8px;min-width:0}
#CartDrawer .b-line__meta>*{grid-column:1/-1;margin:0}
#CartDrawer .b-line__title{grid-row:1;padding-right:34px;font-size:13px;font-weight:600;line-height:1.35}
#CartDrawer .b-line__variant{grid-column:1;grid-row:2;min-width:0;overflow:hidden;font-size:12px;line-height:1.3;white-space:nowrap;text-overflow:ellipsis}
#CartDrawer .b-line__price{grid-row:3;font-size:14px;line-height:1.3}#CartDrawer .b-line__was,#CartDrawer .b-line__save{font-size:12px}
#CartDrawer .b-line__qrow{display:contents}
#CartDrawer .b-line__qrow .b-qty{grid-column:2;grid-row:2}
#CartDrawer .b-line__qrow .b-tag{grid-column:1/-1;grid-row:4;justify-self:start;padding:2px 7px}
#CartDrawer button.b-line__remove{position:absolute;top:2px;right:-10px;width:44px;height:44px}
#CartDrawer .b-vchg{grid-column:1;grid-row:2;justify-self:start;position:relative;display:inline-flex;align-items:center;gap:6px;max-width:100%;min-width:0;height:28px;margin:0;padding:0 8px;background:#f2f2f2;border:0;border-radius:4px;color:#444;font:inherit;font-size:12px;line-height:1;cursor:pointer}
#CartDrawer .b-vchg:after{content:"";position:absolute;top:-8px;bottom:-8px;left:0;right:0}#CartDrawer .b-vchg:hover{background:#e9e9e9}
#CartDrawer .b-vchg__t{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}#CartDrawer .b-vchg svg{flex:none}
#CartDrawer .b-vchg[aria-busy=true]{opacity:.6}#CartDrawer .b-vchg.is-static{cursor:default;background:none;padding:0}#CartDrawer .b-vchg.is-static svg{display:none}
#CartDrawer .b-line .b-qty{height:28px;border:1px solid #d6d6d6;border-radius:4px}
#CartDrawer .b-line .b-qty button{position:relative;width:28px;height:26px;padding:0;font-size:15px;line-height:1;color:var(--c-text)}
#CartDrawer .b-line .b-qty button:after{content:"";position:absolute;top:-9px;bottom:-9px;left:0;right:0}
#CartDrawer .b-line .b-qty span{min-width:26px;font-size:13px}
#CartDrawer .b-up__desc{display:block;white-space:nowrap;text-overflow:ellipsis;-webkit-line-clamp:unset}
#CartDrawer .b-up__desc.is-more{cursor:pointer}#CartDrawer .b-up__desc.is-open{white-space:normal}
@media screen and (max-width:749px){#CartDrawer .b-drawer__panel{width:100%}}
#CartDrawer .b-sh{position:absolute;inset:0;z-index:30;display:flex;flex-direction:column;justify-content:flex-end}#CartDrawer .b-sh[hidden]{display:none}
#CartDrawer .b-sh__bg{position:absolute;inset:0;display:block;background:rgba(0,0,0,.45);opacity:0;transition:opacity .25s}
#CartDrawer .b-sh__p{position:relative;display:flex;flex-direction:column;max-height:88%;background:#fff;border-radius:12px 12px 0 0;box-shadow:0 -4px 20px rgba(0,0,0,.12);transform:translateY(100%);transition:transform .25s ease}#CartDrawer .b-sh__p:focus{outline:none}
#CartDrawer .b-sh.is-open .b-sh__bg{opacity:1}#CartDrawer .b-sh.is-open .b-sh__p{transform:none}
@media (prefers-reduced-motion:reduce){#CartDrawer .b-sh__bg,#CartDrawer .b-sh__p{transition:none}}
#CartDrawer .b-sh__x{position:absolute;top:4px;right:4px;z-index:1;display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0;padding:0;border:0;background:none;color:#555;cursor:pointer}
#CartDrawer .b-sh__in{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}
#CartDrawer .b-sh__top{display:flex;align-items:flex-end;gap:12px;padding:16px 52px 14px 16px;border-bottom:1px solid #eee}
#CartDrawer .b-sh__img{flex:none;display:block;width:96px;height:96px;border-radius:6px;object-fit:cover;object-position:top;background:#f3f3f3}#CartDrawer .b-sh__img[hidden]{display:none}
#CartDrawer .b-sh__pr{min-width:0;line-height:1.3}#CartDrawer .b-sh__pr b{font-size:18px;font-weight:700;color:var(--c-ink)}#CartDrawer .b-sh__pr s{font-size:13px;color:#9a9a9a}
#CartDrawer .b-sh__cur{margin:4px 0 0;font-size:13px;color:#6f6f6f}
#CartDrawer .b-sh__opt{padding:12px 16px;border-bottom:1px solid #eee}#CartDrawer .b-sh__lbl{margin:0 0 8px;font-size:14px;font-weight:600;color:var(--c-text)}
#CartDrawer .b-sh__vals{display:flex;flex-wrap:wrap;gap:8px}
#CartDrawer .b-sh__v{display:inline-flex;align-items:center;gap:6px;min-width:44px;min-height:44px;margin:0;padding:4px 12px;border:1px solid transparent;border-radius:4px;background:#f5f5f5;color:var(--c-text);font:inherit;font-size:13px;line-height:1.2;cursor:pointer}
#CartDrawer .b-sh__v img{flex:none;width:28px;height:28px;border-radius:2px;object-fit:cover;object-position:top}
#CartDrawer .b-sh__v.is-on{border-color:var(--c-ink);background:#fff;color:var(--c-ink)}#CartDrawer .b-sh__v.is-out:not(.is-on){color:#aaa}#CartDrawer .b-sh__v.is-out img{opacity:.5}
#CartDrawer .b-sh__qty{display:flex;align-items:center;justify-content:space-between;border-bottom:0}#CartDrawer .b-sh__qty .b-sh__lbl{margin:0}
#CartDrawer .b-sh__step{display:flex;align-items:center;border:1px solid #ddd;border-radius:4px}#CartDrawer .b-sh__step span{min-width:40px;text-align:center;font-size:14px}
#CartDrawer .b-sh__step button{position:relative;display:flex;align-items:center;justify-content:center;width:44px;height:36px;margin:0;padding:0;border:0;background:none;color:var(--c-text);cursor:pointer}
#CartDrawer .b-sh__step button:after{content:"";position:absolute;top:-4px;bottom:-4px;left:0;right:0}#CartDrawer .b-sh__step button:disabled{color:#ccc;cursor:default}
#CartDrawer .b-sh__ft{flex:none;padding:10px 16px max(12px,env(safe-area-inset-bottom));border-top:1px solid #eee}
#CartDrawer .b-sh__ok{display:block;width:100%;min-height:48px;margin:0;padding:0 20px;border:0;border-radius:40px;background:var(--c-ink);color:var(--c-on-ink);font:inherit;font-size:16px;font-weight:700;cursor:pointer}
#CartDrawer .b-sh__ok:disabled{opacity:.5;cursor:default}#CartDrawer .b-sh button:focus-visible{outline:2px solid var(--c-ink);outline-offset:2px}
{{!-- gift lines + units a Buy X Get Y makes free (ui.js zt): this chip ("Free gift" / "2 Free gifts"), no price, no
      quantity stepper; no discount-name tag on any line (user 2026-11-25, as lunara) --}}
#CartDrawer .b-gift-badge{display:inline-block;vertical-align:1px;margin-left:6px;padding:1px 6px;border:1px solid #e4c0d0;border:1px solid color-mix(in srgb,var(--c-ink) 25%,#fff);border-radius:4px;background:#f6e8ee;background:color-mix(in srgb,var(--c-ink) 8%,#fff);color:var(--c-ink);font-size:12px;font-weight:700;line-height:1.3;white-space:nowrap}
</style>
