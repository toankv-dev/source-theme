{{!-- Phone "Buy now" button pinned to the bottom of the product page (like Brixpant / Hushflex).
      Phones only (< 750 px). Shown from the start; it steps aside while the main buy button or the pack / size picker
      is on screen. A click scrolls to the picker; it never adds to cart by itself.
      Theme settings → Product & cards: lu_mbuy (on/off), lu_mbuy_label (text). While it is on, the section's
      "Sticky Add to cart bar" stays desktop-only so a phone never shows two bars. --}}
<div class="lu-mbuy" id="luMbuy" data-lu-mbuy>
  <button type="button" class="b-btn lu-mbuy__btn" data-testid="sticky-buy-now">{{#if settings.lu_mbuy_label}}{{settings.lu_mbuy_label}}{{else}}BUY NOW{{/if}}</button>
</div>
<script>
(function () {
  function init() {
    var bar = document.getElementById("luMbuy");
    if (!bar) return;
    var phone = window.matchMedia("(max-width:749px)");
    function visible(sel) {
      return Array.prototype.filter.call(document.querySelectorAll(sel), function (n) { return n.offsetParent !== null; })[0];
    }
    var PICKERS = ["[data-cards-block]", ".b-picker", ".b-buy", "[data-main-atc]", ".b-info"];
    function picker() {
      for (var i = 0; i < PICKERS.length; i++) { var f = visible(PICKERS[i]); if (f) return f; }
      return null;
    }
    var ticking = false;
    function update() {
      ticking = false;
      var show = phone.matches;
      var atc = visible("[data-main-atc]");
      if (show && atc) {
        var r = atc.getBoundingClientRect();
        show = r.bottom < 0 || r.top > window.innerHeight;
      }
      bar.classList.toggle("is-on", show);
    }
    function schedule() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    window.addEventListener("load", schedule);
    update();
    bar.querySelector("button").addEventListener("click", function (e) {
      e.preventDefault();
      var t = picker();
      if (!t) return;
      var hd = document.querySelector(".b-header");
      var off = hd && /sticky|fixed/.test(getComputedStyle(hd).position) ? hd.offsetHeight : 0;
      window.scrollTo({ top: Math.max(0, t.getBoundingClientRect().top + window.pageYOffset - off - 40), behavior: "smooth" });
    });
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init); else init();
})();
</script>
