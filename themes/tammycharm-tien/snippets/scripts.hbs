{{!-- core.js = platform behaviour shared by every theme (cart, discounts, tracking, variants, reviews API,
      forms). ui.js = this theme's interface (drawers, gallery, sliders…). A child theme may replace ui.js,
      never core.js. --}}
<script src="{{assets_url}}/js/core.js" defer></script>
{{!-- srv-price.js makes every pack price and cart total the backend's (/cart/price); it must run before ui.js. --}}
<script src="{{assets_url}}/js/srv-price.js" defer></script>
{{!-- cart-sheet.js = the cart line colour / size box + its bottom sheet (BCartSheet.box, used by ui.js zt()); before ui.js. --}}
<script src="{{assets_url}}/js/cart-sheet.js" defer></script>
<script src="{{assets_url}}/js/ui.js" defer></script>
<script src="{{assets_url}}/js/theme.js" defer></script>
