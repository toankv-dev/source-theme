      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "How long does delivery take?",
            "a": "<p>Delivery takes 7 to 15 days depending on your location. The shipping cost is worked out from your address and shown at checkout, before you pay. See our <a href=\"{{ShippingLink}}\">Shipping Policy</a>.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "How can I track my order?",
            "a": "<p>You can check the status of your order any time on our <a href=\"{{TrackOrderLink}}\">Track your order</a> page.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Which size should I choose for the best fit?",
            "a": "<p>The leggings come in nine sizes, US 2 to US 30+, and stretch with you. Open the Size Guide next to the bundles to compare your waist and hip with the chart, in inches and centimeters. If you are between two sizes, pick the larger one for a more relaxed fit. Not sure? <a href=\"{{ContactLink}}\">Contact us</a> before you order.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "What is your return and refund policy?",
            "a": "<p>You have 45 days from delivery to return your order for a refund. Full details are in our <a href=\"{{RefundLink}}\">Refund Policy</a>.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "How does the Buy 1, Get 1 Free offer work?",
            "a": "<p>Choose \"2 Leggings - Get Your 2nd Free\" above, pick a size and color for each pair, then add to cart. The free pair is taken off automatically at checkout. Choose \"Buy 2, Get 2 Free\" to get four pairs for $89.90.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "How can I reach customer support?",
            "a": "<p>Send us a message through our <a href=\"{{ContactLink}}\">Contact page</a> and we will get back to you.</p>"
          }
        }
      },
