{{!-- Footer: brand + contact, policy links, optional collections column, newsletter, payment icons. Rendered on
      the platform's own pages too, so read only brand / config / policyLinks / settings / collections. --}}
<footer class="b-footer">
  <div class="b-wrap b-footer__grid">
    <div class="b-footer__brand">
      <img class="b-footer__logo" src="{{#if brand.logo}}{{brand.logo}}{{else}}{{#if settings.tv_logo}}{{settings.tv_logo}}{{else}}{{assets_url}}/images/tv-brand/untitled_design_6.webp{{/if}}{{/if}}" alt="{{brand.name}}" width="220" height="123">
      {{#if settings.footer_about}}<p class="b-footer__about">{{settings.footer_about}}</p>{{/if}}
    </div>
    <div class="tv-footer__contact">
      <p class="b-footer__title">{{#if settings.tv_footer_contact_title}}{{settings.tv_footer_contact_title}}{{else}}Contact{{/if}}</p>
      <ul class="b-footer__contact">
        {{#if settings.support_hours}}<li><strong>{{settings.support_hours}}</strong></li>{{/if}}
        {{#if brand.email}}<li><strong>{{#if settings.tv_footer_email_label}}{{settings.tv_footer_email_label}}{{else}}Email{{/if}}</strong> <a href="mailto:{{brand.email}}">{{brand.email}}</a></li>{{/if}}
        {{#if brand.store_email}}<li><strong>{{#if settings.tv_footer_email_label}}{{settings.tv_footer_email_label}}{{else}}Email{{/if}}</strong> <a href="mailto:{{brand.store_email}}">{{brand.store_email}}</a></li>{{/if}}
        {{#if settings.tv_footer_company}}<li>{{settings.tv_footer_company}}</li>{{/if}}
      </ul>
    </div>
    <div>
      <p class="b-footer__title">{{#if settings.footer_links_title}}{{settings.footer_links_title}}{{else}}Customer care{{/if}}</p>
      <ul>
        {{> policy-link key="privacy" label="Privacy Policy"}}
        {{> policy-link key="refund" label="Refund Policy"}}
        {{#if policyLinks.contact}}<li><a href="{{policyLinks.contact}}">Contact Information</a></li>{{/if}}
        {{> policy-link key="shipping" label="Shipping Policy"}}
        {{> policy-link key="terms" label="Terms of Service"}}
      </ul>
    </div>
    {{#if settings.footer_collections}}{{#if collections.length}}
    <div>
      <p class="b-footer__title">Shop</p>
      <ul>
        {{#each (limit collections 6)}}<li><a href="/collections/{{handle}}" data-local-domain>{{title}}</a></li>{{/each}}
      </ul>
    </div>
    {{/if}}{{/if}}
    {{#unless (eq settings.footer_newsletter false)}}
    <div class="b-footer__news">
      <p class="b-footer__title">{{#if settings.newsletter_heading}}{{settings.newsletter_heading}}{{else}}Join our newsletter{{/if}}</p>
      {{#if settings.newsletter_text}}<p class="b-footer__about">{{settings.newsletter_text}}</p>{{/if}}
      {{> newsletter-form}}
      {{#if settings.social_facebook}}{{> social-links}}{{else}}{{#if settings.social_instagram}}{{> social-links}}{{else}}{{#if settings.social_tiktok}}{{> social-links}}{{/if}}{{/if}}{{/if}}
    </div>
    {{/unless}}
  </div>
  <div class="b-wrap b-footer__bottom">
    {{#unless (eq settings.footer_payment false)}}{{> pay-icons}}{{/unless}}
    <p class="b-footer__copy">
      <small>© <span data-year></span>, <a href="{{#if config.homeUrl}}{{config.homeUrl}}{{else}}{{#if policyLinks.home}}{{policyLinks.home}}{{else}}/{{/if}}{{/if}}">{{brand.name}}</a></small>
    </p>
  </div>
</footer>
