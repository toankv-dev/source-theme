{{!-- Wayfare Test: Wayfare's own footer (brand / Business information / About), instead of the base footer. --}}
<footer class="b-footer">
  <div class="b-wrap b-footer__grid">
    <div class="b-footer__brand">
      {{#if brand.logo}}<img class="b-footer__logo" src="{{brand.logo}}" alt="{{brand.name}}" loading="lazy">{{else}}<p class="b-footer__name">{{brand.name}}</p>{{/if}}
    </div>
    <div>
      <p class="b-footer__title">Business information</p>
      <ul>
        <li>{{brand.name}}</li>
        {{#if brand.email}}<li>Email: <a href="mailto:{{brand.email}}">{{brand.email}}</a></li>{{/if}}
        {{#if brand.store_email}}<li>Email: <a href="mailto:{{brand.store_email}}">{{brand.store_email}}</a></li>{{/if}}
        {{#if brand.phone}}<li>Phone: {{brand.phone}}</li>{{/if}}
        {{#if brand.address}}<li>Address: {{brand.address}}</li>{{/if}}
        {{#if settings.support_hours}}<li>{{settings.support_hours}}</li>{{/if}}
      </ul>
    </div>
    <div>
      <p class="b-footer__title">About</p>
      <ul>
        {{#if policyLinks.about}}<li><a href="{{policyLinks.about}}">About us</a></li>{{/if}}
        {{#if policyLinks.shipping}}<li><a href="{{policyLinks.shipping}}">Shipping policy</a></li>{{/if}}
        {{#if policyLinks.refund}}<li><a href="{{policyLinks.refund}}">Return and refund policy</a></li>{{/if}}
        {{#if policyLinks.contact}}<li><a href="{{policyLinks.contact}}">Contact us</a></li>{{/if}}
        <li><a href="{{#if config.trackUrl}}{{config.trackUrl}}{{else}}{{#if policyLinks.track}}{{policyLinks.track}}{{else}}/pages/track-your-order{{/if}}{{/if}}" data-local-domain>Track your order</a></li>
        {{#if policyLinks.privacy}}<li><a href="{{policyLinks.privacy}}">Privacy policy</a></li>{{/if}}
        {{#if policyLinks.terms}}<li><a href="{{policyLinks.terms}}">Terms of service</a></li>{{/if}}
      </ul>
    </div>
  </div>
  <div class="b-wrap b-footer__bottom">
    {{> pay-icons}}
    <p class="b-footer__copy">
      <small>© <span data-year></span>, <a href="{{#if config.homeUrl}}{{config.homeUrl}}{{else}}{{#if policyLinks.home}}{{policyLinks.home}}{{else}}/{{/if}}{{/if}}">{{brand.name}}</a></small>
      {{#if policyLinks.privacy}}<small><a href="{{policyLinks.privacy}}">Privacy policy</a></small>{{/if}}
    </p>
  </div>
</footer>
