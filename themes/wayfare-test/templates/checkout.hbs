  <script id="sf-config" type="application/json">{{{configJson}}}</script>
  <script>
    (function () {
      'use strict';

      // 1. Loading cart from localStorage
      var cart = [];
      var CART_DOMAIN = '';
      try {
        try { CART_DOMAIN = (JSON.parse((document.getElementById('sf-config') || {}).textContent || '{}') || {}).domain || ''; } catch (e2) {}
        // theme.js luu {v, handle, domain, items}; ban cu luu mang -> nhan ca hai
        var rawCart = JSON.parse(localStorage.getItem('sf-cart:' + CART_DOMAIN) || localStorage.getItem('sf-cart') || 'null');
        cart = Array.isArray(rawCart) ? rawCart : ((rawCart && Array.isArray(rawCart.items)) ? rawCart.items : []);
      } catch (e) {
        console.error('Failed to parse cart', e);
      }

      // Loading config
      var CFG = {};
      var sfConfigEl = document.getElementById('sf-config');
      if (sfConfigEl) {
        try {
          CFG = JSON.parse(sfConfigEl.textContent);
        } catch (e) {
          console.error('[Checkout] Failed to parse sf-config', e);
        }
      }

      var lastProductUrl = null;
      try {
        lastProductUrl = sessionStorage.getItem('sf-last-product-url');
      } catch (e) {}

      // 2. Redirect if cart is empty
      if (cart.length === 0) {
        alert("Your cart is empty! Redirecting back to storefront.");
        window.location.href = lastProductUrl || (CFG && CFG.productUrl) || "/";
        return;
      }

      function money(n) {
        return '$' + (Math.round(n * 100) / 100).toFixed(2);
      }

      function formatVariantLabel(variantStr) {
        if (!variantStr) return '';
        var parts = variantStr.split(/\s*[\/,]\s*/);
        var htmlParts = [];

        // Check if variant string already contains labels (contains :)
        var needsMapping = true;
        for (var i = 0; i < parts.length; i++) {
          if (parts[i].indexOf(':') !== -1) {
            needsMapping = false;
            break;
          }
        }

        if (!needsMapping) {
          parts.forEach(function (part) {
            var subParts = part.split(/:\s*/);
            if (subParts.length === 2) {
              htmlParts.push('<span style="display: inline-block; margin-right: 14px; margin-bottom: 4px; white-space: nowrap;"><strong style="font-weight: 700; color: #1B1B1B;">' + subParts[0] + ':</strong> ' + subParts[1] + '</span>');
            } else {
              htmlParts.push('<span style="display: inline-block; margin-right: 14px; margin-bottom: 4px; white-space: nowrap;">' + part + '</span>');
            }
          });
          return htmlParts.join('');
        }

        // Auto-map labels for legacy 3-option bra variants
        if (parts.length === 3) {
          var labels = ['Color', 'Band Size', 'Cup Size'];
          for (var i = 0; i < 3; i++) {
            htmlParts.push('<span style="display: inline-block; margin-right: 14px; margin-bottom: 4px; white-space: nowrap;"><strong style="font-weight: 700; color: #1B1B1B;">' + labels[i] + ':</strong> ' + parts[i] + '</span>');
          }
          return htmlParts.join('');
        } else if (parts.length === 2) {
          var labels = ['Color', 'Size'];
          for (var i = 0; i < 2; i++) {
            htmlParts.push('<span style="display: inline-block; margin-right: 14px; margin-bottom: 4px; white-space: nowrap;"><strong style="font-weight: 700; color: #1B1B1B;">' + labels[i] + ':</strong> ' + parts[i] + '</span>');
          }
          return htmlParts.join('');
        } else {
          return '<strong style="font-weight: 700; color: #1B1B1B;">Variant:</strong> ' + variantStr;
        }
      }

      // 3. Render Cart Summary
      var container = document.getElementById('co-items-container');
      var totalCount = 0;
      var subtotal = 0;
      var totalCompare = 0;
      var saving = 0;

      cart.forEach(function (item) {
        totalCount += item.qty;
        subtotal += item.qty * item.price;
        var compPrice = item.comparePrice || (item.price * 4.67);
        totalCompare += item.qty * compPrice;

        var itemHtml =
          '<div class="co-item">' +
          '<img class="co-item__image" src="' + item.image + '" alt="Product Image" />' +
          '<div class="co-item__details">' +
          '<div class="co-item__title">' + item.title + '</div>' +
          '<div class="co-item__meta">' + formatVariantLabel(item.variant) + '</div>' +
          '<div class="co-item__footer">' +
          '<div class="co-item__qty"><strong style="font-weight: 600; color: #1a1a1a;">Quantity:</strong> <span style="font-weight: 400; color: #555;">' + item.qty + '</span></div>' +
          '<div class="co-item__price">' +
          '<span class="co-item__sale-price">' + money(item.price * item.qty) + '</span>' +
          '<span class="co-item__compare-price">' + money(compPrice * item.qty) + '</span>' +
          '</div>' +
          '</div>' +
          '</div>' +
          '</div>';

        container.insertAdjacentHTML('beforeend', itemHtml);
      });

      var appliedDiscount = null;
      var initialSaved = totalCompare - subtotal;
      var alertsBlock = document.querySelector('.co-alerts-block');
      var timerBlock = document.querySelector('.co-alert-timer');

      function updateAlertsDisplay(savedVal) {
        var saveAlert = document.getElementById('save-alert');
        var saveAmount = document.getElementById('save-amount');
        if (saveAlert && saveAmount && alertsBlock && timerBlock) {
          if (savedVal > 0) {
            saveAmount.textContent = money(savedVal);
            saveAlert.style.display = 'block';
            alertsBlock.style.border = '1px solid #c3f0d7';
            timerBlock.style.background = '#fff';
            timerBlock.style.color = '#333';
          } else {
            saveAlert.style.display = 'none';
            alertsBlock.style.border = '1px solid #ffd8d8';
            timerBlock.style.background = '#fff5f5';
            timerBlock.style.color = '#ff3860';
          }
        }
      }

      // Initial update
      updateAlertsDisplay(initialSaved);

      function refreshCheckoutTotals() {
        fetch('/api/storefront/cart-totals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            domain: CFG.domain,
            handle: CFG.handle,
            discountCode: appliedDiscount ? appliedDiscount.code : null,
            items: cart.map(function (i) {
              return { price: parseFloat(i.price), quantity: parseInt(i.qty) };
            })
          })
        })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            if (res.success && res.data) {
              var data = res.data;

              // Render subtotal
              document.getElementById('co-subtotal').textContent = money(data.subtotal);

              // Render shipping
              var shippingEl = document.getElementById('co-shipping');
              if (shippingEl) shippingEl.textContent = money(data.shipping);

              // Update total saved (compare price saving + coupon discount)
              var currentSaved = (totalCompare - subtotal) + data.discount;
              updateAlertsDisplay(currentSaved);

              // Render discount row
              var discRow = document.getElementById('co-disc-row');
              var discEl = document.getElementById('co-discount');
              if (data.discount > 0) {
                if (discRow) discRow.style.display = 'flex';
                if (discEl) discEl.textContent = '-' + money(data.discount);

                var discNameEl = discRow.querySelector('span:first-child');
                if (discNameEl) {
                  discNameEl.textContent = data.appliedDiscount && data.appliedDiscount.title
                    ? data.appliedDiscount.title
                    : (data.appliedDiscount && data.appliedDiscount.code ? 'Discount (' + data.appliedDiscount.code + ')' : 'Discount');
                }
              } else {
                if (discRow) discRow.style.display = 'none';
              }

              // Render totals
              var totalCompareVal = totalCompare + data.shipping;
              document.getElementById('co-total-compare').textContent = money(totalCompareVal);
              document.getElementById('co-total').textContent = money(data.total);
              document.getElementById('co-btn-text').textContent = 'Pay ' + money(data.total) + ' now';
            }
          })
          .catch(function (err) {
            console.error('[Checkout] Failed to fetch totals from server', err);
          });
      }

      // Initial calculation
      refreshCheckoutTotals();

      // 4. Countdown Timer
      var totalSeconds = 590; // 09m 50s
      var timerEl = document.getElementById('co-timer');
      function updateTimer() {
        var m = Math.floor(totalSeconds / 60);
        var s = totalSeconds % 60;

        var pad = function (val) {
          return val < 10 ? '0' + val : val;
        };

        if (timerEl) {
          timerEl.textContent = pad(m) + 'm ' + pad(s) + 's';
        }

        if (totalSeconds > 0) {
          totalSeconds--;
        } else {
          totalSeconds = 590; // loop back
        }
      }
      updateTimer();
      setInterval(updateTimer, 1000);

      // 5. Input formatting helpers
      var cardInput = document.getElementById('cardNumber');
      if (cardInput) {
        cardInput.addEventListener('input', function (e) {
          var val = cardInput.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
          var matches = val.match(/\d{4,16}/g);
          var match = matches && matches[0] || '';
          var parts = [];

          for (var i = 0, len = match.length; i < len; i += 4) {
            parts.push(match.substring(i, i + 4));
          }

          if (parts.length > 0) {
            cardInput.value = parts.join(' ');
          } else {
            cardInput.value = val;
          }
        });
      }

      var expiryInput = document.getElementById('cardExpiry');
      if (expiryInput) {
        expiryInput.addEventListener('input', function () {
          var val = expiryInput.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
          if (val.length >= 2) {
            expiryInput.value = val.substring(0, 2) + ' / ' + val.substring(2, 4);
          } else {
            expiryInput.value = val;
          }
        });
      }

      // 6. Form Submission & Validation
      var form = document.getElementById('co-checkout-form');
      var payBtn = document.getElementById('co-pay-btn');

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();

          // Clear errors
          document.querySelectorAll('.co-error-text').forEach(function (el) {
            el.textContent = '';
            el.style.display = 'none';
          });

          var valid = true;
          var fieldsToValidate = ['email', 'firstName', 'lastName', 'address', 'city', 'state', 'zip', 'phone', 'cardNumber', 'cardExpiry', 'cardCvc'];

          fieldsToValidate.forEach(function (f) {
            var el = document.getElementById(f);
            var errEl = document.getElementById('err-' + f);
            if (el && errEl) {
              var val = el.value.trim();
              if (!val) {
                errEl.textContent = 'Required field';
                errEl.style.display = 'block';
                valid = false;
              } else {
                // Basic formats validation
                if (f === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
                  errEl.textContent = 'Invalid email address';
                  errEl.style.display = 'block';
                  valid = false;
                }
                if (f === 'cardNumber' && val.replace(/\s+/g, '').length < 13) {
                  errEl.textContent = 'Invalid card number';
                  errEl.style.display = 'block';
                  valid = false;
                }
                if (f === 'cardExpiry' && val.length < 7) {
                  errEl.textContent = 'Invalid expiry (MM / YY)';
                  errEl.style.display = 'block';
                  valid = false;
                }
                if (f === 'cardCvc' && val.length < 3) {
                  errEl.textContent = 'Invalid CVC';
                  errEl.style.display = 'block';
                  valid = false;
                }
              }
            }
          });

          if (!valid) return;

          payBtn.disabled = true;
          var origBtnText = payBtn.innerHTML;
          payBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" style="animation:ct-spin .7s linear infinite; margin-right: 8px;"><path d="M12 2a10 10 0 0 1 10 10"/></svg> PROCESSING PAYMENT...';

          // Build checkout payload matching the backend schema
          var payload = {
            domain: CFG.domain,
            handle: CFG.handle,
            discountCode: appliedDiscount ? appliedDiscount.code : null,
            customer: {
              firstName: form.firstName.value.trim(),
              lastName: form.lastName.value.trim(),
              email: form.email.value.trim(),
              phone: form.phone.value.trim(),
              address1: form.address.value.trim(),
              city: form.city.value.trim(),
              zip: form.zip.value.trim(),
              province: form.state.value,
              country: 'United States'
            },
            items: cart.map(function (i) {
              return {
                title: i.title,
                variant: i.variant || '',
                price: parseFloat(i.price),
                quantity: parseInt(i.qty),
                image: i.image || '',
                variantId: i.variantId || undefined
              };
            })
          };

          var chkUrl = CFG.checkoutUrl || '/api/storefront/checkout';
          if (chkUrl && chkUrl.indexOf('http') === 0) {
            try {
              var parsedUrl = new URL(chkUrl);
              if (parsedUrl.host === window.location.host) {
                chkUrl = parsedUrl.pathname;
              }
            } catch (err) { }
          }

          fetch(chkUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
            .then(function (r) { return r.json(); })
            .then(function (res) {
              if (res.success) {
                // Render data on Thank You page
                var firstName = form.firstName.value.trim();
                var lastName = form.lastName.value.trim();
                var email = form.email.value.trim();
                var phone = form.phone.value.trim();
                var address = form.address.value.trim();
                var apartment = document.getElementById('apartment') ? document.getElementById('apartment').value.trim() : '';
                var city = form.city.value.trim();
                var stateEl = document.getElementById('state');
                var stateText = stateEl && stateEl.selectedIndex >= 0 ? stateEl.options[stateEl.selectedIndex].text : '';
                var zip = form.zip.value.trim();

                // 1. Header & Confirmation code
                var orderCodeEl = document.getElementById('ty-order-name');
                if (orderCodeEl) orderCodeEl.textContent = 'Confirmation ' + (res.data.orderName || res.data.orderId);

                var thanksMsgEl = document.getElementById('ty-thanks-message');
                if (thanksMsgEl) thanksMsgEl.textContent = 'Thank you, ' + firstName + '!';

                // 2. Email & Phone
                var tyEmailEl = document.getElementById('ty-email');
                if (tyEmailEl) tyEmailEl.textContent = email;

                // 3. Address formatting
                var addressHtml = lastName + ' ' + firstName + '<br>';
                addressHtml += address;
                if (apartment) {
                  addressHtml += ', ' + apartment;
                }
                addressHtml += '<br>' + city + ', ' + stateText + ' ' + zip + '<br>';
                addressHtml += 'United States';
                if (phone) {
                  addressHtml += '<br>' + phone;
                }

                var tyShippingAddrEl = document.getElementById('ty-shipping-address');
                if (tyShippingAddrEl) tyShippingAddrEl.innerHTML = addressHtml;

                var tyBillingAddrEl = document.getElementById('ty-billing-address');
                if (tyBillingAddrEl) tyBillingAddrEl.innerHTML = addressHtml;

                // 4. Update support email link dynamically
                var tySupportLink = document.getElementById('ty-support-link');
                if (tySupportLink) {
                  var domainName = CFG.domain || window.location.hostname;
                  tySupportLink.href = 'mailto:support@' + domainName;
                }

                // 5. Render product list
                var tyContainer = document.getElementById('ty-items-container');
                if (tyContainer) {
                  tyContainer.innerHTML = '';
                  cart.forEach(function (item) {
                    var compPrice = item.comparePrice || (item.price * 4.67);
                    var itemHtml =
                      '<div class="co-ty-item">' +
                      '<div class="co-ty-item-img-wrapper">' +
                      '<img class="co-ty-item-img" src="' + item.image + '" alt="Product Image" />' +
                      '<span class="co-ty-item-qty-badge">' + item.qty + '</span>' +
                      '</div>' +
                      '<div class="co-ty-item-details">' +
                      '<div class="co-ty-item-title">' + item.title + '</div>' +
                      '<div class="co-ty-item-meta">' + formatVariantLabel(item.variant || '') + '</div>' +
                      '</div>' +
                      '<div class="co-ty-item-price">' + money(item.price * item.qty) + '</div>' +
                      '</div>';
                    tyContainer.insertAdjacentHTML('beforeend', itemHtml);
                  });
                }

                // 6. Render prices
                var subtotalEl = document.getElementById('ty-subtotal');
                if (subtotalEl) subtotalEl.textContent = money(res.data.subtotal);

                var shippingEl = document.getElementById('ty-shipping');
                if (shippingEl) shippingEl.textContent = money(res.data.shipping);

                var tyDiscRow = document.getElementById('ty-discount-row');
                var tyDiscEl = document.getElementById('ty-discount');
                if (res.data.discount > 0) {
                  if (tyDiscRow) tyDiscRow.style.display = 'flex';
                  if (tyDiscEl) tyDiscEl.textContent = '-' + money(res.data.discount);
                } else {
                  if (tyDiscRow) tyDiscRow.style.display = 'none';
                }

                var totalEl = document.getElementById('ty-total');
                if (totalEl) totalEl.textContent = money(res.data.total);

                // 7. Tax note (assuming 9% tax already included in price)
                var taxEl = document.getElementById('ty-tax');
                if (taxEl) {
                  var taxVal = (res.data.subtotal - res.data.discount) * 0.09;
                  taxEl.textContent = money(taxVal);
                }

                // 8. Continue shopping button listener
                var tyContinueBtn = document.getElementById('ty-continue-btn');
                if (tyContinueBtn) {
                  tyContinueBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var targetUrl = lastProductUrl || (CFG && CFG.productUrl) || "/";
                    window.location.href = targetUrl;
                  });
                }

                // Clear cart
                localStorage.removeItem('sf-cart');
                localStorage.removeItem('sf-cart:' + CART_DOMAIN);

                // Hide checkout wrapper, show thank you wrapper
                var checkoutWrapper = document.querySelector('.co-wrapper');
                if (checkoutWrapper) checkoutWrapper.style.display = 'none';

                var tyWrapper = document.getElementById('co-thankyou-wrapper');
                if (tyWrapper) {
                  tyWrapper.style.display = 'block';
                  window.scrollTo({ top: 0, behavior: 'smooth' });
                }
              } else {
                payBtn.disabled = false;
                payBtn.innerHTML = origBtnText;
                alert(res.error || "Error processing checkout. Please try again.");
              }
            })
            .catch(function () {
              payBtn.disabled = false;
              payBtn.innerHTML = origBtnText;
              alert("Server communication error. Please try again.");
            });

        });
      }

      // Handle test card autocompletion when clicking "Card Information" title
      var cardTitle = document.getElementById('card-info-title');
      if (cardTitle) {
        cardTitle.style.cursor = 'pointer';
        cardTitle.addEventListener('click', function (e) {
          e.preventDefault();
          var cardNum = document.getElementById('cardNumber');
          var cardExp = document.getElementById('cardExpiry');
          var cardCvc = document.getElementById('cardCvc');

          if (cardNum) cardNum.value = '4242 4242 4242 4242';
          if (cardExp) cardExp.value = '12 / 29';
          if (cardCvc) cardCvc.value = '123';

          // Clear card validation errors
          var errNum = document.getElementById('err-cardNumber');
          var errExp = document.getElementById('err-cardExpiry');
          var errCvc = document.getElementById('err-cardCvc');
          if (errNum) { errNum.textContent = ''; errNum.style.display = 'none'; }
          if (errExp) { errExp.textContent = ''; errExp.style.display = 'none'; }
          if (errCvc) { errCvc.textContent = ''; errCvc.style.display = 'none'; }
        });
      }

      // Handle logo click navigation to product page
      var logoLink = document.querySelector('.co-logo');
      if (logoLink) {
        logoLink.addEventListener('click', function (e) {
          e.preventDefault();
          var targetUrl = lastProductUrl || (CFG && CFG.productUrl) || "/";
          window.location.href = targetUrl;
        });
      }

      // Spin keyframe style insertion
      var style = document.createElement('style');
      style.textContent = '@keyframes ct-spin{to{transform:rotate(360deg)}}';
      document.head.appendChild(style);

    })();
  </script>
</body>

</html>
